+.theme-emotion-toggle {
+  position: absolute;
+  top: 18px;
+  right: 24px;
+  z-index: 1002;
+  background: linear-gradient(90deg, #fff7e6 0%, #ffe4e1 100%);
+  border: none;
+  border-radius: 999px;
+  box-shadow: 0 2px 16px rgba(255, 180, 120, 0.13), 0 0 0 2px #ffe4e1;
+  padding: 0;
+  width: 68px;
+  height: 38px;
+  display: flex;
+  align-items: center;
+  cursor: pointer;
+  transition: opacity .5s, box-shadow .2s;
+  opacity: 1;
+  overflow: visible;
+}
+.theme-emotion-toggle .toggle-inner {
+  width: 100%;
+  height: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  position: relative;
+}
+.theme-emotion-toggle .honeypig-face,
+.theme-emotion-toggle .lion-face {
+  font-size: 1.55rem;
+  filter: drop-shadow(0 1px 0 #fff6) drop-shadow(0 2px 6px #f9c6);
+  transition: filter .3s, transform .3s;
+}
+.theme-emotion-toggle .lion-face {
+  margin-left: 2px;
+}
+.theme-emotion-toggle .honeypig-face {
+  margin-right: 2px;
+}
+.theme-emotion-toggle .toggle-slider {
+  position: absolute;
+  left: 7px;
+  top: 6px;
+  width: 26px;
+  height: 26px;
+  background: linear-gradient(135deg, #fffbe8 60%, #ffe4e1 100%);
+  border-radius: 50%;
+  box-shadow: 0 2px 8px #f9c6, 0 0 0 2px #ffe4e1;
+  transition: left .38s cubic-bezier(.7,1.7,.5,1), background .3s;
+  will-change: left;
+}
+.theme-emotion-toggle.is-lion .toggle-slider {
+  left: 35px;
+  background: linear-gradient(135deg, #fffbe8 10%, #ffe4e1 80%, #ffe4e1 100%);
+}
+.theme-emotion-toggle.is-lion .honeypig-face {
+  filter: grayscale(0.7) blur(1px) opacity(0.5);
+  transform: scale(0.92) translateY(2px);
+}
+.theme-emotion-toggle.is-lion .lion-face {
+  filter: drop-shadow(0 1px 0 #fff6) drop-shadow(0 2px 8px #f9c6) brightness(1.15);
+  transform: scale(1.13) rotate(-7deg);
+}
+.theme-emotion-toggle:active .toggle-slider {
+  box-shadow: 0 2px 16px #f9c6, 0 0 0 2px #ffe4e1;
+}
+@media (max-width: 600px) {
+  .theme-emotion-toggle {
+    top: 12px;
+    right: 10px;
+    width: 54px;
+    height: 32px;
+  }
+  .theme-emotion-toggle .toggle-slider {
+    width: 20px;
+    height: 20px;
+    left: 5px;
+  }
+  .theme-emotion-toggle.is-lion .toggle-slider {
+    left: 27px;
+  }
+  .theme-emotion-toggle .honeypig-face,
+  .theme-emotion-toggle .lion-face {
+    font-size: 1.18rem;
+  }
+}
