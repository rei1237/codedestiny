{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-TW","id":"ep-35","no":"EP.35","tag":"第35話 · 生時校正","title":"生時校正","rev":2,"beats":[{"id":"ep-35:1","s":"n","t":"船破開星雲疾馳。遠處兔耳帆晃著，始終隔著似乎快追上、卻又差一點的距離。","bg":"skyship","bgm":"daily","shot":"wide","l":null,"c":null,"r":null,"sfx":"whoosh","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-35:2","s":"yeon","t":"來，倒著走。閏月先生，從最近的事說起。","x":"serious","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-35:3","s":"yun","t":"最近？替小姐合婚，差點被Neo先生揪領子的事？","x":"base"},{"id":"ep-35:4","s":"yeon","t":"不是那種。大事，人生裂開了一道縫的那天之類的。","x":"disappoint"},{"id":"ep-35:5","s":"yun","t":"大事啊。收到應用程式的那天吧。三年前，梅雨季的第一天。","x":"think"},{"id":"ep-35:6","s":"n","t":"Yeoni在本上記下：應用程式，三年前，梅雨首日。她寫著，閏月卻歪了歪頭。"},{"id":"ep-35:7","s":"yun","t":"咦。我剛才說了什麼？","x":"surprise"},{"id":"ep-35:8","s":"yeon","t":"應用程式，三年前，梅雨季的第一天。","x":"serious"},{"id":"ep-35:9","s":"yun","t":"啊，對。多虧小姐記下來，我的人生在妳本子裡，可能比在我腦子裡留得更牢。","x":"laugh"},{"id":"ep-35:10","s":"n","t":"笑聲薄得異樣。Yeoni翻到下一頁，用力握筆，一筆一畫重重寫下。","sfx":"page"},{"id":"ep-35:11","s":"moka","t":"那個生時校正，到底怎麼做？","x":"base"},{"id":"ep-35:12","s":"yun","t":"把每件事發生那天，星星經過哪個宮，一一對照。時刻對了，事情就全吻合；時刻不對，就會錯開。","x":"base"},{"id":"ep-35:13","s":"yeon","t":"像拿不同鑰匙，一把把試鎖孔。","x":"think"},{"id":"ep-35:14","s":"yun","t":"正是。還有我的第一印象，那是最重要的鑰匙。記得玄關吧？","x":"base"},{"id":"ep-35:15","s":"moka","t":"第一印象容易。騙子。","x":"base"},{"id":"ep-35:16","s":"yun","t":"答對了。大家第一眼見我，都這麼說。","x":"laugh"},{"id":"ep-35:17","s":"n","t":"桌面玻璃下的圓旋轉起來。東邊門檻閃爍，白天的時間被抹去，只剩夜晚與黎明。","im":true,"sfx":"chime","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:18","s":"yeon","t":"下一件。小時候有嚴重受傷過嗎？","x":"think","bg":"skyship","bgm":"daily","shot":"wide","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"base"},"r":{"who":"neo","x":"calm"},"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"skyship 배경에서 진행되는 yeon의 대사"}},{"id":"ep-35:19","s":"yun","t":"受傷啊。嗯，好像有。","x":"think"},{"id":"ep-35:20","s":"n","t":"閏月聲音漸弱。戴手套的手指在半空摸索，像抓不到自己的記憶。"},{"id":"ep-35:21","s":"yun","t":"真奇怪。自己的事，卻像別人的故事。","x":"sad"},{"id":"ep-35:22","s":"n","t":"船頭傳來低低的聲音。Neo仍望著星海，接著往下說。"},{"id":"ep-35:23","s":"neo","t":"十一歲。從渡船摔下去，左臂骨折。奶奶背著你跑了十里。","x":"deadpan"},{"id":"ep-35:24","s":"yun","t":"……你怎麼知道？","x":"surprise"},{"id":"ep-35:25","s":"neo","t":"在財星島，你說過。第三次問我生日的那天。","x":"deadpan"},{"id":"ep-35:26","s":"yeon","t":"連這個都記得？","x":"surprise"},{"id":"ep-35:27","s":"neo","t":"我那麼留意你，怎麼會忘了你說的話。","x":"smirk"},{"id":"ep-35:28","s":"moka","t":"哇，這是愛，還是執念？","x":"base"},{"id":"ep-35:29","s":"neo","t":"是警戒任務。","x":"deadpan"},{"id":"ep-35:30","s":"n","t":"閏月沉默了很久，然後低下頭，肩膀顫了一下。分不清在笑還是在哭。","im":true,"sfx":"heartbeat","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:31","s":"yun","t":"大家都忘了我，偏偏是貓先生記得。","x":"sad"},{"id":"ep-35:32","s":"neo","t":"我本來就不擅長忘記。想投訴，恐怕得找別家客服。","x":"calm"},{"id":"ep-35:33","s":"yeon","t":"投訴宇宙我試過。不受理。","x":"laugh"},{"id":"ep-35:34","s":"n","t":"Yeoni記下：十一歲，渡船，左臂，奶奶。又在旁邊小小地添上：記得的人，Neo。"},{"id":"ep-35:35","s":"neo","t":"還有一件。你說在雞鳴前出生，奶奶總提這件事。","x":"calm"},{"id":"ep-35:36","s":"n","t":"玻璃下的圓再次旋轉。一顆星嵌入十一歲的位置，另一顆嵌入梅雨首日的位置，東邊門檻的範圍縮小了。","fx":"stars","sfx":"sparkle","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":"stars","camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-35:37","s":"yun","t":"天亮前的兩小時，在卯時裡。這部分本來就知道，問題是分鐘。","x":"serious"},{"id":"ep-35:38","s":"yeon","t":"得精確到分鐘？","x":"serious"},{"id":"ep-35:39","s":"yun","t":"青兔合約上寫著。本人說出出生時刻，精確到分鐘，沙漏才歸還。他以為沒人辦得到，才加了這一條。","x":"serious"},{"id":"ep-35:40","s":"n","t":"兔耳飛船就在前面。摩卡纏緊帆索，把船貼過去，兩艘船砰地相撞。","bg":"jae","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"sfx":"whoosh","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-35:41","s":"rab","t":"哎呀呀！擅自登船，滯納金十倍！","x":"snarl","l":{"who":"yeon","x":"serious"},"c":{"who":"moka","x":"base"},"r":{"who":"rab","x":"snarl"},"fx":"shake","sfx":"thud","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":"shake","camera":"steady"},"a11y":{"description":"jae 배경에서 진행되는 rab의 대사"}},{"id":"ep-35:42","s":"moka","t":"滯納金就拿你的耳朵來付。","x":"angry"},{"id":"ep-35:43","s":"n","t":"飛船甲板上，紙張像暴風雪飛起。全是貸款合約，每張紙的簽名欄都張著嘴。"},{"id":"ep-35:44","s":"rab","t":"只要簽名，立刻發放星光！利息用記憶收喔～","x":"invite"},{"id":"ep-35:45","s":"n","t":"合約像網一樣糾纏而來。一張紙啪地貼上Yeoni手腕，簽名欄竟要自行寫下她的名字。","im":true,"fx":"net","sfx":"page","shot":"impact","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":"net","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:46","s":"yeon","t":"我的手自己在動！","x":"fear"},{"id":"ep-35:47","s":"yun","t":"手給我，小姐。","x":"pain"},{"id":"ep-35:48","s":"n","t":"閏月脫下手套，掌心中央是黑洞。合約上的墨被一股股吸入洞中。"},{"id":"ep-35:49","s":"n","t":"紙變得雪白，簽名欄閉上了。可閏月掌心的洞，又擴大了約一拃。","fx":"suck","sfx":"whoosh","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":"suck","camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-35:50","s":"yeon","t":"你不是說用了會變大嗎！","x":"angry"},{"id":"ep-35:51","s":"yun","t":"罰款十根烤串，對吧？記在摩卡先生帳上。","x":"sly"},{"id":"ep-35:52","s":"moka","t":"別記我帳上！","x":"base"},{"id":"ep-35:53","s":"n","t":"摩卡從懷裡抽出一把烤串，插進炭火罐。辛辣的煙籠罩甲板，青兔打起噴嚏。"},{"id":"ep-35:54","s":"rab","t":"哈啾！這是辣椒煙！妨礙營業！","x":"snarl"},{"id":"ep-35:55","s":"moka","t":"島上特製。流淚了吧？這才叫味道。","x":"base"},{"id":"ep-35:56","s":"n","t":"四人穿過煙，衝進飛船內部金色的迴廊。牆邊金庫門排成行，青兔站在最末一扇門前。","bg":"jaeEnter2","bgm":"warRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-35:57","s":"rab","t":"死胡同了呢～不過沒用。卯時客戶，說不出具體分鐘吧。","x":"smug","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"base"},"r":{"who":"rab","x":"smug"}},{"id":"ep-35:58","s":"rab","t":"合約第七條。本人，親口，說出出生時刻，精確到分鐘。誰都不能代勞～","x":"coin"},{"id":"ep-35:59","s":"yun","t":"他說得對。我現在真的不知道。","x":"sad"},{"id":"ep-35:60","s":"n","t":"閏月面孔的邊緣又暈開了。金色迴廊的光繞開他，像不願照向一個不在那裡的人。"},{"id":"ep-35:61","s":"yeon","t":"（不知道。不，碎片都齊了，只要拼起來。）","x":"think"},{"id":"ep-35:62","s":"n","t":"Yeoni翻著記事本。梅雨首日，十一歲，左臂，雞鳴之前，還有第一印象，騙子。"},{"id":"ep-35:63","s":"yeon","t":"閏月先生，奶奶說過在雞鳴前，對吧？你們那裡，雞幾點叫？","x":"serious"},{"id":"ep-35:64","s":"yun","t":"什麼？","x":"surprise"},{"id":"ep-35:65","s":"yeon","t":"地方不同，時間也不同。我鄉下奶奶家的雞，五點半就叫。準得能當鐘用。","x":"serious"},{"id":"ep-35:66","s":"yun","t":"我奶奶也這樣。雞一叫就下鍋煮飯，飯熟時，六點新聞就開始了。","x":"think"},{"id":"ep-35:67","s":"moka","t":"煮飯要幾分鐘？","x":"base"},{"id":"ep-35:68","s":"yun","t":"大鐵鍋，大概三十分鐘。我在那之前出生，奶奶說我比雞先叫，她都笑了。","x":"think"},{"id":"ep-35:69","s":"n","t":"星星不再出現在玻璃上，而是在Yeoni的本子上彼此咬合。梅雨首日的星，十一歲的星，雞鳴前的星，在同一個位置全部吻合。","im":true,"sfx":"chime","shot":"close","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:70","s":"yeon","t":"那就是五點半之前一點，大約五點二十分。","x":"serious"},{"id":"ep-35:71","s":"neo","t":"十一歲的位置也對應這個時刻。我算過。","x":"calm"},{"id":"ep-35:72","s":"rab","t":"哎呀，推理遊戲真可愛～可還是得本人親口說。他自己都不記得。","x":"greed"},{"id":"ep-35:73","s":"n","t":"Yeoni把本子遞給閏月。那一頁的每個字，全是他的故事。他望著紙，看了許久。","bg":"jaeEnter2","bgm":"crisis2","shot":"wide","l":{"who":"yeon","x":"gentle"},"c":{"who":"yun","x":"base"},"r":{"who":"rab","x":"smug"},"scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-35:74","s":"yeon","t":"不記得也行，讀出來就好。這是你的，我只是記下來了。","x":"gentle"},{"id":"ep-35:75","s":"yun","t":"讀別人替我寫的人生啊。","x":"sad"},{"id":"ep-35:76","s":"yeon","t":"不是別人，是同伴。","x":"smile"},{"id":"ep-35:77","s":"n","t":"閏月吸氣，讀了出來。梅雨首日、渡船、左臂、奶奶、雞。讀到最後一行，聲音顫了。","im":true,"shot":"impact","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:78","s":"yun","t":"凌晨五點二十分。比雞更早哭的孩子，就是我。","x":"serious"},{"id":"ep-35:79","s":"n","t":"青兔頸間的沙漏裂開，淺粉色的沙湧出。沒有落地，而是流過半空，進入閏月掌心。","im":true,"fx":"transform","sfx":"bell","shot":"impact","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"natural","ambient":null,"eventEffect":"transform","camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:80","s":"rab","t":"不行！那可是最貴的！","x":"snarl"},{"id":"ep-35:81","s":"n","t":"閏月面孔的輪廓清晰了。金色迴廊的光終於照在他身上。摩卡無聲地豎起拇指。"},{"id":"ep-35:82","s":"yun","t":"小姐的臉好清楚。不，是我變清楚了嗎？","x":"surprise"},{"id":"ep-35:83","s":"yeon","t":"都是。","x":"laugh"},{"id":"ep-35:84","s":"n","t":"這時，整艘飛船狠狠傾斜。窗外暗了，黑月正懸在飛船上方。","bg":"jae","tone":"dark","bgm":"zeroPoint","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-35:85","s":"n","t":"黑手從天空垂下，手指很長。它們越過Yeoni，徑直抓向青兔。","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"rab","x":"snarl"},"im":true,"fx":"hands","sfx":"glitch","shot":"impact","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":"hands","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:86","s":"heuk","t":"失去卯時的手，沒用了。你自稱最弱，倒是誠實。"},{"id":"ep-35:87","s":"rab","t":"董、董事長！我還有三家分店！還有業績報告！","x":"snarl"},{"id":"ep-35:88","s":"heuk","t":"收走。"},{"id":"ep-35:89","s":"n","t":"黑手攥住青兔的背心。閃亮的名片在指間碎裂，青兔的腿離開地面。"},{"id":"ep-35:90","s":"yeon","t":"等等。放開！","x":"angry"},{"id":"ep-35:91","s":"n","t":"Yeoni身體比思緒先動，伸手拉住青兔前爪。摩卡抱住她的腰。"},{"id":"ep-35:92","s":"moka","t":"瘋了？那可是放高利貸的！","x":"angry"},{"id":"ep-35:93","s":"yeon","t":"知道！可我也不想看他被吃！","x":"angry"},{"id":"ep-35:94","s":"n","t":"Neo用透明的手劃出刀刃，兩根黑指斷開。敵人手裡只剩背心，青兔滾落地板。","fx":"claw","sfx":"slash","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":"claw","camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-35:95","s":"n","t":"脫了背心的青兔比想像中小，就是隻一邊耳朵摺著的普通兔子。"},{"id":"ep-35:96","s":"rab","t":"……客戶。這次給您免息。僅此一次。","x":"sly"},{"id":"ep-35:97","s":"yeon","t":"你就是這麼說謝謝的？","x":"disappoint"},{"id":"ep-35:98","s":"rab","t":"最弱的，本來就活得最久嘛～結束營業大拍賣，下一片天空見！","x":"smug"},{"id":"ep-35:99","s":"n","t":"青兔跳上救生艇。艇尾一張寫著「結束營業」的紙飄著，轉眼消失在星雲中。"},{"id":"ep-35:100","s":"n","t":"回到船上，閏月癱坐甲板，攤開右手。淺粉色的沙在掌紋間閃爍。","bg":"skyship","tone":"dark","bgm":"zeroPoint","shot":"wide","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"pain"},"r":{"who":"neo","x":"serious"},"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-35:101","s":"n","t":"可掌心中央的洞還在，一點沒縮。沙粒繞著洞緣打轉，努力不被吸進去。"},{"id":"ep-35:102","s":"yeon","t":"時辰找回來了，為什麼不合上？","x":"surprise"},{"id":"ep-35:103","s":"heuk","t":"時辰是被偷的，洞卻是我挖的。小偷消失了，洞仍會留下。"},{"id":"ep-35:104","s":"heuk","t":"那個洞，會與我一起合上。絕不會先於我關閉。"},{"id":"ep-35:105","s":"n","t":"黑月緩緩遠去。甲板安靜下來。閏月重新戴上手套，一根手指一根手指，格外仔細。","im":true,"shot":"quiet","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:106","s":"yun","t":"看來得一直跟到底了。小姐的這場旅行。","x":"sly"},{"id":"ep-35:107","s":"yeon","t":"別笑著說。這也要罰款。","x":"serious"},{"id":"ep-35:108","s":"yun","t":"我可沒說沒事。","x":"laugh"}]}
