{"version":2,"sourceHash":"1822d08b1cf0edd0475c92c0afa22fe040cec6e8e632f2e40817de52b7dfdd2e","locale":"zh-TW","id":"ep-34","no":"EP.34","tag":"第34話 · 十二屋的天空","title":"十二屋的天空","rev":2,"beats":[{"id":"ep-34:1","s":"n","t":"腳下晃了晃。Yeoni睜眼，下面是木甲板。甲板外，星星如河水流過。","bg":"skyship","bgm":"starDrift","shot":"wide","l":null,"c":null,"r":null,"sfx":"whoosh","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:2","s":"n","t":"是一艘船。沒有帆，只有巨大的黃銅環層層旋轉，每道環都刻著星座圖案。"},{"id":"ep-34:3","s":"yeon","t":"宮殿呢？剛才還是宮殿啊。","x":"surprise","l":{"who":"yeon","x":"surprise"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"base"}},{"id":"ep-34:4","s":"yun","t":"宮殿折起來變成了船。天空變了，交通工具也會變。","x":"base"},{"id":"ep-34:5","s":"moka","t":"船？我不會坐船。島上來的，就一定會坐船嗎？","x":"angry"},{"id":"ep-34:6","s":"yeon","t":"島上來的，通常都會吧？","x":"grin"},{"id":"ep-34:7","s":"moka","t":"所以才更委屈啊。嘔。","x":"base"},{"id":"ep-34:8","s":"n","t":"摩卡跑向欄杆，想朝星海吐點什麼，卻什麼都吐不出，更難受了。"},{"id":"ep-34:9","s":"n","t":"Neo坐在船頭，銀髮隨風飄動，右手藏在左袖裡面。","r":{"who":"neo","x":"calm"}},{"id":"ep-34:10","s":"yeon","t":"Neo，讓我看看手。","x":"serious"},{"id":"ep-34:11","s":"neo","t":"兩隻腳都還好好長著。妳想看的是手吧？","x":"deadpan"},{"id":"ep-34:12","s":"yeon","t":"剛才透明了，我看見了。","x":"disappoint"},{"id":"ep-34:13","s":"neo","t":"現在是白的。想看，以後給妳看。","x":"calm"},{"id":"ep-34:14","s":"yeon","t":"（以後。又是以後。得記下來。）","x":"think"},{"id":"ep-34:15","s":"n","t":"Yeoni打開記事本。徐寒雨，被拖走，一定找到。又在上方添一行：Neo的手，以後一定要看。","sfx":"page"},{"id":"ep-34:16","s":"n","t":"甲板中央有圓桌，玻璃下一個圓分為十二塊發亮，邊緣銅環停著。","bg":"skyship","bgm":"crystalGarden","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:17","s":"yun","t":"這片天的命盤，出生星圖。環停，船也停。","x":"serious","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"serious"},"r":{"who":"neo","x":"calm"}},{"id":"ep-34:18","s":"yeon","t":"像披薩。","x":"think"},{"id":"ep-34:19","s":"yun","t":"是十二塊披薩沒錯，每塊叫一宮。","x":"laugh"},{"id":"ep-34:20","s":"n","t":"船吱嘎一聲停下，星海舔著船邊，卻不再前進。"},{"id":"ep-34:21","s":"yun","t":"星圖主人得按一宮，環才會轉。找的人所在那宮。","x":"base"},{"id":"ep-34:22","s":"yeon","t":"徐寒雨在的宮？可我不知道哪兒。","x":"surprise"},{"id":"ep-34:23","s":"yun","t":"我也不知。是您的天，只認您的手。","x":"sly"},{"id":"ep-34:24","s":"n","t":"她先按圓最左端、最亮的門檻，星聚在上頭，化成尖耳小貓。","im":true,"fx":"stars","sfx":"chime","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":"stars","camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:25","s":"yeon","t":"是貓……好像Yeongnyangi。","x":"surprise"},{"id":"ep-34:26","s":"yun","t":"第一宮，上升獅子。您的門口站著貓先生。","x":"sly"},{"id":"ep-34:27","s":"n","t":"Neo重新立好外套領子，一聲不吭，只有耳廓微微紅了。"},{"id":"ep-34:28","s":"yun","t":"旁邊是金星，愛的星，緊挨門口呢。","x":"sly"},{"id":"ep-34:29","s":"neo","t":"這段解說可以省略。","x":"deadpan"},{"id":"ep-34:30","s":"yun","t":"為什麼？我覺得這部分最有意思。","x":"laugh"},{"id":"ep-34:31","s":"neo","t":"意思是，別再推銷合婚了。","x":"smirk"},{"id":"ep-34:32","s":"n","t":"銅環沒轉，船反退一掌。玻璃下某處，傳來鎖鏈收緊一節的聲音。"},{"id":"ep-34:33","s":"moka","t":"本來就暈船，別再倒著走。","x":"base"},{"id":"ep-34:34","s":"n","t":"她按上方頂端、第十宮的銀點，是金牛座月亮。","bg":"skyship","bgm":"crystalGarden","shot":"wide","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"},"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:35","s":"yun","t":"月亮。心事容易讓人看見的位置。","x":"base"},{"id":"ep-34:36","s":"yeon","t":"那有點丟臉。","x":"shy"},{"id":"ep-34:37","s":"moka","t":"說得對，你生氣先紅臉。","x":"base"},{"id":"ep-34:38","s":"n","t":"船又退，鏈聲比剛才短，也更近。"},{"id":"ep-34:39","s":"yeon","t":"（每錯一次，鏈就短。發聲方向就是答案。）","x":"think"},{"id":"ep-34:40","s":"n","t":"她耳貼玻璃。聲音在圓下方、東側門檻正上面，只有那裡玻璃下是渾的。"},{"id":"ep-34:41","s":"yeon","t":"門口後面緊貼的房，這是什麼宮？","x":"serious"},{"id":"ep-34:42","s":"yun","t":"第十二宮，隱藏的房，被囚之物所在。","x":"serious"},{"id":"ep-34:43","s":"n","t":"渾玻璃內兩個紅點交疊晃動，是火星和木星。"},{"id":"ep-34:44","s":"yun","t":"鬥爭與擴張的力量藏在裡面，或是被藏起的人。","x":"base"},{"id":"ep-34:45","s":"yeon","t":"（藏起的人。徐寒雨，你在那兒。）","x":"think"},{"id":"ep-34:46","s":"n","t":"她用雙掌按緊渾濁那格，玻璃變得如掌心溫暖。","im":true,"sfx":"heartbeat","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:47","s":"n","t":"銅環咔噠開始轉，船向前滑。"},{"id":"ep-34:48","s":"moka","t":"成了。可鎖鏈，短了兩節吧。","x":"base"},{"id":"ep-34:49","s":"yeon","t":"知道，所以要快。","x":"serious"},{"id":"ep-34:50","s":"n","t":"開會前，Yeoni去了船頭。Neo靠著欄杆望向星海，遠處傳來摩卡難受的呻吟。","bg":"skyship","bgm":"neo","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:51","s":"yeon","t":"我的星盤說，玄關站著一隻大貓。","x":"gentle","l":{"who":"yeon","x":"gentle"},"r":{"who":"neo","x":"calm"}},{"id":"ep-34:52","s":"neo","t":"聽見了。","x":"calm"},{"id":"ep-34:53","s":"yeon","t":"你很開心，都看出來了。耳朵都紅了。","x":"grin"},{"id":"ep-34:54","s":"neo","t":"風冷，臉才紅的。","x":"deadpan"},{"id":"ep-34:55","s":"n","t":"風明明從另一邊吹。Yeoni沒有點破，在Neo身旁坐下。"},{"id":"ep-34:56","s":"yeon","t":"Neo，你初次見我時，也看見我的玄關了嗎？第一印象之類的。","x":"serious"},{"id":"ep-34:57","s":"neo","t":"看見了。傘翻著面，妳在發火。","x":"think"},{"id":"ep-34:58","s":"yeon","t":"糟透了。","x":"laugh"},{"id":"ep-34:59","s":"neo","t":"可妳一直拿著那把翻了的傘。我最先記住的，是那個樣子。","x":"smile"},{"id":"ep-34:60","s":"n","t":"Yeoni抱起膝蓋，肩膀碰到Neo，很暖。他的右手卻仍藏在袖裡。","im":true,"sfx":"chime","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:61","s":"yeon","t":"（始終不肯讓我看手。可今天先到這裡。）","x":"think"},{"id":"ep-34:62","s":"n","t":"船突然傾斜。黃銅環尖鳴著停轉，一角天空正在被抹去。","bg":"eclipseSky","tone":"dark","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-34:63","s":"n","t":"黑圓掠過星座，所經之處的星光全不見了，像被湯匙挖走。","l":{"who":"yeon","x":"fear"},"c":{"who":"yun","x":"serious"},"r":{"who":"neo","x":"serious"},"im":true,"fx":"veil","sfx":"glitch","shot":"impact","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"veil","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:64","s":"yun","t":"黑月，在占星中叫莉莉絲。在這片天，那就是黑月的名。","x":"serious"},{"id":"ep-34:65","s":"yeon","t":"它到底有幾個名字？","x":"fear"},{"id":"ep-34:66","s":"neo","t":"吞過幾片天空，就有幾個。","x":"serious"},{"id":"ep-34:67","s":"moka","t":"那它應該不餓了吧。都吃了多少片天了。","x":"base"},{"id":"ep-34:68","s":"yun","t":"不是餓才吃。是空著，怎麼吃都填不滿。","x":"serious"},{"id":"ep-34:69","s":"yeon","t":"（填不滿。無底的容器。可他們說，那是我。）","x":"think"},{"id":"ep-34:70","s":"n","t":"Yeoni不由自主按住肚子。體內發涼，彷彿有什麼在那裡屏住呼吸。"},{"id":"ep-34:71","s":"n","t":"黑圓停在出生星盤正上方。玻璃裂開，第七宮裡的一顆星被拔了上去。"},{"id":"ep-34:72","s":"yun","t":"第七宮，伴侶的位置。他正在吃掉同伴。","x":"surprise"},{"id":"ep-34:73","s":"n","t":"Neo伸手想抓欄杆，卻踉蹌了一下。右手再次透明，這次一直到手腕上方。","fx":"shake","sfx":"thud","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"shake","camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-34:74","s":"yeon","t":"Neo！","x":"cry"},{"id":"ep-34:75","s":"neo","t":"退後。它盯上的是我，不是妳。","x":"angry"},{"id":"ep-34:76","s":"n","t":"黑圓裡流出聲音，低而溫柔。正因為溫柔，更顯冰冷。"},{"id":"ep-34:77","s":"heuk","t":"竟找到了十二宮，容器。你的老虎在那裡。"},{"id":"ep-34:78","s":"heuk","t":"敲錯門的價，已經付了吧。鎖鏈還會一節節縮短。"},{"id":"ep-34:79","s":"yeon","t":"才不是我的老虎。不過，我會去。","x":"angry"},{"id":"ep-34:80","s":"heuk","t":"是啊，妳總是這樣來，帶著傘。"},{"id":"ep-34:81","s":"n","t":"黑圓沉入星海。第七宮的空位冒起煙，天空那一角就這樣空著。","im":true,"shot":"quiet","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:82","s":"n","t":"船又動了，緩緩地，傾斜著。四個人圍在桌邊。","bg":"skyship","tone":"dark","bgm":"warRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:83","s":"yun","t":"開個作戰會。十二宮的門，得報星圖主人出生時刻，精確到分。","x":"base","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-34:84","s":"yeon","t":"八點三十分。媽媽說，晨間劇剛播完就生了。","x":"serious"},{"id":"ep-34:85","s":"moka","t":"這種事妳怎麼知道。","x":"base"},{"id":"ep-34:86","s":"yeon","t":"每年生日都會聽一次，連劇情結局都知道。","x":"grin"},{"id":"ep-34:87","s":"yun","t":"好。您和坐在您星圖裡的貓先生，都能進去。","x":"laugh"},{"id":"ep-34:88","s":"moka","t":"我呢？","x":"base"},{"id":"ep-34:89","s":"yun","t":"摩卡跟著進就好，門不攔客人，只是——","x":"base"},{"id":"ep-34:90","s":"n","t":"閏月停下，把戴手套的右手放到桌面。手套邊緣的黑裂痕正往手肘爬去。"},{"id":"ep-34:91","s":"yun","t":"我不行。我是沒有時辰的乘客。","x":"pain"},{"id":"ep-34:92","s":"yeon","t":"沒有時辰，就過不了門？","x":"surprise"},{"id":"ep-34:93","s":"yun","t":"這片天以時刻為鑰匙。沒鑰匙的人，會在門前漸漸消失。","x":"sad"},{"id":"ep-34:94","s":"n","t":"桌上閏月的影子變淡了。Yeoni揉揉眼，依舊很淡。","im":true,"sfx":"heartbeat","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:95","s":"yeon","t":"那找回來不就好了，你的時辰。","x":"angry"},{"id":"ep-34:96","s":"yun","t":"青兔帶著跑了。這麼大的天空，不知道跑到哪裡。","x":"sly"},{"id":"ep-34:97","s":"n","t":"就在這時，船邊響起輕快的鈴聲。叮咚，像商店開門時的鈴。"},{"id":"ep-34:98","s":"n","t":"一艘雲朵形飛船緊貼著船靠來，兔耳形的帆撲動著，船側掛著閃亮的廣告牌。","bg":"jae","bgm":"orientalGirl","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-34:99","s":"rab","t":"各位客戶～青兔金融，在這片天空也開分店啦！","x":"invite","l":{"who":"yeon","x":"surprise"},"c":null,"r":{"who":"rab","x":"invite"},"sfx":"coin"},{"id":"ep-34:100","s":"moka","t":"不就是那隻兔子嗎？還沒倒閉？","x":"angry"},{"id":"ep-34:101","s":"rab","t":"什麼叫倒閉～天空換了，利率也會換呢。今天星光貸款特價！","x":"smug"},{"id":"ep-34:102","s":"n","t":"青兔脖子上掛著沙漏，裡面的沙是淺粉色，天剛亮時的天空顏色。"},{"id":"ep-34:103","s":"yun","t":"我的卯時。","x":"surprise","im":true,"fx":"reveal","sfx":"sparkle","shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":"reveal","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:104","s":"rab","t":"哎呀，卯時客戶。還沒被抹掉呢～真了不起。","x":"sly"},{"id":"ep-34:105","s":"neo","t":"把那個沙漏放下。","x":"angry"},{"id":"ep-34:106","s":"rab","t":"不要～這可是這片天空最貴的東西。有了時辰，門才會開呀！","x":"scheme"},{"id":"ep-34:107","s":"n","t":"青兔揮揮前爪，飛船滑入星雲，漸漸遠去。兔耳帆像挑釁似的晃了晃。"},{"id":"ep-34:108","s":"yeon","t":"追，現在就追。不會放過。","x":"angry","im":true,"shot":"impact","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:109","s":"yun","t":"小姐，答應我一件事。抓到那隻兔子後，由妳來找回我的時辰。","x":"base"},{"id":"ep-34:110","s":"yeon","t":"我？","x":"serious"},{"id":"ep-34:111","s":"yun","t":"因為我已經不太記得，自己是什麼時候出生的了。","x":"sad"},{"id":"ep-34:r4-dawn","s":"yun","t":"但直到現在，我也討厭下雨的破曉。一到那時，手先冷起來。","x":"sad"},{"id":"ep-34:112","s":"n","t":"閏月笑著說。笑臉的邊緣在星光裡一點點暈開。Yeoni看了很久，想牢牢記住。"},{"id":"ep-34:113","s":"n","t":"閏月話音未落，摩卡就拉下帆索。黃銅環重新轉動，船猛地向前衝。","bg":"skyship","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:114","s":"moka","t":"什麼暈船，不管了。今天非把那兔耳朵串上烤籤。","x":"base","l":{"who":"yeon","x":"surprise"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"surprise"}},{"id":"ep-34:115","s":"yeon","t":"摩卡，你不是不會坐船嗎！","x":"laugh"},{"id":"ep-34:116","s":"moka","t":"是不會。所以才要快點結束！","x":"angry"},{"id":"ep-34:117","s":"n","t":"星海撞上船舷，激起銀色浪花。前方雲間，兔耳帆時隱時現。","fx":"water","sfx":"whoosh","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":"water","camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:118","s":"yun","t":"小姐，準備聽我的故事。要找回時辰，得倒著走。","x":"base"},{"id":"ep-34:119","s":"yeon","t":"倒著？","x":"serious"},{"id":"ep-34:120","s":"yun","t":"叫生時校正。把人生中發生過的事逐一對照，倒推回出生的那一刻。","x":"sly"},{"id":"ep-34:121","s":"n","t":"Yeoni再度打開記事本，在新頁頂端寫下：閏月先生，出生時刻，倒著找。","im":true,"sfx":"bell","shot":"quiet","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}}]}
