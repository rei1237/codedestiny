{"version":2,"sourceHash":"1822d08b1cf0edd0475c92c0afa22fe040cec6e8e632f2e40817de52b7dfdd2e","locale":"zh-TW","id":"ep-24","no":"EP.24","tag":"第24話 · 因為沒有水","title":"因為沒有水","rev":2,"beats":[{"id":"ep-24:1","s":"n","t":"清晨河畔，水霧低低鋪開。一隻粉紅小豬，蜷在濕石頭上睡著。","bg":"river","tone":"dark","bgm":"lakeDawn","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"crossfade","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"river 배경에서 진행되는 서술"}},{"id":"ep-24:2","s":"n","t":"前蹄上纏著一根白毛，夜裡不知重新系了多少次，結疊了三層。"},{"id":"ep-24:3","s":"moka","t":"找到了。妳還真睡在這裡啊。","x":"base","l":null,"c":{"who":"moka","x":"base"},"r":null},{"id":"ep-24:4","s":"yeon","t":"摩卡。Yeongnyangi呢？","x":"sad","l":{"who":"yeon","x":"sad"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"sad"}},{"id":"ep-24:5","s":"moka","t":"還沒有。","x":"base"},{"id":"ep-24:6","s":"n","t":"她點頭。頭上那片褪白的花瓣沾了露，蔫垂著。"},{"id":"ep-24:7","s":"yun","t":"女士，先進去吧。睡在冷石頭上，乙木會從根開始受傷。","x":"sad"},{"id":"ep-24:8","s":"yeon","t":"進去幹什麼。我留在這裡，他一回來就能看見。","x":"sad"},{"id":"ep-24:9","s":"moka","t":"進去吃飯。貓回來見你這樣，會罵我。","x":"angry"},{"id":"ep-24:10","s":"n","t":"摩卡叼著她後頸往裡拖，傷腳上的書籤緞帶拖過溼石。"},{"id":"ep-24:11","s":"n","t":"河面的霧散開，又聚攏。其間，一道黑色水波無聲掠過。誰也沒有看見。","im":true,"shot":"close","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:12","s":"n","t":"閱覽室長桌上鋪著摩卡從市場帶來的河圖，桌尾貓常坐的椅子獨空。","bg":"library","bgm":"warRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-24:13","s":"yun","t":"先找貓先生的痕跡，他最後坐那裡。","x":"base","l":{"who":"yeon","x":"sad"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-24:14","s":"yeon","t":"椅子底下這是什麼，紅粉末？","x":"surprise"},{"id":"ep-24:15","s":"moka","t":"鏽，有鐵腐掉的味道。","x":"base"},{"id":"ep-24:16","s":"n","t":"她用前蹄攏起鏽粉，幾粒隨風落上窗邊盆栽。"},{"id":"ep-24:17","s":"n","t":"小樹一顫，沾鏽的一片葉發黃捲起，落在桌上。"},{"id":"ep-24:18","s":"n","t":"她想撿葉子，停住。前蹄上白毛末端，也沾著紅粉。"},{"id":"ep-24:19","s":"yun","t":"鏽是鐵生病的痕跡，貓先生看來很難受。","x":"serious"},{"id":"ep-24:20","s":"n","t":"閏月把落葉放掌上，紅斑沿葉脈擴散。"},{"id":"ep-24:21","s":"yeon","t":"只是坐過，樹就會這樣？","x":"angry"},{"id":"ep-24:22","s":"yun","t":"金克木。所以貓先生在您身邊，一直很小心。","x":"serious"},{"id":"ep-24:23","s":"yeon","t":"那從一開始，我們就不合。Yeongnyangi和我。","x":"sad"},{"id":"ep-24:24","s":"yun","t":"不，把水壺給我。","x":"base","im":true,"shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:25","s":"n","t":"他用壺水衝葉，紅斑溶解流去，卷葉稍稍舒開。"},{"id":"ep-24:26","s":"yun","t":"金生水，水養木。中間有水，金就不砍木，而是滋養。","x":"serious"},{"id":"ep-24:27","s":"sys","t":"［ 年 壬 · 結冰 ］","fx":"water","sfx":"water","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":"water","camera":"steady"},"a11y":{"description":"library 배경에서 진행되는 시스템 메시지"}},{"id":"ep-24:28","s":"yun","t":"您的水是年幹壬水，如今凍住了。","x":"serious"},{"id":"ep-24:29","s":"n","t":"她把毛尖的鏽浸在壺水裡，鏽沒散，反而粘得更緊。"},{"id":"ep-24:30","s":"yeon","t":"這個怎麼不化？","x":"surprise"},{"id":"ep-24:31","s":"yun","t":"因為只是普通水。要觸到貓先生，水得從您的命盤裡流出來。","x":"base"},{"id":"ep-24:32","s":"moka","t":"那豬的火呢？不是說她的火會熔貓？","x":"base"},{"id":"ep-24:33","s":"yun","t":"水流動，火也能找到去路，不會滅，只會適度減小。","x":"serious"},{"id":"ep-24:34","s":"n","t":"她指甲尖自動迸出火星，河圖一角燒黑。"},{"id":"ep-24:35","s":"moka","t":"豬，別燒地圖，只有這一張。","x":"angry"},{"id":"ep-24:36","s":"yeon","t":"（只要融了冰。我的水流起來，貓就不再融化。）","x":"think"},{"id":"ep-24:37","s":"n","t":"她扶桌站起，傷腳抽痛，卻沒坐回去。"},{"id":"ep-24:38","s":"yeon","t":"去金庫。我的字盤在那裡。","x":"serious"},{"id":"ep-24:39","s":"moka","t":"不是要找貓嗎？","x":"base"},{"id":"ep-24:40","s":"yeon","t":"兩個都找。貓回來，我的水還凍著，他又會融化。","x":"angry"},{"id":"ep-24:41","s":"moka","t":"好，但地圖歸我拿。","x":"base"},{"id":"ep-24:42","s":"yun","t":"小姐，強融那冰會疼，老虎也說過吧。","x":"sad","c":{"who":"yun","x":"sad"}},{"id":"ep-24:43","s":"yeon","t":"疼就讓我疼。我現在能做的，只有這個。","x":"serious"},{"id":"ep-24:44","s":"n","t":"三人下到記憶金庫。中央，浮著Yeoni的文字面板。八格裡，七格亮著。","bgm":"gloom","bg":"memoryVault","tone":"dark","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"}},{"id":"ep-24:45","s":"sys","t":"[ 年 壬午 · 月 丙午 · 日 乙亥 · 時 □辰 ]  7/8","im":true,"fx":"script","sfx":"page","shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"dark","ambient":null,"eventEffect":"script","camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:46","s":"n","t":"最前面的壬字，與其說是字，不如說是一塊冰。黑黑地凍住，裡面有什麼被困著，蠕動不止。"},{"id":"ep-24:47","s":"yeon","t":"從圖書館找到時就這樣，裡面有東西在動。","x":"fear","l":{"who":"yeon","x":"fear"},"c":{"who":"yun","x":"serious"},"r":{"who":"moka","x":"base"}},{"id":"ep-24:48","s":"yun","t":"老虎的水又冷又黑，把您的水凍住了。","x":"serious"},{"id":"ep-24:49","s":"moka","t":"那個條紋傢伙，真是。每見一次，都要弄壞點東西才走。","x":"angry"},{"id":"ep-24:50","s":"yeon","t":"閏月，讓一下。","x":"serious"},{"id":"ep-24:51","s":"yun","t":"女士，等一下。","x":"surprise"},{"id":"ep-24:choose-1","s":"yun","t":"等老虎來會少疼些，只是不知何時來。","x":"serious"},{"id":"ep-24:choose-2","s":"yeon","t":"那期間貓還在融，我不等。","x":"serious"},{"id":"ep-24:52","s":"n","t":"Yeoni已經舉起前蹄。蹄尖凝出丙火的火種。"},{"id":"ep-24:53","s":"yeon","t":"冰要用火融化。我有的是火。","x":"serious"},{"id":"ep-24:54","s":"yun","t":"問題就在這裡！","x":"surprise"},{"id":"ep-24:55","s":"n","t":"火裹住壬字。冰面冒白汽時，她胸口像被劈開般痛。","im":true,"fx":"fire","sfx":"fire","shot":"impact","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"dark","ambient":null,"eventEffect":"fire","camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:56","s":"yeon","t":"啊，好痛！","x":"fear"},{"id":"ep-24:57","s":"n","t":"她沒收火，咬牙把前蹄再推前，冰上裂了一道細縫。"},{"id":"ep-24:58","s":"n","t":"別的場景從縫裡湧入。下著雨，車站屋簷的水成線落下。","bg":"rainStop","tone":"desat","bgm":"memWater","shot":"wide","scene":{"background":"rainStop","backgroundMeaning":"작가 지정 배경: rainStop","transition":"crossfade","tone":"desat","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"rainStop 배경에서 진행되는 서술"}},{"id":"ep-24:59","s":"n","t":"有人獨站車站角落，沒有傘，溼發遮著臉。"},{"id":"ep-24:60","s":"n","t":"一把傘半傾向那人。握傘的小手很眼熟，是她自己的。"},{"id":"ep-24:stop-1","s":"n","t":"進傘的人肩膀溼了一半，她的手又把傘向那邊偏了些。"},{"id":"ep-24:stop-2","s":"yeon","t":"一起撐吧，等公交來了就好。","x":"soft"},{"id":"ep-24:stop-3","s":"n","t":"是自己的聲音。站牌的路線號被雨暈開，看不清。"},{"id":"ep-24:61","s":"n","t":"雨後傳來笑聲，溫暖又略羞澀，卻不知道是誰。","sfx":"rain"},{"id":"ep-24:62","s":"n","t":"畫面斷了，火也脫手。汽散後，壬仍凍著，裂處反倒更黑。","bg":"memoryVault","tone":"dark","bgm":"gloom","shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"}},{"id":"ep-24:63","s":"yeon","t":"剛才是什麼，我沒去過那站。","x":"cry","l":{"who":"yeon","x":"cry"},"c":{"who":"yun","x":"serious"},"r":{"who":"moka","x":"base"}},{"id":"ep-24:64","s":"yun","t":"是冰映出的畫面。誰的記憶，我也不知道。","x":"serious"},{"id":"ep-24:65","s":"moka","t":"豬，妳流鼻血了。","x":"base"},{"id":"ep-24:66","s":"n","t":"Yeoni揉了揉鼻子。前蹄沾上紅色。胸口深處，仍一陣陣抽痛。"},{"id":"ep-24:67","s":"yun","t":"火融冰，水會煮沸蒸發。還來不及滋養您，就燒光了。","x":"serious","im":true,"shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:68","s":"yeon","t":"除了火，我還有什麼？","x":"cry"},{"id":"ep-24:69","s":"yun","t":"我也還不知道。冰由凍住它的人解，才容易。","x":"sad"},{"id":"ep-24:70","s":"moka","t":"那隻老虎，怎麼可能幫忙解。","x":"angry"},{"id":"ep-24:71","s":"yun","t":"是啊。","x":"sad"},{"id":"ep-24:72","s":"n","t":"金庫安靜了。裂處留下黑細痕，她胸內同一位置，也釘著寒氣，散不去。"},{"id":"ep-24:73","s":"n","t":"下午她坐不住，拖著傷腳轉閱覽室，撞了三次桌角。","bg":"library","bgm":"crisis2","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-24:74","s":"yeon","t":"分頭找吧，乾坐著我會瘋。","x":"serious","l":{"who":"yeon","x":"serious"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"base"}},{"id":"ep-24:75","s":"yun","t":"好，我去樓下書架，那裡水的書多。","x":"base"},{"id":"ep-24:76","s":"moka","t":"我去市場，問有沒有又白又圓戴帽子又冷臉的東西路過。","x":"base"},{"id":"ep-24:77","s":"yeon","t":"我去河邊。最後是在那裡看見的。","x":"serious"},{"id":"ep-24:78","s":"yun","t":"日落前回這裡集合。今天的天不對勁。","x":"serious"},{"id":"ep-24:79","s":"n","t":"閏月先摸摸綁在包帶上的舊折傘，再指窗外。昨天裂過的天異常暗，太陽缺一角，像被咬掉。"},{"id":"ep-24:80","s":"moka","t":"太陽怎麼了。跟慶典島那時一模一樣。","x":"base"},{"id":"ep-24:81","s":"yun","t":"所以我才提醒。別一個人待太久。","x":"serious"},{"id":"ep-24:82","s":"n","t":"與此同時，河流下游。霧最濃的地方，坐著一隻白貓。","bg":"river","tone":"dark","bgm":"none","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"crossfade","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"river 배경에서 진행되는 서술"}},{"id":"ep-24:83","s":"n","t":"貓把鏽爪浸在河中，沾水處的鏽如絲解開流走。","l":null,"c":{"who":"neo","x":"calm"},"r":null},{"id":"ep-24:84","s":"neo","t":"金生水。有水，就不必做刀。","x":"calm"},{"id":"ep-24:85","s":"n","t":"和閏月早上說的一樣。他抬起褪鏽的前爪，看了許久。"},{"id":"ep-24:86","s":"neo","t":"她的水還凍著。金融不了冰。","x":"sad"},{"id":"ep-24:87","s":"n","t":"Yeongnyangi看著水中自己的臉。紫色眼睛，短暫盪起金光，又沉了下去。"},{"id":"ep-24:88","s":"neo","t":"她叫我讓開。","x":"soft"},{"id":"ep-24:89","s":"n","t":"他又念一次，輕輕笑了。"},{"id":"ep-24:90","s":"neo","t":"不過，火還在。真好。","x":"smile"},{"id":"ep-24:91","s":"n","t":"河水翻成漆黑。幾十隻黑手，同時從水裡衝出。就在Yeongnyangi浸著前爪的地方。","im":true,"fx":"hands","sfx":"glitch","shot":"impact","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":"hands","camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:92","s":"heuk","t":"想念水了麼，貓兒。你最弱時，水便在最近處。","bg":"handsRush","tone":"dark","bgm":"zeroPoint","shot":"wide","nm":"聲音","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"handsRush 배경에서 진행되는 heuk의 대사"}},{"id":"ep-24:93","s":"neo","t":"是你，裂開圖書館的天。","x":"angry"},{"id":"ep-24:94","s":"heuk","t":"裂痕是你造的。靠鏽刀支撐，天自然先裂。","nm":"聲音"},{"id":"ep-24:95","s":"n","t":"貓站起，鏽爪伸出刀刃，比昨天短了一半，尖端染鏽。","fx":"claw","sfx":"slash","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":"claw","camera":"drift"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"}},{"id":"ep-24:96","s":"n","t":"刀鋒斬斷三隻黑手。手變成六隻回來。六隻，又變成十二隻。"},{"id":"ep-24:97","s":"heuk","t":"金與金，本就該相依。離開那孩子，到吾這裡來。","nm":"聲音"},{"id":"ep-24:98","s":"neo","t":"不要。我只負責她一人。","x":"serious"},{"id":"ep-24:99","s":"n","t":"一隻黑手抓住Yeongnyangi後頸。另一隻抓左爪，再一隻抓尾巴。小小的身體，被拖向水裡。","im":true,"shot":"close","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:100","s":"neo","t":"Yeoni。","x":"fear"},{"id":"ep-24:101","s":"n","t":"名字剛喊出口，Yeongnyangi就閉上嘴。叫她，她就會來。來了，就會站到這些手面前。"},{"id":"ep-24:102","s":"n","t":"白貓一聲不吭，被拖入黑水。水面猛地翻湧一下，又像什麼都沒發生過般平靜。","fx":"suck","sfx":"whoosh","shot":"impact","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":"suck","camera":"drift"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"}},{"id":"ep-24:103","s":"n","t":"河邊，什麼也沒留下。霧重新落下。","bg":"river","tone":"desat","bgm":"none","shot":"quiet","l":null,"c":null,"r":null,"scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"crossfade","tone":"desat","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"river 배경에서 진행되는 서술"}},{"id":"ep-24:104","s":"n","t":"日落，摩卡從市場回來轉向河邊。聽說白圓的一團去了下游。","bg":"river","tone":"dark","bgm":"gloom2","shot":"wide","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"river 배경에서 진행되는 서술"}},{"id":"ep-24:105","s":"moka","t":"喂，客服。我來告狀，豬哭了一夜。","x":"base","l":null,"c":{"who":"moka","x":"base"},"r":null},{"id":"ep-24:106","s":"n","t":"沒有回應。摩卡嗅著鼻子，踩過一塊塊濕石頭。金屬熔化的氣味，混著一種從未聞過的冰冷氣味。"},{"id":"ep-24:107","s":"n","t":"水邊泥地上，印著巨大的掌印。比人手大得多，手指長得過分。掌印中央，扎著一根白毛。","im":true,"shot":"close","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:108","s":"moka","t":"這個。","x":"only"},{"id":"ep-24:109","s":"n","t":"摩卡撿起毛，和她纏在前蹄上的一樣，是貓的毛，卻比河水還冷。"},{"id":"ep-24:110","s":"yeon","t":"摩卡！我到下游盡頭了，什麼也沒——","x":"fear","l":{"who":"yeon","x":"fear"},"c":{"who":"moka","x":"only"},"r":null},{"id":"ep-24:111","s":"n","t":"Yeoni停住話。她看見摩卡爪中的白毛，也看見下面泥地上，巨大的手印。"},{"id":"ep-24:112","s":"yeon","t":"那是從哪兒來的。","x":"fear"},{"id":"ep-24:113","s":"moka","t":"豬，先坐下。坐著聽。","x":"angry"},{"id":"ep-24:114","s":"yeon","t":"我問你，從哪兒來的！","x":"fear"},{"id":"ep-24:115","s":"n","t":"閏月喘著氣跑來。沒戴手套的掌心裡，洞正在自行旋轉。彷彿有什麼龐然大物，剛在附近來過。","c":{"who":"yun","x":"pain"}},{"id":"ep-24:116","s":"yun","t":"遲了。剛才這兒，有很多那種手。","x":"pain"},{"id":"ep-24:117","s":"sys","t":"[ 時干 庚 · 借來的格子 · 連接中斷 ]","im":true,"fx":"metal","sfx":"bell","shot":"close","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":"metal","camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:118","s":"n","t":"胸內釘著寒氣的地方，什麼忽地斷了。只有她聽見。"},{"id":"ep-24:119","s":"yeon","t":"Yeongnyangi被抓走了。","x":"cry"},{"id":"ep-24:120","s":"n","t":"天空的太陽，連最後一角也被吞盡。一輪黑圓，懸在河面上方。四周燃起環狀紅光。","bg":"eclipseSky","tone":"dark","bgm":"zeroPoint","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-24:121","s":"moka","t":"太陽。太陽沒了。","x":"angry","l":{"who":"yeon","x":"fear"},"c":{"who":"moka","x":"angry"},"r":{"who":"yun","x":"serious"}},{"id":"ep-24:122","s":"yun","t":"日蝕。終於現出形體了。","x":"serious"},{"id":"ep-24:123","s":"heuk","t":"貓收到了，容器。正好空著刀鞘，還有些用。","im":true,"fx":"veil","sfx":"heartbeat","shot":"impact","nm":"聲音","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"veil","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 heuk의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:124","s":"yeon","t":"還給我。把Yeongnyangi還給我！","x":"angry"},{"id":"ep-24:125","s":"heuk","t":"還你便是。你得來，做個空容器。","nm":"聲音"},{"id":"ep-24:126","s":"n","t":"黑圓緩緩眨了一下，像眼皮。然後，河上所有影子，同時轉頭看向Yeoni。"}]}
