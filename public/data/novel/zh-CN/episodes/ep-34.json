{"version":2,"sourceHash":"1822d08b1cf0edd0475c92c0afa22fe040cec6e8e632f2e40817de52b7dfdd2e","locale":"zh-CN","id":"ep-34","no":"EP.34","tag":"第34话 · 十二屋的天空","title":"十二屋的天空","rev":2,"beats":[{"id":"ep-34:1","s":"n","t":"脚下晃了晃。Yeoni睁眼，下面是木甲板。甲板外，星星如河水流过。","bg":"skyship","bgm":"starDrift","shot":"wide","l":null,"c":null,"r":null,"sfx":"whoosh","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:2","s":"n","t":"是一艘船。没有帆，只有巨大的黄铜环层层旋转，每道环都刻着星座图案。"},{"id":"ep-34:3","s":"yeon","t":"宫殿呢？刚才还是宫殿啊。","x":"surprise","l":{"who":"yeon","x":"surprise"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"base"}},{"id":"ep-34:4","s":"yun","t":"宫殿折起来变成了船。天空变了，交通工具也会变。","x":"base"},{"id":"ep-34:5","s":"moka","t":"船？我不会坐船。岛上来的，就一定会坐船吗？","x":"angry"},{"id":"ep-34:6","s":"yeon","t":"岛上来的，通常都会吧？","x":"grin"},{"id":"ep-34:7","s":"moka","t":"所以才更委屈啊。呕。","x":"base"},{"id":"ep-34:8","s":"n","t":"摩卡跑向栏杆，想朝星海吐点什么，却什么都吐不出，更难受了。"},{"id":"ep-34:9","s":"n","t":"Neo坐在船头，银发随风飘动，右手藏在左袖里面。","r":{"who":"neo","x":"calm"}},{"id":"ep-34:10","s":"yeon","t":"Neo，让我看看手。","x":"serious"},{"id":"ep-34:11","s":"neo","t":"两只脚都还好好长着。你想看的是手吧？","x":"deadpan"},{"id":"ep-34:12","s":"yeon","t":"刚才透明了，我看见了。","x":"disappoint"},{"id":"ep-34:13","s":"neo","t":"现在是白的。想看，以后给你看。","x":"calm"},{"id":"ep-34:14","s":"yeon","t":"（以后。又是以后。得记下来。）","x":"think"},{"id":"ep-34:15","s":"n","t":"Yeoni打开备忘本。徐寒雨，被拖走，一定找到。又在上方添一行：Neo的手，以后一定要看。","sfx":"page"},{"id":"ep-34:16","s":"n","t":"甲板中央有圆桌，玻璃下一个圆分为十二块发亮，边缘铜环停着。","bg":"skyship","bgm":"crystalGarden","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:17","s":"yun","t":"这片天的命盘，出生星图。环停，船也停。","x":"serious","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"serious"},"r":{"who":"neo","x":"calm"}},{"id":"ep-34:18","s":"yeon","t":"像披萨。","x":"think"},{"id":"ep-34:19","s":"yun","t":"是十二块披萨没错，每块叫一宫。","x":"laugh"},{"id":"ep-34:20","s":"n","t":"船吱嘎一声停下，星海舔着船边，却不再前进。"},{"id":"ep-34:21","s":"yun","t":"星图主人得按一宫，环才会转。找的人所在那宫。","x":"base"},{"id":"ep-34:22","s":"yeon","t":"徐寒雨在的宫？可我不知道哪儿。","x":"surprise"},{"id":"ep-34:23","s":"yun","t":"我也不知。是您的天，只认您的手。","x":"sly"},{"id":"ep-34:24","s":"n","t":"她先按圆最左端、最亮的门槛，星聚在上头，化成尖耳小猫。","im":true,"fx":"stars","sfx":"chime","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":"stars","camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:25","s":"yeon","t":"是猫……好像Yeongnyangi。","x":"surprise"},{"id":"ep-34:26","s":"yun","t":"第一宫，上升狮子。您的门口站着猫先生。","x":"sly"},{"id":"ep-34:27","s":"n","t":"Neo重新立好外套领子，一声不吭，只有耳廓微微红了。"},{"id":"ep-34:28","s":"yun","t":"旁边是金星，爱的星，紧挨门口呢。","x":"sly"},{"id":"ep-34:29","s":"neo","t":"这段解说可以省略。","x":"deadpan"},{"id":"ep-34:30","s":"yun","t":"为什么？我觉得这部分最有意思。","x":"laugh"},{"id":"ep-34:31","s":"neo","t":"意思是，别再推销合婚了。","x":"smirk"},{"id":"ep-34:32","s":"n","t":"铜环没转，船反退一掌。玻璃下某处，传来锁链收紧一节的声音。"},{"id":"ep-34:33","s":"moka","t":"本来就晕船，别再倒着走。","x":"base"},{"id":"ep-34:34","s":"n","t":"她按上方顶端、第十宫的银点，是金牛座月亮。","bg":"skyship","bgm":"crystalGarden","shot":"wide","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"},"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:35","s":"yun","t":"月亮。心事容易让人看见的位置。","x":"base"},{"id":"ep-34:36","s":"yeon","t":"那有点丢脸。","x":"shy"},{"id":"ep-34:37","s":"moka","t":"说得对，你生气先红脸。","x":"base"},{"id":"ep-34:38","s":"n","t":"船又退，链声比刚才短，也更近。"},{"id":"ep-34:39","s":"yeon","t":"（每错一次，链就短。发声方向就是答案。）","x":"think"},{"id":"ep-34:40","s":"n","t":"她耳贴玻璃。声音在圆下方、东侧门槛正上面，只有那里玻璃下是浑的。"},{"id":"ep-34:41","s":"yeon","t":"门口后面紧贴的房，这是什么宫？","x":"serious"},{"id":"ep-34:42","s":"yun","t":"第十二宫，隐藏的房，被囚之物所在。","x":"serious"},{"id":"ep-34:43","s":"n","t":"浑玻璃内两个红点交叠晃动，是火星和木星。"},{"id":"ep-34:44","s":"yun","t":"斗争与扩张的力量藏在里面，或是被藏起的人。","x":"base"},{"id":"ep-34:45","s":"yeon","t":"（藏起的人。徐寒雨，你在那儿。）","x":"think"},{"id":"ep-34:46","s":"n","t":"她用双掌按紧浑浊那格，玻璃变得如掌心温暖。","im":true,"sfx":"heartbeat","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:47","s":"n","t":"铜环咔哒开始转，船向前滑。"},{"id":"ep-34:48","s":"moka","t":"成了。可锁链，短了两节吧。","x":"base"},{"id":"ep-34:49","s":"yeon","t":"知道，所以要快。","x":"serious"},{"id":"ep-34:50","s":"n","t":"开会前，Yeoni去了船头。Neo靠着栏杆望向星海，远处传来摩卡难受的呻吟。","bg":"skyship","bgm":"neo","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:51","s":"yeon","t":"我的星盘说，玄关站着一只大猫。","x":"gentle","l":{"who":"yeon","x":"gentle"},"r":{"who":"neo","x":"calm"}},{"id":"ep-34:52","s":"neo","t":"听见了。","x":"calm"},{"id":"ep-34:53","s":"yeon","t":"你很开心，都看出来了。耳朵都红了。","x":"grin"},{"id":"ep-34:54","s":"neo","t":"风冷，脸才红的。","x":"deadpan"},{"id":"ep-34:55","s":"n","t":"风明明从另一边吹。Yeoni没有点破，在Neo身旁坐下。"},{"id":"ep-34:56","s":"yeon","t":"Neo，你初次见我时，也看见我的玄关了吗？第一印象之类的。","x":"serious"},{"id":"ep-34:57","s":"neo","t":"看见了。伞翻着面，你在发火。","x":"think"},{"id":"ep-34:58","s":"yeon","t":"糟透了。","x":"laugh"},{"id":"ep-34:59","s":"neo","t":"可你一直拿着那把翻了的伞。我最先记住的，是那个样子。","x":"smile"},{"id":"ep-34:60","s":"n","t":"Yeoni抱起膝盖，肩膀碰到Neo，很暖。他的右手却仍藏在袖里。","im":true,"sfx":"chime","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:61","s":"yeon","t":"（始终不肯让我看手。可今天先到这里。）","x":"think"},{"id":"ep-34:62","s":"n","t":"船突然倾斜。黄铜环尖鸣着停转，一角天空正在被抹去。","bg":"eclipseSky","tone":"dark","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-34:63","s":"n","t":"黑圆掠过星座，所经之处的星光全不见了，像被勺子挖走。","l":{"who":"yeon","x":"fear"},"c":{"who":"yun","x":"serious"},"r":{"who":"neo","x":"serious"},"im":true,"fx":"veil","sfx":"glitch","shot":"impact","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"veil","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:64","s":"yun","t":"黑月，在占星中叫莉莉丝。在这片天，那就是黑月的名。","x":"serious"},{"id":"ep-34:65","s":"yeon","t":"它到底有几个名字？","x":"fear"},{"id":"ep-34:66","s":"neo","t":"吞过几片天空，就有几个。","x":"serious"},{"id":"ep-34:67","s":"moka","t":"那它应该不饿了吧。都吃了多少片天了。","x":"base"},{"id":"ep-34:68","s":"yun","t":"不是饿才吃。是空着，怎么吃都填不满。","x":"serious"},{"id":"ep-34:69","s":"yeon","t":"（填不满。无底的容器。可他们说，那是我。）","x":"think"},{"id":"ep-34:70","s":"n","t":"Yeoni不由自主按住肚子。体内发凉，仿佛有什么在那里屏住呼吸。"},{"id":"ep-34:71","s":"n","t":"黑圆停在出生星盘正上方。玻璃裂开，第七宫里的一颗星被拔了上去。"},{"id":"ep-34:72","s":"yun","t":"第七宫，伴侣的位置。他正在吃掉同伴。","x":"surprise"},{"id":"ep-34:73","s":"n","t":"Neo伸手想抓栏杆，却踉跄了一下。右手再次透明，这次一直到手腕上方。","fx":"shake","sfx":"thud","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"shake","camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-34:74","s":"yeon","t":"Neo！","x":"cry"},{"id":"ep-34:75","s":"neo","t":"退后。它盯上的是我，不是你。","x":"angry"},{"id":"ep-34:76","s":"n","t":"黑圆里流出声音，低而温柔。正因为温柔，更显冰冷。"},{"id":"ep-34:77","s":"heuk","t":"竟找到了十二宫，容器。你的老虎在那里。"},{"id":"ep-34:78","s":"heuk","t":"敲错门的价，已经付了吧。锁链还会一节节缩短。"},{"id":"ep-34:79","s":"yeon","t":"才不是我的老虎。不过，我会去。","x":"angry"},{"id":"ep-34:80","s":"heuk","t":"是啊，你总是这样来，带着伞。"},{"id":"ep-34:81","s":"n","t":"黑圆沉入星海。第七宫的空位冒起烟，天空那一角就这样空着。","im":true,"shot":"quiet","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:82","s":"n","t":"船又动了，缓缓地，倾斜着。四个人围在桌边。","bg":"skyship","tone":"dark","bgm":"warRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:83","s":"yun","t":"开个作战会。十二宫的门，得报星图主人出生时刻，精确到分。","x":"base","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-34:84","s":"yeon","t":"八点三十分。妈妈说，晨间剧刚播完就生了。","x":"serious"},{"id":"ep-34:85","s":"moka","t":"这种事你怎么知道。","x":"base"},{"id":"ep-34:86","s":"yeon","t":"每年生日都会听一次，连剧情结局都知道。","x":"grin"},{"id":"ep-34:87","s":"yun","t":"好。您和坐在您星图里的猫先生，都能进去。","x":"laugh"},{"id":"ep-34:88","s":"moka","t":"我呢？","x":"base"},{"id":"ep-34:89","s":"yun","t":"摩卡跟着进就好，门不拦客人，只是——","x":"base"},{"id":"ep-34:90","s":"n","t":"闰月停下，把戴手套的右手放到桌面。手套边缘的黑裂痕正往手肘爬去。"},{"id":"ep-34:91","s":"yun","t":"我不行。我是没有时辰的乘客。","x":"pain"},{"id":"ep-34:92","s":"yeon","t":"没有时辰，就过不了门？","x":"surprise"},{"id":"ep-34:93","s":"yun","t":"这片天以时刻为钥匙。没钥匙的人，会在门前渐渐消失。","x":"sad"},{"id":"ep-34:94","s":"n","t":"桌上闰月的影子变淡了。Yeoni揉揉眼，依旧很淡。","im":true,"sfx":"heartbeat","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:95","s":"yeon","t":"那找回来不就好了，你的时辰。","x":"angry"},{"id":"ep-34:96","s":"yun","t":"青兔带着跑了。这么大的天空，不知道跑到哪里。","x":"sly"},{"id":"ep-34:97","s":"n","t":"就在这时，船边响起轻快的铃声。叮咚，像商店开门时的铃。"},{"id":"ep-34:98","s":"n","t":"一艘云朵形飞艇紧贴着船靠来，兔耳形的帆扑动着，船侧挂着闪亮的广告牌。","bg":"jae","bgm":"orientalGirl","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-34:99","s":"rab","t":"各位客户～青兔金融，在这片天空也开分店啦！","x":"invite","l":{"who":"yeon","x":"surprise"},"c":null,"r":{"who":"rab","x":"invite"},"sfx":"coin"},{"id":"ep-34:100","s":"moka","t":"不就是那只兔子吗？还没倒闭？","x":"angry"},{"id":"ep-34:101","s":"rab","t":"什么叫倒闭～天空换了，利率也会换呢。今天星光贷款特价！","x":"smug"},{"id":"ep-34:102","s":"n","t":"青兔脖子上挂着沙漏，里面的沙是浅粉色，天刚亮时的天空颜色。"},{"id":"ep-34:103","s":"yun","t":"我的卯时。","x":"surprise","im":true,"fx":"reveal","sfx":"sparkle","shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":"reveal","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:104","s":"rab","t":"哎呀，卯时客户。还没被抹掉呢～真了不起。","x":"sly"},{"id":"ep-34:105","s":"neo","t":"把那个沙漏放下。","x":"angry"},{"id":"ep-34:106","s":"rab","t":"不要～这可是这片天空最贵的东西。有了时辰，门才会开呀！","x":"scheme"},{"id":"ep-34:107","s":"n","t":"青兔挥挥前爪，飞艇滑入星云，渐渐远去。兔耳帆像挑衅似的晃了晃。"},{"id":"ep-34:108","s":"yeon","t":"追，现在就追。不会放过。","x":"angry","im":true,"shot":"impact","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:109","s":"yun","t":"小姐，答应我一件事。抓到那只兔子后，由你来找回我的时辰。","x":"base"},{"id":"ep-34:110","s":"yeon","t":"我？","x":"serious"},{"id":"ep-34:111","s":"yun","t":"因为我已经不太记得，自己是什么时候出生的了。","x":"sad"},{"id":"ep-34:r4-dawn","s":"yun","t":"但直到现在，我也讨厌下雨的破晓。一到那时，手先冷起来。","x":"sad"},{"id":"ep-34:112","s":"n","t":"闰月笑着说。笑脸的边缘在星光里一点点洇开。Yeoni看了很久，想牢牢记住。"},{"id":"ep-34:113","s":"n","t":"闰月话音未落，摩卡就拉下帆索。黄铜环重新转动，船猛地向前冲。","bg":"skyship","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:114","s":"moka","t":"什么晕船，不管了。今天非把那兔耳朵串上烤签。","x":"base","l":{"who":"yeon","x":"surprise"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"surprise"}},{"id":"ep-34:115","s":"yeon","t":"摩卡，你不是不会坐船吗！","x":"laugh"},{"id":"ep-34:116","s":"moka","t":"是不会。所以才要快点结束！","x":"angry"},{"id":"ep-34:117","s":"n","t":"星海撞上船舷，激起银色浪花。前方云间，兔耳帆时隐时现。","fx":"water","sfx":"whoosh","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":"water","camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:118","s":"yun","t":"小姐，准备听我的故事。要找回时辰，得倒着走。","x":"base"},{"id":"ep-34:119","s":"yeon","t":"倒着？","x":"serious"},{"id":"ep-34:120","s":"yun","t":"叫生时校正。把人生中发生过的事逐一对照，倒推回出生的那一刻。","x":"sly"},{"id":"ep-34:121","s":"n","t":"Yeoni再度打开备忘本，在新页顶端写下：闰月先生，出生时刻，倒着找。","im":true,"sfx":"bell","shot":"quiet","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}}]}
