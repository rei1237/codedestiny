{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-34","no":"EP.34","tag":"第34话 · 十二屋的天空","title":"十二屋的天空","rev":2,"beats":[{"id":"ep-34:1","s":"n","t":"脚下晃了晃。Yeoni睁眼，下面是木甲板。甲板外，星星如河水流过。","bg":"skyship","bgm":"starDrift","shot":"wide","l":null,"c":null,"r":null,"sfx":"whoosh","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:2","s":"n","t":"是一艘船。没有帆，只有巨大的黄铜环层层旋转，每道环都刻着星座图案。"},{"id":"ep-34:3","s":"yeon","t":"宫殿呢？刚才还是宫殿啊。","x":"surprise","l":{"who":"yeon","x":"surprise"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"base"}},{"id":"ep-34:4","s":"yun","t":"宫殿折起来变成了船。天空变了，交通工具也会变。","x":"base"},{"id":"ep-34:5","s":"moka","t":"船？我不会坐船。岛上来的，就一定会坐船吗？","x":"angry"},{"id":"ep-34:6","s":"yeon","t":"岛上来的，通常都会吧？","x":"grin"},{"id":"ep-34:7","s":"moka","t":"所以才更委屈啊。呕。","x":"base"},{"id":"ep-34:8","s":"n","t":"摩卡跑向栏杆，想朝星海吐点什么，却什么都吐不出，更难受了。"},{"id":"ep-34:9","s":"n","t":"Neo坐在船头，银发随风飘动，右手藏在左袖里面。","r":{"who":"neo","x":"calm"}},{"id":"ep-34:10","s":"yeon","t":"Neo，让我看看手。","x":"serious"},{"id":"ep-34:11","s":"neo","t":"两只脚都还好好长着。你想看的是手吧？","x":"deadpan"},{"id":"ep-34:12","s":"yeon","t":"刚才透明了，我看见了。","x":"disappoint"},{"id":"ep-34:13","s":"neo","t":"现在是白的。想看，以后给你看。","x":"calm"},{"id":"ep-34:14","s":"yeon","t":"（以后。又是以后。得记下来。）","x":"think"},{"id":"ep-34:15","s":"n","t":"Yeoni打开备忘本。徐寒雨，被拖走，一定找到。又在上方添一行：Neo的手，以后一定要看。","sfx":"page"},{"id":"ep-34:16","s":"n","t":"甲板中央有张圆桌。玻璃下，一个圆正在发光，分成十二片。","bg":"skyship","bgm":"crystalGarden","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:17","s":"yun","t":"这是这片天空的命盘。占星术里，叫出生星盘。","x":"serious","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"serious"},"r":{"who":"neo","x":"calm"}},{"id":"ep-34:18","s":"yeon","t":"像披萨。","x":"think"},{"id":"ep-34:19","s":"yun","t":"没错，十二片的披萨。每一片叫一宫，也是一间屋，人生的十二个房间。","x":"laugh"},{"id":"ep-34:20","s":"n","t":"闰月用戴手套的手指点住圆的最左端，那里光最亮。"},{"id":"ep-34:21","s":"yun","t":"这里是第一宫的门槛，上升点。出生那一刻，东边地平线上升起的星座。","x":"base"},{"id":"ep-34:22","s":"yeon","t":"为什么重要？","x":"surprise"},{"id":"ep-34:23","s":"yun","t":"因为第一次见到小姐的人，先看见的就是这张脸。像玄关一样。","x":"base"},{"id":"ep-34:24","s":"n","t":"门槛上浮出一个星座。尖耳朵、卷尾巴的兽形。星星聚成一只小猫。","im":true,"fx":"stars","sfx":"chime","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":"stars","camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:25","s":"yeon","t":"是猫……好像Yeongnyangi。","x":"surprise"},{"id":"ep-34:26","s":"yun","t":"上升是狮子座，星星却坐成猫的样子。小姐的玄关里，站着猫先生。","x":"sly"},{"id":"ep-34:27","s":"n","t":"Neo重新立好外套领子，一声不吭，只有耳廓微微红了。"},{"id":"ep-34:28","s":"yun","t":"紧挨着还有金星。爱的星，正贴在玄关边上。","x":"sly"},{"id":"ep-34:29","s":"neo","t":"这段解说可以省略。","x":"deadpan"},{"id":"ep-34:30","s":"yun","t":"为什么？我觉得这部分最有意思。","x":"laugh"},{"id":"ep-34:31","s":"neo","t":"意思是，别再推销合婚了。","x":"smirk"},{"id":"ep-34:32","s":"yeon","t":"两个人又吵起来了。","x":"laugh"},{"id":"ep-34:33","s":"moka","t":"我都晕船了，别还让我看吵架。","x":"base"},{"id":"ep-34:34","s":"n","t":"Yeoni沿着圆看了一圈。最顶端，第十宫里有个银点。","bg":"skyship","bgm":"crystalGarden","shot":"wide","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"},"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:35","s":"yun","t":"是月亮，挂在最高处。这个位置，心情容易被别人看见。","x":"base"},{"id":"ep-34:36","s":"yeon","t":"那有点丢脸。","x":"shy"},{"id":"ep-34:37","s":"moka","t":"倒是挺准。你的表情全写着呢，一生气，脸颊先红。","x":"base"},{"id":"ep-34:38","s":"yun","t":"月亮在金牛座，不喜欢变动。吃饭的时间，睡觉的位置，还有始终在身边的人。","x":"base"},{"id":"ep-34:39","s":"yeon","t":"（始终是同一个人。所以才害怕改变吗？）","x":"think"},{"id":"ep-34:40","s":"n","t":"闰月的手指滑向圆下方，东边门槛的正上面。第十二宫，只有那里的玻璃下雾蒙蒙的。"},{"id":"ep-34:41","s":"yun","t":"这里是第十二宫，隐藏的房间。结束之物、暗自承担的重量，以及被囚之物所在。","x":"serious"},{"id":"ep-34:42","s":"n","t":"模糊的玻璃里，两个红点重叠着，像火焰摇曳。"},{"id":"ep-34:43","s":"yun","t":"火星和木星都在这里。战斗的力量与扩张的力量，挨在隐藏的房间里。","x":"serious"},{"id":"ep-34:44","s":"yeon","t":"是隐藏的力量？","x":"serious"},{"id":"ep-34:45","s":"yun","t":"隐藏的力量。也可能，是被藏起来的人。","x":"base"},{"id":"ep-34:46","s":"n","t":"这时，玻璃下传来极轻的声音。铁链刮擦地板。","im":true,"sfx":"heartbeat","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:47","s":"yeon","t":"听见了吗？","x":"fear"},{"id":"ep-34:48","s":"moka","t":"听见了，铁链。","x":"base"},{"id":"ep-34:49","s":"yeon","t":"（徐寒雨，在那里。）","x":"think"},{"id":"ep-34:50","s":"n","t":"开会前，Yeoni去了船头。Neo靠着栏杆望向星海，远处传来摩卡难受的呻吟。","bg":"skyship","bgm":"neo","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:51","s":"yeon","t":"我的星盘说，玄关站着一只大猫。","x":"gentle","l":{"who":"yeon","x":"gentle"},"r":{"who":"neo","x":"calm"}},{"id":"ep-34:52","s":"neo","t":"听见了。","x":"calm"},{"id":"ep-34:53","s":"yeon","t":"你很开心，都看出来了。耳朵都红了。","x":"grin"},{"id":"ep-34:54","s":"neo","t":"风冷，脸才红的。","x":"deadpan"},{"id":"ep-34:55","s":"n","t":"风明明从另一边吹。Yeoni没有点破，在Neo身旁坐下。"},{"id":"ep-34:56","s":"yeon","t":"Neo，你初次见我时，也看见我的玄关了吗？第一印象之类的。","x":"serious"},{"id":"ep-34:57","s":"neo","t":"看见了。伞翻着面，你在发火。","x":"think"},{"id":"ep-34:58","s":"yeon","t":"糟透了。","x":"laugh"},{"id":"ep-34:59","s":"neo","t":"可你一直拿着那把翻了的伞。我最先记住的，是那个样子。","x":"smile"},{"id":"ep-34:60","s":"n","t":"Yeoni抱起膝盖，肩膀碰到Neo，很暖。他的右手却仍藏在袖里。","im":true,"sfx":"chime","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:61","s":"yeon","t":"（爪子始终不肯让我看。不过，今天先到这里。）","x":"think"},{"id":"ep-34:62","s":"n","t":"船突然倾斜。黄铜环尖鸣着停转，一角天空正在被抹去。","bg":"eclipseSky","tone":"dark","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-34:63","s":"n","t":"黑圆掠过星座，所经之处的星光全不见了，像被勺子挖走。","l":{"who":"yeon","x":"fear"},"c":{"who":"yun","x":"serious"},"r":{"who":"neo","x":"serious"},"im":true,"fx":"veil","sfx":"glitch","shot":"impact","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"veil","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:64","s":"yun","t":"黑月。占星师把无光的月之位置叫作莉莉丝。在这片天空，那就是黑月的名字。","x":"serious"},{"id":"ep-34:65","s":"yeon","t":"它到底有几个名字？","x":"fear"},{"id":"ep-34:66","s":"neo","t":"吞过几片天空，就有几个。","x":"serious"},{"id":"ep-34:67","s":"moka","t":"那它应该不饿了吧。都吃了多少片天了。","x":"base"},{"id":"ep-34:68","s":"yun","t":"不是饿才吃，是因为空。怎么吃都填不满的那种。","x":"serious"},{"id":"ep-34:69","s":"yeon","t":"（填不满。无底的容器。可他们说，那是我。）","x":"think"},{"id":"ep-34:70","s":"n","t":"Yeoni不由自主按住肚子。体内发凉，仿佛有什么在那里屏住呼吸。"},{"id":"ep-34:71","s":"n","t":"黑圆停在出生星盘正上方。玻璃裂开，第七宫里的一颗星被拔了上去。"},{"id":"ep-34:72","s":"yun","t":"第七宫，伴侣的位置。它在吞伴侣。","x":"surprise"},{"id":"ep-34:73","s":"n","t":"Neo伸手想抓栏杆，却踉跄了一下。右手再次透明，这次一直到手腕上方。","fx":"shake","sfx":"thud","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"shake","camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-34:74","s":"yeon","t":"Neo！","x":"cry"},{"id":"ep-34:75","s":"neo","t":"退后。它盯上的是我，不是你。","x":"angry"},{"id":"ep-34:76","s":"n","t":"黑圆里流出声音，低而温柔。正因为温柔，更显冰冷。"},{"id":"ep-34:77","s":"heuk","t":"容器啊。你的老虎在第十二宫。"},{"id":"ep-34:78","s":"heuk","t":"来接她吧。不来，锁链就会一根根缩短。"},{"id":"ep-34:79","s":"yeon","t":"才不是我的老虎。不过，我会去。","x":"angry"},{"id":"ep-34:80","s":"heuk","t":"是啊，你总是这样来，带着伞。"},{"id":"ep-34:81","s":"n","t":"黑圆沉入星海。第七宫的空位冒起烟，天空那一角就这样空着。","im":true,"shot":"quiet","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:82","s":"n","t":"船又动了，缓缓地，倾斜着。四个人围在桌边。","bg":"skyship","tone":"dark","bgm":"warRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:83","s":"yun","t":"开个作战会议。第十二宫的门，只认星盘主人的出生时刻，要精确到分钟。","x":"base","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-34:84","s":"yeon","t":"八点三十分。妈妈说，晨间剧刚播完就生了。","x":"serious"},{"id":"ep-34:85","s":"moka","t":"这种事你怎么知道。","x":"base"},{"id":"ep-34:86","s":"yeon","t":"每年生日都会听一次，连剧情结局都知道。","x":"grin"},{"id":"ep-34:87","s":"yun","t":"好，小姐可以进去。猫先生也在你的星盘里，也能进。","x":"laugh"},{"id":"ep-34:88","s":"moka","t":"我呢？","x":"base"},{"id":"ep-34:89","s":"yun","t":"摩卡先生跟着进就行。门不会挡住客人。只是……","x":"base"},{"id":"ep-34:90","s":"n","t":"闰月停下，把戴手套的右手放到桌面。手套边缘的黑裂痕正往手肘爬去。"},{"id":"ep-34:91","s":"yun","t":"我不行。我是没有时辰的乘客。","x":"pain"},{"id":"ep-34:92","s":"yeon","t":"没有时辰，就过不了门？","x":"surprise"},{"id":"ep-34:93","s":"yun","t":"这片天空，以时刻为钥匙。没有钥匙的人，会在门前一点点被抹去。","x":"sad"},{"id":"ep-34:94","s":"n","t":"桌上闰月的影子变淡了。Yeoni揉揉眼，依旧很淡。","im":true,"sfx":"heartbeat","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:95","s":"yeon","t":"那找回来不就好了，你的时辰。","x":"angry"},{"id":"ep-34:96","s":"yun","t":"青兔带着跑了。这么大的天空，不知道跑到哪里。","x":"sly"},{"id":"ep-34:97","s":"n","t":"就在这时，船边响起轻快的铃声。叮咚，像商店开门时的铃。"},{"id":"ep-34:98","s":"n","t":"一艘云朵形飞艇紧贴着船靠来，兔耳形的帆扑动着，船侧挂着闪亮的广告牌。","bg":"jae","bgm":"orientalGirl","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-34:99","s":"rab","t":"各位客户～青兔金融，在这片天空也开分店啦！","x":"invite","l":{"who":"yeon","x":"surprise"},"c":null,"r":{"who":"rab","x":"invite"},"sfx":"coin"},{"id":"ep-34:100","s":"moka","t":"不就是那只兔子吗？还没倒闭？","x":"angry"},{"id":"ep-34:101","s":"rab","t":"什么叫倒闭～天空换了，利率也会换呢。今天星光贷款特价！","x":"smug"},{"id":"ep-34:102","s":"n","t":"青兔脖子上挂着沙漏，里面的沙是浅粉色，天刚亮时的天空颜色。"},{"id":"ep-34:103","s":"yun","t":"我的卯时。","x":"surprise","im":true,"fx":"reveal","sfx":"sparkle","shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":"reveal","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:104","s":"rab","t":"哎呀，卯时客户。还没被抹掉呢～真了不起。","x":"sly"},{"id":"ep-34:105","s":"neo","t":"把那个沙漏放下。","x":"angry"},{"id":"ep-34:106","s":"rab","t":"不要～这可是这片天空最贵的东西。有了时辰，门才会开呀！","x":"scheme"},{"id":"ep-34:107","s":"n","t":"青兔挥挥前爪，飞艇滑入星云，渐渐远去。兔耳帆像挑衅似的晃了晃。"},{"id":"ep-34:108","s":"yeon","t":"追上去。现在就追。这次绝不放跑。","x":"angry","im":true,"shot":"impact","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-34:109","s":"yun","t":"小姐，答应我一件事。抓到那只兔子后，由你来找回我的时辰。","x":"base"},{"id":"ep-34:110","s":"yeon","t":"我？","x":"serious"},{"id":"ep-34:111","s":"yun","t":"因为我已经不太记得，自己是什么时候出生的了。","x":"sad"},{"id":"ep-34:112","s":"n","t":"闰月笑着说。笑脸的边缘在星光里一点点洇开。Yeoni看了很久，想牢牢记住。"},{"id":"ep-34:113","s":"n","t":"闰月话音未落，摩卡就拉下帆索。黄铜环重新转动，船猛地向前冲。","bg":"skyship","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:114","s":"moka","t":"什么晕船，不管了。今天非把那兔耳朵串上烤签。","x":"base","l":{"who":"yeon","x":"surprise"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"surprise"}},{"id":"ep-34:115","s":"yeon","t":"摩卡，你不是不会坐船吗！","x":"laugh"},{"id":"ep-34:116","s":"moka","t":"是不会。所以才要快点结束！","x":"angry"},{"id":"ep-34:117","s":"n","t":"星海撞上船舷，激起银色浪花。前方云间，兔耳帆时隐时现。","fx":"water","sfx":"whoosh","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":"water","camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-34:118","s":"yun","t":"小姐，准备听我的故事。要找回时辰，得倒着走。","x":"base"},{"id":"ep-34:119","s":"yeon","t":"倒着？","x":"serious"},{"id":"ep-34:120","s":"yun","t":"叫生时校正。把人生中发生过的事逐一对照，倒推回出生的那一刻。","x":"sly"},{"id":"ep-34:121","s":"n","t":"Yeoni再度打开备忘本，在新页顶端写下：闰月先生，出生时刻，倒着找。","im":true,"sfx":"bell","shot":"quiet","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}}]}
