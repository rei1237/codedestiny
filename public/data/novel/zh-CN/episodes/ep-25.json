{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-25","no":"EP.25","tag":"第25话 · 黑月","title":"黑月","rev":2,"beats":[{"id":"ep-25:1","s":"n","t":"太阳消失的天空下，河水像黑镜般凝固。风停了，连水雾也悬在空中，一动不动。","bg":"eclipseSky","tone":"dark","bgm":"zeroPoint","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-25:2","s":"yeon","t":"我去。往哪儿走。上面？河里？","x":"angry","l":{"who":"yeon","x":"angry"},"c":{"who":"moka","x":"angry"},"r":{"who":"yun","x":"serious"}},{"id":"ep-25:3","s":"moka","t":"你疯了？它叫你去，你就去？那明摆着是陷阱！","x":"angry"},{"id":"ep-25:4","s":"yeon","t":"我知道是陷阱。可Yeongnyangi在那里。","x":"angry"},{"id":"ep-25:5","s":"yun","t":"女士，对方要的，不是猫先生，是您。猫先生是诱饵。","x":"serious"},{"id":"ep-25:6","s":"yeon","t":"那就得咬钩。不咬，诱饵会怎么样。","x":"serious"},{"id":"ep-25:7","s":"n","t":"闰月答不出来。摩卡也闭上嘴。答案，大家都知道。"},{"id":"ep-25:8","s":"n","t":"黑圆周围的红环，猛地燃亮。凝固的河水中央，陷下一个圆坑。下面，出现阶梯般的影子。","im":true,"fx":"veil","sfx":"glitch","shot":"impact","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"veil","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-25:9","s":"heuk","t":"聪明的小猪。我替你铺好阶梯。朋友也可以带来。有观众，才有意思。","nm":"声音"},{"id":"ep-25:10","s":"yeon","t":"你是谁。叫什么名字。","x":"angry"},{"id":"ep-25:11","s":"heuk","t":"名字啊。你们总是先问名字。好。今天免费给一个。","nm":"声音"},{"id":"ep-25:12","s":"sys","t":"[ 黑月 · 吞噬光的月亮 ]","im":true,"fx":"script","sfx":"bell","shot":"close","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"script","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-25:13","s":"n","t":"文字仿佛刻在天空，浮现出来，又从边缘开始烧黑。像连自己的名字，也要吃掉。"},{"id":"ep-25:14","s":"yun","t":"黑月。","x":"pain"},{"id":"ep-25:15","s":"n","t":"闰月掌心的洞，猛烈旋转。他想重新戴上手套，却抖得戴不进去。"},{"id":"ep-25:16","s":"moka","t":"骗子，你认识？","x":"base"},{"id":"ep-25:17","s":"yun","t":"不认识。可这个洞认识。从它出现的那天起，就一直只被那个名字牵引。","x":"pain"},{"id":"ep-25:18","s":"n","t":"三人沿着河水下的阶梯往下走。阶梯像没有尽头。墙上密密麻麻全是黑掌印，无一例外，都朝着里面。","bg":"hands","tone":"dark","bgm":"crisis2","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"hands","backgroundMeaning":"작가 지정 배경: hands","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"hands 배경에서 진행되는 서술"}},{"id":"ep-25:19","s":"moka","t":"这些手印，都是想爬出去时挠的？还是被拖进去时留下的？","x":"base","l":{"who":"yeon","x":"serious"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"serious"}},{"id":"ep-25:20","s":"yun","t":"都是。被拖进去后，又想爬出去。","x":"serious"},{"id":"ep-25:21","s":"yeon","t":"那就是说，也有出去的路。","x":"serious"},{"id":"ep-25:22","s":"moka","t":"猪，你在这种时候，怎么还这么乐观。","x":"angry"},{"id":"ep-25:23","s":"yeon","t":"悲观，阶梯就会短一点吗？","x":"serious"},{"id":"ep-25:24","s":"yun","t":"女士说得对。乐观悲观，阶梯都一样长。我保证。","x":"base"},{"id":"ep-25:25","s":"moka","t":"你们两个真是一模一样。都这时候了。","x":"angry"},{"id":"ep-25:26","s":"n","t":"摩卡从鼻子里呼出一口气，像是笑了。阶梯尽头，正透出红光。"},{"id":"ep-25:27","s":"n","t":"阶梯尽头，竟又是天空。倒挂在河底的天空。中央浮着黑圆，圆下，悬着一个黑线织成的茧。","bg":"eclipseSky","tone":"desat","bgm":"zeroPoint","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"crossfade","tone":"desat","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-25:28","s":"n","t":"茧的缝隙里，露出白毛。茧缓缓鼓起、落下，像在呼吸。","im":true,"shot":"close","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-25:29","s":"yeon","t":"Yeongnyangi！","x":"fear","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"neo","x":"fear"}},{"id":"ep-25:30","s":"neo","t":"别过来。Yeoni，回去。","x":"fear"},{"id":"ep-25:31","s":"yeon","t":"还活着。活着，还能说话。","x":"cry"},{"id":"ep-25:32","s":"neo","t":"听我的。它不是要抓我，是要抓你。","x":"angry"},{"id":"ep-25:33","s":"yeon","t":"我知道。知道了才来的。","x":"cry"},{"id":"ep-25:34","s":"n","t":"缠茧的黑线骤然收紧。Yeongnyangi咬紧牙。线压过的地方，锈迹扩散，变得漆黑。","fx":"thread","sfx":"whoosh","shot":"impact","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"desat","ambient":null,"eventEffect":"thread","camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-25:35","s":"heuk","t":"幸会，小猪。这样面对面，还是第一次。虽然，我已经看你很久了。"},{"id":"ep-25:36","s":"yeon","t":"你哪有脸。就是个洞。","x":"angry"},{"id":"ep-25:37","s":"heuk","t":"哈哈。没错。脸，是借来用的。需要时，借需要的那个人的脸。"},{"id":"ep-25:38","s":"n","t":"黑圆表面泛起波纹。短短一瞬，上面映出Yeoni自己的脸，又消失了。Yeoni脊背发凉。"},{"id":"ep-25:39","s":"yun","t":"女士，别听它说话。也别和它对视。","x":"serious","l":{"who":"yeon","x":"fear"},"c":{"who":"yun","x":"serious"},"r":{"who":"moka","x":"angry"}},{"id":"ep-25:40","s":"heuk","t":"算命的，你的掌心还饿吗。我吃剩的时间，正在里面哭呢。"},{"id":"ep-25:41","s":"yun","t":"呃。","x":"pain"},{"id":"ep-25:42","s":"n","t":"闰月跪倒。掌心的洞自行张开，把他往前拖。摩卡叼住他的衣领，死死撑住。"},{"id":"ep-25:43","s":"moka","t":"骗子，撑住！你被吸进去了，谁给我们看合婚！","x":"angry"},{"id":"ep-25:44","s":"yeon","t":"停下！你要的是我吧。对我说。别碰别人。","x":"angry","bgm":"crisis2","shot":"wide","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"eclipseSky 배경에서 진행되는 yeon의 대사"}},{"id":"ep-25:45","s":"heuk","t":"态度不错。这生意，谈得成。"},{"id":"ep-25:46","s":"n","t":"黑圆朝Yeoni倾斜，像巨大的眼睛向下俯视。"},{"id":"ep-25:47","s":"heuk","t":"做个交易。我把猫还给你。交换条件，是你剩下的全部运气。"},{"id":"ep-25:48","s":"yeon","t":"运气？","x":"surprise"},{"id":"ep-25:49","s":"heuk","t":"你出生时得到的。还没用掉的明天。好日子，幸运的日子，偶然一切顺利的日子。全部给我。"},{"id":"ep-25:50","s":"yun","t":"女士，不行。把运全掏空，人就会成为容器。空容器，什么都能装进去。那才是它要的。","x":"serious","im":true,"shot":"close","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-25:51","s":"heuk","t":"算命的，话真多。对，容器。我不隐瞒。这孩子的乙木藤蔓，连别人的气息也能接住、包容。这样的容器，不多见。"},{"id":"ep-25:52","s":"neo","t":"Yeoni，别听！它是要吃掉你！","x":"angry"},{"id":"ep-25:53","s":"heuk","t":"不是吃掉，是填满。她所容纳的一切，由我来替她使用。"},{"id":"ep-25:54","s":"n","t":"Yeoni仰望茧。线缝间，能看见生锈的前爪。原本蔓延到肩膀的锈，已经到了后颈。"},{"id":"ep-25:55","s":"yeon","t":"（运气还可以再攒。烤串可以再烤，歌可以再唱。Yeongnyangi，只有一个。）","x":"think"},{"id":"ep-25:56","s":"yeon","t":"我答应。","x":"serious","bgm":"gloom2","shot":"close","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 yeon의 대사"}},{"id":"ep-25:57","s":"moka","t":"猪！","x":"angry"},{"id":"ep-25:58","s":"yun","t":"女士！","x":"surprise"},{"id":"ep-25:59","s":"neo","t":"Yeoni，不行！","x":"shock"},{"id":"ep-25:60","s":"yeon","t":"Yeongnyangi，你总替我疼。这一次，让我来。","x":"serious"},{"id":"ep-25:61","s":"neo","t":"那是我自己决定的。别替我做决定！","x":"angry"},{"id":"ep-25:62","s":"yeon","t":"这句话，原封不动还给你。有没有用，我来决定。","x":"angry"},{"id":"ep-25:63","s":"n","t":"Yeongnyangi答不出来。昨天Yeoni说过的话，原样回到了面前。那时，听见了，却装作不懂的话。"},{"id":"ep-25:64","s":"heuk","t":"契约成立。那么，叫收账的来。"},{"id":"ep-25:65","s":"n","t":"黑圆下的影子猛然裂开。黑虎从缝里走出。斗篷末端湿着，右前爪的金环，在红光里泛着光泽。","bg":"eclipseSky","tone":"dark","bgm":"warCommand","shot":"impact","im":true,"fx":"claw","sfx":"thud","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"claw","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-25:66","s":"tiger","t":"您召唤我？","x":"base","l":{"who":"yeon","x":"serious"},"c":{"who":"tiger","x":"base"},"r":null},{"id":"ep-25:67","s":"heuk","t":"打开账簿。把这孩子剩下的运，全部收走。"},{"id":"ep-25:68","s":"n","t":"老虎看向Yeoni。极短地，她的视线停住。然后，账簿展开。"},{"id":"ep-25:69","s":"tiger","t":"全部，吗。","x":"talk"},{"id":"ep-25:70","s":"heuk","t":"全部。"},{"id":"ep-25:71","s":"tiger","t":"明白。","x":"base"},{"id":"ep-25:72","s":"yeon","t":"又是你。这次不收掌声，要收什么。","x":"serious"},{"id":"ep-25:73","s":"tiger","t":"明天。不会疼。只是，会有点冷。","x":"talk"},{"id":"ep-25:74","s":"moka","t":"条纹家伙！你真要做？猪到底对你做过什么！","x":"angry","c":{"who":"moka","x":"angry"}},{"id":"ep-25:75","s":"tiger","t":"水獭，请让开。契约已经定下了。","x":"angry"},{"id":"ep-25:76","s":"n","t":"老虎握紧账簿。那一瞬，右前爪的金环，自行收紧一格。老虎表情丝毫没变。只有账簿一角，微微皱了。"},{"id":"ep-25:77","s":"n","t":"账簿里Yeoni那一栏，开始抽吸光芒。粉红，金黄，嫩绿。像小星星的光，一颗颗脱离Yeoni身体，进入账簿。","im":true,"fx":"suck","sfx":"whoosh","shot":"close","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"suck","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-25:78","s":"n","t":"庆典岛第一次尝到的烤串。正午舞台的掌声。露娜分来的半个面包。每少一件，Yeoni的眼睛就眨一下。"},{"id":"ep-25:79","s":"sys","t":"[ 账簿 · 乙亥 Yeoni · 正在收回剩余运气 ]","sfx":"heartbeat"},{"id":"ep-25:80","s":"yeon","t":"好冷。","x":"fear"},{"id":"ep-25:81","s":"neo","t":"Yeoni。","x":"fear"},{"id":"ep-25:82","s":"n","t":"缠茧的线绷得像要断了。Yeongnyangi拼命挣扎。越挣扎，线陷得越深。"},{"id":"ep-25:83","s":"yun","t":"水獭先生，那本账簿。或许，我能用这只手吸走。","x":"pain","c":{"who":"yun","x":"pain"}},{"id":"ep-25:84","s":"moka","t":"那就快做！快！","x":"angry"},{"id":"ep-25:85","s":"n","t":"闰月甩掉手套，把掌心伸向账簿。洞旋转着，抓住几颗光。可下一瞬，洞口像被撕开般，猛然张大。","im":true,"fx":"vortex","sfx":"glitch","shot":"impact","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"vortex","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-25:86","s":"yun","t":"啊——！","x":"pain"},{"id":"ep-25:87","s":"heuk","t":"算命的。觊觎别人的容器，你自己的洞，会先破掉。"},{"id":"ep-25:88","s":"n","t":"闰月抓住手腕，倒下了。洞越过掌心，延伸到手腕。摩卡像护在怀里般，挡住他。"},{"id":"ep-25:89","s":"moka","t":"那我烧了它！","x":"angry","fx":"fire","sfx":"fire","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"fire","camera":"steady"},"a11y":{"description":"eclipseSky 배경에서 진행되는 moka의 대사"}},{"id":"ep-25:90","s":"n","t":"摩卡掷出火种。还没碰到账簿，火种就被黑圆的阴影吸走，熄灭。摩卡尾毛猛地竖起。"},{"id":"ep-25:91","s":"moka","t":"不行。这里点不着火。","x":"moved"},{"id":"ep-25:92","s":"n","t":"最后一颗光，从Yeoni前蹄尖脱落。很小的一点白光。Yeoni记不起，那曾是什么。","bg":"eclipseSky","tone":"desat","bgm":"none","shot":"quiet","l":null,"c":null,"r":null,"scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-25:93","s":"yeon","t":"好了吗？","x":"base","l":{"who":"yeon","x":"base"},"c":null,"r":null},{"id":"ep-25:94","s":"n","t":"声音没有起伏。粉红的毛，褪成灰色。眼睛睁着，却映不出任何东西。"},{"id":"ep-25:95","s":"sys","t":"[ 账簿 · 乙亥 Yeoni · 无余额 ]","im":true,"shot":"close","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-25:96","s":"n","t":"老虎合上账簿。合上的前爪，短暂地一颤。她看着Yeoni空荡的眼睛，转开了头。"},{"id":"ep-25:97","s":"tiger","t":"收取完毕。","x":"sad","l":{"who":"yeon","x":"base"},"c":{"who":"tiger","x":"sad"},"r":null},{"id":"ep-25:98","s":"heuk","t":"辛苦了，老虎。现在，该兑现承诺了。"},{"id":"ep-25:99","s":"n","t":"黑线松开。茧裂开，白猫落在Yeoni面前。Yeongnyangi一触地，就撑起身体，爬向她。","bgm":"gloom2","shot":"wide","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-25:100","s":"neo","t":"Yeoni，是我。看着我。","x":"shock","l":{"who":"yeon","x":"base"},"c":null,"r":{"who":"neo","x":"shock"}},{"id":"ep-25:101","s":"yeon","t":"嗯。Yeongnyangi。","x":"base"},{"id":"ep-25:102","s":"neo","t":"为什么这样做。为什么。","x":"sad"},{"id":"ep-25:103","s":"n","t":"Yeongnyangi的声音破裂了。那是他从未在Yeoni面前发出的声音。"},{"id":"ep-25:104","s":"yeon","t":"不知道。就是想这样。","x":"base"},{"id":"ep-25:105","s":"n","t":"Yeoni想笑，嘴角却抬不起来。仿佛连怎么笑，也随着运气，一起进入了账簿。"},{"id":"ep-25:106","s":"n","t":"Yeongnyangi用前爪环住Yeoni。用的是右爪，不是生锈的那只。她的身体，轻得异样。"},{"id":"ep-25:107","s":"n","t":"这时，Yeongnyangi后颈，又冒出一根黑线。那根线，从来没松开过。它一直延伸到地下，连着黑圆。","im":true,"fx":"thread","sfx":"slash","shot":"impact","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"desat","ambient":null,"eventEffect":"thread","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-25:108","s":"heuk","t":"我说了还给你。没说放了他。"},{"id":"ep-25:109","s":"neo","t":"卑鄙的家伙。","x":"angry"},{"id":"ep-25:110","s":"heuk","t":"只是账算得准。跟我的收账人学学。"},{"id":"ep-25:111","s":"n","t":"黑圆开始下降。周围的红环，像巨大的嘴唇张开。里面，黑手像线团般，一束束散出。","bg":"handsRush","tone":"dark","bgm":"zeroPoint","shot":"wide","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"}},{"id":"ep-25:112","s":"heuk","t":"容器空了。真美。现在，该填进去了。","l":{"who":"yeon","x":"base"},"c":{"who":"tiger","x":"surprise"},"r":{"who":"neo","x":"fear"}},{"id":"ep-25:113","s":"n","t":"老虎后退一步。第一次，她脸上掠过什么。在她身后，黑手朝着空掉的Yeoni，同时张开手指。"}]}
