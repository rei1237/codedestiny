{"version":2,"sourceHash":"1822d08b1cf0edd0475c92c0afa22fe040cec6e8e632f2e40817de52b7dfdd2e","locale":"zh-CN","id":"ep-37","no":"EP.37","tag":"第37话 · 二十七月之屋","title":"二十七月之屋","rev":2,"beats":[{"id":"ep-37:1","s":"n","t":"顺着线降到尽头，是一片红色天空。天下石寺无边无际，每座屋顶都浮着一轮小月亮。","bg":"nakshatra","bgm":"forestTemple","shot":"wide","l":null,"c":null,"r":null,"sfx":"bell","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"}},{"id":"ep-37:2","s":"yeon","t":"怎么这么多月亮？","x":"surprise","l":{"who":"yeon","x":"surprise"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-37:3","s":"yun","t":"二十七个。月亮每夜住一宫，二十七夜走完。","x":"base"},{"id":"ep-37:4","s":"moka","t":"月亮住民宿？谁付房钱？","x":"base"},{"id":"ep-37:5","s":"yun","t":"这问题我也是头一次听，记下来。","x":"laugh"},{"id":"ep-37:6","s":"n","t":"石阶两侧垂着红线，从寺柱连向寺柱，从屋顶通向天空。风一吹，丝线便低低鸣响。"},{"id":"ep-37:7","s":"yeon","t":"这些线，和第十二宫里见到的很像。","x":"think","sfx":"chime"},{"id":"ep-37:8","s":"yun","t":"同一条线。那边给看线头，这里给看生与生之间的连接。","x":"serious"},{"id":"ep-37:9","s":"neo","t":"解读缘分的天，月亮有二十七间住处。","x":"calm"},{"id":"ep-37:10","s":"moka","t":"所以是算恋爱的天空嘛。","x":"base"},{"id":"ep-37:11","s":"yun","t":"准确地说，是业、缘分、恋爱，三个都贵。","x":"sly"},{"id":"ep-37:12","s":"n","t":"寺门口立着石碑。上面没有字，只有图：一条只有头的蛇，一条只有尾巴的蛇。","im":true,"shot":"close","sfx":"page","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-37:13","s":"yeon","t":"头和尾分开了。原本像是同一条。","x":"think","bg":"nakshatra","bgm":"templeDawn","shot":"wide","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"base"},"r":{"who":"neo","x":"calm"},"scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"nakshatra 배경에서 진행되는 yeon의 대사"}},{"id":"ep-37:14","s":"yun","t":"是断首蛇的故事。全讲要三天。","x":"base"},{"id":"ep-37:15","s":"moka","t":"三行说完。","x":"base"},{"id":"ep-37:16","s":"yun","t":"蛇偷喝不死之酒，被斩首。头是罗睺，吞太阳；尾是计都……","x":"serious","pacing":{"pauseMs":350,"importance":"breath"}},{"id":"ep-37:17","s":"n","t":"闰月停下，望着石板上的尾图。"},{"id":"ep-37:18","s":"yeon","t":"尾巴怎么样？","x":"think"},{"id":"ep-37:19","s":"yun","t":"看来待会儿能亲眼见。","x":"serious"},{"id":"ep-37:20","s":"moka","t":"连三行也没凑够。","x":"base"},{"id":"ep-37:21","s":"neo","t":"敌人比解释来得快。","x":"deadpan"},{"id":"ep-37:22","s":"n","t":"那一刻，天上一轮月暗了。它原本歇在像牛额头般圆的屋里，一道黑影正慢慢掠过前方。","fx":"stars","sfx":"sparkle","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":"stars","camera":"drift"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"}},{"id":"ep-37:23","s":"neo","t":"罗希尼，金牛座一带的月宿。头在那里。","x":"serious"},{"id":"ep-37:24","s":"yeon","t":"是黑月？","x":"fear"},{"id":"ep-37:25","s":"yun","t":"罗睺的头坐在罗希尼，计都的尾在对面的杰耶什塔。","x":"serious"},{"id":"ep-37:26","s":"yeon","t":"不准擅自占别人的天空！","x":"angry"},{"id":"ep-37:27","s":"moka","t":"收它十倍滞纳金。不是跟青兔学过吗。","x":"base"},{"id":"ep-37:28","s":"n","t":"石井旁，Neo独自坐着，外套盖住右臂。","bg":"nakshatra","bgm":"neo","shot":"wide","l":{"who":"yeon","x":"serious"},"c":null,"r":{"who":"neo","x":"calm"},"scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"}},{"id":"ep-37:29","s":"n","t":"Yeoni点着备忘本上的下划线：Neo的手，以后一定要看。已经不能再拖以后了。"},{"id":"ep-37:30","s":"yeon","t":"现在就是以后。","x":"serious"},{"id":"ep-37:31","s":"neo","t":"……那条记录还带着啊。","x":"surprise"},{"id":"ep-37:32","s":"yeon","t":"没扔过。胳膊伸出来。","x":"serious"},{"id":"ep-37:33","s":"n","t":"Neo慢慢掀开外套。手肘上方都空了，井水蓝光穿过胳膊，投到地上。"},{"id":"ep-37:34","s":"yeon","t":"还会到哪里？腿？身体？","x":"sad","im":true,"shot":"close","sfx":"heartbeat","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-37:35","s":"neo","t":"正在偿还借来的位置。还完，就结束了。","x":"calm"},{"id":"ep-37:36","s":"yeon","t":"借了什么都不说，只说在还，我怎么帮你！","x":"angry"},{"id":"ep-37:37","s":"neo","t":"不用帮。你知道了，代价就会增加。","x":"serious"},{"id":"ep-37:38","s":"n","t":"她双手围住透明手臂，什么也没握住，仍不松开。"},{"id":"ep-37:39","s":"yeon","t":"那我就什么也不知道，照样握着。这样不会涨价吧？","x":"serious"},{"id":"ep-37:40","s":"neo","t":"……这个，不在计算之内。","x":"soft"},{"id":"ep-37:41","s":"n","t":"风停了，井水也静下来。水中映出的手短暂恢复颜色。Yeoni赶紧在本上描下轮廓，五根手指一根没漏。","fx":"water","sfx":"water","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":"water","camera":"drift"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"}},{"id":"ep-37:42","s":"yun","t":"摩卡先生，告诉我生日，替你看看月宿，免费。","x":"sly","bg":"nakshatra","bgm":"daily","shot":"wide","l":{"who":"moka","x":"base"},"c":{"who":"yun","x":"base"},"r":{"who":"yeon","x":"smile"},"scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"nakshatra 배경에서 진행되는 yun의 대사"}},{"id":"ep-37:43","s":"moka","t":"你说免费，才最可疑。","x":"angry"},{"id":"ep-37:44","s":"yun","t":"那我猜猜？手快，听到夸奖就生气，总先照顾别人的饭。","x":"base"},{"id":"ep-37:45","s":"moka","t":"……那不就是看着我瞎说吗。","x":"base"},{"id":"ep-37:46","s":"yun","t":"占卜一半靠观察，另一半靠勇气。","x":"laugh"},{"id":"ep-37:47","s":"yeon","t":"摩卡脸红了。","x":"laugh"},{"id":"ep-37:48","s":"moka","t":"在火前待久了！厨师的职业病！","x":"angry"},{"id":"ep-37:49","s":"n","t":"这时，寺钟响了一声。一轮屋顶上的月移到隔壁屋顶，宣告一夜过去。"},{"id":"ep-37:50","s":"yun","t":"这里时间过得快。月亮每搬一次家，就过一天。","x":"base"},{"id":"ep-37:51","s":"yeon","t":"那我们已经用掉一天了？","x":"surprise"},{"id":"ep-37:52","s":"neo","t":"得抓紧。在这片天空，拖延很贵。","x":"calm"},{"id":"ep-37:53","s":"moka","t":"都说时间宝贵，刚才还讨论我的脸干什么。","x":"base"},{"id":"ep-37:54","s":"n","t":"寺内圆室的地面，二十七格围成圆，每格放一盏熄灯。","bg":"nakshatra","bgm":"templeDawn","shot":"wide","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"base"},"r":{"who":"neo","x":"calm"},"scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"}},{"id":"ep-37:55","s":"yun","t":"您的月宿，只能用您的火点亮。就是出生夜月亮所住的地方。","x":"base"},{"id":"ep-37:56","s":"n","t":"她聚起小而均匀的指尖火。第一格只熏黑芯，便灭；第二格接火后，平稳燃起。"},{"id":"ep-37:57","s":"yun","t":"婆罗尼，怀抱之星。","x":"surprise","im":true,"fx":"reveal","sfx":"chime","shot":"impact","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":"reveal","camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-37:58","s":"yeon","t":"怀抱之星？","x":"think"},{"id":"ep-37:59","s":"yun","t":"孕育，再带到世间的星。这片天称这样的人为容器。","x":"base"},{"id":"ep-37:60","s":"n","t":"Yeoni不自觉按住肚子。黑月也用这个词，冷冷地，饥肠辘辘地叫她。"},{"id":"ep-37:61","s":"yeon","t":"我讨厌容器这个词。黑月就这么叫我。","x":"fear"},{"id":"ep-37:62","s":"yun","t":"黑月只说了一半。「空了才能装下」，是他的意思。","x":"serious"},{"id":"ep-37:63","s":"yun","t":"婆罗尼不会一直存着，孕育、养大，再送还。","x":"base"},{"id":"ep-37:64","s":"n","t":"她把手从腹部移开，又放回去，比刚才没那么怕了。","im":true,"shot":"close","sfx":"heartbeat","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-37:65","s":"n","t":"她点第三格，克里提卡之灯如刀白窜，险烫着手，只得退后。"},{"id":"ep-37:66","s":"yeon","t":"我的月亮挨着那里？","x":"surprise"},{"id":"ep-37:67","s":"neo","t":"只是靠近边界。偏向哪边，由你选。","x":"calm"},{"id":"ep-37:68","s":"yeon","t":"那就孕育这边。刚才我选了。","x":"resolve"},{"id":"ep-37:69","s":"yeon","t":"可是闰月先生，能看看徐寒雨的星吗？","x":"think"},{"id":"ep-37:70","s":"yun","t":"不知道生日，就看不了。小姐知道吗？","x":"serious"},{"id":"ep-37:71","s":"yeon","t":"快递单上只有名字和楼栋房号，没写生日。","x":"disappoint"},{"id":"ep-37:72","s":"yun","t":"那就得直接问。虽然不知道她愿不愿回答。","x":"base"},{"id":"ep-37:73","s":"n","t":"圆房天花板垂下一根红线，缠上Yeoni手腕。不冷，像体温一样微暖。","bg":"sukuyo","bgm":"forestTemple","shot":"wide","l":{"who":"yeon","x":"serious"},"c":{"who":"moka","x":"base"},"r":{"who":"neo","x":"calm"},"scene":{"background":"sukuyo","backgroundMeaning":"작가 지정 배경: sukuyo","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"sukuyo 배경에서 진행되는 서술"}},{"id":"ep-37:74","s":"yeon","t":"为什么缠着我？","x":"surprise"},{"id":"ep-37:75","s":"yun","t":"小姐的缘分线。顺着末端走，就能找到相连的人。","x":"serious"},{"id":"ep-37:76","s":"moka","t":"哇，要揭晓命定对象了？猫该紧张了。","x":"base"},{"id":"ep-37:77","s":"neo","t":"没紧张。","x":"deadpan"},{"id":"ep-37:78","s":"n","t":"线分成两股，一股连向Neo，另一股通向寺院地板的缝隙下。"},{"id":"ep-37:79","s":"n","t":"Yeoni望着通向Neo的线，脸僵住。就在碰到他胸口之前，线散开了，只剩几丝勉强相连。","fx":"thread","sfx":"whoosh","scene":{"background":"sukuyo","backgroundMeaning":"작가 지정 배경: sukuyo","transition":"hold","tone":"natural","ambient":null,"eventEffect":"thread","camera":"drift"},"a11y":{"description":"sukuyo 배경에서 진행되는 서술"}},{"id":"ep-37:80","s":"yeon","t":"Neo，怎么回事？都磨坏了。","x":"fear"},{"id":"ep-37:81","s":"neo","t":"用了很久的线，本来就这样。","x":"calm"},{"id":"ep-37:82","s":"yeon","t":"哪有什么本来如此！胳膊、线，都说本来如此吗？","x":"angry"},{"id":"ep-37:83","s":"n","t":"Neo用手覆住线。透明的手下，快断的细丝一览无遗，根本遮不住。","im":true,"shot":"close","scene":{"background":"sukuyo","backgroundMeaning":"작가 지정 배경: sukuyo","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"sukuyo 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-37:84","s":"yun","t":"小姐，还有另一股。那条往下走。","x":"base"},{"id":"ep-37:85","s":"yeon","t":"（下面，锁链被拖去的地方。）","x":"think"},{"id":"ep-37:86","s":"n","t":"Yeoni轻轻拉了一下。下方传来极弱的回拉，像有人用指尖捏着线的末端。"},{"id":"ep-37:thread-1","s":"yun","t":"分岔的线只能握一边。两边都握，会磨损您的月亮。","x":"serious"},{"id":"ep-37:thread-2","s":"n","t":"她不答，用另一手连Neo那条线也攥住。"},{"id":"ep-37:thread-3","s":"n","t":"婆罗尼灯猛晃，火缩成半，半截芯烧得焦黑。"},{"id":"ep-37:thread-4","s":"neo","t":"放我这边。那线本来就这样。","x":"calm"},{"id":"ep-37:thread-5","s":"yeon","t":"不要。破了就缝。","x":"angry"},{"id":"ep-37:thread-6","s":"n","t":"她把两线各绕手腕一圈，灯仍半暗，再没变大。"},{"id":"ep-37:wick-1","s":"n","t":"她伸手向灯，又停住。松开双线，下面牵着的力或会消失。她只把余下灯芯长度记进眼里。"},{"id":"ep-37:wick-2","s":"yeon","t":"回来先看那火。若更小，就知道下去时发生过什么了。"},{"id":"ep-37:87","s":"yun","t":"往下的线不是一世结成，粗得转生几次也断不了。","x":"serious"},{"id":"ep-37:88","s":"yeon","t":"下面的人，与我别世也见过？","x":"think"},{"id":"ep-37:89","s":"yun","t":"见过，也交换过什么吧。好也罢，坏也罢。","x":"base"},{"id":"ep-37:90","s":"moka","t":"如果是坏的呢？","x":"base"},{"id":"ep-37:91","s":"yeon","t":"那更得问清。","x":"serious"},{"id":"ep-37:92","s":"n","t":"寺院地板轰然裂开。巨大尾尖从缝中升起，覆着蛇尾般的鳞片，锁链层层缠绕。","bg":"nakshatra","tone":"dark","bgm":"zeroPoint","shot":"impact","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"serious"},"r":{"who":"neo","x":"serious"},"im":true,"fx":"hands","sfx":"glitch","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":"hands","camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-37:93","s":"heuk","t":"尾食昨日，首食明日。容器，先献哪一个？"},{"id":"ep-37:94","s":"moka","t":"哪个都不给！我们Yeoni不饿！","x":"angry"},{"id":"ep-37:95","s":"yun","t":"我用空亡接。大家退后。","x":"serious"},{"id":"ep-37:96","s":"n","t":"闰月正要摘手套，Neo按住他的手腕。手虽然透明，握住人的力气还在。"},{"id":"ep-37:97","s":"neo","t":"先别扩大。头来之前，不能耗尽力气。","x":"serious"},{"id":"ep-37:98","s":"yun","t":"猫先生居然担心我。真感动。","x":"pain"},{"id":"ep-37:99","s":"n","t":"尾扫地面，灯纷倒，只剩半烧的婆罗尼灯撑住。她腕上红线绷紧，下面那端有人握住。"},{"id":"ep-37:100","s":"n","t":"裂隙下升起雨声，晴朗的寺院本不该听见的声音。接着，是低而优雅的嗓音。","sfx":"rain"},{"id":"ep-37:101","s":"tiger","t":"那根线，别松手。至少现在别松。","x":"base"},{"id":"ep-37:102","s":"n","t":"尾巴重新沉入裂隙，地板合拢。Yeoni手腕只留下那根线，笔直向下，绷得紧紧的。","im":true,"shot":"quiet","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-37:103","s":"yeon","t":"那个声音，我认识。","x":"serious"},{"id":"ep-37:104","s":"neo","t":"Yeoni。","x":"serious"},{"id":"ep-37:105","s":"yeon","t":"别拦我。说过一大堆事要问，我要下去问清楚。","x":"serious"},{"id":"ep-37:106","s":"neo","t":"不拦。说好站在你旁边。","x":"serious"},{"id":"ep-37:107","s":"moka","t":"我也去。要论质问，我最拿手。","x":"base"},{"id":"ep-37:108","s":"yun","t":"那我在后面替各位鼓掌。鼓掌不要钱。","x":"sly"},{"id":"ep-37:109","s":"n","t":"四人走向寺院最深处的阶梯，尽头通向黑暗。Yeoni腕上的红线像向导一样，走在前面。","im":true,"shot":"quiet","sfx":"bell","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-37:110","s":"n","t":"阶梯墙上依次映出二十七轮月亮。越往下，月亮越是一轮轮熄灭。当只剩最后一轮，雨声已近在咫尺。"}]}
