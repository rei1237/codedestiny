{"version":2,"sourceHash":"1822d08b1cf0edd0475c92c0afa22fe040cec6e8e632f2e40817de52b7dfdd2e","locale":"zh-CN","id":"ep-21","no":"EP.21","tag":"第21话 · 第五道光","title":"第五道光","rev":2,"beats":[{"id":"ep-21:1","s":"n","t":"早晨一到，图书馆便安静下来，仿佛从未湿过。圆顶下，每张阅览桌上，都整齐摊着烘干的书。","bg":"library","bgm":"teaHouse","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-21:2","s":"moka","t":"第一百一十二本了。猪，哪有让厨子烘书的。","x":"base","l":{"who":"yeon","x":"neutral"},"c":{"who":"moka","x":"base"},"r":null},{"id":"ep-21:3","s":"yeon","t":"辛苦了，五星加熨烫服务。","x":"grin"},{"id":"ep-21:4","s":"moka","t":"别给星，给饭。星星又不能吃。","x":"angry"},{"id":"ep-21:5","s":"n","t":"每当摩卡滚过火种，湿书页就沙沙舒展开来。书里升起一股像热面包般的香气。","sfx":"page"},{"id":"ep-21:6","s":"yun","t":"真香。大概写着某个人生日的早晨。","x":"base","r":{"who":"yun","x":"base"}},{"id":"ep-21:7","s":"yeon","t":"光闻书的味道，连这个都能知道？","x":"surprise"},{"id":"ep-21:8","s":"yun","t":"没有，随口说说。挺像回事吧？","x":"sly"},{"id":"ep-21:9","s":"moka","t":"看吧。骗子一大早就骗人。","x":"angry"},{"id":"ep-21:10","s":"yun","t":"水獭先生一大早就记得我。谢谢。","x":"laugh"},{"id":"ep-21:11","s":"moka","t":"别这么说。都没法生气了。","x":"moved"},{"id":"ep-21:12","s":"n","t":"小龙从Yeoni手腕上扭着身子爬出来。肚子圆鼓鼓的，每打一个哈欠，就飞出几滴小水珠。","sfx":"water"},{"id":"ep-21:13","s":"yeon","t":"看它。昨天喝下的洪水，还在消化呢。","x":"laugh"},{"id":"ep-21:14","s":"moka","t":"龙喝水喝坏肚子，算什么天气。梅雨吗。","x":"base"},{"id":"ep-21:15","s":"yun","t":"仓库还没满，是好消息。说明下次洪水，也能帮忙喝掉。","x":"base"},{"id":"ep-21:16","s":"yeon","t":"听见了吗？你就是我们队的官方净水器。","x":"grin"},{"id":"ep-21:17","s":"n","t":"小龙似乎很满意这个称号，用尾巴绕了绕Yeoni的前蹄，又睡着了。"},{"id":"ep-21:18","s":"n","t":"Yeoni坐在桌角，摊开前蹄。八格的文字面板浮起。七格已满，其中一格，冻得漆黑。","sfx":"chime"},{"id":"ep-21:19","s":"sys","t":"[ 年 壬午 · 月 丙午 · 日 乙亥 · 时 □辰 ]  7/8"},{"id":"ep-21:20","s":"yeon","t":"（只剩一个了。可这个空格，要到哪里找。）","x":"think"},{"id":"ep-21:21","s":"yeon","t":"闰月，时柱第一个字，这里该坐什么？","x":"talk","l":{"who":"yeon","x":"talk"},"c":null,"r":{"who":"yun","x":"base"}},{"id":"ep-21:22","s":"yun","t":"乙木日干，那是庚金的位置，也就是官星的位置。","x":"serious"},{"id":"ep-21:23","s":"yeon","t":"官星是什么？就一句。","x":"disappoint"},{"id":"ep-21:24","s":"yun","t":"约束、守护自己的气，像规则或名牌。","x":"base"},{"id":"ep-21:25","s":"yeon","t":"别的格子都在岛上找到了，可没见过官星的岛。","x":"serious"},{"id":"ep-21:26","s":"yun","t":"没有不存在官星的命盘。看不到，就说明藏起来了。","x":"serious"},{"id":"ep-21:27","s":"n","t":"她想起第一天河上的雾，那晚，光在雾后逐道升起。","bgm":"focusFlow","shot":"wide","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-21:28","s":"yeon","t":"（那时猫说，我的字散在四座岛上。）","x":"think"},{"id":"ep-21:29","s":"n","t":"青色的光，摇晃的火光，金光，还有像旧书架一样的光。那时看见的，确实是四道光。","im":true,"shot":"close","fx":"stars","sfx":"sparkle","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":"stars","camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-21:30","s":"yeon","t":"光只有四道。十神有五路，整整空了一路。","x":"serious"},{"id":"ep-21:31","s":"yun","t":"女士学了不少啊。要不要来我的合婚摊打工？","x":"sly"},{"id":"ep-21:32","s":"yeon","t":"现在不是在说这个啊。","x":"disappoint"},{"id":"ep-21:33","s":"moka","t":"第五道光去哪儿了。被谁塞口袋里了？","x":"base"},{"id":"ep-21:34","s":"yun","t":"我也不知道怎么找。时辰空着的人，通常不会长久盯着那一格。","x":"serious"},{"id":"ep-21:35","s":"yeon","t":"说是守护的气吧？那我遇险时，这格该反应最强。","x":"serious"},{"id":"ep-21:36","s":"yun","t":"小姐，您现在的表情有点吓人。","x":"sly"},{"id":"ep-21:37","s":"yeon","t":"（要知道谁在守护，造件需要守护的事就行。）","x":"think"},{"id":"ep-21:38","s":"n","t":"这时，阅览室门开了。Yeongnyangi走进来。毛只干了一半，每次左爪落地，都会有极轻的迟疑。","sfx":"door"},{"id":"ep-21:39","s":"yeon","t":"Yeongnyangi，最初你说岛有四个，那第五个呢？","x":"talk","l":{"who":"yeon","x":"talk"},"c":null,"r":{"who":"neo","x":"neutral"}},{"id":"ep-21:40","s":"neo","t":"现在没有。","x":"deadpan"},{"id":"ep-21:41","s":"yeon","t":"五路偏少一路？说得通吗？","x":"talk"},{"id":"ep-21:42","s":"neo","t":"客服营业时间结束。","x":"deadpan"},{"id":"ep-21:43","s":"yeon","t":"再说那句话，我真给你受理了。","x":"angry"},{"id":"ep-21:44","s":"n","t":"Yeongnyangi坐到桌子另一端。换作平时，他会坐在Yeoni旁边。Yeoni看了一眼那个空位。"},{"id":"ep-21:45","s":"yeon","t":"（从昨天开始，就一直这样。我靠近一步，他就退一步。）","x":"think"},{"id":"ep-21:46","s":"yun","t":"猫先生，冒昧问一下，您的生日是什么时候？","x":"base","c":{"who":"yun","x":"base"}},{"id":"ep-21:47","s":"neo","t":"为什么问。","x":"serious"},{"id":"ep-21:48","s":"yun","t":"遇到谁都会问。一直在小姐身边的，更要问。","x":"sly"},{"id":"ep-21:49","s":"neo","t":"不知道。","x":"angry"},{"id":"ep-21:50","s":"yun","t":"不知道啊。这也挺有意思。","x":"base"},{"id":"ep-21:51","s":"moka","t":"骗子，你在试探猫吧。我都看出来了。","x":"base"},{"id":"ep-21:52","s":"n","t":"她穿过桌间，停在阅览室尽头的梯子前。带轮子的梯，直达天花书架。","c":null,"bgm":"starsName","shot":"wide","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-21:53","s":"yeon","t":"做个实验。摩卡灭火，闰月站梯下。","x":"serious"},{"id":"ep-21:54","s":"moka","t":"又是什么。猪的实验，一般都是我受伤。","x":"base"},{"id":"ep-21:55","s":"n","t":"她没对猫说。猫在另一头抖着湿帽子。"},{"id":"ep-21:56","s":"yun","t":"我也空着时辰。站下面，会干扰实验哦。","x":"serious"},{"id":"ep-21:fall-1","s":"yeon","t":"所以才请您站那儿，我要两个都测。","x":"serious"},{"id":"ep-21:57","s":"n","t":"她爬到梯顶，头上五片花瓣摇动，第一天褪白的那片先抖了起来。"},{"id":"ep-21:fall-2","s":"n","t":"在顶格缓一口气，她松开两只前蹄，故意把藤留缠在腕内。","sfx":"whoosh"},{"id":"ep-21:fall-3","s":"n","t":"闰月用折伞柄钩住她后颈。空格震了一次，伞柄撑不住猪的重量，滑脱了。"},{"id":"ep-21:58","s":"n","t":"另一头一道白影蹬地冲来。猫扑到她下方时，空格像冷铁遇阳光，白亮地燃起。","im":true,"fx":"metal","sfx":"chime","shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":"metal","camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-21:fall-4","s":"n","t":"两人滚进书堆。她左后脚卡住梯脚，向古怪方向折了一下。","sfx":"thud"},{"id":"ep-21:59","s":"yeon","t":"疼！看见吗？闰月那边震一次，你这边也一次。","x":"serious","l":{"who":"yeon","x":"serious"},"c":null,"r":{"who":"neo","x":"fear"}},{"id":"ep-21:60","s":"neo","t":"后脚给我看。","x":"fear"},{"id":"ep-21:61","s":"yeon","t":"没事，没想象那么疼。","x":"grin"},{"id":"ep-21:62","s":"neo","t":"书堆什么时候堆的。","x":"serious"},{"id":"ep-21:63","s":"yeon","t":"早上。我说烘书，自己堆的。","x":"disappoint"},{"id":"ep-21:64","s":"n","t":"猫的耳朵慢慢向后压。他看梯下书堆、闰月的伞，再看她腕上未松的藤。"},{"id":"ep-21:65","s":"neo","t":"故意掉下来的？","x":"angry","im":true,"shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 neo의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-21:angry-1","s":"yeon","t":"我想知道谁有反应。你们都只说以后。","x":"serious"},{"id":"ep-21:angry-2","s":"neo","t":"所以试探我，拿你的后脚来赌。","x":"angry"},{"id":"ep-21:angry-3","s":"n","t":"摩卡的火种一缩。这里没有谁见过猫提高声音。"},{"id":"ep-21:angry-4","s":"neo","t":"我要是没接住，怎么办。","x":"angry"},{"id":"ep-21:angry-5","s":"yeon","t":"可你接住了。","x":"sad"},{"id":"ep-21:angry-6","s":"neo","t":"不许再做。下次不接。","x":"serious"},{"id":"ep-21:66","s":"n","t":"猫转身离开，拖着左脚的声音之后，门关得格外响。"},{"id":"ep-21:67","s":"moka","t":"猫居然也会吼？比平时讨厌的时候吓人多了。","x":"base","l":{"who":"yeon","x":"sad"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"base"}},{"id":"ep-21:68","s":"yeon","t":"我也不知道，他会说这么大声。","x":"sad"},{"id":"ep-21:69","s":"n","t":"闰月把折伞绑回包带，蹲在她后脚前，用戴手套的手指按了肿踝两下。"},{"id":"ep-21:70","s":"yun","t":"扭伤了，至少得跛三天。","x":"serious"},{"id":"ep-21:71","s":"yeon","t":"您那边也震了，那是什么？","x":"surprise"},{"id":"ep-21:72","s":"yun","t":"说过我也空时辰。空的地方互相打招呼罢了。","x":"sly"},{"id":"ep-21:73","s":"yeon","t":"打招呼而已，倒挺亮。","x":"serious"},{"id":"ep-21:74","s":"moka","t":"我看两边都亮，猫那边更白一点。","x":"base"},{"id":"ep-21:75","s":"yun","t":"女命的官星还有一层意思。等脚好了再说。","x":"laugh"},{"id":"ep-21:76","s":"n","t":"整个下午她拖着左后脚转图书馆，摩卡边抱怨，边用书签缎带给她缠脚踝。","bgm":"daily","shot":"wide","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-21:77","s":"yeon","t":"不知道就查。去目录台看看。","x":"serious","l":{"who":"yeon","x":"serious"},"c":null,"r":{"who":"moka","x":"base"}},{"id":"ep-21:78","s":"moka","t":"第一天那个话痨卡片柜？那家伙叫我安静来着。","x":"base"},{"id":"ep-21:79","s":"n","t":"目录台的抽屉一见两人，就咔嗒咔嗒打开。一张卡片飞来，停在Yeoni鼻子前。","sfx":"page"},{"id":"ep-21:80","s":"sys","t":"[ 请说出搜索词 · 借阅额度 0/1 ]"},{"id":"ep-21:81","s":"yeon","t":"花猪，官星，第五道光。","x":"talk"},{"id":"ep-21:82","s":"n","t":"卡上的字如墨散开又聚拢，结果只有一行。","im":true,"fx":"ink","sfx":"glitch","shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":"ink","camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-21:83","s":"sys","t":"[ 无搜索结果 · 收藏处：图书馆外 · 负责人：客服 ]"},{"id":"ep-21:84","s":"yeon","t":"客服？","x":"surprise"},{"id":"ep-21:85","s":"moka","t":"什么客服。这里还有这种东西？","x":"base"},{"id":"ep-21:86","s":"yeon","t":"有，那个投诉和担心都不受理的客服。","x":"serious"},{"id":"ep-21:87","s":"n","t":"她把卡翻过来，背角隐隐印着一个前爪印。"},{"id":"ep-21:88","s":"moka","t":"猫爪啊。它老把爪子放我烤串上，我认得大小。","x":"base"},{"id":"ep-21:89","s":"yeon","t":"（有人先查过，用同一张卡。）","x":"think"},{"id":"ep-21:90","s":"yeon","t":"摩卡。关于Yeongnyangi，你是不是有什么没告诉我？","x":"serious"},{"id":"ep-21:91","s":"moka","t":"没有，水獭不懂什么秘密。","x":"angry","l":{"who":"yeon","x":"serious"},"c":null,"r":{"who":"moka","x":"angry"}},{"id":"ep-21:92","s":"yeon","t":"你现在尾巴摇得好快。","x":"disappoint"},{"id":"ep-21:93","s":"moka","t":"这是在甩干毛！烘书的时候弄湿了！","x":"angry"},{"id":"ep-21:94","s":"n","t":"摩卡匆匆躲到另一排书架那边。Yeoni久久望着他的背影。"},{"id":"ep-21:95","s":"yeon","t":"（三天啊，这期间连逃走的猫也追不上了。）","x":"think"},{"id":"ep-21:96","s":"n","t":"夜里，图书馆深处小房间中，大家都睡了。摩卡枕着书打鼾。","bg":"library2","tone":"dark","bgm":"room","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library2 배경에서 진행되는 서술"}},{"id":"ep-21:97","s":"yeon","t":"（睡不着，脚踝和空格一直隐隐疼。）","x":"think","l":{"who":"yeon","x":"think"},"c":null,"r":null},{"id":"ep-21:98","s":"n","t":"Yeoni翻了个身，看向房间角落。Yeongnyangi平时蜷着睡觉的地方，空着。"},{"id":"ep-21:99","s":"yeon","t":"Yeongnyangi？","x":"fear","sfx":"heartbeat"},{"id":"ep-21:100","s":"n","t":"没有回应。Yeoni掀开被子，坐起身。摩卡的呼噜声之间，夹着自己的心跳。"},{"id":"ep-21:101","s":"n","t":"空位上，留着几根白毛和一张纸条。上面印着前爪形状的签名。"},{"id":"ep-21:102","s":"sys","t":"[ 很快回来。不受理担心。· 客服 ]","im":true,"shot":"close","fx":"script","sfx":"page","scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"hold","tone":"dark","ambient":null,"eventEffect":"script","camera":"focus"},"a11y":{"description":"library2 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-21:103","s":"yeon","t":"这算什么纸条。为什么不受理担心！","x":"angry"},{"id":"ep-21:104","s":"yeon","t":"（白天发那么大火，最后就一张纸条。）","x":"think"},{"id":"ep-21:105","s":"n","t":"她拿纸条起身，踩到左后脚，又跌坐下。腕上小龙睡中睁眼，转头向窗。"},{"id":"ep-21:106","s":"n","t":"窗外传来雨声。天空晴朗，却飘着雨的气味。","sfx":"rain"},{"id":"ep-21:107","s":"yeon","t":"这气味，我知道。","x":"serious"},{"id":"ep-21:108","s":"yeon","t":"（是水底书架、锁链上都闻过的味道。湿披风的气味。）","x":"think"},{"id":"ep-21:109","s":"n","t":"她折好纸条握在前蹄，单脚跳到窗旁，额头抵上玻璃，看见外头天空。","im":true,"shot":"close","scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-21:110","s":"n","t":"半被吃掉的太阳挂在夜空。圆顶上，站着两道影。","bg":"eclipseSky","tone":"dark","bgm":"crisis2","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-21:111","s":"n","t":"一只是戴帽白猫，另一只是披风滴着雨的黑虎。","l":{"who":"yeon","x":"fear"},"c":null,"r":null},{"id":"ep-21:112","s":"n","t":"他们没有打架，隔着一点距离，望着同一方天。"},{"id":"ep-21:113","s":"yeon","t":"他们怎么会在一起。","x":"fear"},{"id":"ep-21:114","s":"n","t":"腕上的小龙，用力咬住Yeoni前蹄。不知道是叫她别去，还是快去。"},{"id":"ep-21:115","s":"yeon","t":"知道了，我会轻点，你也憋住气。","x":"serious"},{"id":"ep-21:116","s":"n","t":"她前蹄搭上窗框，又停住。扭伤后脚，爬不上圆屋顶。"},{"id":"ep-21:117","s":"n","t":"字盘忽然自行浮在前蹄上。白天燃白的空格里，划着一道没见过的笔画。","im":true,"fx":"veil","shot":"close","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"veil","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-21:118","s":"yeon","t":"（刚才还没有这一笔。）","x":"think"},{"id":"ep-21:119","s":"n","t":"身后有人坐起。她以为睡着的闰月，膝上放着折伞，在黑暗中看着她的空格。","im":true,"shot":"impact","sfx":"thud","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}}]}
