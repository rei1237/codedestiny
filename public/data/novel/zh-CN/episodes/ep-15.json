{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-15","no":"EP.15","tag":"第15话 · 洗劫金库","title":"洗劫金库","rev":2,"beats":[{"id":"ep-15:1","s":"n","t":"钟楼后门，比想象中简陋。小门勉强够一个面包篮通过，上面挂着生锈的升降机绳索。","bg":"jaeEnter","tone":"dark","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jaeEnter","backgroundMeaning":"작가 지정 배경: jaeEnter","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter 배경에서 진행되는 서술"}},{"id":"ep-15:2","s":"ln","t":"姐姐每天清晨，都从这里把面包送下去。给守金库的叔叔们当早饭。","x":"worry","l":{"who":"yeon","x":"serious"},"c":{"who":"ln","x":"worry"},"r":{"who":"yun","x":"base"}},{"id":"ep-15:3","s":"yun","t":"多亏露娜小姐，我们跳过了正门的七重关卡。今天的头号功臣。","x":"base"},{"id":"ep-15:4","s":"ln","t":"那我有五星吗？","x":"cheer"},{"id":"ep-15:5","s":"yeon","t":"五星，再加一枚小花印章。姐姐醒了，告诉她。","x":"grin"},{"id":"ep-15:6","s":"n","t":"广场尽头，一盏灯晃动着。穿蓝制服的兔子巡逻兵，打着哈欠走过。"},{"id":"ep-15:7","s":"neo","t":"低头。每到整点，巡逻就绕一圈。离下一次整点还有四分钟。","x":"serious","c":{"who":"neo","x":"serious"}},{"id":"ep-15:8","s":"yeon","t":"（四分钟。在这座岛，四分钟够买一个半面包。）","x":"think"},{"id":"ep-15:9","s":"moka","t":"看那只巡逻兔的耳朵。闻到烤串味，一动一动的。它也饿了。","x":"base"},{"id":"ep-15:10","s":"n","t":"巡逻兵一转过街角，四人便从一处阴影跳进另一处。露娜走在前面，提起小门的门闩。"},{"id":"ep-15:11","s":"n","t":"升降篮吱呀着下降。四人和露娜依次攀住绳索，滑进黑暗。","sfx":"door"},{"id":"ep-15:12","s":"n","t":"第一层是工厂。数百人默默操纵机器。机器里落下的不是钱币，而是滴答作响的沙粒。","bg":"jaeSlave","tone":"dark","bgm":"memWater","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jaeSlave","backgroundMeaning":"작가 지정 배경: jaeSlave","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeSlave 배경에서 진행되는 서술"}},{"id":"ep-15:13","s":"yeon","t":"这些全是守卫？看起来更像工人啊。","x":"fear","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"moka","x":"base"}},{"id":"ep-15:14","s":"yun","t":"这一层，是用劳动偿还欠下的时间。在这里工作，日子不会流逝。但也不能回家。","x":"serious"},{"id":"ep-15:15","s":"n","t":"工人们的脸，无一例外都很模糊。有孩子，也有老人。在这些模糊的脸之间，一只大熊猫正强忍着困意。"},{"id":"ep-15:16","s":"moka","t":"都是饥饿的脸。失去味道的脸。","x":"moved","im":true,"shot":"close","scene":{"background":"jaeSlave","backgroundMeaning":"작가 지정 배경: jaeSlave","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeSlave 배경에서 진행되는 moka의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:17","s":"moka","t":"计划改一下。不是迷住，是喂饱他们。香味干扰算附赠。","x":"base"},{"id":"ep-15:18","s":"n","t":"摩卡点燃便携炉。二十串辣味烤串同时滋滋作响，工厂里的空气仿佛也摇动了。","sfx":"fire"},{"id":"ep-15:19","s":"n","t":"机器声一台接一台停了。工人们抬起头。模糊的脸庞之间，吞口水的声音传了开来。"},{"id":"ep-15:20","s":"moka","t":"排队。不收钱。不过好吃，就说好吃。这就是价钱。","x":"base"},{"id":"ep-15:21","s":"n","t":"熊猫第一个领到烤串。咬下一口，模糊的眼角一瞬间清晰起来。好吃。声音很小。","im":true,"scene":{"background":"jaeSlave","backgroundMeaning":"작가 지정 배경: jaeSlave","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeSlave 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:22","s":"yeon","t":"听见了吗？它说好吃！","x":"happy"},{"id":"ep-15:23","s":"moka","t":"当然。这次可是真正的味道。","x":"only"},{"id":"ep-15:24","s":"n","t":"烤串队伍的末尾，站着一个小孩子。是一只垂耳小兔。孩子领了烤串却没有吃，只盯着自己的手腕。"},{"id":"ep-15:25","s":"yeon","t":"不吃吗？很好吃的。","x":"gentle","im":true,"shot":"close","scene":{"background":"jaeSlave","backgroundMeaning":"작가 지정 배경: jaeSlave","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeSlave 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:26","s":"n","t":"孩子伸出手腕。小小的数字在闪烁。距回家尚欠：00:01:00。"},{"id":"ep-15:27","s":"yeon","t":"一分钟？就因为一分钟，才待在这里？","x":"surprise"},{"id":"ep-15:28","s":"n","t":"孩子点点头。在烤串的香气那头，小声说，再干一分钟，就能回妈妈那里。"},{"id":"ep-15:29","s":"yeon","t":"（一分钟。我挣来的十二分钟，应该……）","x":"sad"},{"id":"ep-15:30","s":"yun","t":"女士，现在不行。那是打开第七格门的代价。回来的路上，再看看吧。","x":"serious"},{"id":"ep-15:31","s":"yeon","t":"等着。回来的时候，我一定来。烤串趁热吃。","x":"serious"},{"id":"ep-15:32","s":"ln","t":"跟姐姐面包的香味很像。暖暖的味道。","x":"joy"},{"id":"ep-15:33","s":"neo","t":"趁摩卡吸引注意，我们下去。从第二层开始，时间会变慢。","x":"serious","l":{"who":"yeon","x":"serious"},"c":{"who":"neo","x":"serious"},"r":{"who":"yun","x":"serious"}},{"id":"ep-15:34","s":"yun","t":"露娜小姐留在摩卡先生旁边。下面让大人去。","x":"serious"},{"id":"ep-15:35","s":"ln","t":"不要。那是我姐姐的一天。我要自己找。","x":"worry"},{"id":"ep-15:36","s":"yeon","t":"那就一起到第三层。在那里等着，我一定把姐姐的东西带回来。约好了。","x":"gentle"},{"id":"ep-15:37","s":"n","t":"第二层。金色长廊延伸不尽。嵌在墙里的仪表指针，像蜂蜜一样缓缓移动。","bg":"jaeEnter2","tone":"dark","bgm":"crisis","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:38","s":"n","t":"迈出一步，脚就沉了下去。第二步，耳中自己的心跳声，响得像雷鸣。","sfx":"heartbeat"},{"id":"ep-15:39","s":"yeon","t":"气息……往上跑了。","x":"fear"},{"id":"ep-15:40","s":"neo","t":"托住。像昨天一样。往下放。","x":"calm"},{"id":"ep-15:41","s":"n","t":"Yeoni把气息送到腹部下方。插在耳后的断芽，轻轻摇了摇。腿又能动了。"},{"id":"ep-15:42","s":"n","t":"第三层门前，长廊猛地一震。地板翻转，金属手臂破地而出。没有警报，是无声的陷阱。","sfx":"thud","fx":"shake","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":"shake","camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:43","s":"n","t":"Yeongnyangi向前跃出。金色利爪，一下斩断三条金属手臂。断臂在缓慢的时间里，缓缓坠落。","sfx":"slash","fx":"claw","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":"claw","camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:44","s":"neo","t":"路开了。那扇门要由你来开。","x":"serious"},{"id":"ep-15:45","s":"yun","t":"好，好。锁住的东西，我来吃。","x":"base","im":true,"shot":"close","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:46","s":"n","t":"闰月把手掌贴上门把。整把锁消失进掌心的洞里。闰月的肩猛地一颤。","sfx":"whoosh","fx":"suck","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":"suck","camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:47","s":"yun","t":"这岛上的锁，铁味可真重。牙都酸了。","x":"pain"},{"id":"ep-15:48","s":"yeon","t":"叔叔，刚才又变大了吧。手伸过来看看。","x":"serious"},{"id":"ep-15:49","s":"yun","t":"如果女士握住我的手，说不定就不那么疼了。","x":"sly"},{"id":"ep-15:50","s":"yeon","t":"这种话，等手不疼了再说！","x":"angry"},{"id":"ep-15:51","s":"n","t":"他们在第三层与露娜分开。露娜蹲在门前，伸出五根手指。五小时内回来。"},{"id":"ep-15:52","s":"n","t":"第四、第五、第六层。越往下，时间越浓稠。坠落的水滴停在半空，像珍珠一样悬着。","bg":"jaeEnter2","tone":"dark","bgm":"crisis","shot":"wide","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:53","s":"moka","t":"我好像要打喷嚏了。","x":"angry","c":{"who":"moka","x":"angry"}},{"id":"ep-15:54","s":"yun","t":"现在打，就是一星期。","x":"serious"},{"id":"ep-15:55","s":"moka","t":"知道。所以才忍着嘛。这里真是个一星楼层。","x":"angry"},{"id":"ep-15:56","s":"n","t":"摩卡的鼻子抽动着。Yeongnyangi默默用斗篷下摆罩住摩卡的鼻子。喷嚏悄悄消失在绣着星星的内衬里。","im":true,"scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:57","s":"yeon","t":"Yeongnyangi的斗篷，还有喷嚏过滤功能？加一星。","x":"laugh"},{"id":"ep-15:58","s":"neo","t":"免费。仅限今天。","x":"deadpan"},{"id":"ep-15:59","s":"n","t":"第七格。巨大的圆形金库敞开着。沿着墙壁，数千只沙漏层层排开。","bg":"timeVault","bgm":"glassBox","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:60","s":"yeon","t":"这些，全都是某个人的一天？","x":"surprise","l":{"who":"yeon","x":"surprise"},"c":null,"r":{"who":"yun","x":"serious"}},{"id":"ep-15:61","s":"yun","t":"一天，一个月，十年。都是在这座岛被卖掉、被夺走的时间。","x":"serious"},{"id":"ep-15:62","s":"n","t":"每只沙漏里，都有极轻的声音。孩子的笑声，煮饭声，有人呼唤名字的声音。那是被卖来的一天的声音。"},{"id":"ep-15:63","s":"moka","t":"这里的声音都有味道。像谁家晚饭香味一样的声音。","x":"moved"},{"id":"ep-15:64","s":"neo","t":"别听太久。跟着别人的一天走，你自己的脚也可能被缠住。","x":"serious"},{"id":"ep-15:65","s":"sys","t":"[ 露娜的姐姐 · 剩余的今天 01:12:40 ]","fx":"script","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"script","camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 시스템 메시지"}},{"id":"ep-15:66","s":"n","t":"Yeoni逐个扫过名牌。在第三排末尾，找到了画着一双沾面粉的手的沙漏。"},{"id":"ep-15:67","s":"yeon","t":"找到了！姐姐的！上面画着手！","x":"excited"},{"id":"ep-15:68","s":"n","t":"闰月奔向对面的墙。最下方一个抽屉上，没有名字，只贴着空白名牌。抽屉是空的。"},{"id":"ep-15:69","s":"yun","t":"不在呢。应该放卯时的地方。","x":"void","im":true,"shot":"close","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"timeVault 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:70","s":"yeon","t":"叔叔……","x":"sad","pacing":{"pauseMs":350,"importance":"breath"}},{"id":"ep-15:71","s":"yun","t":"没关系。那只兔子大概随身带着。它是连吃进去的东西，也舍不得放手的类型。","x":"base"},{"id":"ep-15:72","s":"n","t":"这时，金库中央传来翻纸声。极缓慢，又极清晰的声音。","sfx":"page","bgm":"warCommand","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:73","s":"n","t":"金库中央的圆台上，坐着黑虎。斗篷上摊开账簿，脚边放着一颗金色的蛋。","l":{"who":"yeon","x":"fear"},"c":{"who":"tiger","x":"base"},"r":{"who":"neo","x":"angry"}},{"id":"ep-15:74","s":"tiger","t":"来晚了，猪。虽然早知道你会走面包店的升降机。","x":"base"},{"id":"ep-15:75","s":"yeon","t":"知道，为什么不拦？","x":"serious"},{"id":"ep-15:76","s":"tiger","t":"没有守库者会拦进来的客人。拦的是出去的客人。","x":"talk"},{"id":"ep-15:77","s":"n","t":"老虎翻过一页账簿。Yeoni看得清清楚楚。密密麻麻的记录中，只有一行空着。","im":true,"scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:78","s":"sys","t":"[ 花猪 · 未收 ]","fx":"ink","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"ink","camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 시스템 메시지"}},{"id":"ep-15:79","s":"tiger","t":"有人叫我在下一座岛，收走你的时间。没想到你自己走到了金库里。","x":"talk"},{"id":"ep-15:80","s":"yeon","t":"谁叫你的。你的账簿里，连老板也记着吗？","x":"angry"},{"id":"ep-15:81","s":"tiger","t":"问题真多。债放着不管，会越滚越大。所以必须按时收回来。","x":"base"},{"id":"ep-15:82","s":"yeon","t":"那你呢？你向谁借了什么。","x":"serious"},{"id":"ep-15:83","s":"n","t":"老虎的尾巴停住。翻页的前爪，在半空停顿了极短的一瞬。"},{"id":"ep-15:84","s":"tiger","t":"猪不需要知道。","x":"talk"},{"id":"ep-15:85","s":"yeon","t":"（刚才，它回答不了了。）","x":"think"},{"id":"ep-15:86","s":"neo","t":"离Yeoni远点。","x":"angry"},{"id":"ep-15:87","s":"tiger","t":"猫别插手。你不也已经裂了吗。左爪。","x":"angry"},{"id":"ep-15:88","s":"n","t":"Yeongnyangi的左前爪微微一颤。Yeoni没有看到。Yeoni的目光，正落在老虎脚边的蛋上。"},{"id":"ep-15:89","s":"yeon","t":"（那颗蛋……为什么这么熟悉。好像身体里面，有什么在呼唤。）","x":"think"},{"id":"ep-15:90","s":"yun","t":"女士，就是那颗蛋。辰。您时支的字。辰土是仓库。这整座金库，都是建在那颗蛋上面的。","x":"serious"},{"id":"ep-15:91","s":"sys","t":"[ 年 □□ · 月 丙午 · 日 乙亥 · 时 □辰 ? ]","fx":"script","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"script","camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 시스템 메시지"}},{"id":"ep-15:92","s":"yeon","t":"我的字，为什么被压在金库底下？","x":"surprise"},{"id":"ep-15:93","s":"n","t":"蛋仿佛认出了Yeoni，轻轻摇晃。金色的壳下面，有什么在蠕动。"},{"id":"ep-15:94","s":"tiger","t":"时辰空着的命盘，就是仓库敞着门的房子。谁都能进来，把东西堆进去。","x":"talk"},{"id":"ep-15:95","s":"moka","t":"话真多。把蛋拿来。姐姐的一天也拿来。","x":"angry","bgm":"warCommand","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 moka의 대사"}},{"id":"ep-15:96","s":"n","t":"老虎甩了一下尾巴。黑水沿着地上的钟表指针漫开。一碰到脚踝，水就冻结了时间。","sfx":"water","fx":"water","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"water","camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:97","s":"neo","t":"别碰水！碰到就会停住！","x":"serious"},{"id":"ep-15:98","s":"n","t":"Yeongnyangi抽出金线，分开水流。摩卡从水流裂开的缝隙中扑过去，把姐姐的沙漏抱进怀里。","sfx":"slash","fx":"metal","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"metal","camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:99","s":"moka","t":"拿到了！姐姐的，在我怀里！","x":"only"},{"id":"ep-15:100","s":"tiger","t":"那个可以拿走。本来就不在我的账簿上。是兔子的份。","x":"base"},{"id":"ep-15:101","s":"yeon","t":"那蛋我也拿走了。","x":"serious"},{"id":"ep-15:102","s":"tiger","t":"那个不行。","x":"angry","im":true,"shot":"impact","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"timeVault 배경에서 진행되는 tiger의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:103","s":"n","t":"Yeoni跳上圆台。前蹄碰到蛋的一瞬，整座圆台变成了巨大的钟面。"},{"id":"ep-15:104","s":"n","t":"钟声响了七下。指针围绕Yeoni旋转一圈，透明玻璃墙便从Yeoni四周升起。","sfx":"bell","bgm":"crisis2","fx":"vortex","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"vortex","camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:105","s":"yeon","t":"动不了了！气息……气息沉不下去！","x":"shock"},{"id":"ep-15:106","s":"sys","t":"[ 时间陷阱 · 逃脱代价 72:00:00  持有 71:53:09  不足 00:06:51 ]","fx":"script","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"script","camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 시스템 메시지"}},{"id":"ep-15:107","s":"neo","t":"Yeoni。","x":"shock"},{"id":"ep-15:108","s":"tiger","t":"我不会说对不起。账簿里没有那一栏。","x":"sad"},{"id":"ep-15:109","s":"n","t":"玻璃墙外，金库天花板的通风口里，垂下两只蓝耳朵。青兔倒挂在那里，挥了挥手。","sfx":"whoosh"},{"id":"ep-15:110","s":"rab","t":"哎呀～刚好差六分五十一秒呢？要不要青兔金融借给您？利息真的只有一点点！","x":"invite","l":{"who":"yeon","x":"shock"},"c":null,"r":{"who":"rab","x":"invite"}},{"id":"ep-15:111","s":"yeon","t":"（借了，就能出去。不借，就会停在这里。）","x":"fear","im":true,"shot":"close","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"timeVault 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}}]}
