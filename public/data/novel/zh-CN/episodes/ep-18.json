{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-18","no":"EP.18","tag":"第18话 · 淹没的书架","title":"淹没的书架","rev":2,"beats":[{"id":"ep-18:1","s":"n","t":"水转眼涨到膝盖，又涨到腰间。书本屏住呼吸，浮到水面，随波漂去。","bg":"sunkenStacks","tone":"dark","bgm":"crisis2","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"}},{"id":"ep-18:2","s":"yeon","t":"哼呀！脚，脚踩不到底了！","x":"fear","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"moka","x":"angry"}},{"id":"ep-18:3","s":"moka","t":"猪本来就能浮起来！冷静，你现在就是游泳圈！","x":"angry"},{"id":"ep-18:4","s":"n","t":"Yeoni拼命扑腾。身体虽然浮着，却不听使唤。水流不断把她拖向书架之间。"},{"id":"ep-18:5","s":"n","t":"水中央突然平静下来。一条黑色背脊，缓缓浮上水面。","sfx":"water"},{"id":"ep-18:6","s":"n","t":"是黑虎。毛尖缀满水珠，脖子上的金环，泛着湿漉漉的光。","im":true,"c":{"who":"tiger","x":"water"},"shot":"close","scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-18:7","s":"tiger","t":"要是在上面就结束，多好。偏要跟到下面来。","x":"talk"},{"id":"ep-18:8","s":"yeon","t":"把我的书还来！借阅卡上有我的名字！","x":"angry"},{"id":"ep-18:9","s":"tiger","t":"卡片湿了，字会洇开。名字也一样。","x":"base"},{"id":"ep-18:10","s":"n","t":"老虎一爪拍向水面。水像墙一样竖起，吞下整座书架。","im":true,"fx":"water","sfx":"rain","shot":"impact","skill":{"el":"water","unit":"一之灭","name":"淹没","han":"水沒"},"scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"hold","tone":"dark","ambient":null,"eventEffect":"water","camera":"focus"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-18:11","s":"yeon","t":"（撑住。木有根啊。扎下根就行。）","x":"serious","l":{"who":"yeon","x":"serious"}},{"id":"ep-18:12","s":"n","t":"绿根从Yeoni脚尖伸出，寻找地面。可是，根在水里迷了路，漂了起来。","fx":"root","sfx":"thud","scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"hold","tone":"dark","ambient":null,"eventEffect":"root","camera":"drift"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"}},{"id":"ep-18:13","s":"yeon","t":"抓不住。根找不到地面！","x":"fear"},{"id":"ep-18:14","s":"yun","t":"水太多了！水泛滥，木就会连根漂走。水多木漂！","x":"serious","r":{"who":"yun","x":"serious"}},{"id":"ep-18:15","s":"moka","t":"别给我四字成语，给救生衣啊！","x":"angry"},{"id":"ep-18:16","s":"n","t":"下一道浪，盖住了Yeoni。小小的身体，被吸进书架的缝隙里。"},{"id":"ep-18:17","s":"neo","t":"Yeoni。","x":"angry","c":{"who":"neo","x":"angry"}},{"id":"ep-18:18","s":"n","t":"Yeongnyangi毫不犹豫地跳进水里。可是，蓬松的毛一吸水，小小的身体就像石头般开始下沉。"},{"id":"ep-18:19","s":"yun","t":"猫先生！金会生水，在水里力量会流失！金生水啊！","x":"surprise"},{"id":"ep-18:20","s":"neo","t":"我知道。知道，可现在那重要吗。","x":"serious"},{"id":"ep-18:21","s":"n","t":"Yeongnyangi咬紧牙，拼命划爪。每向前一掌的距离，就会向下沉两掌。"},{"id":"ep-18:22","s":"moka","t":"真是的。全让开。这里会游泳的是谁？","x":"angry","l":{"who":"moka","x":"angry"},"c":null,"r":null},{"id":"ep-18:23","s":"n","t":"摩卡叼住汤勺，滑进水里。紫色尾巴像桨一样一摆，水流便分了开来。"},{"id":"ep-18:24","s":"moka","t":"拿水对付水獭？这可是我家前院。","x":"base"},{"id":"ep-18:25","s":"n","t":"摩卡一把抓住下沉的Yeongnyangi的斗篷领口，向上一拉。湿透的猫晃悠悠挂在水獭手里，脑袋露出水面。"},{"id":"ep-18:26","s":"neo","t":"放开斗篷。被拎着后颈拖走，有失猫的体面。","x":"angry","l":{"who":"moka","x":"angry"},"c":{"who":"neo","x":"angry"},"r":null},{"id":"ep-18:27","s":"moka","t":"水退了再找体面。现在先喘气，你这沉甸甸的铁块。","x":"angry"},{"id":"ep-18:28","s":"neo","t":"别管我，先找Yeoni。","x":"serious"},{"id":"ep-18:29","s":"moka","t":"知道，知道。先捞起你，才能捞猪。两个都沉了，我岂不是得来回两趟。","x":"base"},{"id":"ep-18:30","s":"n","t":"摩卡把Yeongnyangi推上漂浮的书架，再次扑进水中。这一次向下，朝Yeoni消失的方向。"},{"id":"ep-18:31","s":"n","t":"水下很安静。湿书像水母一样，缓缓漂浮。书页之间，隐约映出某个人的记忆。","bg":"sunkenStacks","tone":"dark","bgm":"memWater","shot":"quiet","l":null,"c":null,"r":null,"scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"}},{"id":"ep-18:32","s":"yeon","t":"（呼吸。托住呼吸。Yeongnyangi说过。别拉它，把它放到下面。）","x":"think","l":{"who":"yeon","x":"fear"}},{"id":"ep-18:33","s":"n","t":"Yeoni停止扑腾前蹄。身体放松后，水流不再推开她，而是包裹着她。"},{"id":"ep-18:34","s":"n","t":"眼前，一把旧伞翻了过来，倒着漂浮。形状与她丢在阁楼角落的伞一模一样。"},{"id":"ep-18:35","s":"n","t":"伞下粘着一页撕裂的纸。雨中的车站。一把伞下，两个人。脸被水洇开，看不清。","im":true,"shot":"close","sfx":"chime","scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-18:36","s":"yeon","t":"（这是……我？像我，可我没有这种记忆。）","x":"think"},{"id":"ep-18:37","s":"n","t":"黑色前爪抢走书页。老虎就在眼前，看着她。虽然在水下，声音却清清楚楚。","c":{"who":"tiger","x":"water"}},{"id":"ep-18:38","s":"tiger","t":"别看。那不是你该看的。","x":"angry"},{"id":"ep-18:39","s":"yeon","t":"为什么？是用我的名字借的书啊。凭什么你来决定？","x":"serious"},{"id":"ep-18:40","s":"tiger","t":"有些债，不知道更好。还不起的债，更是如此。","x":"base"},{"id":"ep-18:41","s":"yeon","t":"（这气味。卡片上的雨味。原来是你涂掉了借阅者那一栏。）","x":"think"},{"id":"ep-18:42","s":"yeon","t":"你认识我？从第一次见面起，你就一直像认识我似的。","x":"serious"},{"id":"ep-18:43","s":"tiger","t":"不认识。也没必要认识。我只收走账簿上写着的东西。","x":"talk"},{"id":"ep-18:44","s":"yeon","t":"骗人。如果只是账簿上写的，为什么刚才那么急着藏起那页纸。","x":"angry"},{"id":"ep-18:45","s":"n","t":"老虎的红眼，极短地动摇了一瞬。在水中，仿佛只有那双眼睛没有湿。","im":true,"shot":"close","scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-18:46","s":"n","t":"老虎把书页攥进前爪，揉皱了。动作却奇怪地轻。像是要藏起来，而不是扔掉。"},{"id":"ep-18:47","s":"n","t":"这时，水底的黑暗裂开。五根黑手指像海草一样冒起，缠住老虎的金环。","bgm":"crisis","sfx":"glitch","fx":"hands","scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"hold","tone":"dark","ambient":null,"eventEffect":"hands","camera":"drift"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"}},{"id":"ep-18:48","s":"heuk","t":"你在犹豫什么。让那头猪沉下去。","nm":"声音"},{"id":"ep-18:49","s":"tiger","t":"您说过，只收回书就行。那头猪不在……","x":"sad","pacing":{"pauseMs":350,"importance":"breath"}},{"id":"ep-18:50","s":"heuk","t":"这是命令。是你在账簿上留下未收的代价。","nm":"声音"},{"id":"ep-18:51","s":"n","t":"金环收紧。老虎短促地吸了一口气，抬起前爪，放到Yeoni头顶。","im":true,"shot":"impact","sfx":"heartbeat","scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-18:52","s":"yeon","t":"（被压住了。往下，往下。）","x":"fear"},{"id":"ep-18:53","s":"n","t":"可是，前爪没有马上按下去。一拍。极短的一拍里，老虎一动不动。"},{"id":"ep-18:54","s":"moka","t":"把爪子拿开，条纹家伙！","x":"angry","l":{"who":"yeon","x":"fear"},"c":{"who":"tiger","x":"angry"},"r":{"who":"moka","x":"angry"}},{"id":"ep-18:55","s":"n","t":"摩卡破水冲来。尾巴猛抽老虎腰侧，趁隙叼住Yeoni后颈，把她往上拖。"},{"id":"ep-18:56","s":"n","t":"Yeoni腕上的小龙猛地睁眼。它看了水一眼，张开大嘴。","sfx":"whoosh"},{"id":"ep-18:57","s":"n","t":"小龙开始喝水。旋涡被吸进小小的嘴巴，吞没书架的水迅速减少。","im":true,"fx":"vortex","sfx":"water","skill":{"el":"earth","unit":"辰之库","name":"水库","han":"水庫"},"scene":{"background":"sunkenStacks","backgroundMeaning":"작가 지정 배경: sunkenStacks","transition":"hold","tone":"dark","ambient":null,"eventEffect":"vortex","camera":"focus"},"a11y":{"description":"sunkenStacks 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-18:58","s":"n","t":"退了水的书库地面，像泥地一样黏湿。湿书倒得到处都是，细细地喘着气。","bg":"library2","tone":"dark","bgm":"stillLake","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library2 배경에서 진행되는 서술"}},{"id":"ep-18:59","s":"yeon","t":"它，这么个小家伙，把那些水全喝了？","x":"surprise","l":{"who":"yeon","x":"surprise"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-18:60","s":"yun","t":"辰土是水的仓库。辰，是能蓄水的土。这条龙来到女士身边，并不是偶然呢。","x":"base"},{"id":"ep-18:61","s":"moka","t":"肚子要撑破了。喂，小龙。你到底喝了几升水。","x":"base"},{"id":"ep-18:62","s":"n","t":"小龙挺着鼓鼓的肚子，重新缠回Yeoni手腕。然后嗝的一声，打出一个带小水珠的饱嗝。"},{"id":"ep-18:63","s":"yeon","t":"五星。不，给六星。虽然违反打分规则。","x":"laugh"},{"id":"ep-18:64","s":"n","t":"泥泞地面尽头，向下延伸的楼梯平台上，站着老虎。脖子上的金环，仍烧得通红。","l":{"who":"yeon","x":"serious"},"c":{"who":"tiger","x":"base"},"r":null},{"id":"ep-18:65","s":"tiger","t":"没想到你连龙都带着。下次，这也没用。","x":"base"},{"id":"ep-18:66","s":"yeon","t":"你刚才为什么停下？让你按我下去的时候，你停了一拍。","x":"serious"},{"id":"ep-18:67","s":"tiger","t":"错觉。水下，什么看起来都慢。","x":"angry"},{"id":"ep-18:68","s":"n","t":"老虎转过身。下楼前，攥着皱纸的前爪，朝胸口收了一下。像在护着什么，不让它沾湿。","im":true,"shot":"close","scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-18:69","s":"n","t":"黑色尾巴消失在阶梯下的黑暗里。只剩湿脚印，一级一级向下延伸。","sfx":"whoosh"},{"id":"ep-18:70","s":"n","t":"Yeongnyangi在水边抖了抖身体。毛紧贴着身子，看起来比平时小了一半。帽尖流苏滴着水。他咳嗽着站起来。","r":{"who":"neo","x":"calm"}},{"id":"ep-18:71","s":"yeon","t":"猫先生！还好吗？呛了很多水？","x":"happy"},{"id":"ep-18:72","s":"neo","t":"没事。多亏摩卡，捡回一命。别让我说第二遍。","x":"deadpan"},{"id":"ep-18:73","s":"moka","t":"早知道录下来。够我拿来说一辈子。","x":"base"},{"id":"ep-18:74","s":"n","t":"Yeoni看着Yeongnyangi的左前爪。烧焦的痕迹上，红锈般的斑痕正在蔓延。他迅速把爪子藏进斗篷下面。","im":true,"shot":"close","scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-18:75","s":"yeon","t":"那只爪子。刚才就不对劲。给我看。","x":"serious"},{"id":"ep-18:76","s":"neo","t":"湿了而已。铁湿了也会生锈。晾干，就会好些。","x":"calm"},{"id":"ep-18:77","s":"n","t":"闰月看了Yeongnyangi一眼，什么也没说，只把戴手套的手，深深插进口袋。","c":{"who":"yun","x":"serious"}},{"id":"ep-18:78","s":"yeon","t":"（大家都知道些什么。只有我不知道。）","x":"think"},{"id":"ep-18:79","s":"n","t":"湿书在地上艰难地呼吸。有几本书页粘在一起，连呼吸的缝隙也堵住了。","l":{"who":"yeon","x":"sad"},"c":null,"r":{"who":"moka","x":"base"}},{"id":"ep-18:80","s":"yeon","t":"再这样下去，它们全要硬成一团。可是用火，刚才已经那样了。","x":"sad"},{"id":"ep-18:81","s":"moka","t":"那是因为火太大。猪，烤面包的时候，你会把火开到最大吗？","x":"base"},{"id":"ep-18:82","s":"yeon","t":"不会。那样外面烧焦，里面还没熟。","x":"talk"},{"id":"ep-18:83","s":"moka","t":"就是这个道理。烘书也一样。火要弱，时间要长。像手心的温度就好。","x":"base"},{"id":"ep-18:84","s":"n","t":"Yeoni轻轻把前蹄放到书上。没有火焰，只缓缓送出暖意。像晒在阳光下的被子一样温暖。","im":true,"fx":"fire","sfx":"fire","shot":"close","scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"hold","tone":"dark","ambient":null,"eventEffect":"fire","camera":"focus"},"a11y":{"description":"library2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-18:85","s":"n","t":"粘住的书页，一张张松开。湿书轻轻咳了一下，重新开始呼吸。"},{"id":"ep-18:86","s":"yeon","t":"成了！在呼吸了。摩卡，你不会真是天才吧？","x":"happy"},{"id":"ep-18:87","s":"moka","t":"现在才知道？烹饪是驾驭火的学问。说唱，是驾驭呼吸的学问。","x":"base"},{"id":"ep-18:88","s":"yun","t":"食伤在帮助印星呢。用火烘干湿掉的记忆，这座图书馆建成以来，恐怕还是第一次见。","x":"laugh","c":{"who":"yun","x":"laugh"}},{"id":"ep-18:89","s":"n","t":"Yeoni低头看手里的东西。老虎揉皱带走的那页纸，有一小角挂在她蹄尖上，留了下来。","l":{"who":"yeon","x":"think"},"c":null,"r":null},{"id":"ep-18:90","s":"n","t":"指甲大小的一片纸。翻倒雨伞的一角，还有一行极小的字。一起撑吧，这把伞。"},{"id":"ep-18:91","s":"yeon","t":"（一起撑吧。是谁对谁说的。）","x":"think","sfx":"page"},{"id":"ep-18:92","s":"n","t":"水退后的墙下，露出一段阶梯。入口处，悬着湿漉漉的金字。","bgm":"glassBox","fx":"reveal","sfx":"door","scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"hold","tone":"dark","ambient":null,"eventEffect":"reveal","camera":"drift"},"a11y":{"description":"library2 배경에서 진행되는 서술"}},{"id":"ep-18:93","s":"sys","t":"[ 地下三层 · 未曾发生的事 · 阅览须谨慎 ]"},{"id":"ep-18:94","s":"yun","t":"未曾发生之事的书架。我也没下去过。听说那里放着的，是还没有任何人活过的记忆。","x":"serious","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"serious"},"r":{"who":"neo","x":"serious"}},{"id":"ep-18:95","s":"neo","t":"老虎也下去了。台阶上留着湿脚印。","x":"serious"},{"id":"ep-18:96","s":"n","t":"Yeoni折好那一角纸，收在前蹄内侧。阶梯下，隐隐传来像雨一样的声音。"},{"id":"ep-18:97","s":"yeon","t":"下去吧。我的春天，就在下面。","x":"serious"},{"id":"ep-18:98","s":"moka","t":"走吧。不过这次要是再来水，先捞猪，再捞猫。换个顺序。","x":"base"},{"id":"ep-18:99","s":"n","t":"腕上的小龙抱着鼓鼓的肚子，轻轻叫了一声。阶梯下某处，传来有人收伞的声音。","sfx":"heartbeat","shot":"quiet","scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library2 배경에서 진행되는 서술"}}]}
