{"version":2,"sourceHash":"1822d08b1cf0edd0475c92c0afa22fe040cec6e8e632f2e40817de52b7dfdd2e","locale":"zh-CN","id":"ep-12","no":"EP.12","tag":"第12话 · 正午之歌","title":"正午之歌","rev":2,"beats":[{"id":"ep-12:1","s":"n","t":"钟声即将响起，日晷舞台上。太阳被吞噬得只剩细细的一弯新月。舞台上日晷的指针，几乎已经没有影子。","bg":"siksang4","bgm":"warCommand","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"}},{"id":"ep-12:clock-1","s":"sys","t":"［ 月柱 丙 · 停止 ］ 距正午00:09:00"},{"id":"ep-12:clock-2","s":"yeon","t":"（太阳全被吃掉，我的丙也会停在这里。我的声音，这岛上的正午，都会。）","x":"think"},{"id":"ep-12:2","s":"n","t":"三人爬上后台台阶。她喉咙仍空着，背上绑着市场用过的黑板。摩卡前爪攥勺太紧，已泛白。","l":{"who":"yeon","x":"base"},"c":{"who":"neo","x":"serious"},"r":{"who":"moka","x":"base"}},{"id":"ep-12:3","s":"yeon","t":"（大家会来吗。）","x":"think"},{"id":"ep-12:4","s":"neo","t":"发了多少张传单。","x":"calm"},{"id":"ep-12:5","s":"yeon","t":"（一千张。全是画。）","x":"grin"},{"id":"ep-12:6","s":"neo","t":"一千张都手画的？前爪辛苦了。","x":"deadpan"},{"id":"ep-12:7","s":"moka","t":"你们俩都安静点。不对，其中一个本来就很安静。","x":"angry"},{"id":"ep-12:8","s":"moka","t":"猫，老实说。你觉得能成吗？","x":"base"},{"id":"ep-12:9","s":"neo","t":"不知道。","x":"calm"},{"id":"ep-12:10","s":"moka","t":"这种时候应该说能成啊！","x":"angry"},{"id":"ep-12:11","s":"neo","t":"不知道却说能成，你不会信。就是因为不知道，才要试一试。","x":"soft"},{"id":"ep-12:12","s":"yeon","t":"（Yeongnyangi刚才有点帅。）","x":"grin"},{"id":"ep-12:13","s":"n","t":"钟响了。第一声钟。整座岛随之颤抖。栖息在舞台上方各处屋顶的乌鸦，同时抬起了头。","sfx":"bell","fx":"shake","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":"shake","camera":"drift"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"}},{"id":"ep-12:14","s":"crow","t":"这里是正午禁区。","x":"base","r":{"who":"crow","x":"base"}},{"id":"ep-12:15","s":"crow","t":"上来的人，一律没收。","x":"alt"},{"id":"ep-12:16","s":"n","t":"面具上的裂缝还在。乌鸦微微低着头，不让任何东西从裂缝里露出来。"},{"id":"ep-12:17","s":"moka","t":"猫、猫。一个人都没有。","x":"angry","r":{"who":"moka","x":"base"}},{"id":"ep-12:18","s":"n","t":"摩卡说得没错。台下的广场空无一人。只有风吹过。"},{"id":"ep-12:19","s":"yeon","t":"（果然，大家害怕得不敢来。）","x":"sad"},{"id":"ep-12:20","s":"moka","t":"当然，要我也不来。回去吧。","x":"base"},{"id":"ep-12:21","s":"neo","t":"才第一声钟。别急。","x":"serious"},{"id":"ep-12:22","s":"n","t":"就在这时。嗒，嗒嗒。广场尽头的小巷里，传来敲箱子的声音。","sfx":"drum"},{"id":"ep-12:23","s":"n","t":"是鼓队长。后面跟着老奶奶，再后面是市场里的人。地下舞台的那些人和Yeoul姐也来了。大家手里都拿着一个锅盖。","sfx":"drum","im":true,"scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12:24","s":"yeon","t":"（锅盖节！）","x":"surprise"},{"id":"ep-12:25","s":"moka","t":"……还真的拿着锅盖来了。","x":"moved"},{"id":"ep-12:26","s":"neo","t":"前排几个锅盖，是你店里的。","x":"deadpan"},{"id":"ep-12:27","s":"crow","t":"解散。","x":"base","bgm":"crisis2","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"siksang4 배경에서 진행되는 crow의 대사"}},{"id":"ep-12:28","s":"n","t":"乌鸦群降落在广场上。人们一颤，却没有谁转身离开。老奶奶站到最前面，像举盾牌一样举起锅盖。"},{"id":"ep-12:29","s":"crow","t":"唱歌的人会遭到嘲笑。你们不知道这一点，就来了吗。","x":"alt"},{"id":"ep-12:30","s":"neo","t":"摩卡，现在。","x":"serious"},{"id":"ep-12:31","s":"moka","t":"现、现在？","x":"angry"},{"id":"ep-12:32","s":"neo","t":"第二声钟响之前。发出第一个声音。","x":"calm"},{"id":"ep-12:33","s":"n","t":"摩卡走到舞台中央。双腿像两根木棍。广场上一百多只眼睛，同时看向了他。"},{"id":"ep-12:34","s":"n","t":"他张开嘴。没有任何声音。他明明没有印章。声音也没有被乌鸦吃掉。","shot":"close","bgm":"none","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"}},{"id":"ep-12:35","s":"moka","t":"……不行。发不出来。","x":"angry"},{"id":"ep-12:36","s":"n","t":"Yeoni从摩卡身后走来，拿着一个锅盖，托到了摩卡面前。"},{"id":"ep-12:37","s":"yeon","t":"（不是说对着锅就唱得出来吗。）","x":"smile"},{"id":"ep-12:38","s":"n","t":"摩卡看着锅盖，看着里面映出的自己的脸，也看见了后面那张笑着的猪脸。"},{"id":"ep-12:39","s":"moka","t":"两勺酱油。","x":"base","bgm":"drumCircle","shot":"wide","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"siksang4 배경에서 진행되는 moka의 대사"}},{"id":"ep-12:40","s":"n","t":"声音很小。大概只有广场最前面的老奶奶勉强听见。"},{"id":"ep-12:41","s":"moka","t":"糖一勺。火要大，心要软。","x":"base"},{"id":"ep-12:42","s":"n","t":"鼓队长敲响箱子。咚，嗒嗒。摩卡的声音稍稍大了些。","sfx":"drum"},{"id":"ep-12:43","s":"moka","t":"烤串转呀转，烧焦之前转。奶奶说过，人生也要转。","x":"angry"},{"id":"ep-12:44","s":"n","t":"节拍乱了。最后一句，摩卡的声音吱地一下破了音。"},{"id":"ep-12:45","s":"n","t":"广场某处爆出笑声。一个人。两个人。笑声蔓延开来。","sfx":"heartbeat","im":true,"scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12:46","s":"crow","t":"看吧。是嘲笑。","x":"base"},{"id":"ep-12:47","s":"yeon","t":"（不行。摩卡要是停下来。）","x":"fear"},{"id":"ep-12:48","s":"n","t":"摩卡停了下来。脸涨得通红。然后，他也笑了。自己的破音实在太好笑，他笑了。"},{"id":"ep-12:49","s":"moka","t":"啊搞砸了！从头来，酱油两勺！","x":"angry"},{"id":"ep-12:50","s":"yeon","t":"（摩卡笑了。在舞台上。）","x":"laugh"},{"id":"ep-12:51","s":"n","t":"广场上的人跟着喊。两勺酱油！一边笑，一边敲锅盖。连节拍都没跟上。","sfx":"drum","im":true,"scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12:52","s":"neo","t":"奶奶错得最响。","x":"surprise","c":{"who":"neo","x":"surprise"}},{"id":"ep-12:53","s":"n","t":"那是一首歌。乱七八糟，毫无音准的歌。一百个人慢一拍跟唱的食谱。"},{"id":"ep-12:54","s":"crow","t":"……为什么。","x":"alt","r":{"who":"crow","x":"base"},"shot":"close","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 crow의 대사"}},{"id":"ep-12:55","s":"n","t":"乌鸦的声音在颤抖。面具又多了一道裂缝。"},{"id":"ep-12:56","s":"crow","t":"错了，为什么没人发火。","x":"base"},{"id":"ep-12:57","s":"yeon","t":"（没法说，就做给他看。）","x":"calm"},{"id":"ep-12:58","s":"n","t":"她解下黑板，拂掉盖住画中舞台的黑羽。市场画的画还在：台上小小的人，台下拍手的脸。"},{"id":"ep-12:knot-1","s":"n","t":"她向乌鸦举起黑板，前蹄发抖，板角不断歪斜。","im":true,"scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12:knot-2","s":"n","t":"乌鸦翼尖伸向黑板，半途停住。张开的羽间，怀中丝线被两处结束着，颤着sol与mi。"},{"id":"ep-12:knot-3","s":"n","t":"胸前的结是灰的，粗糙得像用自己羽毛扎起。外面的结是黑的，细影绳从那里连到日影。"},{"id":"ep-12:knot-4","s":"yeon","t":"（只断黑色。两个都切，会伤到他胸口。）","x":"think"},{"id":"ep-12:knot-5","s":"n","t":"字一写上黑板便会褪去。她只在角落划了一小笔粉笔，是最短、最准的锋刃。"},{"id":"ep-12:knot-6","s":"n","t":"她无声说「断开」，吹了口气。粉笔一划燃起，细如针飞出，只切断那黑结。","fx":"fire","sfx":"fire","im":true,"scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":"fire","camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12:59","s":"n","t":"影绳掉落。乌鸦目不离黑板，慢慢张翼，丝线从怀里滑出，回到她喉间。","fx":"thread","sfx":"sparkle","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":"thread","camera":"drift"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"}},{"id":"ep-12:knot-7","s":"sys","t":"［ 丙 · 重新启动 ］"},{"id":"ep-12:knot-8","s":"n","t":"日晷针尖停住的影子，挪了一格。"},{"id":"ep-12:60","s":"yeon","t":"哼、哼唧！","x":"excited","shot":"impact","im":true,"scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12:61","s":"n","t":"mi回来了，可该出sol的地方，喉咙像漏气气球般破音。高音的一格空着。"},{"id":"ep-12:62","s":"moka","t":"破音了！干脆拿来当副歌！","x":"base"},{"id":"ep-12:63","s":"crow","t":"你割断了。从我怀里。","x":"alt"},{"id":"ep-12:64","s":"yeon","t":"我只切了结。线是你放开的。","x":"calm"},{"id":"ep-12:65","s":"crow","t":"……第一次听到这种话。","x":"base"},{"id":"ep-12:knot-9","s":"crow","t":"sol还在这里。这个我还放不开。","x":"alt"},{"id":"ep-12:knot-10","s":"yeon","t":"那先托你保管。以后一起唱时还我。","x":"smile"},{"id":"ep-12:66","s":"n","t":"第二声钟响。像追赶重新移动的影子，阴影继续啃食太阳最后的边缘。","bgm":"sacredFlame","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"}},{"id":"ep-12:67","s":"neo","t":"把太阳推上去。用歌。","x":"serious"},{"id":"ep-12:68","s":"yeon","t":"我卡拉OK才四十七分，现在还没sol。","x":"think"},{"id":"ep-12:69","s":"neo","t":"用有的音唱。四十七分就够。","x":"soft"},{"id":"ep-12:70","s":"moka","t":"喂，我刚刚也破音了。不是只有你一个人丢脸。","x":"angry"},{"id":"ep-12:71","s":"yeon","t":"你这是安慰吗？","x":"laugh"},{"id":"ep-12:72","s":"moka","t":"是同犯之间算的账。","x":"base"},{"id":"ep-12:73","s":"n","t":"Yeoni吸了一口气，想起在审判庭里，话语化作火焰的感觉。那时是愤怒。现在不是了。"},{"id":"ep-12:74","s":"yeon","t":"变得好吃吧。","x":"calm"},{"id":"ep-12:75","s":"n","t":"Yeoni的声音化作火种。广场上散开的不再是尖锐的文字，而是一团团圆润的火光。人们的声音，一一接住那些火。","fx":"fire","sfx":"fire","skill":{"el":"fire","unit":"一之拍","name":"火种","han":"火種"},"im":true,"scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":"fire","camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12:76","s":"yeon","t":"大家一起！两勺酱油！","x":"excited"},{"id":"ep-12:77","s":"n","t":"百点火种升空。她唱到sol又破音，广场用笑声填满空格。火种触到被蚀的日缘，黑影如烫伤般缩动。"},{"id":"ep-12:78","s":"n","t":"阴影撕裂。光从裂缝中倾泻而下。日晷的指针，将一道短影准确地钉在地面上。正午到了。","fx":"burst","sfx":"whoosh","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":"burst","camera":"drift"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"}},{"id":"ep-12:79","s":"n","t":"裂开的影里涌出黑手，手指没冲人群或太阳，只指向乌鸦。","bgm":"zeroPoint","fx":"hands","sfx":"glitch","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":"hands","camera":"drift"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"}},{"id":"ep-12:80","s":"heuk","t":"你失败了，孩子。我要收回羽毛。","nm":"声音"},{"id":"ep-12:81","s":"crow","t":"请等一下。还没，我还没。","x":"alt"},{"id":"ep-12:82","s":"neo","t":"是谁。出来。","x":"angry"},{"id":"ep-12:83","s":"heuk","t":"原来是戴帽子的猫。莫急，还未轮到你。","nm":"声音"},{"id":"ep-12:84","s":"n","t":"黑手包住乌鸦，面具粉碎。后面是握麦少年的影子，胸前灰结微微闪着。","r":{"who":"mu"},"shot":"impact","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang4 배경에서 진행되는 서술"}},{"id":"ep-12:85","s":"yeon","t":"不要！","x":"fear"},{"id":"ep-12:86","s":"n","t":"Yeoni纵身扑去。前蹄碰到少年的指尖。是温暖的。下一瞬，指尖却像烟一样从蹄间溜走。"},{"id":"ep-12:87","s":"crow","t":"我也。","x":"base","r":{"who":"crow","x":"base"},"shot":"close","scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 crow의 대사"}},{"id":"ep-12:88","s":"crow","t":"我也想和大家一起唱。","x":"base","im":true,"scene":{"background":"siksang4","backgroundMeaning":"작가 지정 배경: siksang4","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang4 배경에서 진행되는 crow의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12:89","s":"n","t":"黑色的手消失在阴影里。Yeoni的前蹄中，只剩下一根灰色羽毛。"},{"id":"ep-12:90","s":"n","t":"太阳升到岛屿中央。屋顶、小巷和大海，重新有了自己的颜色。海浪哗啦一声拍来。那是久违的声音。","bg":"siksang5","bgm":"firstLight","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"siksang5","backgroundMeaning":"작가 지정 배경: siksang5","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang5 배경에서 진행되는 서술"}},{"id":"ep-12:91","s":"n","t":"广场上，人们手背上的灰色印章融化了。老奶奶张开嘴。虽然沙哑，却是清楚的话语。","l":{"who":"yeon","x":"cry"},"c":{"who":"neo","x":"calm"},"r":{"who":"moka","x":"moved"}},{"id":"ep-12:92","s":"yeon","t":"老奶奶说话了。刚才老奶奶说话了。","x":"cry"},{"id":"ep-12:93","s":"neo","t":"说了什么。","x":"soft"},{"id":"ep-12:94","s":"moka","t":"她说烤串好吃，和我奶奶做的一样。","x":"moved"},{"id":"ep-12:95","s":"yeon","t":"你看吧。我就说可以冲一冲五星。","x":"grin"},{"id":"ep-12:96","s":"moka","t":"……五星还早。四星半。","x":"moved"},{"id":"ep-12:97","s":"neo","t":"摩卡，你哭了。","x":"calm"},{"id":"ep-12:98","s":"moka","t":"是油溅进去了！溅进眼睛里了！","x":"angry"},{"id":"ep-12:99","s":"yeon","t":"现在连火都没点啊？","x":"laugh"},{"id":"ep-12:100","s":"n","t":"日晷针尖浮出丙午二字。正午的太阳与马融入胸口，头顶四片花瓣发暖，只有褪白那片仍白着。","fx":"reveal","sfx":"chime","im":true,"scene":{"background":"siksang5","backgroundMeaning":"작가 지정 배경: siksang5","transition":"hold","tone":"natural","ambient":null,"eventEffect":"reveal","camera":"focus"},"a11y":{"description":"siksang5 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12:101","s":"sys","t":"[四柱文字收回 · 月柱：丙午]"},{"id":"ep-12:102","s":"sys","t":"[ 年 □□ · 月 丙午 · 日 乙亥 · 时 □□ ]  4/8"},{"id":"ep-12:103","s":"yeon","t":"填满一半了！再找一半就好！","x":"excited"},{"id":"ep-12:104","s":"neo","t":"剩下的一半更难。","x":"calm"},{"id":"ep-12:105","s":"yeon","t":"这种话不能等会儿再说吗？现在是庆祝时间。","x":"grin"},{"id":"ep-12:106","s":"neo","t":"丙是伤官，午中丁是食神。今天两种都用了吧。","x":"lecture"},{"id":"ep-12:107","s":"yeon","t":"嗯。一个把烤串烧焦，一个把烤串烤熟。","x":"grin"},{"id":"ep-12:108","s":"neo","t":"准确。","x":"deadpan"},{"id":"ep-12:109","s":"n","t":"Yeoni摊开前蹄。灰色羽毛躺在上面，羽尖轻轻颤动。"},{"id":"ep-12:110","s":"yeon","t":"我连那孩子的名字都不知道。他说他也想一起唱。","x":"sad"},{"id":"ep-12:111","s":"moka","t":"那家伙，就是拆走奶奶店招牌的家伙。","x":"base"},{"id":"ep-12:112","s":"yeon","t":"知道。我的sol也在他那儿。","x":"sad"},{"id":"ep-12:113","s":"moka","t":"那就拿回来。借出去的勺子，一定得收回。","x":"base"},{"id":"ep-12:114","s":"neo","t":"羽毛留下了。说明还没结束。","x":"soft"},{"id":"ep-12:115","s":"n","t":"太阳开始西斜。久违地，真正落下的夕阳。河边浮起了荷叶船。那是前往下一座岛的船。","bgm":"teaKind","scene":{"background":"siksang5","backgroundMeaning":"작가 지정 배경: siksang5","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang5 배경에서 진행되는 서술"}},{"id":"ep-12:116","s":"yeon","t":"摩卡。要一起走吗？","x":"think"},{"id":"ep-12:117","s":"moka","t":"我为什么要去。","x":"angry"},{"id":"ep-12:118","s":"yeon","t":"我们是同犯啊。同犯丢下同犯，还叫什么同犯。","x":"grin"},{"id":"ep-12:119","s":"moka","t":"别偷别人的台词。","x":"angry"},{"id":"ep-12:120","s":"n","t":"摩卡用围裙裹好火种罐，也收好奶奶的汤勺。鼓队长一路跟到船前，敲着箱子。咚，嗒嗒，咚。"},{"id":"ep-12:121","s":"moka","t":"火种归我守。你只要别闯祸就行。","x":"base"},{"id":"ep-12:122","s":"yeon","t":"闯祸可是我的特长呢？","x":"excited"},{"id":"ep-12:123","s":"moka","t":"所以才叫你别闯。","x":"angry"},{"id":"ep-12:124","s":"n","t":"船晃了一下。Yeoni抓住栏杆时，灰色羽毛从前蹄间溜出，乘风飞走了。","sfx":"whoosh"},{"id":"ep-12:125","s":"yeon","t":"啊，羽毛！","x":"surprise"},{"id":"ep-12:126","s":"neo","t":"风把它带走了。羽毛认得回来的路。","x":"calm"},{"id":"ep-12:127","s":"yeon","t":"这话你从哪儿学的。","x":"sad"},{"id":"ep-12:128","s":"neo","t":"刚编的。","x":"deadpan"},{"id":"ep-12:129","s":"n","t":"Yeoni蹲到鼓队长面前。孩子手腕上，金线留下的伤痕还在。"},{"id":"ep-12:130","s":"yeon","t":"鼓队长。你的名字，我一定会找回来。","x":"calm"},{"id":"ep-12:131","s":"n","t":"孩子点头，把箱子敲得最响。"},{"id":"ep-12:132","s":"n","t":"上船前，猫与摩卡目光相遇。摩卡的视线落到猫的左前爪。","l":null,"r":null,"c":{"who":"neo","x":"serious"},"bgm":"gloom2","shot":"close","scene":{"background":"siksang5","backgroundMeaning":"작가 지정 배경: siksang5","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang5 배경에서 진행되는 서술"}},{"id":"ep-12:133","s":"moka","t":"正午结束了。","x":"base"},{"id":"ep-12:134","s":"neo","t":"到下一座岛就说。","x":"calm"},{"id":"ep-12:135","s":"moka","t":"猫是专门拖延承诺的动物吗？","x":"angry"},{"id":"ep-12:136","s":"n","t":"Yeongnyangi没有回答，走上了船。白毛下面，傷又深了一点。"},{"id":"ep-12:137","s":"n","t":"山坡上，黑虎背着落日坐着。风从广场带来一根灰羽，它用前爪按住，收进披风。","bg":"siksang3","bgm":"crisis","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-12:138","s":"n","t":"虎望向河边荷叶船，望向戴帽猫的左前爪。恰好水獭抖开围裙，那只爪便藏在阴影里。","r":{"who":"tiger","x":"base"}},{"id":"ep-12:139","s":"tiger","t":"水獭先生真敏锐呢。下一座岛，近些再见吧。","x":"base"},{"id":"ep-12:140","s":"n","t":"披风内，羽毛无风而颤，正是她喉中空掉的sol的音高。","im":true,"shot":"impact","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}}]}
