{"version":2,"sourceHash":"1822d08b1cf0edd0475c92c0afa22fe040cec6e8e632f2e40817de52b7dfdd2e","locale":"zh-CN","id":"ep-27b","no":"EP.27B","tag":"第27话 番外 · 留下的人","title":"留下的人","rev":2,"beats":[{"id":"ep-27b:1","s":"n","t":"门开启前夜，店灯全熄，只有炉子低低呼吸。","bg":"jae","tone":"dark","bgm":"destinyRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-27b:2","s":"n","t":"闰月独坐炉前，膝上黄纸与笔，腕口蔓延的洞缠着三层绷带。","l":null,"c":{"who":"yun","x":"base"},"r":null},{"id":"ep-27b:3","s":"yun","t":"来，客人。今天最后一单生意了。","x":"base"},{"id":"ep-27b:4","s":"n","t":"没有客人。自人们开始忘记他，一半的话便成自语，他已习惯。"},{"id":"ep-27b:5","s":"n","t":"笔写下小姐的日柱乙亥，周围画八颗小星，留空最后一颗。","im":true,"shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-27b:6","s":"yun","t":"符只用一次，力量才最强。想着用两次，就会沾上贪心。","x":"serious"},{"id":"ep-27b:7","s":"n","t":"他把符迎向火光，满意点头。"},{"id":"ep-27b:8","s":"yun","t":"引路符，替小姐照亮一次回来的路。没有有效期，不退款。","x":"sly"},{"id":"ep-27b:9","s":"neo","t":"在那儿干什么？","x":"serious","l":null,"c":{"who":"yun","x":"surprise"},"r":{"who":"neo","x":"serious"}},{"id":"ep-27b:10","s":"yun","t":"哎哟，猫先生。客服晚上也巡逻啊。","x":"surprise"},{"id":"ep-27b:11","s":"neo","t":"闻着味道来的。墨的味道。","x":"serious"},{"id":"ep-27b:12","s":"n","t":"Neo看他手里的符，又看下方绷带，末端渗出黑斑。"},{"id":"ep-27b:13","s":"neo","t":"那是给Yeoni的？","x":"serious"},{"id":"ep-27b:14","s":"yun","t":"明早偷偷放进面包袋。亲手给她，她会道谢，我大概会哭。","x":"base"},{"id":"ep-27b:15","s":"neo","t":"你不会哭。","x":"deadpan"},{"id":"ep-27b:16","s":"yun","t":"猫先生太不了解我。我很爱哭，只是大家把这也忘了。","x":"laugh"},{"id":"ep-27b:17","s":"n","t":"Neo不答，坐到他旁边，一起看了很久炉火。","bgm":"gloom","shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-27b:18","s":"neo","t":"你早就知道，自己过不了那扇门？","x":"serious"},{"id":"ep-27b:19","s":"yun","t":"从初到这世界就这样。没时辰回不去，三年里，倒也两次走到那门前。","x":"serious"},{"id":"ep-27b:20","s":"neo","t":"两次都……","x":"serious"},{"id":"ep-27b:21","s":"yun","t":"嗯。两次，门都没认出我。","x":"sad"},{"id":"ep-27b:r3-lost","s":"yun","t":"起初不是一个人。还有个人同日收到应用，可先消失了。","x":"sad"},{"id":"ep-27b:r5-late","s":"yun","t":"去找的时候已经迟了。我总是晚一步。","x":"base"},{"id":"ep-27b:22","s":"n","t":"炉中一根柴塌下，火星飞起。他用缠绷带的手一握，火星被掌洞吸去。","im":true,"fx":"fire","sfx":"fire","shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":"fire","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-27b:23","s":"neo","t":"那边，我守在Yeoni身边。你在这里撑住。","x":"serious"},{"id":"ep-27b:24","s":"yun","t":"当然。别的不好说，硬撑我最在行。","x":"base"},{"id":"ep-27b:25","s":"neo","t":"还有，谢谢，昨夜河上的事。","x":"soft"},{"id":"ep-27b:26","s":"yun","t":"哇，猫先生道谢了。写成符卖，一定大发。","x":"surprise"},{"id":"ep-27b:27","s":"neo","t":"收回。","x":"angry"},{"id":"ep-27b:28","s":"n","t":"第二天早上，门开了。金色的风充满了面包店的仓库。","bg":"tarotDoor","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"tarotDoor","backgroundMeaning":"작가 지정 배경: tarotDoor","transition":"crossfade","tone":"natural","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"tarotDoor 배경에서 진행되는 서술"}},{"id":"ep-27b:29","s":"n","t":"小姐跨门槛时，他轻念一个名字，那个不叫闰月的名字，盼过门的人或许捎走。","im":true,"fx":"flash","sfx":"door","shot":"close","l":null,"c":{"who":"yun","x":"sad"},"r":null,"scene":{"background":"tarotDoor","backgroundMeaning":"작가 지정 배경: tarotDoor","transition":"hold","tone":"natural","ambient":"moonlight","eventEffect":"flash","camera":"focus"},"a11y":{"description":"tarotDoor 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-27b:30","s":"n","t":"风盖过声音。小姐似回头，门却已经关了。"},{"id":"ep-27b:31","s":"yun","t":"果然还是勉强吗。","x":"sad"},{"id":"ep-27b:32","s":"n","t":"门又成旧仓库门，一切比想象快。他站了许久，抚过门柄，仍暖。","im":true,"shot":"quiet","scene":{"background":"tarotDoor","backgroundMeaning":"작가 지정 배경: tarotDoor","transition":"hold","tone":"natural","ambient":"moonlight","eventEffect":null,"camera":"focus"},"a11y":{"description":"tarotDoor 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-27b:33","s":"n","t":"中午摩卡收行李，不过一捆烤串铁签，与昨日装满的火罐。","bg":"jae","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-27b:34","s":"moka","t":"那我走了，去祭典岛。趁火未冷得上船。","x":"base","l":null,"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-27b:35","s":"yun","t":"水獭先生，多保重。说唱也少来点。","x":"base"},{"id":"ep-27b:36","s":"moka","t":"说唱不减。骗子，想寒酸就来祭典岛寒酸。","x":"angry"},{"id":"ep-27b:36b","s":"moka","t":"来了坐火边，烤串会给你。","x":"base"},{"id":"ep-27b:37","s":"yun","t":"免费？","x":"laugh"},{"id":"ep-27b:38","s":"moka","t":"赊账。","x":"angry"},{"id":"ep-27b:39","s":"n","t":"摩卡抱火罐跑向码头，一次未回头。闰月便安心挥手，直到水獭尾巴消失巷尾。"},{"id":"ep-27b:40","s":"n","t":"那夜他在角桌铺白纸，收起制符黄纸，特意拿出的白纸。","bg":"jae","tone":"dark","bgm":"memWater","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-27b:41","s":"n","t":"笔蘸墨写下一个名字，不是闰月，是三年前总写在住址下的名字。","l":null,"c":{"who":"yun","x":"serious"},"r":null},{"id":"ep-27b:42","s":"n","t":"墨未干，字边已糊，一笔笔如渗进纸里，最后一笔消失，纸又白了。","im":true,"fx":"ink","sfx":"page","shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":"ink","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-27b:43","s":"yun","t":"今天有点快啊。","x":"sad"},{"id":"ep-27b:44","s":"n","t":"再写，又消失。第三次，他搁笔，把名字念出。"},{"id":"ep-27b:45","s":"n","t":"名字一成声音，便散入面包香与炉烟，没到任何人耳边。","im":true,"shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-27b:46","s":"yun","t":"没关系。我还记得。","x":"void"},{"id":"ep-27b:47","s":"n","t":"是不是真的没关系，连他也不知道。只是三年来，他早已非常熟练地学会了说这句话。"},{"id":"ep-27b:48","s":"ln","t":"叔叔，你不睡吗？","x":"worry","l":null,"c":{"who":"yun","x":"void"},"r":{"who":"ln","x":"worry"}},{"id":"ep-27b:49","s":"yun","t":"啊，露娜小姐。醒了？","x":"surprise"},{"id":"ep-27b:50","s":"ln","t":"口渴。不过叔叔叫什么？","x":"worry"},{"id":"ep-27b:50b","s":"ln","t":"姐姐让我早上问，说新来的客人怎么一直在。","x":"worry"},{"id":"ep-27b:51","s":"n","t":"他脸僵了一瞬。新客人，这不该是昨日并肩烤面包的人说的话。"},{"id":"ep-27b:52","s":"yun","t":"闰月，像有又像没有的闰月，忘了也没关系的名字。","x":"laugh"},{"id":"ep-27b:53","s":"ln","t":"闰月叔叔，记住了！明天告诉姐姐。","x":"cheer"},{"id":"ep-27b:54","s":"yun","t":"谢谢你。那明天也请再问我一次。","x":"base"},{"id":"ep-27b:55","s":"n","t":"露娜打着哈欠回房了。闰月望着她的背影很久。明天早上，这孩子也会再问一次。叔叔叫什么名字？"},{"id":"ep-27b:56","s":"n","t":"他开门出巷，仰望天空。黑月退去处，天缝合了，却未完全合拢。","bg":"jae","tone":"desat","bgm":"starDrift","shot":"wide","l":null,"c":{"who":"yun","x":"serious"},"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-27b:57","s":"n","t":"缝中漏出不属这世界的星光，陌生星排成十二行，每行嵌一颗无名大星。","im":true,"fx":"stars","sfx":"chime","shot":"impact","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"desat","ambient":null,"eventEffect":"stars","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-27b:58","s":"yun","t":"另一片天啊。","x":"surprise"},{"id":"ep-27b:59","s":"n","t":"掌洞自行朝星光牵引。从生出那日起，洞总朝黑月所在方向倾斜。"},{"id":"ep-27b:60","s":"yun","t":"原来在那里。吃掉我时间的那家伙的主人。","x":"serious"},{"id":"ep-27b:61","s":"n","t":"他把手套重新紧紧套在绷带上。"},{"id":"ep-27b:62","s":"yun","t":"小姐用了符就会回来。她忘不了面包的味道。","x":"sly"},{"id":"ep-27b:63","s":"yun","t":"那我先去占个位子。合婚摊位，地段很重要的。","x":"base"},{"id":"ep-27b:64","s":"yun","t":"猫先生又该吃醋了。不过，这也有助于生意。","x":"laugh"},{"id":"ep-27b:65","s":"n","t":"次晨姐姐开店，角桌已没人。笔旁白纸，什么也没写。","im":true,"shot":"quiet","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-27b:66","s":"lns","t":"谁把纸落在这儿了？","x":"tired"},{"id":"ep-27b:67","s":"n","t":"露娜的姐姐把纸折好，放进抽屉，没有扔掉。为什么这么做，她自己也不知道。"}]}
