{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-49","no":"EP.49","tag":"第49话 · 世界树","title":"世界树","rev":2,"beats":[{"id":"ep-49:1","s":"n","t":"沿着树根向下走了许久。黑暗尽头立着一棵树，比五片天空加起来还要巨大。","bg":"worldTree","tone":"dark","bgm":"forestTemple","shot":"wide","l":{"who":"yeon","x":"surprise"},"c":{"who":"neo","x":"serious"},"r":{"who":"yun","x":"serious"},"sfx":"whoosh","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"worldTree 배경에서 진행되는 서술"}},{"id":"ep-49:2","s":"n","t":"枝头挂的不是叶子，而是一张张小纸。每张纸上画着八个格子，写着某个人的出生年月日时。"},{"id":"ep-49:3","s":"yun","t":"世界树，挂着所有命式的树。占卜师之间一直流传的传说……原来真的存在。","x":"serious"},{"id":"ep-49:4","s":"moka","t":"每一张纸，都是一个人？","x":"base"},{"id":"ep-49:5","s":"yun","t":"对。摩卡的、我的、Yeoni妈妈的，也都在某个地方。","x":"base"},{"id":"ep-49:6","s":"yeon","t":"（妈妈的也在。在那里的某个地方。）","x":"think"},{"id":"ep-49:7","s":"neo","t":"别找。看见了，就会想伸手碰。这里的纸，装着别人的时间。","x":"calm"},{"id":"ep-49:8","s":"yeon","t":"我不找。只要知道在那里，就够了。","x":"sad"},{"id":"ep-49:9","s":"n","t":"Yeoni仰头望去。风一吹，纸叶便沙沙作响，像几十亿个生日一齐低语。"},{"id":"ep-49:10","s":"n","t":"可沙沙声之间，还混着另一种声音。有什么东西正在啃咬。"},{"id":"ep-49:11","s":"n","t":"树干中央破了一个黑洞。种子大小的黑月正往里面钻，洞周围的年轮一圈圈染黑。","im":true,"fx":"root","sfx":"glitch","shot":"impact","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"dark","ambient":null,"eventEffect":"root","camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-49:12","s":"neo","t":"它在吃年轮。每一圈，都是某个人的一年。","x":"serious"},{"id":"ep-49:13","s":"n","t":"上方几张纸叶飘落，尚未触地，字迹就消失了。"},{"id":"ep-49:14","s":"yeon","t":"那些人会怎么样？纸上的字没了的话？","x":"fear"},{"id":"ep-49:15","s":"yun","t":"现实里，就会有人的一年消失。生日从记忆里漏掉，或名字变得模糊。像我经历过的那样。","x":"serious"},{"id":"ep-49:16","s":"pje","t":"树根在枯萎。我来浇水。","x":"serious","bg":"worldTree","tone":"dark","bgm":"warCommand","shot":"wide","l":{"who":"yeon","x":"serious"},"c":{"who":"pje","x":"serious"},"r":{"who":"moka","x":"angry"},"sfx":"drum","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"worldTree 배경에서 진행되는 pje의 대사"}},{"id":"ep-49:17","s":"n","t":"徐寒雨倒举起雨伞。雨水积在伞里，满溢而出，沿着树根渗入。枯萎的细根，一根根抬起头。","im":true,"fx":"water","sfx":"rain","shot":"impact","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"dark","ambient":null,"eventEffect":"water","camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-49:18","s":"moka","t":"我也得做点什么。放把火，烧掉它怎么样？","x":"angry"},{"id":"ep-49:19","s":"yun","t":"不行！这里是树！摩卡，你一点火，整个世界都成柴火了！","x":"surprise"},{"id":"ep-49:20","s":"moka","t":"可我只会用火啊！","x":"angry"},{"id":"ep-49:21","s":"yeon","t":"不要烧，给它温暖。我们在岛上做过的，日出的时候。","x":"grin"},{"id":"ep-49:22","s":"n","t":"摩卡闭上嘴，把双手合拢，贴在树干上。散开的不是火焰，而是暖意。树皮上的霜融化了，叶间沉睡的鸟儿醒了过来。"},{"id":"ep-49:23","s":"moka","t":"原来是这样。不烧毁，只温暖。","x":"moved"},{"id":"ep-49:24","s":"pje","t":"摩卡，刚才那一下，很帅。","x":"smile"},{"id":"ep-49:25","s":"moka","t":"别夸我，怪别扭的。你记账的时候，我还自在一点。","x":"angry"},{"id":"ep-49:26","s":"n","t":"徐寒雨笑出了声，伞尖滴落的水珠，也随着笑声晃动。"},{"id":"ep-49:27","s":"neo","t":"我把洞口扩大，把它拖出来。","x":"serious","bg":"worldTree","tone":"dark","shot":"close","sfx":"slash","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 neo의 대사"}},{"id":"ep-49:28","s":"n","t":"Neo抬起手，指尖凝出金色刀刃，却在即将碰到树干时停住。"},{"id":"ep-49:29","s":"yeon","t":"怎么停了？","x":"surprise"},{"id":"ep-49:30","s":"neo","t":"我的力量会斩断树木。要把它弄出来，就得连这根树干也劈开。","x":"serious"},{"id":"ep-49:31","s":"n","t":"Neo的手在发抖。Yeoni想起在岛上与他配合呼吸的那一天，也想起他说自己可能会伤到她的声音。"},{"id":"ep-49:32","s":"yeon","t":"那就别砍。托住它，像你托住我那样。","x":"serious"},{"id":"ep-49:33","s":"n","t":"Neo收起刀刃，用双手撑住树干。金光如支架般包住大树，裂开的年轮停了下来。","im":true,"fx":"metal","sfx":"chime","shot":"impact","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"dark","ambient":null,"eventEffect":"metal","camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-49:34","s":"neo","t":"这样拉不出那家伙，但至少能不让树倒下。","x":"calm"},{"id":"ep-49:35","s":"yeon","t":"这样就对了。你本来就是这一边的，托住别人的那一边。","x":"grin"},{"id":"ep-49:36","s":"heuk","t":"撑着吧，继续撑。终究，我还在这棵树里。","bg":"hands","tone":"dark","bgm":"crisis2","shot":"impact","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"yun","x":"serious"},"sfx":"glitch","scene":{"background":"hands","backgroundMeaning":"작가 지정 배경: hands","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"hands 배경에서 진행되는 heuk의 대사"}},{"id":"ep-49:37","s":"n","t":"一只黑手从树干里伸出。这次没有成百上千只，只有一只，却又粗又大，顺着木纹往上爬。"},{"id":"ep-49:38","s":"heuk","t":"这棵树就是我最后的身体。要赶我出去，就得杀死它；想救它，就得留下我。","im":true,"fx":"hands","sfx":"glitch","shot":"impact","scene":{"background":"hands","backgroundMeaning":"작가 지정 배경: hands","transition":"hold","tone":"dark","ambient":null,"eventEffect":"hands","camera":"focus"},"a11y":{"description":"hands 배경에서 진행되는 heuk의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-49:39","s":"moka","t":"卑鄙！躲在别人家里，还拿人家威胁！","x":"angry"},{"id":"ep-49:40","s":"heuk","t":"这就是我的活法，住进空着的地方。你们的容器都满了，如今只剩这里。"},{"id":"ep-49:41","s":"n","t":"Yeoni反复咀嚼那句话。住进空着的地方。因为空，所以什么都能进去的位置。"},{"id":"ep-49:42","s":"yeon","t":"（空着的地方，空出来的位置。在哪里听过呢。）","x":"think"},{"id":"ep-49:43","s":"n","t":"Yeoni转过头。闰月已经在摘手套了。"},{"id":"ep-49:44","s":"heuk","t":"你们也知道，不是吗？空着，就会饿。我从一开始，就只是饿了而已。"},{"id":"ep-49:45","s":"yeon","t":"我知道你饿。但不能吃别人的生日，那是属于那个人的。","x":"serious"},{"id":"ep-49:46","s":"heuk","t":"那我吃什么？我没有生日。"},{"id":"ep-49:47","s":"n","t":"Yeoni答不出来。那问题莫名在耳边停留很久。没有生日的存在。没有人呼唤的存在。"},{"id":"ep-49:48","s":"yun","t":"Yeoni刚刚想到的，我也想到了。","x":"serious","bg":"worldTree","tone":"dark","bgm":"memWater","shot":"close","l":{"who":"yeon","x":"fear"},"c":{"who":"yun","x":"serious"},"r":{"who":"neo","x":"serious"},"sfx":"heartbeat","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 yun의 대사"}},{"id":"ep-49:49","s":"yeon","t":"没有，我没想。我真的没想。","x":"fear"},{"id":"ep-49:50","s":"yun","t":"空洞会吞噬空洞。我掌心的洞，是黑月最初造出的洞。青兔吃掉我的时辰时留下的，本来就属于它。","x":"base"},{"id":"ep-49:51","s":"yun","t":"所以，物归原主。把它塞得满满的。","x":"sly"},{"id":"ep-49:52","s":"neo","t":"把它吞进去，你也会……","x":"serious"},{"id":"ep-49:53","s":"yun","t":"我知道。不知道空亡会扩大到什么程度，说不定连我也一起被掏空。","x":"base"},{"id":"ep-49:54","s":"pje","t":"那不是偿还，是直接消失。","x":"sad"},{"id":"ep-49:55","s":"pje","t":"让我来吧。我原本是黑月那边的人，应该由欠债的人来做。","x":"serious"},{"id":"ep-49:56","s":"yun","t":"徐寒雨，你的手是水。水填不了洞，只会流进去。这件事，得用我的手。","x":"base"},{"id":"ep-49:57","s":"yun","t":"真没想到能听见你说这种话。长进不少啊，我们的记账专家。","x":"laugh"},{"id":"ep-49:58","s":"n","t":"闰月笑着把手掌贴在树干的黑洞上。没有手套，赤裸的手。蔓延至手腕的黑圈，与洞口接在了一起。"},{"id":"ep-49:59","s":"n","t":"响起吸气般的声音，深而悠长。黑手从树干上被撕下，拖进闰月的掌心。","im":true,"fx":"suck","sfx":"whoosh","shot":"impact","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"dark","ambient":null,"eventEffect":"suck","camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-49:60","s":"heuk","t":"放开！这是我的洞，是我凿开的！"},{"id":"ep-49:61","s":"yun","t":"正是。你凿的洞，就该由你来填。","x":"pain"},{"id":"ep-49:62","s":"n","t":"闰月脸色惨白。黑圈越过手腕，蔓延到手肘，他的轮廓开始一点点模糊。","bg":"worldTree","tone":"dark","shot":"close","sfx":"none","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 서술"}},{"id":"ep-49:63","s":"moka","t":"咦，那个，那个人……是谁来着？名字……","x":"base"},{"id":"ep-49:64","s":"n","t":"摩卡话说到一半停住。嘴唇在动，却叫不出名字，连自己都吓了一跳。"},{"id":"ep-49:65","s":"yeon","t":"闰月！","x":"cry","im":true,"shot":"impact","sfx":"heartbeat","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-49:66","s":"n","t":"Yeoni大喊。名字悬在空中，闰月的轮廓随着那声呼唤，稍稍清晰了一点。"},{"id":"ep-49:67","s":"yun","t":"那是假名啊。闰月，明明存在却又不存在的月份，所以不太留得住。","x":"pain"},{"id":"ep-49:68","s":"yeon","t":"假名也是我们叫过的名字！Neo不也是绰号，他都回来了！","x":"angry"},{"id":"ep-49:69","s":"pje","t":"闰月。闰月。","x":"resolve"},{"id":"ep-49:70","s":"moka","t":"闰月哥！你可以问我出生年月日！全都告诉你！","x":"moved"},{"id":"ep-49:71","s":"n","t":"名字每被叫一遍，闰月的轮廓便回来一层。四个人的声音，把他牢牢留在地面上。"},{"id":"ep-49:72","s":"neo","t":"闰月，我还没说完让你把手从Yeoni肩上拿开的事。回来。","x":"serious"},{"id":"ep-49:73","s":"yun","t":"啊，听见这话，我倒想回去了。回去让你吃醋。","x":"laugh"},{"id":"ep-49:74","s":"n","t":"最后一缕也被吸了进去。闰月掌上的黑圈收拢，越来越小，越来越小，终于缩成一个点。","bg":"worldTree","bgm":"templeDawn","shot":"wide","l":{"who":"yeon","x":"happy"},"c":{"who":"yun","x":"base"},"r":{"who":"pje","x":"smile"},"sfx":"bell","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"worldTree 배경에서 진행되는 서술"}},{"id":"ep-49:75","s":"n","t":"然后，连那一点也消失了。剩下普通的手掌，有掌纹，有茧，微微发抖的手。","im":true,"fx":"stars","sfx":"sparkle","shot":"impact","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"natural","ambient":null,"eventEffect":"stars","camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-49:76","s":"n","t":"再也听不见黑月的声音，最后只留下一声极轻的叹息。没人知道，那是吃饱后的叹息，还是饥饿的叹息。"},{"id":"ep-49:77","s":"yeon","t":"（再见。下次，生在一个有你生日的地方吧。）","x":"think"},{"id":"ep-49:78","s":"yun","t":"闭合了。空亡，闭合了。空的吃掉空的，反而被填满了。","x":"surprise"},{"id":"ep-49:79","s":"n","t":"闰月反复握拳，又张开，好像连握起手的感觉都很陌生。"},{"id":"ep-49:80","s":"n","t":"树干上的洞也愈合了。变黑的年轮恢复褐色，落下的纸叶乘着风，重新挂回枝头。"},{"id":"ep-49:81","s":"moka","t":"闰月哥，我想起你的名字了。刚才怎么想不起来，对不起。","x":"moved"},{"id":"ep-49:82","s":"yun","t":"没关系，我自己也不知道自己的名字呢。","x":"laugh"},{"id":"ep-49:83","s":"n","t":"就在这时，闰月手腕上浮起一点光。那是时钟的指针，五点二十分，指针稳稳停在那里。"},{"id":"ep-49:84","s":"sys","t":"[ 卯时 · 05:20 · 已归还 ]"},{"id":"ep-49:85","s":"yun","t":"是我的时辰。真正属于我的时辰，凌晨五点二十分，日出前。","x":"void"},{"id":"ep-49:86","s":"n","t":"闰月很久没有说话，随后用手背揉了揉眼睛。谁也没有取笑他。"},{"id":"ep-49:87","s":"yeon","t":"那名字呢？真正的名字。","x":"serious"},{"id":"ep-49:88","s":"yun","t":"那个保密。还没回家呢，到家门口再说。","x":"sly"},{"id":"ep-49:89","s":"neo","t":"到最后还这么油嘴滑舌。","x":"serious"},{"id":"ep-49:90","s":"yun","t":"猫先生才是，刚才叫我名字时，声音都在抖。","x":"laugh"},{"id":"ep-49:91","s":"neo","t":"没抖。","x":"serious"},{"id":"ep-49:92","s":"yeon","t":"抖了，我听见了。加一颗星。","x":"grin"},{"id":"ep-49:93","s":"n","t":"树顶敞开了。一张卡从最高的枝梢缓缓落下，什么都没画，是张空白卡。","bg":"worldTree","shot":"quiet","sfx":"chime","l":{"who":"yeon","x":"think"},"c":{"who":"neo","x":"calm"},"r":{"who":"pje","x":"base"},"scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"worldTree 배경에서 진행되는 서술"}},{"id":"ep-49:94","s":"n","t":"卡的上方只有一个数字，23。名字栏空着，没有图画，也没有文字。"},{"id":"ep-49:95","s":"neo","t":"第二十三张卡，还没有任何人写下的命运。","x":"calm"},{"id":"ep-49:96","s":"yeon","t":"空着的话，不会又有谁来吃吧？","x":"think"},{"id":"ep-49:97","s":"neo","t":"所以得有人写。这次不是吞食的家伙，而是执笔的人。","x":"serious"},{"id":"ep-49:98","s":"n","t":"这时，Yeoni口袋里的手机响了。来到这个世界后，它一次也没响过。"},{"id":"ep-49:99","s":"sys","t":"[ 客服中心：宇宙 · 等待接通：1人 ]","im":true,"sfx":"chime","shot":"impact","scene":{"background":"worldTree","backgroundMeaning":"작가 지정 배경: worldTree","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"worldTree 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-49:100","s":"yeon","t":"一个人在等，不是九千九百九十九个。","x":"surprise"},{"id":"ep-49:101","s":"neo","t":"接吧。这次会有人接的。","x":"serious"},{"id":"ep-49:102","s":"n","t":"Yeoni的拇指停在通话键上。大家都望着她，摩卡、闰月、徐寒雨、Neo，一个也没少。"},{"id":"ep-49:103","s":"yeon","t":"我准备好写评价了，五星的。","x":"grin"}]}
