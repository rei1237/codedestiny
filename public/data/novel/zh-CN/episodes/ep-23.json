{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-23","no":"EP.23","tag":"第23话 · 伤官见官","title":"伤官见官","rev":2,"beats":[{"id":"ep-23:1","s":"n","t":"黑手从天空的裂缝中倾泻而下。圆形玻璃窗碎了，手像雨一样，落进阅览室。","bg":"handsRush","tone":"dark","bgm":"warCommand","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"}},{"id":"ep-23:2","s":"moka","t":"还真比雨更糟！骗子，这时候倒是骗一个看看啊！","x":"angry","l":{"who":"yeon","x":"fear"},"c":{"who":"moka","x":"angry"},"r":{"who":"yun","x":"serious"}},{"id":"ep-23:3","s":"yun","t":"水獭先生，女士左边交给您。右边我来吃。","x":"serious"},{"id":"ep-23:4","s":"n","t":"闰月摘下手套。掌心的洞旋转起来，吸走最近的三只黑手。洞口又扩大了一个指甲的宽度。"},{"id":"ep-23:5","s":"yeon","t":"闰月，手！洞在变大！","x":"fear"},{"id":"ep-23:6","s":"yun","t":"现在，比起洞变大，我更怕女士变小。","x":"pain"},{"id":"ep-23:7","s":"n","t":"摩卡像扔球一样掷出火种。一只黑手被烫到，猛地缩回。可是那些手，全都越过了Yeoni。","sfx":"fire"},{"id":"ep-23:8","s":"moka","t":"咦？它们没朝猪来？","x":"base"},{"id":"ep-23:9","s":"yeon","t":"不是我，那是谁。","x":"surprise"},{"id":"ep-23:10","s":"n","t":"Yeoni伸出藤蔓，缠住最近的一只手。藤蔓刚碰到黑手，就枯成黑色。不是抓住了对方，而是在被吃掉。"},{"id":"ep-23:11","s":"yeon","t":"它们吃我的藤蔓。怎么这么饿。","x":"fear"},{"id":"ep-23:12","s":"yun","t":"这些手，已经饿很久了。而今天，似乎看见了比女士更美味的东西。","x":"serious"},{"id":"ep-23:13","s":"n","t":"黑手只涌向一个方向。窗边的白猫。","im":true,"shot":"impact","sfx":"whoosh","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:14","s":"neo","t":"Yeoni，趴下！","x":"serious","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"neo","x":"serious"}},{"id":"ep-23:15","s":"n","t":"Yeongnyangi浑身的毛竖起。金色刀锋从前爪迸出，一下斩断好几只黑手。但断掉的手分成两半，再次扑来。","fx":"claw","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":"claw","camera":"drift"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"}},{"id":"ep-23:16","s":"heuk","t":"猫啊，你是一把刀。刀，就该插进刀鞘。","nm":"声音"},{"id":"ep-23:17","s":"n","t":"一只黑手抓住Yeongnyangi生锈的左爪。他的膝盖猛地弯了下去。"},{"id":"ep-23:18","s":"neo","t":"放开。这不是你的。","x":"angry"},{"id":"ep-23:19","s":"n","t":"手没有松开。反而从指缝伸出黑线，一圈圈缠上Yeongnyangi的腿。白毛尖端，变成灰色。"},{"id":"ep-23:20","s":"yeon","t":"把那只爪子放开！","x":"angry"},{"id":"ep-23:21","s":"n","t":"Yeoni胸口深处，有什么爆开了。像正午烈日的火焰，从前蹄倾泻而出。面板上的丙字，烧得通红。","im":true,"fx":"fire","sfx":"fire","shot":"impact","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":"fire","camera":"focus"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:22","s":"n","t":"火烧掉了黑手，却没有停。烧过手的火，继续扑向那只手抓着的白色前爪。"},{"id":"ep-23:23","s":"neo","t":"呃。","x":"shock"},{"id":"ep-23:24","s":"n","t":"黑手如尖叫般散去。天空的裂缝缓缓闭合。阅览室里，只剩焦味和金属熔化的气味。","bgm":"none","shot":"close","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"}},{"id":"ep-23:25","s":"moka","t":"结束了？结束了吧？猪，刚才那是你？比庆典岛的太阳还热。","x":"base","l":{"who":"yeon","x":"fear"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"pain"}},{"id":"ep-23:26","s":"yun","t":"女士，把火调小一点。书都在冒汗了。","x":"pain"},{"id":"ep-23:27","s":"n","t":"Yeoni低头看前蹄。蹄尖还噼啪跳着火星。她赶紧甩了甩前蹄。"},{"id":"ep-23:28","s":"yeon","t":"我从没做到这种程度。只是，它抓住了Yeongnyangi的爪子。","x":"surprise"},{"id":"ep-23:29","s":"n","t":"这时，窗边传来低低的呻吟。"},{"id":"ep-23:30","s":"n","t":"Yeongnyangi倒在地上。遮住左爪的斗篷下摆，全烧掉了。一直藏在下面的东西，彻底露了出来。","im":true,"shot":"close","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:31","s":"yeon","t":"Yeongnyangi。","x":"fear"},{"id":"ep-23:32","s":"n","t":"焦痕从前爪一路蔓延到肩膀，上面覆盖着红锈。那不是一两天形成的伤。","bg":"library","tone":"dark","bgm":"gloom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-23:33","s":"yeon","t":"从什么时候开始的。这不是今天才有的。","x":"cry","l":{"who":"yeon","x":"cry"},"c":null,"r":{"who":"neo","x":"sad"}},{"id":"ep-23:34","s":"neo","t":"没什么。","x":"sad"},{"id":"ep-23:35","s":"yeon","t":"没什么，会一路到肩膀？","x":"cry"},{"id":"ep-23:36","s":"n","t":"还没等回答，Yeoni的前蹄已经动了。她抽出细细的藤蔓，缠住Yeongnyangi前爪。每缠一圈，藤尖碰到焦痕，就碎成灰。"},{"id":"ep-23:37","s":"neo","t":"停下。现在没有用。","x":"serious"},{"id":"ep-23:38","s":"yeon","t":"别动。有没有用，我来决定。","x":"angry"},{"id":"ep-23:39","s":"yun","t":"女士，坐下吧。我来告诉您。","x":"serious","c":{"who":"yun","x":"serious"}},{"id":"ep-23:40","s":"yeon","t":"闰月也知道？","x":"angry"},{"id":"ep-23:41","s":"yun","t":"知道。从猫先生教您呼吸的那天开始。","x":"sad"},{"id":"ep-23:42","s":"yeon","t":"摩卡，你也知道？","x":"angry","c":{"who":"moka","x":"angry"}},{"id":"ep-23:43","s":"moka","t":"我从庆典岛就知道。审判庭里，你第一次大喊的那天，猫的前爪冒烟了。","x":"angry"},{"id":"ep-23:44","s":"moka","t":"我一问，猫就说了。敢告诉猪，就往烤串里下毒。","x":"angry"},{"id":"ep-23:45","s":"neo","t":"我没那么说。我说，把烤串全吃掉。","x":"deadpan"},{"id":"ep-23:46","s":"moka","t":"那更残忍啊！","x":"angry"},{"id":"ep-23:47","s":"yeon","t":"从那时起？那么多天，你们都知道，只有我不知道？","x":"cry"},{"id":"ep-23:48","s":"n","t":"没人回答。摩卡垂下尾巴，闰月把戴手套的手放进口袋。沉默，就是回答。"},{"id":"ep-23:49","s":"yeon","t":"只有我不知道。只有我，兴高采烈地到处放火。","x":"sad"},{"id":"ep-23:50","s":"yun","t":"女士的月干是丙火，是伤官。让人说出想说的话，打破框架的火。","x":"serious","c":{"who":"yun","x":"serious"}},{"id":"ep-23:51","s":"yun","t":"而猫先生，是庚金，是正官。是框架，是规则，是名牌。","x":"serious"},{"id":"ep-23:52","s":"yun","t":"伤官见到正官，正官就会受伤。这叫伤官见官。女士的火越大，猫先生就越会熔化。","x":"sad"},{"id":"ep-23:53","s":"sys","t":"[ 丙 伤官 → 庚 正官 · 伤官见官 ]","im":true,"fx":"script","sfx":"page","shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"dark","ambient":null,"eventEffect":"script","camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:54","s":"n","t":"面板上的丙字，仍烧得通红。热气触及的庚字边角，一处处蔓延着黑色焦痕。"},{"id":"ep-23:55","s":"yeon","t":"所以，是我造成的？审判庭，正午舞台，还有现在？","x":"cry"},{"id":"ep-23:56","s":"neo","t":"不是你的错。这个命盘里，就是会这样相撞。","x":"serious"},{"id":"ep-23:57","s":"yeon","t":"既然是这样的命盘，就该告诉我啊！","x":"angry"},{"id":"ep-23:58","s":"yeon","t":"为什么不说？","x":"angry","bgm":"gloom2","shot":"wide","l":{"who":"yeon","x":"angry"},"c":null,"r":{"who":"neo","x":"serious"},"scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"library 배경에서 진행되는 yeon의 대사"}},{"id":"ep-23:59","s":"neo","t":"因为说了，你就会把火熄掉。","x":"serious"},{"id":"ep-23:60","s":"yeon","t":"那当然！你都被我的火伤成这样了！","x":"angry"},{"id":"ep-23:61","s":"neo","t":"所以我才不说。熄了火，你就不是你了。唱不了歌的庆典，没味道的烤串。你也看见过。","x":"angry"},{"id":"ep-23:62","s":"yeon","t":"那你呢？你就可以熔化吗？","x":"cry"},{"id":"ep-23:63","s":"neo","t":"我就是为此，才在你身边。","x":"serious"},{"id":"ep-23:64","s":"yeon","t":"别说这种话。说这种话，一点也不帅。","x":"angry","im":true,"shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:65","s":"n","t":"Yeongnyangi闭上嘴。Yeoni用前蹄揉眼睛。泪混着焦灰，洇成一片黑。"},{"id":"ep-23:66","s":"yeon","t":"你总说以后。说结束了就告诉我。这就叫结束？非要锈到肩膀，才算结束吗？","x":"angry"},{"id":"ep-23:67","s":"neo","t":"对不起。","x":"sad"},{"id":"ep-23:68","s":"yeon","t":"我想听的不是对不起！","x":"angry"},{"id":"ep-23:69","s":"neo","t":"那你想听什么。","x":"serious"},{"id":"ep-23:70","s":"yeon","t":"不知道！就，就疼的话，说疼。那有这么难吗？","x":"cry"},{"id":"ep-23:71","s":"n","t":"阅览室静下来。摩卡端着烤串盘僵住了，闰月正重新戴手套，手也停在那里。","sfx":"heartbeat"},{"id":"ep-23:72","s":"neo","t":"疼。","x":"soft"},{"id":"ep-23:73","s":"yeon","t":"嗯？","x":"surprise"},{"id":"ep-23:74","s":"neo","t":"疼。每次你点起火，都疼。可是你点不出火，那更疼。","x":"soft"},{"id":"ep-23:75","s":"n","t":"Yeoni一句话也说不出。Yeongnyangi缓缓撑起身体。生锈的前爪，拖过地面。"},{"id":"ep-23:76","s":"neo","t":"我在旁边，你就会变小。你成长，我就会熔化。这就是我们的命盘。","x":"serious"},{"id":"ep-23:77","s":"yeon","t":"那怎么办。我们当中，必须有一个一直痛吗？","x":"angry"},{"id":"ep-23:78","s":"neo","t":"不用。有一个让开，就行。","x":"serious"},{"id":"ep-23:79","s":"yeon","t":"Yeongnyangi。","x":"fear"},{"id":"ep-23:80","s":"n","t":"那一刻，话比念头更快，从Yeoni嘴里冲出。像火，根本来不及拦。","im":true,"shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:81","s":"yeon","t":"那就让开！别受着伤还待在我旁边！这种事，我一点也不感激！","x":"angry"},{"id":"ep-23:82","s":"n","t":"话刚说完，Yeoni就后悔了。可是话已经落在阅览室地面，滚了出去。","bgm":"none","shot":"quiet","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-23:83","s":"neo","t":"是啊。那才是对的。","x":"sad","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"neo","x":"sad"}},{"id":"ep-23:84","s":"yeon","t":"不，不是那个意思。","x":"fear"},{"id":"ep-23:85","s":"n","t":"Yeongnyangi转过身。白色尾巴消失在门缝里。门轻轻关上。这一次，连响声也没有。","bg":"library","tone":"desat","bgm":"rainWindow","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-23:86","s":"sys","t":"[ 年 壬午 · 月 丙午 · 日 乙亥 · 时 □辰 ]  7/8","im":true,"fx":"metal","sfx":"bell","shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"desat","ambient":null,"eventEffect":"metal","camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:87","s":"n","t":"面板上的庚字熄灭。格子又空了。缠在Yeoni前蹄上的藤蔓，无力地垂到地面。"},{"id":"ep-23:88","s":"yeon","t":"我叫他让开。他真的走了。","x":"cry","l":{"who":"yeon","x":"cry"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"sad"}},{"id":"ep-23:89","s":"moka","t":"喂，猪。","x":"base"},{"id":"ep-23:90","s":"yeon","t":"干吗。","x":"cry"},{"id":"ep-23:91","s":"moka","t":"别哭，去抓住他。你本来就是这样啊。先说出口，再拔腿跑的人。","x":"angry"},{"id":"ep-23:92","s":"yun","t":"按猫先生的脚程，现在应该到阶梯尽头了。生锈的爪子，走不快。","x":"sad"},{"id":"ep-23:93","s":"yeon","t":"抓住他，又说什么。我待在旁边，他还是会熔化。","x":"cry"},{"id":"ep-23:94","s":"yun","t":"那之后一起解。命盘是题目，不是判决。我还没见过，找不到解法的题。","x":"serious"},{"id":"ep-23:95","s":"moka","t":"第一次信骗子的话。快去！","x":"angry"},{"id":"ep-23:96","s":"n","t":"Yeoni用袖子抹掉泪，猛地推开门，跑出去。"},{"id":"ep-23:97","s":"n","t":"飞奔下楼时，一幕幕画面掠过脑海。收到一星，也只是点点头的猫。审判庭里，挡在前面的背影。","im":true,"shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:98","s":"n","t":"正午舞台结束后，独自走向河边的背影。落水后，走路姿势奇怪的左爪。全看见了，却全都装作没看见。"},{"id":"ep-23:99","s":"yeon","t":"（我也知道。不是大家没说，而是我没有问。）","x":"think"},{"id":"ep-23:100","s":"n","t":"图书馆外，是河。流淌着星光的河面上，一只空渡船轻轻摇晃。","bg":"river","tone":"dark","bgm":"memWater","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"crossfade","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"river 배경에서 진행되는 서술"}},{"id":"ep-23:101","s":"yeon","t":"Yeongnyangi！Yeongnyangi，我说错话了！回来！","x":"cry","l":{"who":"yeon","x":"cry"},"c":null,"r":null},{"id":"ep-23:102","s":"n","t":"声音落进河水，随流而去。渡船晃了一下。Yeoni跑过去，探头看里面。空的。"},{"id":"ep-23:103","s":"yeon","t":"哪有叫你让开，就真的让开的猫。平时明明一句话也不听我的。","x":"cry"},{"id":"ep-23:104","s":"n","t":"船底落着一根白毛。Yeoni把它缠在前蹄上。还暖着。"},{"id":"ep-23:105","s":"n","t":"没有回应。河边石头上，一点点红锈斑，组成脚印，沿着下游延伸，在雾里断了。"},{"id":"ep-23:106","s":"n","t":"雾很浓。Yeoni举起前蹄。只要点一点火，似乎就能看清路。"},{"id":"ep-23:107","s":"n","t":"蹄尖凝出火种。Yeoni看了很久，然后攥紧前蹄，把它熄灭。","im":true,"shot":"close","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:108","s":"yeon","t":"点起这团火，你又会在某处疼起来吧。","x":"cry"},{"id":"ep-23:109","s":"n","t":"Yeoni没点火，走进雾里。她用前蹄一处处摸着锈迹，沿路追去。冰冷的石头，让前蹄不断打滑。"},{"id":"ep-23:110","s":"n","t":"每次跌倒，她都先检查缠在前蹄上的白毛。而那根毛，一次比一次凉。"},{"id":"ep-23:111","s":"yeon","t":"我收回那一星。给你五星。所以，回答我一下。","x":"sad"},{"id":"ep-23:112","s":"n","t":"浓雾那头，只有水声回应。脚印就在这里结束了。"},{"id":"ep-23:113","s":"n","t":"断掉的脚印上，一道黑影缓缓爬过。是人手形状的影子。","im":true,"fx":"hands","sfx":"glitch","shot":"close","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":"hands","camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-23:114","s":"yeon","t":"不要。","x":"fear"},{"id":"ep-23:115","s":"n","t":"影子滑进雾里，消失了。连同锈的气味。"}]}
