{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-19","no":"EP.19","tag":"第19话 · 第一个春天","title":"第一个春天","rev":2,"beats":[{"id":"ep-19:1","s":"n","t":"阶梯比想象中长。每下一级，雨声就近一点。明明在地下，却像下着雨。","bg":"library2","tone":"dark","bgm":"glassBox","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library2","backgroundMeaning":"작가 지정 배경: library2","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library2 배경에서 진행되는 서술"}},{"id":"ep-19:2","s":"moka","t":"地下还下雨。这图书馆的排水是谁做的。一星。","x":"base","l":{"who":"yeon","x":"think"},"c":null,"r":{"who":"moka","x":"base"}},{"id":"ep-19:3","s":"yeon","t":"（打分是我的工作啊。摩卡正在侵占我的地盘。）","x":"think"},{"id":"ep-19:4","s":"n","t":"阶梯尽头的门自行打开。里面的空气冰凉而清澈，仿佛还从未有人呼吸过。","sfx":"door"},{"id":"ep-19:5","s":"n","t":"像玻璃瓶般透明的书，被红线吊着，悬在半空。地面浮起金色规则。","bg":"memoryVault","shot":"wide","fx":"script","sfx":"page","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":"script","camera":"drift"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"}},{"id":"ep-19:6","s":"sys","t":"[ 地下三层 · 未曾发生的事 · 翻开，便会离那件事近一点 ]"},{"id":"ep-19:7","s":"yeon","t":"还没发生的事，也有书？那所有未来，都在这里吗？","x":"surprise","l":{"who":"yeon","x":"surprise"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-19:8","s":"yun","t":"与其说未来，不如说，是原本可能发生的事。可能成真，也可能永远不会。","x":"base"},{"id":"ep-19:9","s":"moka","t":"等一下。喂，看这个。《摩卡，地下舞台个人演出座无虚席》。这个能打开吗？","x":"base"},{"id":"ep-19:10","s":"yun","t":"说是翻开就会近一点。可没说不用练习。","x":"sly"},{"id":"ep-19:11","s":"moka","t":"那有什么意义！满座近了，我的实力却没变，那不就是丢脸越来越近！","x":"angry"},{"id":"ep-19:12","s":"yeon","t":"摩卡真的不练说唱啊。","x":"laugh"},{"id":"ep-19:13","s":"moka","t":"有练！趁你睡觉的时候练的！","x":"angry"},{"id":"ep-19:14","s":"neo","t":"原来每晚隔墙听到的节拍，就是那个。","x":"deadpan"},{"id":"ep-19:15","s":"moka","t":"不是老鼠，是口技打拍！猫耳朵是摆设吗？","x":"angry"},{"id":"ep-19:16","s":"n","t":"腕上的小龙朝雨声方向伸长了脖子。刚才喝下的水，还在肚子里晃荡。","sfx":"water"},{"id":"ep-19:17","s":"yeon","t":"你还想喝？不行。肚子会撑破。这次真给你一星。","x":"talk"},{"id":"ep-19:18","s":"n","t":"闰月笑着走向旁边的书架。指尖碰到一本薄书，停住了。"},{"id":"ep-19:19","s":"sys","t":"[《闰月，回家》· 0页 ]","im":true,"shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-19:20","s":"yeon","t":"叔叔。是零页。","x":"soft"},{"id":"ep-19:21","s":"moka","t":"骗子，你真没打算回去？怎么一行都没有。","x":"base"},{"id":"ep-19:22","s":"yun","t":"还有封面呢。那就够了。有封面，就说明还没结束。","x":"base"},{"id":"ep-19:23","s":"n","t":"他没有碰书，收回了手。手套里的洞，发出一丝细微的风声。"},{"id":"ep-19:24","s":"yeon","t":"那我每天都叫你。闰月，闰月。这样，楼上叔叔的书，每天也会厚一页啊。","x":"serious"},{"id":"ep-19:25","s":"yun","t":"一天一页，十年就是三千页。那书太重，怕是带不动了。","x":"laugh"},{"id":"ep-19:26","s":"moka","t":"别担心。我帮你搬。搬运费另算。","x":"base"},{"id":"ep-19:27","s":"n","t":"闰月笑了。这次的笑里，没有一丝玩笑。","im":true,"shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-19:28","s":"n","t":"这时，Yeongnyangi独自走在前面。即使遇上岔路，也不犹豫。像是走过无数次。","l":{"who":"yeon","x":"think"},"c":null,"r":{"who":"neo","x":"calm"}},{"id":"ep-19:29","s":"yeon","t":"猫先生，你认识路？不是第一次来吗？","x":"talk"},{"id":"ep-19:30","s":"neo","t":"跟着气味走的。湿脚印，也在这边。","x":"calm"},{"id":"ep-19:31","s":"yeon","t":"（脚印刚才在阶梯上，就断了啊。）","x":"think"},{"id":"ep-19:32","s":"n","t":"跟在Yeongnyangi后面的Yeoni，注意到一本书。浅粉色封面上的标题，有一半已经洇开。"},{"id":"ep-19:33","s":"sys","t":"[《花猪 · 与白色□□在樱花河畔》· 0页 ]","im":true,"shot":"close","sfx":"chime","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-19:34","s":"yeon","t":"白色什么？和白色什么？怎么偏偏那个地方糊了！","x":"surprise"},{"id":"ep-19:35","s":"moka","t":"白米糕。是你的话，一定是白米糕。在樱花河畔吃米糕的书。","x":"base"},{"id":"ep-19:36","s":"yeon","t":"别连零页的书里，都把我写成吃货！","x":"angry"},{"id":"ep-19:37","s":"n","t":"前面的Yeongnyangi，尾巴停了极短的一瞬，又重新摇摆。他没有回头。"},{"id":"ep-19:38","s":"n","t":"最深处，一本书放在小台座上。与其他书不同，它并不透明，而是裹着黑布，缠着黑色锁链。","bgm":"starsName","shot":"wide","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"}},{"id":"ep-19:39","s":"n","t":"封面印着白字。花猪 · 第一个春天。","l":{"who":"yeon","x":"surprise"},"c":null,"r":null},{"id":"ep-19:40","s":"yeon","t":"找到了。原来在这里。","x":"surprise"},{"id":"ep-19:41","s":"yun","t":"等一下。明明说借出去了，为什么会在这里？而且，这里是未曾发生之事的书架。","x":"serious","c":{"who":"yun","x":"serious"}},{"id":"ep-19:42","s":"yeon","t":"那是什么意思？","x":"talk"},{"id":"ep-19:43","s":"yun","t":"说明这个春天，曾在某处发生，如今却变成了未曾发生的事。有人把这本书藏到了这里。","x":"serious"},{"id":"ep-19:44","s":"n","t":"锁链中央，挂着一把锁。锁上刻着两个字。壬午。"},{"id":"ep-19:45","s":"n","t":"Yeoni胸口咚地一震。命盘上年柱的空格，仿佛被那两个字牵引着。","im":true,"fx":"thread","sfx":"heartbeat","shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"thread","camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-19:46","s":"sys","t":"[ 年 □□ · 月 丙午 · 日 乙亥 · 时 □辰 ]  5/8——感应：壬午"},{"id":"ep-19:47","s":"yeon","t":"是我的年柱。这本书里，有我的字。","x":"serious"},{"id":"ep-19:48","s":"n","t":"Yeoni把前蹄放到锁上。那一刻，地上的金字变成了红色。"},{"id":"ep-19:49","s":"sys","t":"[ 无法阅览 · 花猪已经读过一本（1/1）]","sfx":"bell"},{"id":"ep-19:50","s":"yeon","t":"啊。摇篮曲。","x":"disappoint","l":{"who":"yeon","x":"disappoint"},"c":null,"r":{"who":"moka","x":"base"}},{"id":"ep-19:51","s":"moka","t":"那我帮你开。让一下。","x":"base"},{"id":"ep-19:52","s":"n","t":"摩卡一抓住锁，锁链就像蛇一样扭动，把他的前爪弹开。","sfx":"thud"},{"id":"ep-19:53","s":"sys","t":"[ 无法阅览 · 仅限所有者阅览 ]"},{"id":"ep-19:54","s":"moka","t":"主人打不开，别人也打不开。那这书谁来开！","x":"angry"},{"id":"ep-19:55","s":"yeon","t":"没关系。我不后悔。那个小家伙，今晚一定能睡好。","x":"smile"},{"id":"ep-19:56","s":"n","t":"Yeoni笑了。可是带着笑，前蹄尖却微微颤抖。春天就在眼前，却碰不到。"},{"id":"ep-19:57","s":"neo","t":"Yeoni。别打开那本书。也别找办法。","x":"serious","l":{"who":"yeon","x":"think"},"c":null,"r":{"who":"neo","x":"serious"}},{"id":"ep-19:58","s":"n","t":"声音低得异样。Yeoni缓缓转头，看向Yeongnyangi。"},{"id":"ep-19:59","s":"yeon","t":"你知道这本书，对不对。","x":"serious"},{"id":"ep-19:60","s":"neo","t":"我也不知道。第一次见。","x":"calm"},{"id":"ep-19:61","s":"yeon","t":"骗人。你说谎的时候，毛尖会竖起来。现在就竖着。","x":"angry","im":true,"shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-19:62","s":"n","t":"Yeongnyangi没有回答，只稍稍抬起左前爪。Yeoni的声音越尖锐，那只爪子的焦痕就越深。"},{"id":"ep-19:63","s":"yeon","t":"借阅卡有雨味的时候，看见空位的时候，只有你不对劲。到底是什么。你在藏什么。","x":"angry"},{"id":"ep-19:64","s":"neo","t":"现在不能说。对不起。","x":"serious"},{"id":"ep-19:65","s":"yeon","t":"现在？那要等什么时候？你永远都说以后！","x":"angry"},{"id":"ep-19:66","s":"moka","t":"喂，喂。都冷静点。吃完饭再吵。空着肚子，话会变重的。","x":"base","r":{"who":"moka","x":"base"}},{"id":"ep-19:67","s":"yeon","t":"摩卡别插手。这是我们两个的事。","x":"angry"},{"id":"ep-19:68","s":"neo","t":"Yeoni说得对。是我的问题。","x":"serious"},{"id":"ep-19:69","s":"moka","t":"两个人说的话都一样。所以才会吵架。","x":"angry"},{"id":"ep-19:70","s":"n","t":"Yeongnyangi的前爪又一颤。Yeoni没看见。她已经转头，望向了书。","r":{"who":"neo","x":"serious"}},{"id":"ep-19:71","s":"yun","t":"两位，等一下。空气变了。","x":"serious","c":{"who":"yun","x":"serious"}},{"id":"ep-19:72","s":"n","t":"台座下的影子鼓胀起来。锁链缝隙中，黑手指一根根伸出，把书握住。","bgm":"crisis2","sfx":"glitch","fx":"hands","shot":"impact","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"hands","camera":"drift"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"}},{"id":"ep-19:73","s":"heuk","t":"容器的第一个春天。那从一开始，就是我的。","nm":"声音"},{"id":"ep-19:74","s":"yeon","t":"又是你？别再吃别人的书了！","x":"fear","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"yun","x":"serious"}},{"id":"ep-19:75","s":"heuk","t":"不是吃，孩子。是拿回来。","nm":"声音"},{"id":"ep-19:76","s":"n","t":"几十只黑手同时扑来。Yeongnyangi冲上前，挥出利爪。摩卡的汤勺尖端，迸出火花。"},{"id":"ep-19:77","s":"n","t":"闰月摘下手套。掌心的洞，呼呼作响，把黑手一把把吸进去。","fx":"suck","sfx":"whoosh","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"suck","camera":"drift"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"}},{"id":"ep-19:78","s":"yun","t":"呃……今天这道菜，咸得有点过头。","x":"pain"},{"id":"ep-19:79","s":"n","t":"掌心的洞，朝手腕方向扩展了约一指节。闰月仍带着笑，再次抬起那只手。"},{"id":"ep-19:80","s":"yeon","t":"叔叔，停下！洞在变大啊！","x":"fear"},{"id":"ep-19:81","s":"yun","t":"没关系。既然是保护女士的书，这点代价，先赊着好了。","x":"base"},{"id":"ep-19:82","s":"n","t":"这时，天花板开始落下真正的雨。黑手之间，一道黑影顺着雨丝滑了下来。","sfx":"rain"},{"id":"ep-19:83","s":"n","t":"是老虎。她跃上台座，用前爪压住书。黑手仿佛认出了主人，纷纷退开。","im":true,"l":{"who":"yeon","x":"serious"},"c":{"who":"tiger","x":"base"},"r":null,"scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-19:84","s":"tiger","t":"我来收回。这本，由我带走。","x":"base"},{"id":"ep-19:85","s":"yeon","t":"收回？那本书上写的是我的名字。你的账簿里，连别人的春天也记着？","x":"angry"},{"id":"ep-19:86","s":"heuk","t":"来晚了。不过也好。拿来。","nm":"声音"},{"id":"ep-19:87","s":"yeon","t":"不行！","x":"angry"},{"id":"ep-19:88","s":"n","t":"Yeoni跃起，抓住书的另一侧。锁链上，小猪的前蹄与老虎的前爪碰在一起。","im":true,"fx":"wood","sfx":"slash","shot":"impact","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"wood","camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-19:89","s":"n","t":"只有短短一瞬。老虎的前爪一颤。一滴雨，啪嗒落在Yeoni头顶。"},{"id":"ep-19:90","s":"tiger","t":"你……为什么淋着雨，还在笑。","x":"surprise"},{"id":"ep-19:91","s":"yeon","t":"不知道。就是下雨会开心。从以前就这样。","x":"grin"},{"id":"ep-19:92","s":"n","t":"老虎的红眼剧烈动摇。可下一瞬，颈上的金环闪亮起来，猛然收紧。"},{"id":"ep-19:93","s":"n","t":"老虎猛地扯过书。锁链从Yeoni前蹄间滑走。","sfx":"thud"},{"id":"ep-19:94","s":"tiger","t":"雨就是雨。没什么好高兴的。","x":"angry"},{"id":"ep-19:95","s":"yeon","t":"你为什么拿走那本书？你也在那个春天里？所以才涂掉借阅者那栏？","x":"serious"},{"id":"ep-19:96","s":"tiger","t":"问题真多。欠债的一方，本来不该问问题。","x":"base"},{"id":"ep-19:97","s":"yeon","t":"我不欠你什么！","x":"angry"},{"id":"ep-19:98","s":"tiger","t":"是啊。这一次，就这么结束。那对你更好。","x":"sad","im":true,"shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 tiger의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-19:99","s":"n","t":"老虎叼着书，跳上阶梯。一次三四级，留下湿脚印，消失在圆顶的方向。","bg":"library","tone":"dark","bgm":"gloom2","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-19:100","s":"moka","t":"追！那个条纹家伙，这次我要在它尾巴上绑蝴蝶结。","x":"angry","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"pain"},"r":{"who":"moka","x":"angry"}},{"id":"ep-19:101","s":"n","t":"闰月背靠台座，瘫坐下来。他把没戴手套的手，裹在怀里。"},{"id":"ep-19:102","s":"yun","t":"你们去吧。我坐一会儿就走。水獭先生，能留在旁边就好了。","x":"pain"},{"id":"ep-19:103","s":"moka","t":"为什么偏偏是我。","x":"angry"},{"id":"ep-19:104","s":"yun","t":"因为您最吵。待在吵闹的人身边，就不会被忘记。","x":"sly"},{"id":"ep-19:105","s":"moka","t":"这话犯规，骗子。知道了。以后请我吃饭。","x":"moved"},{"id":"ep-19:106","s":"neo","t":"一起去。","x":"serious","l":{"who":"yeon","x":"serious"},"c":null,"r":{"who":"neo","x":"serious"}},{"id":"ep-19:107","s":"yeon","t":"嗯。不过结束以后，全都告诉我。答应我。","x":"serious"},{"id":"ep-19:108","s":"neo","t":"结束以后。","x":"calm"},{"id":"ep-19:109","s":"moka","t":"猫，别弄丢猪。丢了，我把你毛全剃光。","x":"base","c":{"who":"moka","x":"base"}},{"id":"ep-19:110","s":"neo","t":"没想到，还会有被水獭威胁的一天。","x":"smirk"},{"id":"ep-19:111","s":"n","t":"Yeoni终究没有追问，那算不算承诺。两人并肩跑上湿漉漉的阶梯。","c":null,"im":true,"shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-19:112","s":"n","t":"阶梯顶端那边，雨声越来越大。圆顶下，整座呼吸着的图书馆，正在慢慢湿透。"},{"id":"ep-19:113","s":"sys","t":"[《第一个春天》· 借出中 · 借阅者：■■■ ]","fx":"ink","sfx":"page","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"dark","ambient":null,"eventEffect":"ink","camera":"steady"},"a11y":{"description":"library 배경에서 진행되는 시스템 메시지"}},{"id":"ep-19:114","s":"n","t":"借阅卡上的三个黑格，被雨水浸湿，一点点洇开。仿佛下面那个三字姓名，即将浮现。"}]}
