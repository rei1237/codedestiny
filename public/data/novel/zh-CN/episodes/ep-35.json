{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-35","no":"EP.35","tag":"第35话 · 生时校正","title":"生时校正","rev":2,"beats":[{"id":"ep-35:1","s":"n","t":"船破开星云疾驰。远处兔耳帆晃着，始终隔着似乎快追上、却又差一点的距离。","bg":"skyship","bgm":"daily","shot":"wide","l":null,"c":null,"r":null,"sfx":"whoosh","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-35:2","s":"yeon","t":"来，倒着走。闰月先生，从最近的事说起。","x":"serious","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-35:3","s":"yun","t":"最近？替小姐合婚，差点被Neo先生揪领子的事？","x":"base"},{"id":"ep-35:4","s":"yeon","t":"不是那种。大事，人生裂开了一道缝的那天之类的。","x":"disappoint"},{"id":"ep-35:5","s":"yun","t":"大事啊。收到应用的那天吧。三年前，梅雨季的第一天。","x":"think"},{"id":"ep-35:6","s":"n","t":"Yeoni在本上记下：应用，三年前，梅雨首日。她写着，闰月却歪了歪头。"},{"id":"ep-35:7","s":"yun","t":"咦。我刚才说了什么？","x":"surprise"},{"id":"ep-35:8","s":"yeon","t":"应用，三年前，梅雨季的第一天。","x":"serious"},{"id":"ep-35:9","s":"yun","t":"啊，对。多亏小姐记下来，我的人生在你本子里，可能比在我脑子里留得更牢。","x":"laugh"},{"id":"ep-35:10","s":"n","t":"笑声薄得异样。Yeoni翻到下一页，用力握笔，一笔一画重重写下。","sfx":"page"},{"id":"ep-35:11","s":"moka","t":"那个生时校正，到底怎么做？","x":"base"},{"id":"ep-35:12","s":"yun","t":"把每件事发生那天，星星经过哪个宫，一一对照。时刻对了，事情就全吻合；时刻不对，就会错开。","x":"base"},{"id":"ep-35:13","s":"yeon","t":"像拿不同钥匙，一把把试锁孔。","x":"think"},{"id":"ep-35:14","s":"yun","t":"正是。还有我的第一印象，那是最重要的钥匙。记得玄关吧？","x":"base"},{"id":"ep-35:15","s":"moka","t":"第一印象容易。骗子。","x":"base"},{"id":"ep-35:16","s":"yun","t":"答对了。大家第一眼见我，都这么说。","x":"laugh"},{"id":"ep-35:17","s":"n","t":"桌面玻璃下的圆旋转起来。东边门槛闪烁，白天的时间被抹去，只剩夜晚与黎明。","im":true,"sfx":"chime","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:18","s":"yeon","t":"下一件。小时候有严重受伤过吗？","x":"think","bg":"skyship","bgm":"daily","shot":"wide","l":{"who":"yeon","x":"think"},"c":{"who":"yun","x":"base"},"r":{"who":"neo","x":"calm"},"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"skyship 배경에서 진행되는 yeon의 대사"}},{"id":"ep-35:19","s":"yun","t":"受伤啊。嗯，好像有。","x":"think"},{"id":"ep-35:20","s":"n","t":"闰月声音渐弱。戴手套的手指在半空摸索，像抓不到自己的记忆。"},{"id":"ep-35:21","s":"yun","t":"真奇怪。自己的事，却像别人的故事。","x":"sad"},{"id":"ep-35:22","s":"n","t":"船头传来低低的声音。Neo仍望着星海，接着往下说。"},{"id":"ep-35:23","s":"neo","t":"十一岁。从渡船摔下去，左臂骨折。奶奶背着你跑了十里。","x":"deadpan"},{"id":"ep-35:24","s":"yun","t":"……你怎么知道？","x":"surprise"},{"id":"ep-35:25","s":"neo","t":"在财星岛，你说过。第三次问我生日的那天。","x":"deadpan"},{"id":"ep-35:26","s":"yeon","t":"连这个都记得？","x":"surprise"},{"id":"ep-35:27","s":"neo","t":"我那么留意你，怎么会忘了你说的话。","x":"smirk"},{"id":"ep-35:28","s":"moka","t":"哇，这是爱，还是执念？","x":"base"},{"id":"ep-35:29","s":"neo","t":"是警戒任务。","x":"deadpan"},{"id":"ep-35:30","s":"n","t":"闰月沉默了很久，然后低下头，肩膀颤了一下。分不清在笑还是在哭。","im":true,"sfx":"heartbeat","shot":"close","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:31","s":"yun","t":"大家都忘了我，偏偏是猫先生记得。","x":"sad"},{"id":"ep-35:32","s":"neo","t":"我本来就不擅长忘记。想投诉，恐怕得找别家客服。","x":"calm"},{"id":"ep-35:33","s":"yeon","t":"投诉宇宙我试过。不受理。","x":"laugh"},{"id":"ep-35:34","s":"n","t":"Yeoni记下：十一岁，渡船，左臂，奶奶。又在旁边小小地添上：记得的人，Neo。"},{"id":"ep-35:35","s":"neo","t":"还有一件。你说在鸡鸣前出生，奶奶总提这件事。","x":"calm"},{"id":"ep-35:36","s":"n","t":"玻璃下的圆再次旋转。一颗星嵌入十一岁的位置，另一颗嵌入梅雨首日的位置，东边门槛的范围缩小了。","fx":"stars","sfx":"sparkle","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"natural","ambient":null,"eventEffect":"stars","camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-35:37","s":"yun","t":"天亮前的两小时，在卯时里。这部分本来就知道，问题是分钟。","x":"serious"},{"id":"ep-35:38","s":"yeon","t":"得精确到分钟？","x":"serious"},{"id":"ep-35:39","s":"yun","t":"青兔合同上写着。本人说出出生时刻，精确到分钟，沙漏才归还。他以为没人办得到，才加了这一条。","x":"serious"},{"id":"ep-35:40","s":"n","t":"兔耳飞艇就在前面。摩卡缠紧帆索，把船贴过去，两艘船砰地相撞。","bg":"jae","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"sfx":"whoosh","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-35:41","s":"rab","t":"哎呀呀！擅自登船，滞纳金十倍！","x":"snarl","l":{"who":"yeon","x":"serious"},"c":{"who":"moka","x":"base"},"r":{"who":"rab","x":"snarl"},"fx":"shake","sfx":"thud","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":"shake","camera":"steady"},"a11y":{"description":"jae 배경에서 진행되는 rab의 대사"}},{"id":"ep-35:42","s":"moka","t":"滞纳金就拿你的耳朵来付。","x":"angry"},{"id":"ep-35:43","s":"n","t":"飞艇甲板上，纸张像暴风雪飞起。全是贷款合同，每张纸的签名栏都张着嘴。"},{"id":"ep-35:44","s":"rab","t":"只要签名，立刻发放星光！利息用记忆收喔～","x":"invite"},{"id":"ep-35:45","s":"n","t":"合同像网一样纠缠而来。一张纸啪地贴上Yeoni手腕，签名栏竟要自行写下她的名字。","im":true,"fx":"net","sfx":"page","shot":"impact","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":"net","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:46","s":"yeon","t":"我的手自己在动！","x":"fear"},{"id":"ep-35:47","s":"yun","t":"手给我，小姐。","x":"pain"},{"id":"ep-35:48","s":"n","t":"闰月脱下手套，掌心中央是黑洞。合同上的墨被一股股吸入洞中。"},{"id":"ep-35:49","s":"n","t":"纸变得雪白，签名栏闭上了。可闰月掌心的洞，又扩大了约一拃。","fx":"suck","sfx":"whoosh","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"natural","ambient":null,"eventEffect":"suck","camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-35:50","s":"yeon","t":"你不是说用了会变大吗！","x":"angry"},{"id":"ep-35:51","s":"yun","t":"罚款十根烤串，对吧？记在摩卡先生账上。","x":"sly"},{"id":"ep-35:52","s":"moka","t":"别记我账上！","x":"base"},{"id":"ep-35:53","s":"n","t":"摩卡从怀里抽出一把烤串，插进炭火罐。辛辣的烟笼罩甲板，青兔打起喷嚏。"},{"id":"ep-35:54","s":"rab","t":"阿嚏！这是辣椒烟！妨碍营业！","x":"snarl"},{"id":"ep-35:55","s":"moka","t":"岛上特制。流泪了吧？这才叫味道。","x":"base"},{"id":"ep-35:56","s":"n","t":"四人穿过烟，冲进飞艇内部金色的回廊。墙边金库门排成行，青兔站在最末一扇门前。","bg":"jaeEnter2","bgm":"warRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-35:57","s":"rab","t":"死胡同了呢～不过没用。卯时客户，说不出具体分钟吧。","x":"smug","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"base"},"r":{"who":"rab","x":"smug"}},{"id":"ep-35:58","s":"rab","t":"合同第七条。本人，亲口，说出出生时刻，精确到分钟。谁都不能代劳～","x":"coin"},{"id":"ep-35:59","s":"yun","t":"他说得对。我现在真的不知道。","x":"sad"},{"id":"ep-35:60","s":"n","t":"闰月面孔的边缘又洇开了。金色回廊的光绕开他，像不愿照向一个不在那里的人。"},{"id":"ep-35:61","s":"yeon","t":"（不知道。不，碎片都齐了，只要拼起来。）","x":"think"},{"id":"ep-35:62","s":"n","t":"Yeoni翻着备忘本。梅雨首日，十一岁，左臂，鸡鸣之前，还有第一印象，骗子。"},{"id":"ep-35:63","s":"yeon","t":"闰月先生，奶奶说过在鸡鸣前，对吧？你们那里，鸡几点叫？","x":"serious"},{"id":"ep-35:64","s":"yun","t":"什么？","x":"surprise"},{"id":"ep-35:65","s":"yeon","t":"地方不同，时间也不同。我乡下奶奶家的鸡，五点半就叫。准得能当钟用。","x":"serious"},{"id":"ep-35:66","s":"yun","t":"我奶奶也这样。鸡一叫就下锅煮饭，饭熟时，六点新闻就开始了。","x":"think"},{"id":"ep-35:67","s":"moka","t":"煮饭要几分钟？","x":"base"},{"id":"ep-35:68","s":"yun","t":"大铁锅，大概三十分钟。我在那之前出生，奶奶说我比鸡先叫，她都笑了。","x":"think"},{"id":"ep-35:69","s":"n","t":"星星不再出现在玻璃上，而是在Yeoni的本子上彼此咬合。梅雨首日的星，十一岁的星，鸡鸣前的星，在同一个位置全部吻合。","im":true,"sfx":"chime","shot":"close","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:70","s":"yeon","t":"那就是五点半之前一点，大约五点二十分。","x":"serious"},{"id":"ep-35:71","s":"neo","t":"十一岁的位置也对应这个时刻。我算过。","x":"calm"},{"id":"ep-35:72","s":"rab","t":"哎呀，推理游戏真可爱～可还是得本人亲口说。他自己都不记得。","x":"greed"},{"id":"ep-35:73","s":"n","t":"Yeoni把本子递给闰月。那一页的每个字，全是他的故事。他望着纸，看了许久。","bg":"jaeEnter2","bgm":"crisis2","shot":"wide","l":{"who":"yeon","x":"gentle"},"c":{"who":"yun","x":"base"},"r":{"who":"rab","x":"smug"},"scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-35:74","s":"yeon","t":"不记得也行，读出来就好。这是你的，我只是记下来了。","x":"gentle"},{"id":"ep-35:75","s":"yun","t":"读别人替我写的人生啊。","x":"sad"},{"id":"ep-35:76","s":"yeon","t":"不是别人，是同伴。","x":"smile"},{"id":"ep-35:77","s":"n","t":"闰月吸气，读了出来。梅雨首日、渡船、左臂、奶奶、鸡。读到最后一行，声音颤了。","im":true,"shot":"impact","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:78","s":"yun","t":"凌晨五点二十分。比鸡更早哭的孩子，就是我。","x":"serious"},{"id":"ep-35:79","s":"n","t":"青兔颈间的沙漏裂开，浅粉色的沙涌出。没有落地，而是流过半空，进入闰月掌心。","im":true,"fx":"transform","sfx":"bell","shot":"impact","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"natural","ambient":null,"eventEffect":"transform","camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:80","s":"rab","t":"不行！那可是最贵的！","x":"snarl"},{"id":"ep-35:81","s":"n","t":"闰月面孔的轮廓清晰了。金色回廊的光终于照在他身上。摩卡无声地竖起拇指。"},{"id":"ep-35:82","s":"yun","t":"小姐的脸好清楚。不，是我变清楚了吗？","x":"surprise"},{"id":"ep-35:83","s":"yeon","t":"都是。","x":"laugh"},{"id":"ep-35:84","s":"n","t":"这时，整艘飞艇狠狠倾斜。窗外暗了，黑月正悬在飞艇上方。","bg":"jae","tone":"dark","bgm":"zeroPoint","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-35:85","s":"n","t":"黑手从天空垂下，手指很长。它们越过Yeoni，径直抓向青兔。","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"rab","x":"snarl"},"im":true,"fx":"hands","sfx":"glitch","shot":"impact","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":"hands","camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:86","s":"heuk","t":"失去卯时的手，没用了。你自称最弱，倒是诚实。"},{"id":"ep-35:87","s":"rab","t":"董、董事长！我还有三家分店！还有业绩报告！","x":"snarl"},{"id":"ep-35:88","s":"heuk","t":"收走。"},{"id":"ep-35:89","s":"n","t":"黑手攥住青兔的马甲。闪亮的名片在指间碎裂，青兔的腿离开地面。"},{"id":"ep-35:90","s":"yeon","t":"等等。放开！","x":"angry"},{"id":"ep-35:91","s":"n","t":"Yeoni身体比思绪先动，伸手拉住青兔前爪。摩卡抱住她的腰。"},{"id":"ep-35:92","s":"moka","t":"疯了？那可是放高利贷的！","x":"angry"},{"id":"ep-35:93","s":"yeon","t":"知道！可我也不想看他被吃！","x":"angry"},{"id":"ep-35:94","s":"n","t":"Neo用透明的手划出刀刃，两根黑指断开。敌人手里只剩马甲，青兔滚落地板。","fx":"claw","sfx":"slash","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":"claw","camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-35:95","s":"n","t":"脱了马甲的青兔比想象中小，就是只一边耳朵折着的普通兔子。"},{"id":"ep-35:96","s":"rab","t":"……客户。这次给您免息。仅此一次。","x":"sly"},{"id":"ep-35:97","s":"yeon","t":"你就是这么说谢谢的？","x":"disappoint"},{"id":"ep-35:98","s":"rab","t":"最弱的，本来就活得最久嘛～清仓大甩卖，下一片天空见！","x":"smug"},{"id":"ep-35:99","s":"n","t":"青兔跳上救生艇。艇尾一张写着「清仓」的纸飘着，转眼消失在星云中。"},{"id":"ep-35:100","s":"n","t":"回到船上，闰月瘫坐甲板，摊开右手。浅粉色的沙在掌纹间闪烁。","bg":"skyship","tone":"dark","bgm":"zeroPoint","shot":"wide","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"pain"},"r":{"who":"neo","x":"serious"},"scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"skyship 배경에서 진행되는 서술"}},{"id":"ep-35:101","s":"n","t":"可掌心中央的洞还在，一点没缩。沙粒绕着洞缘打转，努力不被吸进去。"},{"id":"ep-35:102","s":"yeon","t":"时辰找回来了，为什么不合上？","x":"surprise"},{"id":"ep-35:103","s":"heuk","t":"时辰是被偷的，洞却是我挖的。小偷消失了，洞仍会留下。"},{"id":"ep-35:104","s":"heuk","t":"那个洞，会与我一起合上。绝不会先于我关闭。"},{"id":"ep-35:105","s":"n","t":"黑月缓缓远去。甲板安静下来。闰月重新戴上手套，一根手指一根手指，格外仔细。","im":true,"shot":"quiet","scene":{"background":"skyship","backgroundMeaning":"작가 지정 배경: skyship","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"skyship 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-35:106","s":"yun","t":"看来得一直跟到底了。小姐的这场旅行。","x":"sly"},{"id":"ep-35:107","s":"yeon","t":"别笑着说。这也要罚款。","x":"serious"},{"id":"ep-35:108","s":"yun","t":"我可没说没事。","x":"laugh"}]}
