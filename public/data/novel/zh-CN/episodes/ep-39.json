{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-39","no":"EP.39","tag":"第39话 · 业","title":"业","rev":2,"beats":[{"id":"ep-39:1","s":"n","t":"上方，Yeoni攥着红线。下方，尾巴攥着锁链。黑虎就悬在两者之间。","bg":"gongmang","tone":"dark","bgm":"crisis2","shot":"wide","l":null,"c":null,"r":null,"sfx":"whoosh","scene":{"background":"gongmang","backgroundMeaning":"작가 지정 배경: gongmang","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"gongmang 배경에서 진행되는 서술"}},{"id":"ep-39:2","s":"tiger","t":"会长。账本最后一行，我亲自写。","x":"angry","c":{"who":"tiger","x":"angry"}},{"id":"ep-39:3","s":"heuk","t":"什么一行？"},{"id":"ep-39:4","s":"tiger","t":"徐寒雨。已偿还。金饰环一只。","x":"angry"},{"id":"ep-39:5","s":"n","t":"老虎用右前爪抓住颈间的环。爪尖陷入金属，环变得滚烫，烧焦毛发的气味飘了出来。"},{"id":"ep-39:6","s":"heuk","t":"放手。那只环就是你的身体。断了它，你的力量和回去的路也会一并断掉。"},{"id":"ep-39:7","s":"tiger","t":"我知道。所以才要断。","x":"base"},{"id":"ep-39:8","s":"n","t":"环上出现裂纹。一道，两道。黑烟从缝里泄出，尾巴发出惨叫，锁链疯狂晃动。","im":true,"fx":"metal","sfx":"slash","shot":"impact","scene":{"background":"gongmang","backgroundMeaning":"작가 지정 배경: gongmang","transition":"hold","tone":"dark","ambient":null,"eventEffect":"metal","camera":"focus"},"a11y":{"description":"gongmang 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-39:9","s":"n","t":"环断成了两截。声音很轻，像打碎一只玻璃杯。可那一点声响，让日食之下的一切都震颤起来。","im":true,"fx":"burst","sfx":"bell","shot":"impact","scene":{"background":"gongmang","backgroundMeaning":"작가 지정 배경: gongmang","transition":"hold","tone":"dark","ambient":null,"eventEffect":"burst","camera":"focus"},"a11y":{"description":"gongmang 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-39:10","s":"n","t":"黑毛像雨水一样流下。爪子蜷缩，庞大的身躯变小。最后只剩一个穿着湿大衣的人。"},{"id":"ep-39:11","s":"pje","t":"啊。比想象中，还冷呢。","x":"blank","c":{"who":"pje","x":"blank"}},{"id":"ep-39:12","s":"n","t":"人继续坠落。下方再没有锁链可抓，只剩手腕上缠着的一根红线。"},{"id":"ep-39:13","s":"n","t":"上方，二十七月宿的井边。红线突然变沉，Yeoni向前栽去，膝盖重重磕在石地上。","bg":"nakshatra","tone":"dark","bgm":"crisis","shot":"wide","l":{"who":"yeon","x":"fear"},"c":{"who":"neo","x":"serious"},"r":{"who":"moka","x":"angry"},"sfx":"thud","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"}},{"id":"ep-39:14","s":"yeon","t":"好重！比刚才更重了！为什么？！","x":"fear"},{"id":"ep-39:15","s":"neo","t":"不是老虎的重量，是一个人的重量。也是连一点支撑自己的力气都没剩下的重量。","x":"serious"},{"id":"ep-39:16","s":"n","t":"Neo低头想咬住线，前腿却直接穿了过去。透明到肩膀的腿，什么也抓不住。"},{"id":"ep-39:17","s":"neo","t":"偏偏这时候使不上劲。该死。","x":"angry"},{"id":"ep-39:18","s":"moka","t":"让开，猫！围裙就是这时候用的！","x":"angry"},{"id":"ep-39:19","s":"n","t":"摩卡解下围裙，绑在红线上。闰月抓住另一头，三个排成一列往后拉。像拔河，只是对手是宇宙。"},{"id":"ep-39:20","s":"yun","t":"一、二、三。我平时真不干这种事的。","x":"pain"},{"id":"ep-39:21","s":"moka","t":"闭嘴，拉！合盘待会儿再看！","x":"angry"},{"id":"ep-39:22","s":"n","t":"井下伸出一只湿漉漉的手。右腕有一道环形伤疤。Yeoni抓住那手腕，冰凉。","im":true,"fx":"thread","sfx":"whoosh","shot":"close","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"dark","ambient":null,"eventEffect":"thread","camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-39:23","s":"n","t":"被拉上来的人伏在石地上咳嗽，黑大衣不停淌水，怀里抱着一本湿透的账本。","l":{"who":"yeon","x":"surprise"},"c":{"who":"pje","x":"blank"},"r":{"who":"neo","x":"serious"}},{"id":"ep-39:24","s":"yeon","t":"隔壁那个人。","x":"surprise"},{"id":"ep-39:25","s":"pje","t":"你好。这个时间，真是多有打扰了。","x":"blank"},{"id":"ep-39:26","s":"n","t":"Yeoni说不出话来。晴天也带黑伞的邻居，隔着墙念叨袜子的声音，快递单上的名字，全都是同一个人。"},{"id":"ep-39:27","s":"yeon","t":"是够打扰的。打扰得可大了。","x":"angry"},{"id":"ep-39:28","s":"n","t":"雨停了。五个围坐在井边。不，四个加一个。徐寒雨独自坐得稍远一些。","bg":"nakshatra","tone":"desat","bgm":"gloom2","shot":"wide","l":{"who":"yeon","x":"serious"},"c":{"who":"pje","x":"base"},"r":{"who":"moka","x":"angry"},"sfx":"rain","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"}},{"id":"ep-39:29","s":"yun","t":"几乎没有气了。大概只剩一滴水，连老虎时的百分之一都不到。","x":"serious"},{"id":"ep-39:30","s":"pje","t":"真准。你的手一向这么准吗？","x":"base"},{"id":"ep-39:31","s":"yun","t":"看合盘的时候才准。给我出生年月日时，还能更准。","x":"sly"},{"id":"ep-39:32","s":"pje","t":"那是债。","x":"cynic"},{"id":"ep-39:33","s":"moka","t":"你现在连这人的合盘都要看？！我们岛上的声音，全让她拿走了！","x":"angry"},{"id":"ep-39:34","s":"n","t":"摩卡的胡须在抖，前爪攥紧围裙角。徐寒雨抬头看着摩卡，没有躲闪。"},{"id":"ep-39:35","s":"pje","t":"没错，是我拿走的。市场奶奶的声音，地下舞台那些孩子的说唱声。账本里都记着。","x":"serious"},{"id":"ep-39:36","s":"moka","t":"你居然能这么平静地说出来？！","x":"angry"},{"id":"ep-39:37","s":"pje","t":"是装作平静。不然我说不出口。","x":"serious"},{"id":"ep-39:38","s":"n","t":"摩卡闭上了嘴。那不是消了气的表情，但她没有再喊。"},{"id":"ep-39:39","s":"n","t":"徐寒雨翻开账本，湿页上密密麻麻都是名字。其中有Yeoni的名字，旁边一栏写着：未收，未收。","im":true,"shot":"close","sfx":"page","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"desat","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-39:40","s":"pje","t":"让我先辩解。这样接下来的话，才不会是谎话。","x":"talk"},{"id":"ep-39:41","s":"yeon","t":"你说。","x":"serious"},{"id":"ep-39:42","s":"pje","t":"那个春天，我被骗了。黑月顶着你的脸来，拿走了我的信封。我以为你抛下了我。","x":"talk"},{"id":"ep-39:43","s":"pje","t":"所以我说，要赶在你变成怪物之前阻止你。代价就是戴上这个环。到这里，都是黑月的错。","x":"sad"},{"id":"ep-39:44","s":"n","t":"徐寒雨停了片刻，手指摩挲账本的边角，纸页起了毛。"},{"id":"ep-39:45","s":"pje","t":"可是，受骗是黑月的错，夺走那个孩子掌声的，却是我的手。","x":"serious"},{"id":"ep-39:46","s":"pje","t":"打鼓的孩子哭的时候，我在账本上写：回收完成。在摩卡的岛上，在时间岛上，也一样。全是我亲手做的。","x":"serious","im":true,"fx":"heart","sfx":"heartbeat","shot":"quiet","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"desat","ambient":null,"eventEffect":"heart","camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 pje의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-39:47","s":"n","t":"谁都没有说话。只有井底的滴水声。嗒。嗒。"},{"id":"ep-39:48","s":"yeon","t":"谢谢。刚才救了我，还有，现在没有找借口。","x":"angry","l":{"who":"yeon","x":"angry"},"c":{"who":"pje","x":"sad"},"r":{"who":"neo","x":"serious"}},{"id":"ep-39:49","s":"pje","t":"嗯。","x":"waver"},{"id":"ep-39:50","s":"yeon","t":"但我不原谅你。现在不。","x":"angry"},{"id":"ep-39:51","s":"n","t":"Yeoni的声音在颤。是因为生气，还是因为想哭，连她自己也不知道。可她还是把话说完了。"},{"id":"ep-39:52","s":"yeon","t":"打鼓的那个孩子，那天真的哭了。我亲眼看见的。摩卡岛上的奶奶们也是。你什么都还没还给他们，我怎么能先原谅你。","x":"angry"},{"id":"ep-39:53","s":"yeon","t":"现在我只说谢谢。原谅的事以后再说。而且由我来决定。","x":"serious"},{"id":"ep-39:54","s":"pje","t":"这样才对。现在就被原谅，我的账也对不上。","x":"sad"},{"id":"ep-39:55","s":"yeon","t":"又是账本。","x":"serious"},{"id":"ep-39:56","s":"pje","t":"习惯了。我会改，慢慢来。","x":"smile"},{"id":"ep-39:57","s":"n","t":"徐寒雨又翻了一页，指着回收栏里的一道声音，试着把字往回推。墨迹纹丝不动。"},{"id":"ep-39:58","s":"pje","t":"啊。连归还的力量也一块儿付出去了。算在断环的代价里。","x":"blank"},{"id":"ep-39:59","s":"yun","t":"用老虎的力量收走的，只有老虎的力量才能解开。现在这副身体办不到。","x":"serious"},{"id":"ep-39:60","s":"pje","t":"那就得找别的办法。就算要花些时间。","x":"base"},{"id":"ep-39:61","s":"moka","t":"花多久都要做。奶奶们还在等。","x":"base"},{"id":"ep-39:62","s":"n","t":"摩卡只说了这一句就转过身，但没有离开。她把剩下的一盒火柴推向徐寒雨，像是让她烘干湿大衣。"},{"id":"ep-39:63","s":"pje","t":"这个，我可以收吗？价钱怎么算？","x":"waver"},{"id":"ep-39:64","s":"moka","t":"还价钱呢。让你用就用。火分给别人，也不会少。","x":"angry"},{"id":"ep-39:65","s":"n","t":"入夜了。二十七轮月亮逐一亮起。Yeoni坐在井沿，拿出备忘本。Neo趴在旁边。","bg":"nakshatra","tone":"dark","bgm":"neo2","shot":"wide","l":{"who":"yeon","x":"think"},"c":null,"r":{"who":"neo","x":"calm"},"scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"nakshatra 배경에서 진행되는 서술"}},{"id":"ep-39:66","s":"yeon","t":"徐寒雨，获救。暂不原谅。打鼓孩子的名字，仍不知道。","x":"think"},{"id":"ep-39:67","s":"n","t":"Yeoni停下笔。沿着红线传来的画面仍留在脑中：下雨的公交站，还有掉落白伞的男人。"},{"id":"ep-39:68","s":"yeon","t":"Neo。那个车站，你也在吗？","x":"serious"},{"id":"ep-39:69","s":"neo","t":"什么车站。","x":"calm"},{"id":"ep-39:70","s":"yeon","t":"白伞。『又迟了啊，我又。』那个声音就是你吧。","x":"serious"},{"id":"ep-39:71","s":"n","t":"Neo的手停了。他没有回答，只低头看着自己的胳膊。透明已经蔓延到了肩膀。"},{"id":"ep-39:72","s":"neo","t":"有些事不能说。不全是因为想瞒着你。","x":"serious"},{"id":"ep-39:73","s":"yeon","t":"又来了？你们的秘密也太多了。这世界的客服中心没有公告栏吗？","x":"angry"},{"id":"ep-39:74","s":"neo","t":"有。只是没人看。","x":"smirk"},{"id":"ep-39:75","s":"yeon","t":"别逗了。一点都不好笑。","x":"angry"},{"id":"ep-39:76","s":"n","t":"Yeoni看着Neo透明的前腿，想碰一碰，却把手停住了。她怕自己的手穿过去，那样会更可怕。"},{"id":"ep-39:77","s":"yeon","t":"那你只回答我一件事。那个春天，你也站在我这边吗？","x":"sad"},{"id":"ep-39:78","s":"neo","t":"这个可以说。我站在你这边。从一开始，到现在。","x":"soft"},{"id":"ep-39:79","s":"yeon","t":"（模样不同，也还是Neo。站在我这边。这一件事，一定要记下来。）","x":"think","im":true,"shot":"close","sfx":"chime","scene":{"background":"nakshatra","backgroundMeaning":"작가 지정 배경: nakshatra","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"nakshatra 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-39:80","s":"n","t":"Yeoni用力写在备忘本一角。Neo装作没有看见那些字。"},{"id":"ep-39:81","s":"n","t":"井的另一边，徐寒雨独自数着月亮。Neo悄无声息走到她身旁。","l":{"who":"pje","x":"base"},"r":{"who":"neo","x":"serious"}},{"id":"ep-39:82","s":"pje","t":"那时来晚的，是你吧。白伞。","x":"base"},{"id":"ep-39:83","s":"neo","t":"是。你还留在那里。","x":"serious"},{"id":"ep-39:84","s":"pje","t":"我们两个，谁都没能守住。","x":"sad"},{"id":"ep-39:85","s":"neo","t":"这次会不一样。你也一样。","x":"serious"},{"id":"ep-39:86","s":"pje","t":"我已经没力量了。也不能像你一样操控光。","x":"cynic"},{"id":"ep-39:87","s":"neo","t":"现在连操控光也很勉强。先从这条胳膊开始，一点点消失。","x":"deadpan"},{"id":"ep-39:88","s":"n","t":"徐寒雨低头看了看Neo的腿。她第一次敛去所有笑意，脸色僵住了。"},{"id":"ep-39:89","s":"pje","t":"那孩子，知道吗？","x":"serious"},{"id":"ep-39:90","s":"neo","t":"不知道。也不能知道。你也别说。","x":"serious"},{"id":"ep-39:91","s":"pje","t":"这是让我欠债呢。","x":"serious"},{"id":"ep-39:92","s":"neo","t":"对。以后还。","x":"smirk"},{"id":"ep-39:93","s":"n","t":"黎明时，二十七轮月亮中有一轮骤然熄灭。是Yeoni的月亮，婆罗尼。天空的一角黑成了圆。","bg":"eclipseSky","tone":"dark","bgm":"zeroPoint","shot":"wide","l":{"who":"yeon","x":"fear"},"c":{"who":"pje","x":"blank"},"r":{"who":"yun","x":"serious"},"sfx":"glitch","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-39:94","s":"yeon","t":"咦，不对。身体里又有空掉的感觉。","x":"fear"},{"id":"ep-39:95","s":"n","t":"黑圆里降下一颗巨大的头颅。没有身体的头，是罗睺。每张一次嘴，星光便被吸进去。","im":true,"fx":"vortex","sfx":"whoosh","shot":"impact","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"vortex","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-39:96","s":"yun","t":"头吞的是未来。女士，备忘本！","x":"serious"},{"id":"ep-39:97","s":"n","t":"Yeoni翻开备忘本。下周的待办事项正在逐行消失：买菜，交作业，去海边。字变成黑烟，升向天空。"},{"id":"ep-39:98","s":"yeon","t":"去海边也要吃？！我连日期都还没定呢！","x":"angry"},{"id":"ep-39:99","s":"heuk","t":"没有日期的约定，最是美味。就像你们两个，曾经没能守住的那个约定。"},{"id":"ep-39:100","s":"n","t":"徐寒雨的脸一下子白了。知道那个约定的只有她们两个，以及插进两人之间的那个东西。"},{"id":"ep-39:101","s":"sys","t":"[ 年 壬午 · 结冰 ] 裂缝正在扩散"},{"id":"ep-39:102","s":"heuk","t":"不戴环的狗，我不需要。连同那个容器，一起掏空吧。"},{"id":"ep-39:103","s":"n","t":"头颅降下。Yeoni往后退，Neo上前挡住，腿却踏不实地面。","im":true,"fx":"shake","sfx":"thud","shot":"impact","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"shake","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-39:104","s":"n","t":"挡在前面的，是一件湿大衣。没有利爪，没有尖牙，只剩血肉之躯的徐寒雨。"},{"id":"ep-39:105","s":"yeon","t":"你干什么！不是说没力量了吗！","x":"surprise"},{"id":"ep-39:106","s":"pje","t":"是没有。可这一次，我不会走向那边。","x":"resolve"},{"id":"ep-39:107","s":"pje","t":"连伞都没有了。还谈什么一人一半。","x":"smile"},{"id":"ep-39:108","s":"n","t":"罗睺张开嘴。就在那一刻，有什么落在徐寒雨掌心。一滴冰凉的水。不是黑的，清澈见底。","im":true,"shot":"quiet","sfx":"rain","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-39:109","s":"pje","t":"……雨？","x":"surprise"}]}
