{"version":2,"sourceHash":"1822d08b1cf0edd0475c92c0afa22fe040cec6e8e632f2e40817de52b7dfdd2e","locale":"zh-CN","id":"ep-24","no":"EP.24","tag":"第24话 · 因为没有水","title":"因为没有水","rev":2,"beats":[{"id":"ep-24:1","s":"n","t":"清晨河畔，水雾低低铺开。一只粉红小猪，蜷在湿石头上睡着。","bg":"river","tone":"dark","bgm":"lakeDawn","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"crossfade","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"river 배경에서 진행되는 서술"}},{"id":"ep-24:2","s":"n","t":"前蹄上缠着一根白毛，夜里不知重新系了多少次，结叠了三层。"},{"id":"ep-24:3","s":"moka","t":"找到了。你还真睡在这里啊。","x":"base","l":null,"c":{"who":"moka","x":"base"},"r":null},{"id":"ep-24:4","s":"yeon","t":"摩卡。Yeongnyangi呢？","x":"sad","l":{"who":"yeon","x":"sad"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"sad"}},{"id":"ep-24:5","s":"moka","t":"还没有。","x":"base"},{"id":"ep-24:6","s":"n","t":"她点头。头上那片褪白的花瓣沾了露，蔫垂着。"},{"id":"ep-24:7","s":"yun","t":"女士，先进去吧。睡在冷石头上，乙木会从根开始受伤。","x":"sad"},{"id":"ep-24:8","s":"yeon","t":"进去干什么。我留在这里，他一回来就能看见。","x":"sad"},{"id":"ep-24:9","s":"moka","t":"进去吃饭。猫回来见你这样，会骂我。","x":"angry"},{"id":"ep-24:10","s":"n","t":"摩卡叼着她后颈往里拖，伤脚上的书签缎带拖过湿石。"},{"id":"ep-24:11","s":"n","t":"河面的雾散开，又聚拢。其间，一道黑色水波无声掠过。谁也没有看见。","im":true,"shot":"close","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:12","s":"n","t":"阅览室长桌上铺着摩卡从市场带来的河图，桌尾猫常坐的椅子独空。","bg":"library","bgm":"warRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-24:13","s":"yun","t":"先找猫先生的痕迹，他最后坐那里。","x":"base","l":{"who":"yeon","x":"sad"},"c":{"who":"yun","x":"base"},"r":{"who":"moka","x":"base"}},{"id":"ep-24:14","s":"yeon","t":"椅子底下这是什么，红粉末？","x":"surprise"},{"id":"ep-24:15","s":"moka","t":"锈，有铁腐掉的味道。","x":"base"},{"id":"ep-24:16","s":"n","t":"她用前蹄拢起锈粉，几粒随风落上窗边盆栽。"},{"id":"ep-24:17","s":"n","t":"小树一颤，沾锈的一片叶发黄卷起，落在桌上。"},{"id":"ep-24:18","s":"n","t":"她想捡叶子，停住。前蹄上白毛末端，也沾着红粉。"},{"id":"ep-24:19","s":"yun","t":"锈是铁生病的痕迹，猫先生看来很难受。","x":"serious"},{"id":"ep-24:20","s":"n","t":"闰月把落叶放掌上，红斑沿叶脉扩散。"},{"id":"ep-24:21","s":"yeon","t":"只是坐过，树就会这样？","x":"angry"},{"id":"ep-24:22","s":"yun","t":"金克木。所以猫先生在您身边，一直很小心。","x":"serious"},{"id":"ep-24:23","s":"yeon","t":"那从一开始，我们就不合。Yeongnyangi和我。","x":"sad"},{"id":"ep-24:24","s":"yun","t":"不，把水壶给我。","x":"base","im":true,"shot":"close","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"library 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:25","s":"n","t":"他用壶水冲叶，红斑溶解流去，卷叶稍稍舒开。"},{"id":"ep-24:26","s":"yun","t":"金生水，水养木。中间有水，金就不砍木，而是滋养。","x":"serious"},{"id":"ep-24:27","s":"sys","t":"［ 年 壬 · 结冰 ］","fx":"water","sfx":"water","scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"hold","tone":"natural","ambient":null,"eventEffect":"water","camera":"steady"},"a11y":{"description":"library 배경에서 진행되는 시스템 메시지"}},{"id":"ep-24:28","s":"yun","t":"您的水是年干壬水，如今冻住了。","x":"serious"},{"id":"ep-24:29","s":"n","t":"她把毛尖的锈浸在壶水里，锈没散，反而粘得更紧。"},{"id":"ep-24:30","s":"yeon","t":"这个怎么不化？","x":"surprise"},{"id":"ep-24:31","s":"yun","t":"因为只是普通水。要触到猫先生，水得从您的命盘里流出来。","x":"base"},{"id":"ep-24:32","s":"moka","t":"那猪的火呢？不是说她的火会熔猫？","x":"base"},{"id":"ep-24:33","s":"yun","t":"水流动，火也能找到去路，不会灭，只会适度减小。","x":"serious"},{"id":"ep-24:34","s":"n","t":"她指甲尖自动迸出火星，河图一角烧黑。"},{"id":"ep-24:35","s":"moka","t":"猪，别烧地图，只有这一张。","x":"angry"},{"id":"ep-24:36","s":"yeon","t":"（只要融了冰。我的水流起来，猫就不再融化。）","x":"think"},{"id":"ep-24:37","s":"n","t":"她扶桌站起，伤脚抽痛，却没坐回去。"},{"id":"ep-24:38","s":"yeon","t":"去金库。我的字盘在那里。","x":"serious"},{"id":"ep-24:39","s":"moka","t":"不是要找猫吗？","x":"base"},{"id":"ep-24:40","s":"yeon","t":"两个都找。猫回来，我的水还冻着，他又会融化。","x":"angry"},{"id":"ep-24:41","s":"moka","t":"好，但地图归我拿。","x":"base"},{"id":"ep-24:42","s":"yun","t":"小姐，强融那冰会疼，老虎也说过吧。","x":"sad","c":{"who":"yun","x":"sad"}},{"id":"ep-24:43","s":"yeon","t":"疼就让我疼。我现在能做的，只有这个。","x":"serious"},{"id":"ep-24:44","s":"n","t":"三人下到记忆金库。中央，浮着Yeoni的文字面板。八格里，七格亮着。","bgm":"gloom","bg":"memoryVault","tone":"dark","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"}},{"id":"ep-24:45","s":"sys","t":"[ 年 壬午 · 月 丙午 · 日 乙亥 · 时 □辰 ]  7/8","im":true,"fx":"script","sfx":"page","shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"dark","ambient":null,"eventEffect":"script","camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:46","s":"n","t":"最前面的壬字，与其说是字，不如说是一块冰。黑黑地冻住，里面有什么被困着，蠕动不止。"},{"id":"ep-24:47","s":"yeon","t":"从图书馆找到时就这样，里面有东西在动。","x":"fear","l":{"who":"yeon","x":"fear"},"c":{"who":"yun","x":"serious"},"r":{"who":"moka","x":"base"}},{"id":"ep-24:48","s":"yun","t":"老虎的水又冷又黑，把您的水冻住了。","x":"serious"},{"id":"ep-24:49","s":"moka","t":"那个条纹家伙，真是。每见一次，都要弄坏点东西才走。","x":"angry"},{"id":"ep-24:50","s":"yeon","t":"闰月，让一下。","x":"serious"},{"id":"ep-24:51","s":"yun","t":"女士，等一下。","x":"surprise"},{"id":"ep-24:choose-1","s":"yun","t":"等老虎来会少疼些，只是不知何时来。","x":"serious"},{"id":"ep-24:choose-2","s":"yeon","t":"那期间猫还在融，我不等。","x":"serious"},{"id":"ep-24:52","s":"n","t":"Yeoni已经举起前蹄。蹄尖凝出丙火的火种。"},{"id":"ep-24:53","s":"yeon","t":"冰要用火融化。我有的是火。","x":"serious"},{"id":"ep-24:54","s":"yun","t":"问题就在这里！","x":"surprise"},{"id":"ep-24:55","s":"n","t":"火裹住壬字。冰面冒白汽时，她胸口像被劈开般痛。","im":true,"fx":"fire","sfx":"fire","shot":"impact","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"dark","ambient":null,"eventEffect":"fire","camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:56","s":"yeon","t":"啊，好痛！","x":"fear"},{"id":"ep-24:57","s":"n","t":"她没收火，咬牙把前蹄再推前，冰上裂了一道细缝。"},{"id":"ep-24:58","s":"n","t":"别的场景从缝里涌入。下着雨，车站屋檐的水成线落下。","bg":"rainStop","tone":"desat","bgm":"memWater","shot":"wide","scene":{"background":"rainStop","backgroundMeaning":"작가 지정 배경: rainStop","transition":"crossfade","tone":"desat","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"rainStop 배경에서 진행되는 서술"}},{"id":"ep-24:59","s":"n","t":"有人独站车站角落，没有伞，湿发遮着脸。"},{"id":"ep-24:60","s":"n","t":"一把伞半倾向那人。握伞的小手很眼熟，是她自己的。"},{"id":"ep-24:stop-1","s":"n","t":"进伞的人肩膀湿了一半，她的手又把伞向那边偏了些。"},{"id":"ep-24:stop-2","s":"yeon","t":"一起撑吧，等公交来了就好。","x":"soft"},{"id":"ep-24:stop-3","s":"n","t":"是自己的声音。站牌的路线号被雨晕开，看不清。"},{"id":"ep-24:61","s":"n","t":"雨后传来笑声，温暖又略羞涩，却不知道是谁。","sfx":"rain"},{"id":"ep-24:62","s":"n","t":"画面断了，火也脱手。汽散后，壬仍冻着，裂处反倒更黑。","bg":"memoryVault","tone":"dark","bgm":"gloom","shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 서술"}},{"id":"ep-24:63","s":"yeon","t":"刚才是什么，我没去过那站。","x":"cry","l":{"who":"yeon","x":"cry"},"c":{"who":"yun","x":"serious"},"r":{"who":"moka","x":"base"}},{"id":"ep-24:64","s":"yun","t":"是冰映出的画面。谁的记忆，我也不知道。","x":"serious"},{"id":"ep-24:65","s":"moka","t":"猪，你流鼻血了。","x":"base"},{"id":"ep-24:66","s":"n","t":"Yeoni揉了揉鼻子。前蹄沾上红色。胸口深处，仍一阵阵抽痛。"},{"id":"ep-24:67","s":"yun","t":"火融冰，水会煮沸蒸发。还来不及滋养您，就烧光了。","x":"serious","im":true,"shot":"close","scene":{"background":"memoryVault","backgroundMeaning":"작가 지정 배경: memoryVault","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"memoryVault 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:68","s":"yeon","t":"除了火，我还有什么？","x":"cry"},{"id":"ep-24:69","s":"yun","t":"我也还不知道。冰由冻住它的人解，才容易。","x":"sad"},{"id":"ep-24:70","s":"moka","t":"那只老虎，怎么可能帮忙解。","x":"angry"},{"id":"ep-24:71","s":"yun","t":"是啊。","x":"sad"},{"id":"ep-24:72","s":"n","t":"金库安静了。裂处留下黑细痕，她胸内同一位置，也钉着寒气，散不去。"},{"id":"ep-24:73","s":"n","t":"下午她坐不住，拖着伤脚转阅览室，撞了三次桌角。","bg":"library","bgm":"crisis2","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"library","backgroundMeaning":"작가 지정 배경: library","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"library 배경에서 진행되는 서술"}},{"id":"ep-24:74","s":"yeon","t":"分头找吧，干坐着我会疯。","x":"serious","l":{"who":"yeon","x":"serious"},"c":{"who":"moka","x":"base"},"r":{"who":"yun","x":"base"}},{"id":"ep-24:75","s":"yun","t":"好，我去楼下书架，那里水的书多。","x":"base"},{"id":"ep-24:76","s":"moka","t":"我去市场，问有没有又白又圆戴帽子又冷脸的东西路过。","x":"base"},{"id":"ep-24:77","s":"yeon","t":"我去河边。最后是在那里看见的。","x":"serious"},{"id":"ep-24:78","s":"yun","t":"日落前回这里集合。今天的天不对劲。","x":"serious"},{"id":"ep-24:79","s":"n","t":"闰月先摸摸绑在包带上的旧折伞，再指窗外。昨天裂过的天异常暗，太阳缺一角，像被咬掉。"},{"id":"ep-24:80","s":"moka","t":"太阳怎么了。跟庆典岛那时一模一样。","x":"base"},{"id":"ep-24:81","s":"yun","t":"所以我才提醒。别一个人待太久。","x":"serious"},{"id":"ep-24:82","s":"n","t":"与此同时，河流下游。雾最浓的地方，坐着一只白猫。","bg":"river","tone":"dark","bgm":"none","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"crossfade","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"river 배경에서 진행되는 서술"}},{"id":"ep-24:83","s":"n","t":"猫把锈爪浸在河中，沾水处的锈如丝解开流走。","l":null,"c":{"who":"neo","x":"calm"},"r":null},{"id":"ep-24:84","s":"neo","t":"金生水。有水，就不必做刀。","x":"calm"},{"id":"ep-24:85","s":"n","t":"和闰月早上说的一样。他抬起褪锈的前爪，看了许久。"},{"id":"ep-24:86","s":"neo","t":"她的水还冻着。金融不了冰。","x":"sad"},{"id":"ep-24:87","s":"n","t":"Yeongnyangi看着水中自己的脸。紫色眼睛，短暂荡起金光，又沉了下去。"},{"id":"ep-24:88","s":"neo","t":"她叫我让开。","x":"soft"},{"id":"ep-24:89","s":"n","t":"他又念一次，轻轻笑了。"},{"id":"ep-24:90","s":"neo","t":"不过，火还在。真好。","x":"smile"},{"id":"ep-24:91","s":"n","t":"河水翻成漆黑。几十只黑手，同时从水里冲出。就在Yeongnyangi浸着前爪的地方。","im":true,"fx":"hands","sfx":"glitch","shot":"impact","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":"hands","camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:92","s":"heuk","t":"想念水了么，猫儿。你最弱时，水便在最近处。","bg":"handsRush","tone":"dark","bgm":"zeroPoint","shot":"wide","nm":"声音","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"handsRush 배경에서 진행되는 heuk의 대사"}},{"id":"ep-24:93","s":"neo","t":"是你，裂开图书馆的天。","x":"angry"},{"id":"ep-24:94","s":"heuk","t":"裂痕是你造的。靠锈刀支撑，天自然先裂。","nm":"声音"},{"id":"ep-24:95","s":"n","t":"猫站起，锈爪伸出刀刃，比昨天短了一半，尖端染锈。","fx":"claw","sfx":"slash","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":"claw","camera":"drift"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"}},{"id":"ep-24:96","s":"n","t":"刀锋斩断三只黑手。手变成六只回来。六只，又变成十二只。"},{"id":"ep-24:97","s":"heuk","t":"金与金，本就该相依。离开那孩子，到吾这里来。","nm":"声音"},{"id":"ep-24:98","s":"neo","t":"不要。我只负责她一人。","x":"serious"},{"id":"ep-24:99","s":"n","t":"一只黑手抓住Yeongnyangi后颈。另一只抓左爪，再一只抓尾巴。小小的身体，被拖向水里。","im":true,"shot":"close","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:100","s":"neo","t":"Yeoni。","x":"fear"},{"id":"ep-24:101","s":"n","t":"名字刚喊出口，Yeongnyangi就闭上嘴。叫她，她就会来。来了，就会站到这些手面前。"},{"id":"ep-24:102","s":"n","t":"白猫一声不吭，被拖入黑水。水面猛地翻涌一下，又像什么都没发生过般平静。","fx":"suck","sfx":"whoosh","shot":"impact","scene":{"background":"handsRush","backgroundMeaning":"작가 지정 배경: handsRush","transition":"hold","tone":"dark","ambient":null,"eventEffect":"suck","camera":"drift"},"a11y":{"description":"handsRush 배경에서 진행되는 서술"}},{"id":"ep-24:103","s":"n","t":"河边，什么也没留下。雾重新落下。","bg":"river","tone":"desat","bgm":"none","shot":"quiet","l":null,"c":null,"r":null,"scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"crossfade","tone":"desat","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"river 배경에서 진행되는 서술"}},{"id":"ep-24:104","s":"n","t":"日落，摩卡从市场回来转向河边。听说白圆的一团去了下游。","bg":"river","tone":"dark","bgm":"gloom2","shot":"wide","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"drift"},"a11y":{"description":"river 배경에서 진행되는 서술"}},{"id":"ep-24:105","s":"moka","t":"喂，客服。我来告状，猪哭了一夜。","x":"base","l":null,"c":{"who":"moka","x":"base"},"r":null},{"id":"ep-24:106","s":"n","t":"没有回应。摩卡嗅着鼻子，踩过一块块湿石头。金属熔化的气味，混着一种从未闻过的冰冷气味。"},{"id":"ep-24:107","s":"n","t":"水边泥地上，印着巨大的掌印。比人手大得多，手指长得过分。掌印中央，扎着一根白毛。","im":true,"shot":"close","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":null,"camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:108","s":"moka","t":"这个。","x":"only"},{"id":"ep-24:109","s":"n","t":"摩卡捡起毛，和她缠在前蹄上的一样，是猫的毛，却比河水还冷。"},{"id":"ep-24:110","s":"yeon","t":"摩卡！我到下游尽头了，什么也没——","x":"fear","l":{"who":"yeon","x":"fear"},"c":{"who":"moka","x":"only"},"r":null},{"id":"ep-24:111","s":"n","t":"Yeoni停住话。她看见摩卡爪中的白毛，也看见下面泥地上，巨大的手印。"},{"id":"ep-24:112","s":"yeon","t":"那是从哪儿来的。","x":"fear"},{"id":"ep-24:113","s":"moka","t":"猪，先坐下。坐着听。","x":"angry"},{"id":"ep-24:114","s":"yeon","t":"我问你，从哪儿来的！","x":"fear"},{"id":"ep-24:115","s":"n","t":"闰月喘着气跑来。没戴手套的掌心里，洞正在自行旋转。仿佛有什么庞然大物，刚在附近来过。","c":{"who":"yun","x":"pain"}},{"id":"ep-24:116","s":"yun","t":"迟了。刚才这儿，有很多那种手。","x":"pain"},{"id":"ep-24:117","s":"sys","t":"[ 时干 庚 · 借来的格子 · 连接中断 ]","im":true,"fx":"metal","sfx":"bell","shot":"close","scene":{"background":"river","backgroundMeaning":"작가 지정 배경: river","transition":"hold","tone":"dark","ambient":"moonlight","eventEffect":"metal","camera":"focus"},"a11y":{"description":"river 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:118","s":"n","t":"胸内钉着寒气的地方，什么忽地断了。只有她听见。"},{"id":"ep-24:119","s":"yeon","t":"Yeongnyangi被抓走了。","x":"cry"},{"id":"ep-24:120","s":"n","t":"天空的太阳，连最后一角也被吞尽。一轮黑圆，悬在河面上方。四周燃起环状红光。","bg":"eclipseSky","tone":"dark","bgm":"zeroPoint","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"eclipseSky 배경에서 진행되는 서술"}},{"id":"ep-24:121","s":"moka","t":"太阳。太阳没了。","x":"angry","l":{"who":"yeon","x":"fear"},"c":{"who":"moka","x":"angry"},"r":{"who":"yun","x":"serious"}},{"id":"ep-24:122","s":"yun","t":"日食。终于现出形体了。","x":"serious"},{"id":"ep-24:123","s":"heuk","t":"猫收到了，容器。正好空着刀鞘，还有些用。","im":true,"fx":"veil","sfx":"heartbeat","shot":"impact","nm":"声音","scene":{"background":"eclipseSky","backgroundMeaning":"작가 지정 배경: eclipseSky","transition":"hold","tone":"dark","ambient":null,"eventEffect":"veil","camera":"focus"},"a11y":{"description":"eclipseSky 배경에서 진행되는 heuk의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-24:124","s":"yeon","t":"还给我。把Yeongnyangi还给我！","x":"angry"},{"id":"ep-24:125","s":"heuk","t":"还你便是。你得来，做个空容器。","nm":"声音"},{"id":"ep-24:126","s":"n","t":"黑圆缓缓眨了一下，像眼皮。然后，河上所有影子，同时转头看向Yeoni。"}]}
