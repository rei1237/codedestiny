{"version":2,"sourceHash":"8ba562241517e1e324fbb5326f4ec69210a15b0a6dae5c333b57fe04c2e0c36e","locale":"zh-CN","id":"ep-09","no":"EP.09","tag":"第9话 · 黑羽审判","title":"黑羽审判","rev":2,"beats":[{"id":"ep-09:1","s":"n","t":"法庭是一座巨大的鸟笼。圆形铁栏直通天空，里面每级台阶上，都坐着身带灰印、沉默无言的人。","bg":"siksangB","bgm":"warRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"}},{"id":"ep-09:2","s":"n","t":"Yeoni连着网吊在被告席，网整夜都没有松过半分。","l":{"who":"yeon","x":"fear"}},{"id":"ep-09:3","s":"yeon","t":"这里有被告人权之类的吗？不然猪权也行。","x":"fear"},{"id":"ep-09:4","s":"n","t":"穿法袍的乌鸦落在高台上。面具下看不见眼睛，羽毛法槌敲了桌面一下。","r":{"who":"crow","x":"base"},"sfx":"bell"},{"id":"ep-09:5","s":"crow","t":"开庭。","x":"base"},{"id":"ep-09:6","s":"crow","t":"被告花猪，三项罪名：煽动歌唱，擅自品尝美食，过度使用感叹词。","x":"alt"},{"id":"ep-09:7","s":"yeon","t":"第三个真是头一次听说的罪。","x":"angry"},{"id":"ep-09:8","s":"crow","t":"据记录，被告昨日共发出四十七次感叹词。","x":"base"},{"id":"ep-09:9","s":"yeon","t":"你还数了？","x":"surprise"},{"id":"ep-09:10","s":"crow","t":"四十八次。","x":"alt"},{"id":"ep-09:11","s":"crow","t":"宣读示例。哼唧。哼——唧。哼呀。哇。绝了。疯了。","x":"base"},{"id":"ep-09:12","s":"yeon","t":"听法官用这种声音念，真的很羞耻。","x":"shy"},{"id":"ep-09:13","s":"neo","t":"哼呀这个词，我也是第一次听。","x":"deadpan"},{"id":"ep-09:14","s":"yeon","t":"你也听过啊！第一天就听了！","x":"angry"},{"id":"ep-09:15","s":"n","t":"台阶上几个人肩膀颤动，在忍笑。乌鸦猛地转头，那些肩膀顿时僵住。"},{"id":"ep-09:16","s":"neo","t":"辩护席在哪里。","x":"serious","c":{"who":"neo","x":"serious"}},{"id":"ep-09:17","s":"n","t":"Yeongnyangi被羽毛层层缠着，绑在证人席旁，可声音仍清晰传遍法庭。"},{"id":"ep-09:18","s":"crow","t":"不准被告有辩护人。","x":"base"},{"id":"ep-09:19","s":"neo","t":"按本岛法律，上台的人可以有一个鼓掌者，我来担任。","x":"lecture"},{"id":"ep-09:20","s":"yeon","t":"还有这种法律？","x":"surprise"},{"id":"ep-09:21","s":"neo","t":"刚想到的。","x":"deadpan"},{"id":"ep-09:22","s":"yeon","t":"律师最棒，五星。","x":"laugh"},{"id":"ep-09:23","s":"crow","t":"……允许。但条件是，鼓掌者不得鼓掌。","x":"alt","im":true,"scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksangB 배경에서 진행되는 crow의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-09:24","s":"neo","t":"猫用前爪鼓掌，本来就困难。","x":"deadpan"},{"id":"ep-09:25","s":"crow","t":"证物一号。","x":"base","bgm":"midnightPulse","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"siksangB 배경에서 진행되는 crow의 대사"}},{"id":"ep-09:26","s":"n","t":"一只乌鸦端来银盘，上面躺着吃了一半的年糕串。Yeoni眼睛亮了。"},{"id":"ep-09:27","s":"yeon","t":"啊，我的串。","x":"bliss"},{"id":"ep-09:28","s":"neo","t":"Yeoni，对着证物流口水，很难辩护的。","x":"serious"},{"id":"ep-09:29","s":"yeon","t":"身体先反应，不是我的错。","x":"shy"},{"id":"ep-09:30","s":"crow","t":"该串检出了滋味。交代来源。","x":"alt"},{"id":"ep-09:31","s":"n","t":"Yeoni紧闭嘴。摩卡的名字到了舌尖，又退了回去。"},{"id":"ep-09:32","s":"yeon","t":"地上捡的，反正是捡的。","x":"angry"},{"id":"ep-09:33","s":"crow","t":"追加虚假陈述。","x":"base"},{"id":"ep-09:34","s":"neo","t":"反对。食物好吃，总不能也怪吃的人。","x":"lecture"},{"id":"ep-09:35","s":"crow","t":"驳回。","x":"alt"},{"id":"ep-09:36","s":"neo","t":"反对，不能连赞叹都算歌唱。","x":"lecture"},{"id":"ep-09:37","s":"crow","t":"被告的哼——唧有音高，从sol落到mi。","x":"base"},{"id":"ep-09:38","s":"yeon","t":"连我的尖叫都配上唱名了？","x":"surprise"},{"id":"ep-09:39","s":"neo","t":"……这么一听，确实是sol到mi。","x":"think"},{"id":"ep-09:40","s":"yeon","t":"Yeongnyangi！你到底哪边的！","x":"angry"},{"id":"ep-09:41","s":"neo","t":"审判长，我对证物保管状态提出异议。串凉了。","x":"lecture"},{"id":"ep-09:42","s":"crow","t":"这有什么问题。","x":"alt"},{"id":"ep-09:43","s":"neo","t":"凉串不好吃。不好吃，就不构成擅自品尝美食。","x":"deadpan"},{"id":"ep-09:44","s":"yeon","t":"哦，刚才有点像律师了。","x":"excited"},{"id":"ep-09:45","s":"crow","t":"驳回。被告对凉串也流了口水。","x":"base"},{"id":"ep-09:46","s":"crow","t":"传证人。","x":"base","bgm":"warRoom","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"siksangB 배경에서 진행되는 crow의 대사"}},{"id":"ep-09:47","s":"n","t":"铁栏门开了，灰色市场的奶奶走进来。手背三枚印。她看见Yeoni，轻轻低了低头。","sfx":"door"},{"id":"ep-09:48","s":"crow","t":"证人，这头猪是否在市场唱过歌。","x":"alt"},{"id":"ep-09:49","s":"n","t":"奶奶无法回答，印已夺走话语。她把双手合在胸前，再慢慢展开。"},{"id":"ep-09:50","s":"yeon","t":"那是什么意思？","x":"think"},{"id":"ep-09:51","s":"neo","t":"意思是花开了。你在市场吃糖后微笑时。","x":"soft"},{"id":"ep-09:52","s":"n","t":"奶奶点头，台阶上几个人也跟着展开双手。无声的花在法庭各处绽放。"},{"id":"ep-09:53","s":"crow","t":"停下。","x":"base","im":true,"scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksangB 배경에서 진행되는 crow의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-09:54","s":"n","t":"乌鸦的声音第一次劈了。展开手的人赶紧放下。"},{"id":"ep-09:55","s":"yeon","t":"那个，法官，能问一件事吗？","x":"think"},{"id":"ep-09:56","s":"crow","t":"被告不得提问。","x":"alt"},{"id":"ep-09:57","s":"yeon","t":"那我自言自语。为什么讨厌歌到这种地步？歌是扇过法官耳光吗？","x":"think"},{"id":"ep-09:58","s":"yeon","t":"我也因为唱不好，被笑过不少。KTV最高分四十七。","x":"think"},{"id":"ep-09:59","s":"neo","t":"四十七，和今天的感叹词数相同。","x":"deadpan"},{"id":"ep-09:60","s":"n","t":"法庭静了下来，握着羽毛槌的爪子绷得发白。","bgm":"none","shot":"close","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"}},{"id":"ep-09:61","s":"crow","t":"歌声会招来嘲笑。","x":"base"},{"id":"ep-09:62","s":"crow","t":"没人唱，就没人嘲笑。","x":"alt"},{"id":"ep-09:63","s":"yeon","t":"……谁嘲笑过你？","x":"sad"},{"id":"ep-09:64","s":"n","t":"槌砸上桌面，桌子裂开。铁栏上的鸦群齐齐展开翅膀。","fx":"shake","sfx":"thud","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":"shake","camera":"drift"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"}},{"id":"ep-09:65","s":"crow","t":"判决。","x":"base","bgm":"crisis2","shot":"wide","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"siksangB 배경에서 진행되는 crow의 대사"}},{"id":"ep-09:66","s":"crow","t":"被告花猪，没收全部声音。鼓掌猫按同伙处理，没收帽子。","x":"alt"},{"id":"ep-09:67","s":"yeon","t":"帽子？为什么要拿Yeongnyangi的帽子！","x":"surprise"},{"id":"ep-09:68","s":"crow","t":"世上最喧闹的帽子。","x":"base"},{"id":"ep-09:69","s":"neo","t":"我就当夸奖了。","x":"deadpan"},{"id":"ep-09:70","s":"n","t":"两只乌鸦拿着剪刀靠近Yeongnyangi，刀锋碰到帽尖穗饰。一缕金穗落到地上。"},{"id":"ep-09:71","s":"n","t":"Yeongnyangi眼也没眨。Yeoni的呼吸却急促起来，耳中，心跳如鼓。","im":true,"scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-09:72","s":"yeon","t":"别碰。","x":"angry"},{"id":"ep-09:73","s":"crow","t":"被告不得发言。","x":"alt"},{"id":"ep-09:74","s":"yeon","t":"我说别碰！","x":"angry"},{"id":"ep-09:75","s":"n","t":"Yeoni出口的话变成火。文字形状的火焰蹿向空中。别、碰、它、啊。四团火熔化了剪刀。","fx":"fire","sfx":"fire","im":true,"shot":"impact","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":"fire","camera":"focus"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-09:76","s":"crow","t":"……伤官。","x":"base"},{"id":"ep-09:77","s":"n","t":"火没有停。Yeoni每次呼吸，话就更灼热。铁栏烧红，台阶上的人往后退。"},{"id":"ep-09:78","s":"yeon","t":"不喜欢唱歌，你自己别唱就好！为什么堵别人的嘴！","x":"angry"},{"id":"ep-09:79","s":"neo","t":"Yeoni，停！","x":"serious"},{"id":"ep-09:80","s":"yeon","t":"就喜欢大家这么安静地活？没什么可笑的岛，就那么好？","x":"angry"},{"id":"ep-09:81","s":"n","t":"一道火焰转向台阶，正是奶奶坐的地方。Yeongnyangi撕开缠身羽毛，冲了过去。","c":{"who":"neo","x":"fear"}},{"id":"ep-09:82","s":"n","t":"白光与红火相撞，Yeongnyangi用前爪击开火焰。火掠过奶奶头顶，撞上铁栏散开。","fx":"flash","sfx":"whoosh","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":"flash","camera":"drift"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"}},{"id":"ep-09:83","s":"yeon","t":"Ye、Yeongnyangi？","x":"fear"},{"id":"ep-09:84","s":"neo","t":"没事。先呼吸，慢慢来。","x":"calm"},{"id":"ep-09:85","s":"n","t":"Yeoni吸气，火渐渐弱下去，嘴里留着焦味。Yeongnyangi却把前爪藏在背后。"},{"id":"ep-09:86","s":"yeon","t":"我刚才差点打中奶奶。","x":"cry"},{"id":"ep-09:87","s":"neo","t":"打中了，我会骂你。没打中，就行。","x":"soft"},{"id":"ep-09:88","s":"crow","t":"看到了吗。话语是火，所以才要封住。","x":"alt"},{"id":"ep-09:89","s":"yeon","t":"……","x":"sad"},{"id":"ep-09:90","s":"n","t":"这时，法庭顶上的通风口传来金属声。哐当，哐当。有什么正滚下来。","bgm":"warTheme","sfx":"drum","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"}},{"id":"ep-09:91","s":"moka","t":"您点的炸物上桌了！","x":"angry","r":{"who":"moka","x":"angry"},"im":true,"scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksangB 배경에서 진행되는 moka의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-09:92","s":"n","t":"摩卡从通风口落下，掀翻油锅。面糊团碰上铁栏热气，白烟爆炸般腾起。","fx":"burst","sfx":"fire","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":"burst","camera":"drift"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"}},{"id":"ep-09:93","s":"crow","t":"驱散烟雾！","x":"base"},{"id":"ep-09:94","s":"moka","t":"晚了。我奶奶的烟幕炸物，十分钟都散不了。","x":"angry"},{"id":"ep-09:95","s":"yeon","t":"用炸物做烟幕，也行？","x":"surprise"},{"id":"ep-09:96","s":"moka","t":"面糊里放双倍面粉，不过不好吃，别吃。","x":"base"},{"id":"ep-09:97","s":"yeon","t":"这个最让人难过。","x":"sad"},{"id":"ep-09:98","s":"n","t":"摩卡的菜刀割断网角，Yeoni从被告席滚落。Yeongnyangi咬住后颈，把人拖起。","fx":"claw","sfx":"slash","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"natural","ambient":null,"eventEffect":"claw","camera":"drift"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"}},{"id":"ep-09:99","s":"neo","t":"出口呢。","x":"serious"},{"id":"ep-09:100","s":"moka","t":"下水道。想活命，就忍着味。","x":"angry"},{"id":"ep-09:101","s":"yeon","t":"我被网勒得都成花纹猪了，还要下水道？","x":"fear"},{"id":"ep-09:102","s":"neo","t":"花纹以后再难过，跑。","x":"serious"},{"id":"ep-09:103","s":"n","t":"下水道尽头通向海边山丘下。傍晚的海没有声音，浪涌过来也没有拍岸声。","bg":"siksang3","tone":"dark","bgm":"gloom2","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-09:104","s":"yeon","t":"海好像也被盖印了。","x":"disappoint","l":{"who":"yeon","x":"disappoint"},"c":{"who":"neo","x":"calm"},"r":{"who":"moka","x":"base"}},{"id":"ep-09:105","s":"moka","t":"从太阳停下那天就这样，浪闭上了嘴。","x":"base"},{"id":"ep-09:106","s":"n","t":"摩卡从岩石后拿出小火种罐，用剩余面糊煎了张薄饼。这回香味对了。"},{"id":"ep-09:107","s":"moka","t":"吃吧，是好吃的那种。","x":"base"},{"id":"ep-09:108","s":"n","t":"一口咬下，油煎的香味散开，Yeoni的耳朵自动扇了起来。","sfx":"sparkle"},{"id":"ep-09:109","s":"yeon","t":"谢谢……可是你为什么来？被发现，你也会被盖印啊。","x":"sad"},{"id":"ep-09:110","s":"moka","t":"不是说听见就是同伙吗。同伙丢下同伙，还算什么同伙。","x":"angry"},{"id":"ep-09:111","s":"yeon","t":"你还挺讲义气。","x":"smile"},{"id":"ep-09:112","s":"moka","t":"不是还挺，是明摆着很讲。","x":"angry"},{"id":"ep-09:113","s":"n","t":"饼吃到一半，Yeoni停了。蹄尖仍刺痛，是火经过的地方。"},{"id":"ep-09:114","s":"yeon","t":"刚才那个，是我。我的话变成了火。","x":"sad"},{"id":"ep-09:115","s":"neo","t":"伤官，是从你内里向外释放的力量中，最锋利的一种。","x":"lecture"},{"id":"ep-09:116","s":"yeon","t":"那食神呢？","x":"think"},{"id":"ep-09:117","s":"neo","t":"同样的火，朝着让人吃了会笑的方向燃烧，就是食神。","x":"soft"},{"id":"ep-09:118","s":"moka","t":"简单说，烤串的火和烧房子的火。火一样，用的人不同。","x":"base"},{"id":"ep-09:119","s":"yeon","t":"哦，摩卡老师讲得更好懂啊？","x":"grin"},{"id":"ep-09:120","s":"neo","t":"我是猫，不擅长比喻，哼。","x":"deadpan"},{"id":"ep-09:121","s":"moka","t":"奶奶说过，太阳本来就是用歌声托起来的。正午大家一起唱，太阳就升得最高。","x":"base"},{"id":"ep-09:122","s":"yeon","t":"那正午唱歌，太阳就会再动？","x":"surprise"},{"id":"ep-09:123","s":"moka","t":"老故事，童话啦，别当真。","x":"angry"},{"id":"ep-09:124","s":"yeon","t":"我可是特别容易信童话的类型。","x":"grin"},{"id":"ep-09:125","s":"neo","t":"丙是正午的太阳。若它无法跨过正午，那童话并不算错。","x":"think"},{"id":"ep-09:126","s":"moka","t":"……真的？那奶奶说对了？","x":"base","im":true,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 moka의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-09:127","s":"n","t":"笑声渐止。Yeoni抱住膝头，望着无声的浪。","sfx":"heartbeat","im":true,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-09:128","s":"yeon","t":"那乌鸦，刚才声音劈了的时候，看着真的很痛。","x":"sad"},{"id":"ep-09:129","s":"moka","t":"别同情它。那家伙拆走了我奶奶店里的招牌。","x":"base"},{"id":"ep-09:130","s":"yeon","t":"不是同情，只是在想，当时是谁笑了呢。","x":"sad"},{"id":"ep-09:131","s":"n","t":"没有人回答。过了一会儿，Yeoni的呼吸慢下来。猪含着饼睡着了。"},{"id":"ep-09:132","s":"n","t":"Yeongnyangi独自走向水边，把前爪浸进无声的浪里。","l":null,"r":null,"c":{"who":"neo","x":"sad"},"bgm":"none","shot":"quiet","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-09:133","s":"n","t":"蒸汽升起。白毛下皮肤烧得发黑，烧痕像一个字。傷。","fx":"water","sfx":"water","shot":"close","im":true,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":"water","camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-09:134","s":"neo","t":"……比想象中快。","x":"sad"},{"id":"ep-09:135","s":"n","t":"Yeongnyangi从水里抽出前爪，拢上毛遮住。回头时，Yeoni仍在睡。"},{"id":"ep-09:136","s":"n","t":"与此同时，空法庭里，乌鸦捡起地上掉落的一缕金色帽穗。","bg":"siksangB","tone":"dark","bgm":"crisis","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksangB 배경에서 진행되는 서술"}},{"id":"ep-09:137","s":"crow","t":"伤官醒了。再这样，正午就会到来。","x":"alt","r":{"who":"crow","x":"base"}},{"id":"ep-09:138","s":"n","t":"乌鸦把金穗放进怀里。怀中一根黑羽自行颤动，没有风。"},{"id":"ep-09:139","s":"crow","t":"在那之前，吞掉那头猪的声音。","x":"base","im":true,"shot":"impact","scene":{"background":"siksangB","backgroundMeaning":"작가 지정 배경: siksangB","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksangB 배경에서 진행되는 crow의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}}]}
