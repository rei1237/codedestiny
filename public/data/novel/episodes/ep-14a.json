{"version":2,"sourceHash":"46c9cd86ab1ac97d2482693e8c4af40052df61b0aebb1da8a2732a1597f1e00c","id":"ep-14a","no":"EP.14A","tag":"EP.14A · 숨을 받치는 법","title":"숨을 받치는 법","rev":2,"beats":[{"id":"ep-14a:1","s":"n","t":"빵집 다락. 밀가루 포대를 쌓아 만든 탁자 위에 윤달이 종이 한 장을 펼쳤다. 숯으로 그린 시계탑 단면도였다.","bg":"jae","tone":"dark","bgm":"warRoom","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-14a:2","s":"yun","t":"금고는 시계탑 아래 일곱 층이에요. 층이 깊어질수록 시간이 느려져요.","x":"serious","l":{"who":"yeon","x":"serious"},"c":{"who":"yun","x":"serious"},"r":{"who":"moka","x":"base"}},{"id":"ep-14a:3","s":"yun","t":"마지막 칸쯤 가면 한 걸음 떼는 데 한 시간쯤 걸리죠. 숨 한 번이 하루일 수도 있고요.","x":"base"},{"id":"ep-14a:4","s":"moka","t":"그럼 거기서 재채기하면 일주일 날아가는 거야?","x":"angry"},{"id":"ep-14a:5","s":"yun","t":"재채기는 참으세요. 모카 씨는 특히.","x":"laugh"},{"id":"ep-14a:6","s":"moka","t":"왜 나만 특히야.","x":"base"},{"id":"ep-14a:7","s":"yun","t":"수달은 코가 예민하잖아요. 아, 그러고 보니 모카 씨 생시는 언제예요?","x":"sly"},{"id":"ep-14a:8","s":"moka","t":"지금 이 상황에 수달한테 생시를 물어? 별 하나.","x":"angry","im":true,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 moka의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-14a:9","s":"yeon","t":"아저씨 그거 버릇이죠. 만나는 사람마다 묻는 거.","x":"laugh"},{"id":"ep-14a:10","s":"yun","t":"직업병이에요. 생시를 알면 그 사람이 어디서 넘어질지 보이거든요.","x":"base"},{"id":"ep-14a:11","s":"neo","t":"넘어질 곳은 정해져 있다. 일곱째 칸. 시간이 거의 멈춘 곳이다.","x":"serious","c":{"who":"neo","x":"serious"}},{"id":"ep-14a:12","s":"yun","t":"거기선 보통 숨으로는 못 버텨요. 숨이 얼어서 가슴에 걸리거든요.","x":"serious"},{"id":"ep-14a:13","s":"yeon","t":"숨이 얼어? 그럼 어떻게 들어가?","x":"fear"},{"id":"ep-14a:14","s":"neo","t":"받치면 된다. 숨이 떨어지지 않게 아래에서 받쳐 주는 거다.","x":"calm"},{"id":"ep-14a:15","s":"yun","t":"그 전에 역할부터 나눌게요. 모카 씨는 입구에서 냄새로 경비를 홀리고.","x":"serious"},{"id":"ep-14a:16","s":"moka","t":"경비가 뭔데. 토끼야?","x":"base"},{"id":"ep-14a:17","s":"yun","t":"시간을 못 갚은 사람들이에요. 금고 앞에 빚 대신 서 있죠. 배가 고플 거예요. 아주 오래.","x":"base"},{"id":"ep-14a:18","s":"moka","t":"그럼 홀리는 게 아니라 먹이는 거네. 그건 자신 있어.","x":"moved"},{"id":"ep-14a:19","s":"n","t":"모카의 수염이 축 처졌다가 다시 섰다. 맛을 잃었던 식상의 섬 사람들 얼굴이 스친 모양이었다.","im":true,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-14a:20","s":"yun","t":"사자님은 길을 열고, 저는 잠긴 문을 먹고. 숙녀분은 가장 깊은 칸까지.","x":"serious"},{"id":"ep-14a:21","s":"yeon","t":"왜 내가 제일 깊이 가?","x":"surprise"},{"id":"ep-14a:22","s":"yun","t":"일곱째 칸 문은 제 손으로 번 시간으로만 열려요. 우리 중에 그걸 가진 사람은 숙녀분뿐이에요.","x":"base"},{"id":"ep-14a:23","s":"yeon","t":"(내 12분.)","x":"think"},{"id":"ep-14a:24","s":"n","t":"연이는 앞발의 작은 글씨를 다른 앞발로 가렸다. 액자에 넣겠다던 12분이 갑자기 무거워졌다.","im":true,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-14a:25","s":"yeon","t":"이 계획 리뷰해도 돼? 무모함 별 다섯, 디테일 별 셋. 생존율은 아직 별을 못 정하겠어.","x":"talk"},{"id":"ep-14a:26","s":"yun","t":"정직한 리뷰네요. 3년 동안 받은 것 중에 제일이에요.","x":"laugh"},{"id":"ep-14a:27","s":"n","t":"지붕 위. 섬의 째깍 소리가 멀어졌다. 네오는 연이를 마주 보고 앉아 제 앞발을 내밀었다.","bg":"jae","tone":"dark","bgm":"focusFlow","shot":"wide","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-14a:28","s":"neo","t":"내 발 위에 네 앞발을 얹어라. 들이쉴 때 나를 누르고, 내쉴 때 나를 놓지 마라.","x":"calm","l":{"who":"yeon","x":"calm"},"c":null,"r":{"who":"neo","x":"calm"}},{"id":"ep-14a:29","s":"yeon","t":"누르고, 놓지 말고. 알았어. 쉬운데?","x":"calm"},{"id":"ep-14a:30","s":"n","t":"첫 숨은 쉬웠다. 두 번째 숨에서 가슴 한가운데가 뻐근해졌다. 세 번째 숨에서 연이의 앞발이 미끄러졌다.","sfx":"heartbeat"},{"id":"ep-14a:31","s":"yeon","t":"하나도 안 쉬워. 숨이 자꾸 위로 도망가.","x":"disappoint"},{"id":"ep-14a:32","s":"neo","t":"위로 끌어올리니까 그렇다. 잡아당기지 말고 바닥에 내려놔라.","x":"talk"},{"id":"ep-14a:33","s":"yeon","t":"(잡아당기지 말고. 어디서 들어 본 말인데.)","x":"think","im":true,"shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-14a:34","s":"n","t":"연이가 눈을 감았다. 숨을 가슴이 아니라 배 아래까지 내려보냈다. 네오의 앞발이 그 숨을 아래에서 떠받쳤다."},{"id":"ep-14a:35","s":"n","t":"연이의 앞발 끝에서 연둣빛 싹이 하나 돋았다. 싹은 네오의 발등을 타고 천천히 감겨 올라갔다.","fx":"wood","sfx":"chime","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":"wood","camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-14a:36","s":"yeon","t":"됐다! 봤어? 싹 났어!","x":"excited"},{"id":"ep-14a:37","s":"n","t":"그 순간 네오의 발에서 은빛이 번쩍였다. 감겨 오르던 싹이 소리도 없이 잘려 지붕 위로 떨어졌다.","fx":"metal","sfx":"slash","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":"metal","camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-14a:38","s":"yeon","t":"어… 왜 잘렸어?","x":"surprise"},{"id":"ep-14a:39","s":"neo","t":"내 기운은 금이다. 금은 나무를 벤다.","x":"sad","im":true,"scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 neo의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-14a:40","s":"neo","t":"기억해 둬라. 나는 너를 다치게 하는 기운이야. 가까이 붙을수록 더.","x":"serious"},{"id":"ep-14a:41","s":"yeon","t":"근데 방금 숨은 네가 받쳐 줬잖아. 다치게 하는 기운이 그렇게 받쳐 줘?","x":"serious"},{"id":"ep-14a:42","s":"neo","t":"그건…","x":"think","pacing":{"pauseMs":350,"importance":"breath"}},{"id":"ep-14a:43","s":"yeon","t":"대답 못 하지. 그럼 내 해석이 맞는 걸로 할게. 반은 베고 반은 받쳐 주는 기운.","x":"grin"},{"id":"ep-14a:44","s":"n","t":"네오는 대답 대신 잘린 싹을 주워 연이의 귀 뒤에 꽂아 주었다."},{"id":"ep-14a:45","s":"yeon","t":"이거… 장식이야? 리본 같은 거야?","x":"shy"},{"id":"ep-14a:46","s":"neo","t":"증거물이다. 수련 중에 다쳤다는.","x":"deadpan"},{"id":"ep-14a:47","s":"yeon","t":"증거물을 귀에 꽂아 주는 사자는 처음 봐. 별 네 개.","x":"laugh"},{"id":"ep-14a:48","s":"neo","t":"하나는 왜 빼지.","x":"smirk"},{"id":"ep-14a:49","s":"yeon","t":"설명이 너무 짧았으니까.","x":"happy"},{"id":"ep-14a:50","s":"n","t":"다락 창문 아래에서 모카가 꼬치를 뒤집다가 혀를 찼다. 저 둘 수련하는 거야, 데이트하는 거야."},{"id":"ep-14a:51","s":"yeon","t":"다 들려! 수련이거든! 증거물도 있거든!","x":"angry"},{"id":"ep-14a:52","s":"n","t":"연이가 다시 다락으로 내려간 뒤에도 네오는 지붕 끝에 남았다. 달빛 아래로 그가 왼 앞발을 뒤집었다.","bgm":"neo","shot":"wide","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jae 배경에서 진행되는 서술"}},{"id":"ep-14a:53","s":"n","t":"발바닥의 털이 군데군데 타 있었다. 까마귀 재판정에서 그을린 자리였다. 상처 위로 방금 싹이 남긴 초록 물이 번져 있었다.","im":true,"shot":"close","scene":{"background":"jae","backgroundMeaning":"작가 지정 배경: jae","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jae 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-14a:54","s":"yun","t":"그 발, 아직 안 나았네요.","x":"base","l":null,"c":null,"r":{"who":"yun","x":"base"}},{"id":"ep-14a:55","s":"neo","t":"언제부터 봤지.","x":"serious"},{"id":"ep-14a:56","s":"yun","t":"처음 천막에서요. 사자님 발 디딜 때 왼쪽이 늘 반 박자 늦더라고요.","x":"serious"},{"id":"ep-14a:57","s":"yun","t":"숙녀분 명식에 상관이 커요. 말이 불이 되는 기운. 그 불이 커질수록 관이 다치죠.","x":"serious"},{"id":"ep-14a:58","s":"neo","t":"그 관이 누구인지 말하지 마라. 그녀에게도.","x":"calm"},{"id":"ep-14a:59","s":"yun","t":"말 안 하면 언젠가 터져요. 상처는 숨긴다고 작아지지 않거든요.","x":"serious"},{"id":"ep-14a:60","s":"neo","t":"알고 있다. 그래도 지금은 아니다. 그녀가 자기 불을 무서워하게 되는 건 싫다.","x":"serious"},{"id":"ep-14a:61","s":"n","t":"윤달은 한동안 네오의 옆얼굴을 보았다. 사자의 금빛 눈이 다락 창의 불빛 쪽만 향해 있었다."},{"id":"ep-14a:62","s":"yun","t":"비밀 하나 맡는 값은 비싼데요. 사자님 생시 하나면 될 것 같은데.","x":"sly"},{"id":"ep-14a:63","s":"neo","t":"모른다. 내 생일은.","x":"deadpan"},{"id":"ep-14a:64","s":"yun","t":"진짜 모르는 거였어요? 어제 농담인 줄 알았는데.","x":"surprise"},{"id":"ep-14a:65","s":"n","t":"윤달은 웃음을 거두고, 장갑 낀 손으로 네오의 어깨를 한 번 두드렸다."},{"id":"ep-14a:66","s":"yun","t":"좋아요. 외상으로 해 둘게요. 저도 외상 인생이라 그 기분 알아요.","x":"base"},{"id":"ep-14a:67","s":"n","t":"새벽 두 시. 넷은 시계탑 아래 광장 그늘에 모였다. 탑 꼭대기의 바늘이 느릿느릿 돌았다.","bg":"jaeEnter","tone":"dark","bgm":"crisis","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jaeEnter","backgroundMeaning":"작가 지정 배경: jaeEnter","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter 배경에서 진행되는 서술"}},{"id":"ep-14a:68","s":"moka","t":"냄새 교란용 꼬치 마흔 개. 매운맛 스무 개, 단맛 스무 개.","x":"base","l":{"who":"yeon","x":"serious"},"c":{"who":"neo","x":"serious"},"r":{"who":"moka","x":"base"}},{"id":"ep-14a:69","s":"yeon","t":"루나 언니 남은 시간은 네 시간. 해 뜨기 전에 나온다.","x":"serious"},{"id":"ep-14a:70","s":"sys","t":"[ 루나 언니 · 남은 오늘 03:58:12 ]","im":true,"fx":"script","scene":{"background":"jaeEnter","backgroundMeaning":"작가 지정 배경: jaeEnter","transition":"hold","tone":"dark","ambient":null,"eventEffect":"script","camera":"focus"},"a11y":{"description":"jaeEnter 배경에서 진행되는 시스템 메시지"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-14a:71","s":"neo","t":"숨 받치는 법, 잊지 마라.","x":"calm"},{"id":"ep-14a:72","s":"yeon","t":"귀에 증거물 꽂고 다니는데 어떻게 잊어.","x":"grin"},{"id":"ep-14a:73","s":"n","t":"연이는 시계탑 꼭대기를 올려다보았다. 바늘 위에는 아무도 없었다. 그게 더 무서웠다."},{"id":"ep-14a:74","s":"yun","t":"호랑이는 아래에 있어요. 금고지기는 금고 앞을 떠나지 않으니까.","x":"serious"},{"id":"ep-14a:75","s":"moka","t":"그 줄무늬, 식상의 섬에서 박수를 걷어 간 녀석이지. 이번엔 내 차례야.","x":"angry"},{"id":"ep-14a:76","s":"yeon","t":"싸우러 가는 거 아니야. 돌려받으러 가는 거야.","x":"serious"},{"id":"ep-14a:77","s":"neo","t":"그 말, 일곱째 칸에서도 기억해라.","x":"calm"},{"id":"ep-14a:78","s":"n","t":"윤달이 장갑을 고쳐 끼었다. 손가락 끝이 아주 조금 떨렸다.","im":true,"shot":"close","scene":{"background":"jaeEnter","backgroundMeaning":"작가 지정 배경: jaeEnter","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-14a:79","s":"yeon","t":"아저씨 이름도 찾자. 찾으면 내가 제일 먼저 불러 줄게.","x":"gentle"},{"id":"ep-14a:80","s":"yun","t":"그럼 숙녀분이 제 이름을 부르는 세 번째 사람이 되겠네요.","x":"sad"},{"id":"ep-14a:81","s":"yeon","t":"왜 세 번째예요?","x":"surprise"},{"id":"ep-14a:82","s":"yun","t":"첫 번째는 엄마, 두 번째는 저. 그다음이 숙녀분.","x":"base"},{"id":"ep-14a:83","s":"n","t":"탑의 종이 두 번 울렸다. 넷은 그림자를 따라 시계탑의 문 안으로 미끄러져 들어갔다.","sfx":"bell","im":true,"shot":"wide","scene":{"background":"jaeEnter","backgroundMeaning":"작가 지정 배경: jaeEnter","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}}]}
