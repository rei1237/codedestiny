{"version":2,"sourceHash":"fcd6b2a60ca39d0c9c0a0269c0d4e1c507126080ef6b1b526e4c11714b76a05d","id":"ep-12a","no":"EP.12A","tag":"EP.12A · 장부의 빈 줄","title":"장부의 빈 줄","rev":2,"beats":[{"id":"ep-12a:1","s":"n","t":"해가 돌아온 섬에 처음으로 저녁이 왔다. 해는 제 시간에 맞춰 수평선으로 내려가고 있었다. 광장 쪽에서는 아직 냄비 뚜껑 소리가 띄엄띄엄 들렸다.","bg":"siksang3","tone":"dark","bgm":"gloom2","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-12a:2","s":"n","t":"바닷가 언덕은 조용했다. 파도가 모래를 핥고 물러날 때마다 젖은 소금 냄새가 올라왔다."},{"id":"ep-12a:3","s":"n","t":"검은 호랑이가 바위 위에 엎드려 있었다. 앞발 사이에 두꺼운 장부 한 권이 펼쳐져 있었다.","r":{"who":"tiger","x":"base"}},{"id":"ep-12a:4","s":"n","t":"종이는 낡았는데 글씨는 새것처럼 반짝였다. 빌려준 것과 거둔 것이 한 줄도 어긋남 없이 적혀 있었다."},{"id":"ep-12a:5","s":"tiger","t":"정리하자. 오늘 들어온 것부터.","x":"base"},{"id":"ep-12a:6","s":"n","t":"발톱 끝이 첫 장을 넘겼다. 종이 넘어가는 소리가 파도 소리 사이에 또렷하게 끼어들었다.","sfx":"page"},{"id":"ep-12a:7","s":"tiger","t":"지하 무대. 빌려준 박수 열두 묶음, 회수 완료.","x":"talk"},{"id":"ep-12a:8","s":"tiger","t":"노래꾼 여울. 목소리 한 가닥, 회수 완료.","x":"talk"},{"id":"ep-12a:9","s":"tiger","t":"빌린 박수로 무대에 섰으면, 내려올 때 갚는 게 맞아. 누구도 억지로 빌리게 하진 않았어.","x":"base"},{"id":"ep-12a:10","s":"n","t":"장부 사이에서 은빛 실 한 가닥이 저절로 풀려 올라왔다. 실은 바람도 없는데 가늘게 떨었다.","fx":"thread","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":"thread","camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-12a:11","s":"n","t":"실 끝에서 아주 작은 소리가 났다. 누군가 숨을 들이마시고, 첫 음을 고르는 소리였다."},{"id":"ep-12a:12","s":"tiger","t":"쉿. 넌 내 거야. 값은 치렀잖아.","x":"base"},{"id":"ep-12a:13","s":"n","t":"호랑이는 실을 발톱으로 눌러 다시 종이 사이에 끼웠다. 떨림은 한참 뒤에야 멎었다."},{"id":"ep-12a:14","s":"n","t":"그때 수평선에 걸린 해가 한 번 깜빡였다.","bgm":"zeroPoint","sfx":"glitch","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-12a:15","s":"n","t":"빛이 꺼진 자리에서 물결이 거꾸로 일었다. 모래 위에 검은 손가락 자국이 하나씩 찍히며 다가왔다."},{"id":"ep-12a:16","s":"n","t":"수면 위로 검은 손 여러 개가 솟았다. 손들은 호랑이를 둘러싸고 손바닥을 위로 펼쳤다.","fx":"hands","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":"hands","camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-12a:17","s":"heuk","t":"해가 돌아왔더구나.","nm":"목소리"},{"id":"ep-12a:18","s":"tiger","t":"…돌아왔습니다. 노래 때문에요.","x":"base","im":true,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 tiger의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12a:19","s":"heuk","t":"노래. 그 돼지의 노래.","nm":"목소리"},{"id":"ep-12a:20","s":"heuk","t":"깃털 하나를 잃었다. 그 아이는 쓸 만한 그릇이었는데.","nm":"목소리"},{"id":"ep-12a:21","s":"tiger","t":"까마귀는 제 몫이 아니었습니다. 저는 박수만 맡았어요.","x":"talk"},{"id":"ep-12a:22","s":"heuk","t":"그래서 박수는 거뒀느냐.","nm":"목소리"},{"id":"ep-12a:23","s":"n","t":"호랑이의 수염이 아주 조금 움직였다. 장부 위에 올린 앞발에 힘이 들어갔다."},{"id":"ep-12a:24","s":"tiger","t":"…대부분은요.","x":"base"},{"id":"ep-12a:25","s":"n","t":"오른 앞발의 금 고리가 달아올랐다. 고리는 한 칸 좁아지며 털을 파고들었다.","sfx":"heartbeat"},{"id":"ep-12a:26","s":"tiger","t":"크읏…!","x":"angry","im":true,"shot":"close","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 tiger의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12a:27","s":"heuk","t":"대부분. 나는 대부분을 맡긴 적이 없다.","nm":"목소리"},{"id":"ep-12a:28","s":"n","t":"호랑이는 고개를 숙였다. 숨을 고르는 동안 고리 아래로 가는 열이 계속 번졌다."},{"id":"ep-12a:29","s":"tiger","t":"다음엔 남기지 않겠습니다.","x":"sad"},{"id":"ep-12a:30","s":"heuk","t":"너는 약속을 지키는 짐승이지. 그래서 골랐다. 잊지 마라, 네가 왜 여기 있는지.","nm":"목소리"},{"id":"ep-12a:31","s":"tiger","t":"잊은 적 없습니다. 그 아이가 괴물이 되기 전에 막는 것.","x":"base","im":true,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 tiger의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12a:32","s":"heuk","t":"다음 섬은 시간을 사고파는 곳이다. 거기서 그 돼지의 시간을 거둬라.","nm":"목소리"},{"id":"ep-12a:33","s":"heuk","t":"한 시간도 남기지 마라. 비어야 담긴다.","nm":"목소리"},{"id":"ep-12a:34","s":"tiger","t":"담긴다니요. 무엇이—","x":"surprise","pacing":{"pauseMs":350,"importance":"breath"}},{"id":"ep-12a:35","s":"n","t":"대답 대신 손들이 물속으로 꺼졌다. 노을이 다시 번졌고, 파도는 아무 일 없었다는 듯 모래를 핥았다.","sfx":"whoosh"},{"id":"ep-12a:36","s":"n","t":"고리의 열은 쉽게 식지 않았다. 호랑이는 앞발을 바닷물에 담갔다가, 한참 뒤에 꺼냈다.","bgm":"memWater","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-12a:37","s":"tiger","t":"비어야 담긴다. 뭘 담겠다는 건지.","x":"base"},{"id":"ep-12a:38","s":"tiger","t":"상관없어. 시키는 대로 거두면 끝나. 그게 계약이니까.","x":"talk"},{"id":"ep-12a:39","s":"n","t":"호랑이는 다시 장부를 넘겼다. 식상의 섬 마지막 장, 거기에 꽃돼지의 줄이 있었다.","sfx":"page"},{"id":"ep-12a:40","s":"n","t":"받은 것은 없었다. 거절한 박수 천 개. 거절한 거래 하나. 그 옆에 붉은 글씨가 저절로 떠올랐다."},{"id":"ep-12a:41","s":"sys","t":"[ 꽃돼지 · 미수(未收) ]","fx":"script","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":"script","camera":"steady"},"a11y":{"description":"siksang3 배경에서 진행되는 시스템 메시지"}},{"id":"ep-12a:42","s":"tiger","t":"미수…?","x":"surprise","im":true,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 tiger의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12a:43","s":"n","t":"호랑이는 앞발로 글자를 문질렀다. 붉은 글씨는 번지지도 않고 사라지지도 않았다."},{"id":"ep-12a:44","s":"tiger","t":"내 장부에 미수는 없어. 지금까지 한 번도.","x":"angry"},{"id":"ep-12a:45","s":"tiger","t":"거절한 값은 따로 받는다고 했잖아. 그럼 받으면 돼. 간단한 계산이야.","x":"talk"},{"id":"ep-12a:46","s":"n","t":"말은 그렇게 했지만 발톱은 그 줄 위에서 오래 멈춰 있었다."},{"id":"ep-12a:47","s":"n","t":"낮에 본 장면이 자꾸 겹쳤다. 목소리도 없이 무대 위에 서서 냄비 뚜껑을 들고 있던 분홍 돼지."},{"id":"ep-12a:48","s":"tiger","t":"바보 같은 녀석. 빌린 박수였으면 훨씬 쉬웠을 텐데.","x":"base"},{"id":"ep-12a:49","s":"tiger","t":"다친 걸 보면 멈추고, 공짜로 주고, 받을 건 안 받고. 그런 녀석은 오래 못 버텨.","x":"talk"},{"id":"ep-12a:50","s":"tiger","t":"…그런 녀석이 괴물이 된다고? 계산이 안 맞잖아.","x":"sad"},{"id":"ep-12a:51","s":"n","t":"그때 바다 쪽에서 빗소리가 났다. 호랑이는 고개를 들었다. 하늘은 맑았고, 노을만 붉었다.","bgm":"rainWindow","sfx":"rain","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-12a:52","s":"n","t":"빗소리는 귀 안쪽에서만 들리고 있었다."},{"id":"ep-12a:53","s":"n","t":"아주 짧은 장면이 스쳤다. 젖은 아스팔트. 버스 정류장의 깜빡이는 불빛. 머리 위로 기울어진 노란 우산.","im":true,"shot":"quiet","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12a:54","s":"n","t":"우산 아래에서 누군가 웃었다. 얼굴은 보이지 않았다. 반쯤 젖은 어깨만 보였다."},{"id":"ep-12a:55","s":"tiger","t":"…뭐야, 지금 건.","x":"surprise"},{"id":"ep-12a:56","s":"n","t":"빗소리가 뚝 끊겼다. 파도 소리만 남았다. 호랑이는 앞발로 이마를 눌렀다."},{"id":"ep-12a:57","s":"tiger","t":"피곤한 거야. 섬 하나를 통째로 단속했으니까.","x":"base"},{"id":"ep-12a:58","s":"n","t":"호랑이는 장부를 몇 장 거꾸로 넘겼다. 비겁의 섬 장. 거기에는 지워야 할 줄이 하나 남아 있었다.","sfx":"page"},{"id":"ep-12a:59","s":"sys","t":"[ 북 치는 아이 · 이름 — 보관 중 ]"},{"id":"ep-12a:60","s":"tiger","t":"이름 하나. 보관 중이 아니라 회수 완료로 고치면 끝이야.","x":"talk"},{"id":"ep-12a:61","s":"n","t":"호랑이는 망토 안쪽을 더듬었다. 금실로 꿰맨 작은 주머니 안에서 이름 하나가 따뜻하게 맥박 쳤다."},{"id":"ep-12a:62","s":"n","t":"발톱으로 한 번 긋기만 하면 됐다. 이름은 장부로 넘어가고, 아이의 손목 흉터는 영영 아물지 않을 것이었다."},{"id":"ep-12a:63","s":"tiger","t":"…","x":"sad","im":true,"scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 tiger의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12a:64","s":"n","t":"발톱은 내려가지 않았다. 호랑이는 주머니를 망토 안쪽 더 깊은 곳으로 밀어 넣었다."},{"id":"ep-12a:65","s":"tiger","t":"나중에. 다음 섬 끝나고.","x":"base"},{"id":"ep-12a:66","s":"n","t":"낮에 광장에서 아이가 북을 치던 소리가 귓가에 남아 있었다. 이름도 모르면서 박자는 하나도 틀리지 않던 소리였다."},{"id":"ep-12a:67","s":"n","t":"마지막으로 호랑이는 망토 안에서 회색 깃털을 꺼냈다. 까마귀가 남기고 간 깃털이었다.","bgm":"gloom2","im":true,"shot":"close","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12a:68","s":"n","t":"깃털 끝은 아직 따뜻했다. 귀를 가까이 대자, 아주 희미한 허밍이 들렸다."},{"id":"ep-12a:69","s":"tiger","t":"같이 부르고 싶었다, 라.","x":"talk"},{"id":"ep-12a:70","s":"tiger","t":"누구든 처음엔 그렇게 말해. 그러다 비웃음을 한 번 받으면 끝이야.","x":"base"},{"id":"ep-12a:71","s":"tiger","t":"나도 그랬으니까.","x":"sad","im":true,"shot":"close","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"siksang3 배경에서 진행되는 tiger의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-12a:72","s":"n","t":"호랑이는 제가 한 말에 놀란 듯 입을 다물었다. 무엇을 그랬다는 건지 자신도 기억나지 않았다."},{"id":"ep-12a:73","s":"n","t":"깃털은 장부에 적지 않았다. 대신 북 대장의 이름 옆, 망토의 가장 안쪽에 함께 넣었다."},{"id":"ep-12a:74","s":"n","t":"금 고리가 다시 한 번 조여 왔다. 호랑이는 이를 악물고 장부를 덮었다.","sfx":"heartbeat"},{"id":"ep-12a:75","s":"tiger","t":"다음 섬. 시간을 파는 곳. 그 돼지의 시간을 남김없이.","x":"talk"},{"id":"ep-12a:76","s":"tiger","t":"빚은 남겨 두면 불어나. 그러니까 이번엔, 미수 없이.","x":"base"},{"id":"ep-12a:77","s":"n","t":"호랑이가 언덕을 내려갔다. 젖은 모래 위로 발자국이 이어지다가 물가에서 끊겼다.","bg":"siksang3","bgm":"crisis2","shot":"wide","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}},{"id":"ep-12a:78","s":"n","t":"바람이 장부 한 귀퉁이를 들춰 올렸다. 덮인 장부 안에서 붉은 두 글자가 아직 꺼지지 않고 있었다."},{"id":"ep-12a:79","s":"n","t":"호랑이의 몸이 검은 안개로 풀어져 바다 위로 흩어졌다. 수평선 너머, 시계 소리가 나는 섬 쪽으로.","fx":"veil","scene":{"background":"siksang3","backgroundMeaning":"작가 지정 배경: siksang3","transition":"hold","tone":"natural","ambient":null,"eventEffect":"veil","camera":"drift"},"a11y":{"description":"siksang3 배경에서 진행되는 서술"}}]}
