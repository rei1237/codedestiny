{"version":2,"sourceHash":"fcd6b2a60ca39d0c9c0a0269c0d4e1c507126080ef6b1b526e4c11714b76a05d","id":"ep-15","no":"EP.15","tag":"제15화 · 금고 털이","title":"금고 털이","rev":2,"beats":[{"id":"ep-15:1","s":"n","t":"시계탑 뒷문은 생각보다 초라했다. 빵 바구니 하나가 겨우 지나갈 만한 쪽문에, 녹슨 승강기 줄이 매달려 있었다.","bg":"jaeEnter","tone":"dark","bgm":"midnightPulse","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jaeEnter","backgroundMeaning":"작가 지정 배경: jaeEnter","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter 배경에서 진행되는 서술"}},{"id":"ep-15:2","s":"ln","t":"언니가 매일 새벽 여기로 빵을 내려보냈어. 금고 경비 아저씨들 아침밥.","x":"worry","l":{"who":"yeon","x":"serious"},"c":{"who":"ln","x":"worry"},"r":{"who":"yun","x":"base"}},{"id":"ep-15:3","s":"yun","t":"루나 양 덕분에 정문 일곱 겹을 건너뛰네요. 오늘의 일등 공신이에요.","x":"base"},{"id":"ep-15:4","s":"ln","t":"그럼 나 별 다섯 개야?","x":"cheer"},{"id":"ep-15:5","s":"yeon","t":"별 다섯 개에 꽃 도장까지. 언니 깨면 자랑하자.","x":"grin"},{"id":"ep-15:6","s":"n","t":"광장 끝에서 등불 하나가 흔들렸다. 파란 제복을 입은 토끼 순찰이 하품을 하며 지나갔다."},{"id":"ep-15:7","s":"neo","t":"숙여라. 순찰은 정각마다 돈다. 다음 정각까지 4분.","x":"serious","c":{"who":"neo","x":"serious"}},{"id":"ep-15:8","s":"yeon","t":"(4분. 이 섬에선 4분이면 빵 하나 반이야.)","x":"think"},{"id":"ep-15:9","s":"moka","t":"순찰 토끼 귀 봐. 꼬치 냄새 맡고 실룩거려. 저것도 배고픈 거야.","x":"base"},{"id":"ep-15:10","s":"n","t":"순찰이 모퉁이를 돌자 넷은 그림자에서 그림자로 건너뛰었다. 루나가 앞장서서 쪽문의 빗장을 들어 올렸다."},{"id":"ep-15:11","s":"n","t":"승강기 바구니가 삐걱이며 내려갔다. 넷과 루나는 차례로 줄에 매달려 어둠 속으로 미끄러졌다.","sfx":"door"},{"id":"ep-15:12","s":"n","t":"첫 층은 공장이었다. 수백 명이 말없이 기계를 돌리고 있었다. 기계에서는 동전 대신 째깍거리는 모래알이 쏟아졌다.","bg":"jaeSlave","tone":"dark","bgm":"memWater","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jaeSlave","backgroundMeaning":"작가 지정 배경: jaeSlave","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeSlave 배경에서 진행되는 서술"}},{"id":"ep-15:13","s":"yeon","t":"이 사람들 다 경비야? 경비가 아니라 일꾼 같아.","x":"fear","l":{"who":"yeon","x":"fear"},"c":null,"r":{"who":"moka","x":"base"}},{"id":"ep-15:14","s":"yun","t":"빚진 시간을 몸으로 갚는 층이에요. 여기서 일하는 동안은 하루가 안 흘러요. 대신 집에도 못 가죠.","x":"serious"},{"id":"ep-15:15","s":"n","t":"일꾼들의 얼굴은 하나같이 흐렸다. 누구는 아이였고 누구는 노인이었다. 흐린 얼굴들 가운데 커다란 판다 하나가 졸음을 참고 있었다."},{"id":"ep-15:16","s":"moka","t":"다들 배고픈 얼굴이야. 맛을 잃은 얼굴.","x":"moved","im":true,"shot":"close","scene":{"background":"jaeSlave","backgroundMeaning":"작가 지정 배경: jaeSlave","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeSlave 배경에서 진행되는 moka의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:17","s":"moka","t":"계획 바꿀게. 홀리는 게 아니라 먹일 거야. 냄새 교란은 덤.","x":"base"},{"id":"ep-15:18","s":"n","t":"모카가 휴대 화로에 불을 붙였다. 매운 꼬치 스무 개가 한꺼번에 지글거리자 공장 안 공기가 흔들렸다.","sfx":"fire"},{"id":"ep-15:19","s":"n","t":"기계 소리가 하나씩 멈췄다. 일꾼들이 고개를 들었다. 흐린 얼굴들 사이로 침 삼키는 소리가 번졌다."},{"id":"ep-15:20","s":"moka","t":"줄 서. 값은 안 받아. 대신 맛있으면 맛있다고 말해. 그게 값이야.","x":"base"},{"id":"ep-15:21","s":"n","t":"판다가 맨 먼저 꼬치를 받았다. 한 입 베어 문 판다의 흐린 눈가가 잠깐 또렷해졌다. 맛있다. 아주 작은 목소리였다.","im":true,"scene":{"background":"jaeSlave","backgroundMeaning":"작가 지정 배경: jaeSlave","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeSlave 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:22","s":"yeon","t":"들었어? 맛있대!","x":"happy"},{"id":"ep-15:23","s":"moka","t":"당연하지. 이번엔 진짜 맛이니까.","x":"only"},{"id":"ep-15:24","s":"n","t":"꼬치 줄 맨 끝에 작은 아이 하나가 서 있었다. 귀가 접힌 아기 토끼였다. 아이는 꼬치를 받고도 먹지 않고 손목만 들여다보았다."},{"id":"ep-15:25","s":"yeon","t":"안 먹어? 맛있는데.","x":"gentle","im":true,"shot":"close","scene":{"background":"jaeSlave","backgroundMeaning":"작가 지정 배경: jaeSlave","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeSlave 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:26","s":"n","t":"아이가 손목을 내밀었다. 작은 숫자가 깜빡이고 있었다. 집까지 남은 빚 00:01:00."},{"id":"ep-15:27","s":"yeon","t":"1분? 1분 때문에 여기 있는 거야?","x":"surprise"},{"id":"ep-15:28","s":"n","t":"아이는 고개를 끄덕였다. 1분만 더 일하면 엄마한테 간다고, 꼬치 냄새 너머로 작게 말했다."},{"id":"ep-15:29","s":"yeon","t":"(1분. 내가 번 12분이면…)","x":"sad"},{"id":"ep-15:30","s":"yun","t":"숙녀분, 지금은 안 돼요. 일곱째 칸 문값이에요. 돌아오는 길에 다시 봐요.","x":"serious"},{"id":"ep-15:31","s":"yeon","t":"기다려. 돌아올 때 꼭 들를게. 꼬치 식기 전에 먹고 있어.","x":"serious"},{"id":"ep-15:32","s":"ln","t":"언니 빵 냄새랑 비슷해. 따뜻한 냄새.","x":"joy"},{"id":"ep-15:33","s":"neo","t":"모카가 시선을 끄는 동안 내려간다. 둘째 층부터는 시간이 느려진다.","x":"serious","l":{"who":"yeon","x":"serious"},"c":{"who":"neo","x":"serious"},"r":{"who":"yun","x":"serious"}},{"id":"ep-15:34","s":"yun","t":"루나 양은 모카 씨 옆에 있어요. 아래는 어른들이 갈게요.","x":"serious"},{"id":"ep-15:35","s":"ln","t":"싫어. 우리 언니 하루야. 내가 찾을 거야.","x":"worry"},{"id":"ep-15:36","s":"yeon","t":"그럼 셋째 층까지만 같이 가자. 거기서 기다리면 내가 언니 거 꼭 들고 올게. 약속.","x":"gentle"},{"id":"ep-15:37","s":"n","t":"둘째 층. 황금빛 회랑이 끝없이 이어졌다. 벽에 박힌 계기판 바늘들이 꿀처럼 느리게 움직였다.","bg":"jaeEnter2","tone":"dark","bgm":"crisis","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"crossfade","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:38","s":"n","t":"한 걸음을 떼자 발이 무거워졌다. 두 걸음째에는 귀에서 제 심장 소리가 천둥처럼 울렸다.","sfx":"heartbeat"},{"id":"ep-15:39","s":"yeon","t":"숨이… 위로 올라와.","x":"fear"},{"id":"ep-15:40","s":"neo","t":"받쳐라. 어제처럼. 아래로 내려놓고.","x":"calm"},{"id":"ep-15:41","s":"n","t":"연이는 배 아래로 숨을 내려보냈다. 귀 뒤에 꽂은 잘린 싹이 살짝 흔들렸다. 다리가 다시 움직였다."},{"id":"ep-15:42","s":"n","t":"셋째 층 문 앞에서 회랑이 덜컹 흔들렸다. 바닥 판이 뒤집히며 금속 팔들이 솟구쳤다. 경보도 없이 조용한 함정이었다.","sfx":"thud","fx":"shake","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":"shake","camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:43","s":"n","t":"네오가 앞으로 뛰쳐나갔다. 금빛 발톱이 금속 팔 셋을 한 번에 베었다. 잘린 팔들이 느린 시간 속에서 천천히 떨어졌다.","sfx":"slash","fx":"claw","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":"claw","camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:44","s":"neo","t":"길은 열었다. 문은 네 몫이다.","x":"serious"},{"id":"ep-15:45","s":"yun","t":"네, 네. 잠긴 건 제가 먹을게요.","x":"base","im":true,"shot":"close","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:46","s":"n","t":"윤달이 문고리에 손바닥을 댔다. 자물쇠가 통째로 구멍 안으로 사라졌다. 윤달의 어깨가 한 번 움찔했다.","sfx":"whoosh","fx":"suck","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":"suck","camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:47","s":"yun","t":"이 섬 자물쇠는 철 맛이 진하네요. 이빨이 시려요.","x":"pain"},{"id":"ep-15:48","s":"yeon","t":"아저씨, 방금 또 커졌죠. 손 줘 봐요.","x":"serious"},{"id":"ep-15:49","s":"yun","t":"숙녀분이 손을 잡아 주시면 덜 아플지도요.","x":"sly"},{"id":"ep-15:50","s":"yeon","t":"그런 말은 손 안 아플 때 해요!","x":"angry"},{"id":"ep-15:51","s":"n","t":"셋째 층에서 루나와 헤어졌다. 루나는 문 앞에 쪼그려 앉아 손가락 다섯 개를 펴 보였다. 다섯 시간 안에 와."},{"id":"ep-15:52","s":"n","t":"넷째, 다섯째, 여섯째 층. 내려갈수록 시간이 짙어졌다. 떨어지는 물방울이 공중에 멈춰 진주처럼 걸려 있었다.","bg":"jaeEnter2","tone":"dark","bgm":"crisis","shot":"wide","scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"}},{"id":"ep-15:53","s":"moka","t":"나 재채기 나올 것 같아.","x":"angry","c":{"who":"moka","x":"angry"}},{"id":"ep-15:54","s":"yun","t":"지금 하면 일주일이에요.","x":"serious"},{"id":"ep-15:55","s":"moka","t":"알아. 그래서 참고 있잖아. 별 하나짜리 층이야, 여기.","x":"angry"},{"id":"ep-15:56","s":"n","t":"모카의 코가 씰룩였다. 네오가 말없이 갈기 끝으로 모카의 코를 덮었다. 재채기는 갈기 속에서 조용히 사라졌다.","im":true,"scene":{"background":"jaeEnter2","backgroundMeaning":"작가 지정 배경: jaeEnter2","transition":"hold","tone":"dark","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"jaeEnter2 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:57","s":"yeon","t":"네오 갈기, 재채기 필터 기능도 있어? 별 하나 추가.","x":"laugh"},{"id":"ep-15:58","s":"neo","t":"공짜다. 오늘만.","x":"deadpan"},{"id":"ep-15:59","s":"n","t":"일곱째 칸. 거대한 원형 금고가 열려 있었다. 벽을 따라 수천 개의 모래시계가 층층이 꽂혀 있었다.","bg":"timeVault","bgm":"glassBox","shot":"wide","l":null,"c":null,"r":null,"scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"crossfade","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:60","s":"yeon","t":"이게 다 누군가의 하루야?","x":"surprise","l":{"who":"yeon","x":"surprise"},"c":null,"r":{"who":"yun","x":"serious"}},{"id":"ep-15:61","s":"yun","t":"하루, 한 달, 십 년. 이 섬에서 팔리고 빼앗긴 시간들이요.","x":"serious"},{"id":"ep-15:62","s":"n","t":"모래시계마다 아주 작은 소리가 났다. 아이 웃음소리, 밥 짓는 소리, 누군가 이름을 부르는 소리. 팔려 온 하루의 소리였다."},{"id":"ep-15:63","s":"moka","t":"여기 소리 다 맛이 있어. 누구 집 저녁 냄새 같은 소리.","x":"moved"},{"id":"ep-15:64","s":"neo","t":"오래 듣지 마라. 남의 하루에 마음이 붙으면 발이 묶인다.","x":"serious"},{"id":"ep-15:65","s":"sys","t":"[ 루나 언니 · 남은 오늘 01:12:40 ]","fx":"script","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"script","camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 시스템 메시지"}},{"id":"ep-15:66","s":"n","t":"연이는 이름표를 하나하나 훑었다. 셋째 줄 끝에서 밀가루 묻은 손 그림이 그려진 모래시계를 찾았다."},{"id":"ep-15:67","s":"yeon","t":"찾았다! 언니 거! 손 그림 있어!","x":"excited"},{"id":"ep-15:68","s":"n","t":"윤달은 반대편 벽으로 달려갔다. 맨 아래 서랍 하나에 이름 대신 빈 이름표가 붙어 있었다. 서랍은 비어 있었다."},{"id":"ep-15:69","s":"yun","t":"없네요. 묘시가 있어야 할 자리가.","x":"void","im":true,"shot":"close","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"timeVault 배경에서 진행되는 yun의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:70","s":"yeon","t":"아저씨…","x":"sad","pacing":{"pauseMs":350,"importance":"breath"}},{"id":"ep-15:71","s":"yun","t":"괜찮아요. 그 토끼가 들고 다니나 봐요. 먹은 걸 아까워하는 타입이거든요.","x":"base"},{"id":"ep-15:72","s":"n","t":"그때 금고 한가운데서 종이 넘기는 소리가 났다. 아주 느리고 아주 또박또박한 소리였다.","sfx":"page","bgm":"warCommand","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:73","s":"n","t":"금고 중앙의 둥근 단 위에 검은 호랑이가 앉아 있었다. 망토 위로 장부가 펼쳐져 있었고, 발밑에는 금빛 알 하나가 놓여 있었다.","l":{"who":"yeon","x":"fear"},"c":{"who":"tiger","x":"base"},"r":{"who":"neo","x":"angry"}},{"id":"ep-15:74","s":"tiger","t":"늦었네, 돼지. 빵집 승강기로 올 줄은 알았지만.","x":"base"},{"id":"ep-15:75","s":"yeon","t":"알았으면서 막지 않았어?","x":"serious"},{"id":"ep-15:76","s":"tiger","t":"오는 손님을 막는 금고지기는 없어. 나가는 손님을 막지.","x":"talk"},{"id":"ep-15:77","s":"n","t":"호랑이가 장부를 한 장 넘겼다. 연이는 똑똑히 보았다. 빼곡한 줄들 가운데 한 줄만 비어 있었다.","im":true,"scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:78","s":"sys","t":"[ 꽃돼지 · 미수(未收) ]","fx":"ink","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"ink","camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 시스템 메시지"}},{"id":"ep-15:79","s":"tiger","t":"다음 섬에서 너의 시간을 거두라는 말을 들었어. 그런데 네가 제 발로 금고까지 왔네.","x":"talk"},{"id":"ep-15:80","s":"yeon","t":"누가 그런 말을 했는데. 네 장부엔 사장도 적혀 있어?","x":"angry"},{"id":"ep-15:81","s":"tiger","t":"질문이 많네. 빚은 남겨 두면 불어나. 그러니까 제때 거둬야지.","x":"base"},{"id":"ep-15:82","s":"yeon","t":"그럼 너는? 너는 누구한테 뭘 빌렸는데.","x":"serious"},{"id":"ep-15:83","s":"n","t":"호랑이의 꼬리가 멈췄다. 장부를 넘기던 앞발이 아주 잠깐 허공에 걸렸다."},{"id":"ep-15:84","s":"tiger","t":"돼지가 알 필요 없는 거.","x":"talk"},{"id":"ep-15:85","s":"yeon","t":"(방금, 대답을 못 했어.)","x":"think"},{"id":"ep-15:86","s":"neo","t":"그녀에게 손대지 마라.","x":"angry"},{"id":"ep-15:87","s":"tiger","t":"사자는 빠져. 너도 이미 금이 갔잖아. 왼발.","x":"angry"},{"id":"ep-15:88","s":"n","t":"네오의 왼 앞발이 미세하게 움찔했다. 연이는 그 움직임을 보지 못했다. 연이의 눈은 호랑이 발밑의 알에 가 있었다."},{"id":"ep-15:89","s":"yeon","t":"(저 알… 왜 이렇게 낯익지. 내 안에서 뭔가가 부르는 것 같아.)","x":"think"},{"id":"ep-15:90","s":"yun","t":"숙녀분, 그 알이에요. 辰. 숙녀분 시지의 글자. 진토는 창고예요. 이 금고 전체가 그 알 위에 지어진 거예요.","x":"serious"},{"id":"ep-15:91","s":"sys","t":"[ 年 □□ · 月 丙午 · 日 乙亥 · 時 □辰 ? ]","fx":"script","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"script","camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 시스템 메시지"}},{"id":"ep-15:92","s":"yeon","t":"내 글자가 왜 금고 바닥에 깔려 있어?","x":"surprise"},{"id":"ep-15:93","s":"n","t":"알은 연이를 알아보기라도 한 듯 아주 작게 흔들렸다. 금빛 껍질 아래로 무언가 꿈틀거렸다."},{"id":"ep-15:94","s":"tiger","t":"시간이 비어 있는 명식은 창고가 열려 있는 집이야. 누구든 들어와서 쌓아 둘 수 있지.","x":"talk"},{"id":"ep-15:95","s":"moka","t":"말 길다. 알 내놔. 언니 하루도 내놔.","x":"angry","bgm":"warCommand","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 moka의 대사"}},{"id":"ep-15:96","s":"n","t":"호랑이가 꼬리를 한 번 휘둘렀다. 바닥의 시곗바늘을 따라 검은 물이 번져 나갔다. 물은 발목에 닿자마자 시간을 얼렸다.","sfx":"water","fx":"water","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"water","camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:97","s":"neo","t":"물에 닿지 마라! 멈춘다!","x":"serious"},{"id":"ep-15:98","s":"n","t":"네오가 금선을 뽑아 물길을 갈랐다. 물이 갈라진 틈으로 모카가 몸을 날려 언니의 모래시계를 품에 안았다.","sfx":"slash","fx":"metal","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"metal","camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:99","s":"moka","t":"챙겼어! 언니 거, 내 품에 있어!","x":"only"},{"id":"ep-15:100","s":"tiger","t":"그건 가져가. 원래 내 장부에 없는 거니까. 토끼 몫이야.","x":"base"},{"id":"ep-15:101","s":"yeon","t":"그럼 저 알도 가져갈게.","x":"serious"},{"id":"ep-15:102","s":"tiger","t":"그건 안 돼.","x":"angry","im":true,"shot":"impact","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"timeVault 배경에서 진행되는 tiger의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}},{"id":"ep-15:103","s":"n","t":"연이가 단 위로 뛰어올랐다. 앞발이 알에 닿는 순간, 단 전체가 거대한 시계판으로 바뀌었다."},{"id":"ep-15:104","s":"n","t":"종소리가 일곱 번 울렸다. 시곗바늘이 연이를 중심으로 빙글 돌더니, 연이의 몸 둘레에 투명한 유리벽이 솟았다.","sfx":"bell","bgm":"crisis2","fx":"vortex","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"vortex","camera":"drift"},"a11y":{"description":"timeVault 배경에서 진행되는 서술"}},{"id":"ep-15:105","s":"yeon","t":"움직일 수가 없어! 숨이… 숨이 안 내려가!","x":"shock"},{"id":"ep-15:106","s":"sys","t":"[ 시간 덫 · 탈출 값 72:00:00  보유 71:53:09  부족 00:06:51 ]","fx":"script","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":"script","camera":"steady"},"a11y":{"description":"timeVault 배경에서 진행되는 시스템 메시지"}},{"id":"ep-15:107","s":"neo","t":"연이!","x":"shock"},{"id":"ep-15:108","s":"tiger","t":"미안하다는 말은 안 해. 장부에 그런 칸은 없으니까.","x":"sad"},{"id":"ep-15:109","s":"n","t":"유리벽 바깥, 금고 천장의 환기구에서 파란 귀 두 개가 쏙 내려왔다. 청토끼가 거꾸로 매달려 손을 흔들었다.","sfx":"whoosh"},{"id":"ep-15:110","s":"rab","t":"어머~ 딱 6분 51초 모자라시네요? 청토끼 금융이 빌려드릴까요? 이자는 아주아주 조금!","x":"invite","l":{"who":"yeon","x":"shock"},"c":null,"r":{"who":"rab","x":"invite"}},{"id":"ep-15:111","s":"yeon","t":"(빌리면 나간다. 안 빌리면, 여기서 멈춘다.)","x":"fear","im":true,"shot":"close","scene":{"background":"timeVault","backgroundMeaning":"작가 지정 배경: timeVault","transition":"hold","tone":"natural","ambient":null,"eventEffect":null,"camera":"focus"},"a11y":{"description":"timeVault 배경에서 진행되는 yeon의 대사"},"pacing":{"pauseMs":700,"importance":"impact"}}]}
