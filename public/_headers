# ✅ PERF: Cloudflare Pages Cache-Control 헤더 설정
# 정적 자산: 버전 해시/쿼리스트링 포함 — 1년 불변 캐시
# HTML: revalidate 단기 캐시

# ─── JS/CSS: 무버전 자산이 섞여 있어 immutable은 금지, 대신 중기 캐시 + SWR ───
/js/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/lib/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/styles/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/css/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# ─── Next 해시 자산: 장기 immutable 캐시 ──────────────────────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ─── 이미지 & 폰트 ────────────────────────────────────────────
/icons/*
  Cache-Control: public, max-age=31536000, immutable

/fuctionassets/*
  Cache-Control: public, max-age=31536000, immutable

/tarot-cards/*
  Cache-Control: public, max-age=31536000, immutable

# ─── 서비스 워커 — 항상 재검증 ────────────────────────────────
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# ─── PWA 매니페스트 — 단기 캐시 ──────────────────────────────
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/manifest-samba.json
  Cache-Control: no-cache, no-store, must-revalidate

# ─── HTML 페이지 — revalidate (SEO 필수) ─────────────────────
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: index, follow

/static/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: index, follow

/en-us
  X-Robots-Tag: index, follow

/ja-jp
  X-Robots-Tag: index, follow

/zh-cn
  X-Robots-Tag: index, follow

/hi-in
  X-Robots-Tag: index, follow

/es-es
  X-Robots-Tag: index, follow

/fr-fr
  X-Robots-Tag: index, follow

/de-de
  X-Robots-Tag: index, follow

/nl-nl
  X-Robots-Tag: index, follow

/ms-my
  X-Robots-Tag: index, follow

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

# ─── API 응답 — 캐시 없음 ─────────────────────────────────────
/api/*
  Cache-Control: no-store
