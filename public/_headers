# Cloudflare Pages cache policy
# Goal: always deliver latest HTML/API, cache only hashed build assets for long-term.

# HTML and entry routes must never be long-cached.
/
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/static
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/static/
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/static/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

# Runtime metadata and APIs must always revalidate.
/api/*
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/status.json
  Cache-Control: no-cache, no-store, must-revalidate

# Service worker and manifest should update immediately.
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/tadagochi-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/manifest-samba.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

# Non-hashed legacy assets: do not use immutable cache.
/*.js
  Cache-Control: no-cache, no-store, must-revalidate

/*.css
  Cache-Control: no-cache, no-store, must-revalidate

/js/*.js
  Cache-Control: no-cache, no-store, must-revalidate

/lib/*.js
  Cache-Control: no-cache, no-store, must-revalidate

/styles/*.css
  Cache-Control: no-cache, no-store, must-revalidate

/css/*.css
  Cache-Control: no-cache, no-store, must-revalidate

/icons/*
  Cache-Control: no-cache, no-store, must-revalidate

/fuctionassets/*
  Cache-Control: no-cache, no-store, must-revalidate

/tarot-cards/*
  Cache-Control: no-cache, no-store, must-revalidate

/fonts/*
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed Next.js static build assets only.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
