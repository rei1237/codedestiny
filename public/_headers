# ✅ PERF: Cloudflare Pages Cache-Control 헤더 설정
# 정적 자산: 버전 해시/쿼리스트링 포함 — 1년 불변 캐시
# HTML: revalidate 단기 캐시

# ─── JS/CSS: 무버전 자산이 섞여 있으므로 항상 재검증 ─────────
/js/*.js
  Cache-Control: public, max-age=0, must-revalidate

/lib/*.js
  Cache-Control: public, max-age=0, must-revalidate

/styles/*.css
  Cache-Control: public, max-age=0, must-revalidate

/css/*.css
  Cache-Control: public, max-age=0, must-revalidate

# ─── 이미지 & 폰트 ────────────────────────────────────────────
/icons/*
  Cache-Control: public, max-age=31536000, immutable

/fuctionassets/*
  Cache-Control: public, max-age=31536000, immutable

/tarot-cards/*
  Cache-Control: public, max-age=31536000, immutable

# ─── 서비스 워커 — 항상 재검증 ────────────────────────────────
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# ─── PWA 매니페스트 — 단기 캐시 ──────────────────────────────
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/manifest-samba.json
  Cache-Control: no-cache, no-store, must-revalidate

# ─── HTML 페이지 — revalidate (SEO 필수) ─────────────────────
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/static/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

# ─── API 응답 — 캐시 없음 ─────────────────────────────────────
/api/*
  Cache-Control: no-store
