# ✅ PERF: Cloudflare Pages Cache-Control 헤더 설정
# ★ 2026-03-28 Core Web Vitals 최적화 업데이트
#   - 버전 쿼리스트링(?v=...) 포함 자산 → 1년 불변 캐시
#   - 무버전 자산 → 항상 재검증
#   - 전체 응답에 Vary: Accept-Encoding, Link preload 힌트 추가

# ─── JS: 버전 쿼리스트링 포함 파일 — 1년 불변 캐시 ──────────
# Cloudflare Pages는 쿼리스트링별 분기가 불가하므로
# 무버전 혼재 가능성을 고려해 must-revalidate 유지.
/js/*.js
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept-Encoding

/lib/*.js
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept-Encoding

# ─── CSS: 버전 태그 포함 → 1년 캐시 가능하나 무버전 혼재 ────
/styles/*.css
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept-Encoding

/css/*.css
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept-Encoding

# ─── 이미지 & 폰트: 내용 불변 — 1년 불변 캐시 ───────────────
/icons/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/fuctionassets/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/tarot-cards/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/public/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ─── 서비스 워커 — 항상 재검증 ────────────────────────────────
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# ─── PWA 매니페스트 — 단기 캐시 ──────────────────────────────
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/manifest-samba.json
  Cache-Control: no-cache, no-store, must-revalidate

# ─── HTML 페이지 — revalidate (SEO 필수) ─────────────────────
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  # LCP 자산 HTTP/2 Server Push (Cloudflare 지원 시 동작)
  Link: </icons/samba.webp>; rel=preload; as=image, </icons/honeypig.webp>; rel=preload; as=image; fetchpriority=low

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: index, follow
  Link: </icons/samba.webp>; rel=preload; as=image

/static/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: index, follow

/en-us
  X-Robots-Tag: index, follow

/ja-jp
  X-Robots-Tag: index, follow

/zh-cn
  X-Robots-Tag: index, follow

/hi-in
  X-Robots-Tag: index, follow

/es-es
  X-Robots-Tag: index, follow

/fr-fr
  X-Robots-Tag: index, follow

/de-de
  X-Robots-Tag: index, follow

/nl-nl
  X-Robots-Tag: index, follow

/ms-my
  X-Robots-Tag: index, follow

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff

# ─── fortune 정적 운세 HTML — SEO 명시적 허용 ────────────────
# NOTE: Cloudflare Pages _headers의 * 는 / 경계를 넘지 않으므로
#       depth별 규칙을 모두 선언합니다.
# /fortune/today/rat.html (depth 2)
/fortune/*
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff

/fortune/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff

# /fortune/today/rat.html, /fortune/weekly/rat.html (depth 2 sub-dir)
/fortune/*/*
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff

/fortune/*/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff

# /fortune/today/sukuyo/1.html (depth 3)
/fortune/*/*/*
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff

/fortune/*/*/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff

# ─── API 응답 — 캐시 없음 ─────────────────────────────────────
/api/*
  Cache-Control: no-store
