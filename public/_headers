# Cloudflare Pages cache policy
# ══════════════════════════════════════════════════════════════
# 원칙:
#   - HTML, SW, manifest, version.json → 절대 캐시 금지
#   - 해시 기반 Next.js 빌드 assets(_next/static/) → 장기 캐시
#   - 그 외 고정 파일명 JS/CSS/assets → 캐시 금지
# ══════════════════════════════════════════════════════════════

# ── 보안 헤더(전체 응답) ─────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# ── HTML 진입점: 절대 캐시 금지 ──────────────────────────────────
/
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/*.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/static
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/static/
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/static/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

# ── API: 절대 캐시 금지 ──────────────────────────────────────────
/api/*
  Cache-Control: no-cache, no-store, must-revalidate

# ── 버전/상태 파일: 절대 캐시 금지 ──────────────────────────────
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/status.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

# ── Service Worker: 절대 캐시 금지 ──────────────────────────────
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/tadagochi-sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

# ── Manifest: 절대 캐시 금지 (PWA 설치 상태에서 구버전 앱 방지) ──
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/manifest-samba.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

/manifest-tadagochi.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-cache, no-store, must-revalidate

# ── 고정 파일명 JS/CSS (해시 없음): 단기 캐시 + 재검증 ───────────
/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/lib/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/styles/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/css/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# ── 고정 파일명 assets: 단기 캐시 + 재검증 ───────────────────────
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
  CDN-Cache-Control: public, max-age=604800, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/fuctionassets/*
