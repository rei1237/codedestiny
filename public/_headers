# ── Next.js 해시 기반 빌드 assets: 장기 캐시 허용 ───────────────
# _next/static/ 하위 파일은 content hash가 파일명에 포함됨
# 파일이 변경되면 자동으로 새 해시 URL이 생성됨
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
