# Cloudflare Pages _redirects
# 저장 경로: public/_redirects
# ─────────────────────────────────────────────

# canonical 경로 정규화
# Next.js trailingSlash=true 정책과 충돌하는 slash 제거 리다이렉트는 제거합니다.
# (예: /about -> /about/ 과 /about/ -> /about 이 공존하면 무한 루프 발생)
/sukyo                         /sukuyo                   301
/sukyo/*                       /sukuyo/:splat            301
/face-reading                  /physiognomy              301

# 브랜드/핵심 서비스 별칭
/ggulggul                      /manse                    301
/ggulggul-manse                /manse                    301
/code-destiny                  /                         301
/codedestiny                   /                         301
/fortune                       /daily-fortune            301
/saju-free                     /saju                     301

# 쿼리스트링 → 클린 URL 리다이렉트 (301 영구)
# 구형 /insights?topic=XXX 구조를 새 /insights/XXX 경로로 리다이렉트

# insights 쿼리스트링 리다이렉트는 Cloudflare Pages _redirects에서 지원되지 않음
# (쿼리스트링 매칭 미지원: ?topic=XXX 전부 /insights로 인식 → 중복 오류)
# 구형 클라이언트는 /insights 페이지 자체에서 JS로 처리

# 로케일 루트는 trailing slash canonical을 유지합니다.
# /{locale}/index.html 형태의 직접 접근만 /{locale}/로 정규화합니다.
/en/index.html                 /en/            301
/ja/index.html                 /ja/            301
/zh/index.html                 /zh/            301

# 레거시 locale slug -> 신규 locale slug
/en-us                         /en             301
/en-us/*                       /en/:splat      301
/ja-jp                         /ja             301
/ja-jp/*                       /ja/:splat      301
/zh-cn                         /zh             301
/zh-cn/*                       /zh/:splat      301

# 구형 /blog/* → /insights/*
/blog/saju-pallja               /insights/saju-pallja-basic-principles-complete-guide  301
