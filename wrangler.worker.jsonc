{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-destiny",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-03-14",
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
