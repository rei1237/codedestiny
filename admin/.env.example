# 관리자 포털(비밀 해시 기반) 설정 예시
#
# 운영 권장:
# - ADMIN_SECRET_HASH 는 32자리 랜덤 문자열(실제 값은 소스코드에 두지 말 것)
# - ADMIN_ALLOWED_IPS 는 “허용 IP만” 포함 (그 외는 404로 위장)

ADMIN_SECURITY_LEVEL="relaxed"
ADMIN_SECRET_HASH="PUT_32_CHAR_RANDOM_HASH_HERE"
ADMIN_ALLOWED_IPS="127.0.0.1,203.0.113.10"

# 세션/토큰 서명 비밀 (기존 Express JWT_SECRET과 동일하게 사용)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# 잠금 해제(이메일 인증) SMTP 설정
# - 이 설정이 없으면 이메일 발송 기반 잠금 해제는 동작하지 않으며, 안전하게 404로 위장된다.
ADMIN_SMTP_HOST="smtp.example.com"
ADMIN_SMTP_PORT="587"
ADMIN_SMTP_USER="smtp-user@example.com"
ADMIN_SMTP_PASS="smtp-password"
ADMIN_SMTP_FROM="CODE DESTINY <smtp-user@example.com>"

# (옵션) KASI/기타 만세력 엔진 설정은 기존 프로젝트의 환경변수를 따른다.

