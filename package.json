{
  "name": "code-destiny",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "api": "node server/server.js",
    "guard:privacy": "node scripts/guard-blocked-keywords.mjs",
    "cron:daily-content": "node server/jobs/daily-content-cron.js",
    "seo:check": "node scripts/check-seo-health.mjs",
    "adsense:audit": "node scripts/adsense-crawl-audit.mjs https://code-destiny.com 250",
    "rss:generate": "node scripts/generate-rss.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "seo:generate": "npm run sitemap:generate && npm run rss:generate",
    "build": "next build",
    "postbuild": "node scripts/promote-static-shell-to-root.mjs",
    "clean:cf": "node scripts/clean-cloudflare-build.mjs",
    "sync:public": "node scripts/sync-legacy-static-to-public.mjs",
    "fortune:generate": "node scripts/gen-daily.mjs && node scripts/gen-fortune-system-pages.mjs",
    "fortune:generate:daily": "node scripts/gen-daily.mjs",
    "fortune:generate:system-pages": "node scripts/gen-fortune-system-pages.mjs",
    "fortune:generate:once": "node scripts/fortune-daily-once.mjs",
    "secrets:cf:pages:dry": "node scripts/sync-cloudflare-pages-secrets.mjs --dry-run",
    "secrets:cf:pages": "node scripts/sync-cloudflare-pages-secrets.mjs",
    "secrets:cf:worker:dry": "node scripts/sync-cloudflare-worker-secrets.mjs --dry-run",
    "secrets:cf:worker": "node scripts/sync-cloudflare-worker-secrets.mjs",
    "sanitize:cf-env": "node scripts/sanitize-open-next-env.mjs",
    "prune:serverfn:heavy": "node scripts/prune-server-function-static-heavy.mjs",
    "verify:no-secret-leak": "node scripts/verify-no-secret-leak.mjs",
    "verify:worker-size": "node scripts/verify-worker-size-budget.mjs",
    "verify:entry-encoding": "node scripts/verify-entry-encoding.mjs",
    "verify:style-sync": "node scripts/verify-style-sync.mjs",
    "verify:public-parity": "node scripts/verify-public-parity.mjs",
    "migrate:withdraw": "node scripts/migrate-withdraw-indexes.mjs",
    "seed:inicis-test-account": "node scripts/seed-inicis-test-account.mjs",
    "seed:test-account": "node scripts/seed-test-account.mjs",
    "verify:test-account-payment-flow": "node scripts/verify-test-account-payment-flow.mjs",
    "verify:inicis-local-auth": "node scripts/verify-inicis-local-auth.mjs",
    "verify:locale-main-sync": "node scripts/verify-locale-main-sync.mjs",
    "verify:runtime-cache-sync": "node scripts/verify-runtime-cache-sync.mjs",
    "smoke:oauth:prod": "node scripts/smoke-oauth-callbacks.mjs --base https://code-destiny.com",
    "smoke:oauth:worker": "node scripts/smoke-oauth-callbacks.mjs --base https://code-destiny-web.bulegyung.workers.dev",
    "test:signup": "node scripts/test-signup.mjs",
    "perf:psi": "node scripts/measure-psi.mjs",
    "perf:psi:before": "node scripts/measure-psi.mjs --out reports/psi-before.json",
    "perf:psi:after": "node scripts/measure-psi.mjs --out reports/psi-after.json",
    "build:web-vitals": "npx esbuild scripts/web-vitals-console.mjs --bundle --format=esm --outfile=js/web-vitals-console.js --platform=browser",
    "prebuild:cf": "node scripts/sync-legacy-static-to-public.mjs && node scripts/verify-entry-encoding.mjs --strict-core",
    "build:cf": "npm run build",
    "deploy:cf": "npm run deploy:cf:worker",
    "deploy:cf:pages": "npm run build:cf && node scripts/deploy-pages.mjs",
    "deploy:cf:worker": "node scripts/deploy-worker.mjs",
    "deploy:cf:opennext": "node scripts/opennext-deploy-retry.mjs",
    "deploy:cf:opennext:retry": "node scripts/opennext-deploy-retry.mjs",
    "deploy:cf:versions": "npx wrangler versions upload --config worker/wrangler.toml",
    "deploy:cf:all": "npm run deploy:cf",
    "build:worker": "npx wrangler deploy --config worker/wrangler.toml --dry-run",
    "deploy:worker": "npm run deploy:cf:worker",
    "preview:worker": "npx wrangler dev --config worker/wrangler.toml",
    "deploy": "npm run deploy:cf",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.11.0",
    "@react-pdf/renderer": "^4.4.0",
    "astronomy-engine": "^2.1.19",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "framer-motion": "^11.15.0",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "lunar-javascript": "^1.7.7",
    "mongoose": "^9.3.0",
    "next": "^15.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.3",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.8.1",
    "resend": "^6.12.2",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.4",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.12",
    "lighthouse": "^13.1.0",
    "postcss": "^8.4.39",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.2",
    "wrangler": "^4.73.0"
  }
}
