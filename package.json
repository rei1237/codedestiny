    "build:worker": "npx wrangler deploy --config worker/wrangler.toml --dry-run",
    "deploy:worker": "npm run deploy:cf:worker",
    "preview:worker": "npx wrangler dev --config worker/wrangler.toml",
    "deploy": "npm run deploy:cf",
