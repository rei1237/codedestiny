{
  "name": "code-destiny-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "api": "node server/server.js",
    "cron:daily-content": "node server/jobs/daily-content-cron.js",
    "seo:check": "node scripts/check-seo-health.mjs",
    "seo:indexnow": "tsx scripts/indexnow-submit.ts",
    "build": "next build",
    "clean:cf": "node scripts/clean-cloudflare-build.mjs",
    "sync:public": "node scripts/sync-legacy-static-to-public.mjs",
    "fortune:generate": "node scripts/gen-daily.mjs && node scripts/gen-fortune-system-pages.mjs",
    "fortune:generate:daily": "node scripts/gen-daily.mjs",
    "fortune:generate:system-pages": "node scripts/gen-fortune-system-pages.mjs",
    "fortune:generate:once": "node scripts/fortune-daily-once.mjs",
    "secrets:cf:pages:dry": "node scripts/sync-cloudflare-pages-secrets.mjs --dry-run",
    "secrets:cf:pages": "node scripts/sync-cloudflare-pages-secrets.mjs",
    "sanitize:cf-env": "node scripts/sanitize-open-next-env.mjs",
    "verify:no-secret-leak": "node scripts/verify-no-secret-leak.mjs",
    "build:web-vitals": "npx esbuild scripts/web-vitals-console.mjs --bundle --format=esm --outfile=js/web-vitals-console.js --platform=browser",
    "build:cf": "npm run clean:cf && npm run sync:public && node scripts/build-cloudflare.mjs && npm run sanitize:cf-env && npm run verify:no-secret-leak && node scripts/prepare-cloudflare-dist.mjs && npm run verify:no-secret-leak",
    "deploy:cf:pages": "npm run build:cf && node scripts/deploy-pages.mjs",
    "deploy:cf:worker": "node scripts/deploy-worker.mjs",
    "deploy:cf:versions": "npx wrangler versions upload",
    "deploy:cf:all": "npm run build:cf && node scripts/deploy-worker.mjs && node scripts/deploy-pages.mjs",
    "deploy": "next build && npx @opennextjs/cloudflare build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "framer-motion": "^11.15.0",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "lunar-javascript": "^1.7.7",
    "mongoose": "^9.3.0",
    "next": "^15.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.3",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "cssnano": "^7.1.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.12",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.5.2",
    "wrangler": "^4.73.0"
  }
}
