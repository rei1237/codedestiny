{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "dist/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "_graveyard",
    ".next",
    ".open-next",
    "build",
    "out",
    "dist",
    "_scripts-archive",
    ".codex-worktrees",
    ".claude/worktrees",
    ".release-clean",
    "_release-clean",
    "**/_tmp_*.mjs",
    "**/_tmp_*.cjs",
    "**/_test*.mjs",
    "**/_fix_*.mjs",
    "**/_patch_*.mjs",
    "**/_verify_*.mjs",
    "**/_sync_*.mjs",
    "veda"
  ]
}
