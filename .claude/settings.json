{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git check-attr *)",
      "Bash(git worktree *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git revert *)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run verify:*)",
      "Bash(npm run check:*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run sync:public)",
      "Bash(node scripts/verify-*)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx cross-env *)",
      "Bash(node --check *)",
      "Bash(node --input-type=module --check)",
      "Bash(node -e *)",
      "Bash(node scripts/lib/change-risk.mjs *)",
      "Bash(node .claude/skills/impeccable/scripts/*)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(diff *)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run verify:*)",
      "PowerShell(npm run check:*)",
      "PowerShell(npm run test*)",
      "PowerShell(npm run build*)",
      "PowerShell(npx jest *)",
      "PowerShell(npx cross-env *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Test-Path *)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ],
    "baseRef": "fresh",
    "bgIsolation": "worktree"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-costly-commands.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking for billed/production commands"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  }
}
