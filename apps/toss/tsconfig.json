{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "../..",
    "paths": {"@/*": ["./*"],"react": ["apps/toss/node_modules/@types/react"],"react/*": ["apps/toss/node_modules/@types/react/*"]},
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "src",
    "apps-in-toss.config.ts",
    "vite.config.ts"
  ]
}
