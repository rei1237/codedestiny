{
  "name": "code-destiny-toss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317",
    "dev:offline": "node --require=../../scripts/lib/mock-network-guard.cjs ./node_modules/vite/bin/vite.js --config test/offline/vite.config.ts --mode toss-offline",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && ait build && node scripts/check-bundle-size.mjs",
    "verify:release-bundle": "node scripts/check-bundle-size.mjs --require-portable",
    "test": "node --test test/*.test.mjs",
    "launch:status": "node scripts/launch-status.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.7.0",
    "@emotion/react": "11.14.0",
    "@toss/tds-mobile": "2.5.1",
    "@toss/tds-mobile-ait": "2.5.1",
    "fflate": "0.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "3.9.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
