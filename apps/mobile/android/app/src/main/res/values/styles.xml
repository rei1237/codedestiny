<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 12+ 스플래시 API(및 minSdk24 core-splashscreen 백포트):
             다크 배경 위에 앱버전 로고를 중앙 표시. MainActivity.installSplashScreen() 필요. -->
        <item name="windowSplashScreenBackground">@color/cd_splash_bg</item>
        <!-- splash_logo.webp(512x512)는 drawable-nodpi/ 에 둔다.
             density 없는 drawable/ 에 두면 Android 가 mdpi 로 간주해 xxhdpi 기기에서 3배로
             늘려 첫 프레임이 흐릿하게 나온다. nodpi 는 density 스케일링을 건너뛰므로
             288dp 아이콘 캔버스까지 1.69배 확대에 그친다. 다른 버킷으로 옮기지 말 것. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- 네오(다크) 모드용 스플래시. 배경색만 다르고 로고·postSplashScreenTheme 은 상속으로 동일하다.
         base 스타일(AppTheme.NoActionBarLaunch)은 LockScreenActivity 도 쓰므로 수정하지 않고
         형제 스타일로 추가한다. MainActivity 가 installSplashScreen() 직전에 골라 적용한다.
         values-night/ 을 쓰지 않는 이유: 그건 OS 다크모드를 따르는데, 여기서 필요한 것은
         앱 자체의 연이/네오 토글 상태다(웹뷰 알고리즘 다크닝을 끈 결정과도 일관). -->
    <style name="AppTheme.NoActionBarLaunch.Neo" parent="AppTheme.NoActionBarLaunch">
        <item name="windowSplashScreenBackground">@color/cd_splash_bg_neo</item>
    </style>
</resources>