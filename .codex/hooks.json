{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/verify-worktree-policy.mjs\" --hook",
            "timeout": 5,
            "statusMessage": "Checking secondary worktree policy"
          }
        ]
      }
    ]
  }
}
