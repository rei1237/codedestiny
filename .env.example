# 포트원 고객사 식별코드(IMP.init)
NEXT_PUBLIC_PORTONE_IMP_CODE="imp00000000"
# PortOne V2 전환 대비: Store ID / Channel Key
# 관리자 콘솔 > 연동 관리에서 TossPayments 채널 생성 후 값을 입력하세요.
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=""
# TossPayments 채널을 명시적으로 고정할 때 사용 (비우면 NEXT_PUBLIC_PORTONE_CHANNEL_KEY 사용)
NEXT_PUBLIC_PORTONE_TOSS_CHANNEL_KEY=""
# 모바일 결제 복귀 경로(반드시 PortOne 콘솔에 등록된 도메인/경로와 일치)
NEXT_PUBLIC_PORTONE_MOBILE_REDIRECT_PATH="/points"
# 선택: 결제 요청 시 웹훅 URL 강제 지정 (notice_url)
