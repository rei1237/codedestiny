NEXT_PUBLIC_PORTONE_PG_TOSS_CARD=""
NEXT_PUBLIC_PORTONE_PG_TOSS_TRANSFER=""
NEXT_PUBLIC_PORTONE_PG_NAVERPAY=""
# 일반 카드 기본값은 TossPayments 권장 (기존 html5_inicis 대체)
NEXT_PUBLIC_PORTONE_PG_CARD="tosspayments"
NEXT_PUBLIC_PORTONE_PG_PAYPAL=""
NEXT_PUBLIC_PORTONE_PG_APPLEPAY=""
NEXT_PUBLIC_PORTONE_PG_GOOGLEPAY=""
# 포트원 웹훅 보호용 선택 토큰 (설정 시 x-cd-webhook-token 헤더와 일치해야 처리)
PORTONE_WEBHOOK_TOKEN=""

# 사주 동물 이미지 생성 (server-only, Gemini)
