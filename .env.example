# 프로젝트 공통 환경변수 예시
#
# 주의: 이 파일은 예시이며 실제 운영환경에서는 `.env`로 복사해 사용하세요.

# API 서버 (기존 프로젝트 설정 예시)
API_PORT=4000
MONGODB_URI="CHANGE_ME"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# -------- Social OAuth (server-side) --------
# API 서버가 OAuth 콜백 URL을 만들 때 사용
AUTH_API_BASE_URL="http://localhost:4000"
# OAuth 완료 후 프론트 로그인 페이지로 복귀할 주소
AUTH_FRONTEND_BASE_URL="http://localhost:3000"

GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

NAVER_OAUTH_CLIENT_ID=""
NAVER_OAUTH_CLIENT_SECRET=""

KAKAO_OAUTH_CLIENT_ID=""
KAKAO_OAUTH_CLIENT_SECRET=""

# 관리자 포털(비밀 해시/화이트리스트/2FA) 예시
ADMIN_SECURITY_LEVEL="relaxed"
ADMIN_SECRET_HASH="PUT_32_CHAR_RANDOM_HASH_HERE"
ADMIN_ALLOWED_IPS="127.0.0.1,203.0.113.10"

# 잠금 해제(이메일 인증) SMTP 예시(옵션)
ADMIN_SMTP_HOST="smtp.example.com"
ADMIN_SMTP_PORT="587"
ADMIN_SMTP_USER="smtp-user@example.com"
ADMIN_SMTP_PASS="smtp-password"
ADMIN_SMTP_FROM="CODE DESTINY <smtp-user@example.com>"

# -------- AI / External API Secrets (server-only) --------
# 절대 NEXT_PUBLIC_* 로 노출하지 마세요.
# 실사용은 .env.local(로컬), 배포 환경 Secret Manager(Cloudflare/Vercel/GitHub Secrets) 권장
# 기본 권장 키 (Gemini 서버 호출용)
GOOGLE_API_KEY=""
# 호환용 별칭 (둘 중 하나만 설정해도 동작)
GEMINI_API_KEY=""
# 보조 키(트래픽 분산/예비키)
GOOGLE_API_KEY_2=""
GEMINI_API_KEY_2=""
GOOGLE_API_KEY_3=""
GEMINI_API_KEY_3=""
PSYCHO_ANALYSIS_GEMINI_MODEL="gemini-2.5-flash"
PSYCHO_ANALYSIS_MAX_TOKENS="2400"
PSYCHO_ANALYSIS_PROVIDER_TIMEOUT_MS="45000"
# 쉼표로 구분한 허용 오리진 (비워두면 기본 allowlist 사용)
PSYCHO_ANALYSIS_ALLOWED_ORIGINS="https://code-destiny.com,https://www.code-destiny.com"


YOUTUBE_API_KEY="AIzaSyAYtZJZzNHWWciMDgaleLv7IFudqLBoBkw"

ANTHROPIC_API_KEY=""
PSYCHO_ANALYSIS_ANTHROPIC_MODEL="claude-sonnet-4-20250514"

DEEPL_API_KEY=""
DEEPL_API_BASE_URL="https://api.deepl.com/v2/translate"

PORTONE_API_KEY=""
PORTONE_API_SECRET=""

# 사주 동물 이미지 생성 (server-only, Gemini)
SAJU_ANIMAL_GEMINI_MODEL="gemini-2.0-flash-preview-image-generation"

