# 프로젝트 공통 환경변수 예시
#
# 주의: 이 파일은 예시이며 실제 운영환경에서는 `.env`로 복사해 사용하세요.

# API 서버 (기존 프로젝트 설정 예시)
API_PORT=4000
MONGODB_URI="CHANGE_ME"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# -------- Social OAuth (server-side) --------
# API 서버가 OAuth 콜백 URL을 만들 때 사용
AUTH_API_BASE_URL="http://localhost:4000"
# OAuth 완료 후 프론트 로그인 페이지로 복귀할 주소
AUTH_FRONTEND_BASE_URL="http://localhost:3000"

# -------- Auth.js / NextAuth 호환 키 (현재 프로젝트는 커스텀 JWT 라우트 사용) --------
# Auth.js v5 권장 키
AUTH_URL="http://localhost:3000"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
AUTH_TRUST_HOST="true"

