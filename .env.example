# Code Destiny Environment Variables Example
# 복사하여 .env 파일을 생성하고 실제 키 값을 입력하세요.

MONGO_NAME:MONGO_DB_NAME:code_destiny
MONGO_URI:mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/?appName=Neo

NAVER_OAUTH_CLIENT_ID:YOUR_NAVER_OAUTH_CLIENT_ID
NAVER_OAUTH_CLIENT_SECRET:YOUR_NAVER_OAUTH_CLIENT_SECRET

GOOGLE_OAUTH_CLIENT_ID:YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET:YOUR_GOOGLE_OAUTH_CLIENT_SECRET

NEXT_PUBLIC_API_BASE_URL:https://code-destiny.com
NEXT_PUBLIC_CODE_DESTINY_API_URL:https://code-destiny.com/api

PAGESPEED_API_KEY:YOUR_PAGESPEED_API_KEY
EMAILAPI:YOUR_EMAIL_API_KEY
PORTONE_API_KEY:YOUR_PORTONE_API_KEY
YOUTUBE_API_KEY:YOUR_YOUTUBE_API_KEY

# Gemini Flash API Keys
GEMINIF_API_KEY1:YOUR_GEMINI_API_KEY_1
GEMINIF_API_KEY2:YOUR_GEMINI_API_KEY_2
GEMINIF_API_KEY3:YOUR_GEMINI_API_KEY_3
GEMINIF_API_KEY4:YOUR_GEMINI_API_KEY_4
GEMINIF_API_KEY5:YOUR_GEMINI_API_KEY_5
GEMINIF_API_KEY6:YOUR_GEMINI_API_KEY_6
GEMINIF_API_KEY7:YOUR_GEMINI_API_KEY_7
GEMINIF_API_KEY8:YOUR_GEMINI_API_KEY_8

# KASI API (Lunar-Solar Conversion)
KASI_SERVICE_KEY:YOUR_KASI_SERVICE_KEY
KASI_API_BASE_URL:https://apis.data.go.kr/B090041/openapi/service/LrsrCldInfoService