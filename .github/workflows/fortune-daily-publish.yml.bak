# KST 자정(UTC 15:00) 직후에만 “그날”(KST 달력) daily-YYYY-MM-DD.json 1건 생성 → 커밋·푸시 → main 푸시로 배포 1회.
# 코드 배포(build:cf)와 무관 — 중복 생성 방지(FORTUNE_SCHEDULED + fortune-daily-once 스킵 + gen-daily 멱등).

name: Fortune daily package (once per day)

on:
  schedule:
    # 00:00 KST (한국 표준시) — 이 시점의 KST ‘오늘’ 날짜로 패키지 생성
    - cron: "0 15 * * *"
  workflow_dispatch:

concurrency:
  group: fortune-daily-kst
  cancel-in-progress: false

permissions:
  contents: write

env:
  FORTUNE_SCHEDULED: "1"

jobs:
  daily-fortune:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Generate daily JSON if missing (KST today)
        run: node scripts/fortune-daily-once.mjs

      - name: Commit and push if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          DATE_KST=$(node --input-type=module -e "import { kstYmdToday } from './scripts/lib/fortune-date.mjs'; console.log(kstYmdToday())")
          git add -A fortune/data/ public/fortune/data/
          if git diff --staged --quiet; then
            echo "No fortune data changes (already generated for ${DATE_KST} or skip)."
            exit 0
          fi
          git commit -m "chore(fortune): daily package ${DATE_KST}"
          git push
