# Cloudflare Pages deploy auth
# Recommended scope: Account.Cloudflare Pages:Edit + Account:Read
CLOUDFLARE_API_TOKEN=

# Optional alias supported by scripts/deploy-pages.mjs
# CF_API_TOKEN=

# Pages project settings
CF_PAGES_PROJECT_NAME=code-destiny-web
CF_PAGES_BRANCH=main

# OpenNext Worker name (wrangler.json default: code-destiny-web). Override if your Worker uses another name.
# CF_WORKER_NAME=code-destiny

# Pages Secret sync source values (optional if already in .env.local/.env)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# PAGESPEED_API_KEY=
# GOOGLE_PAGESPEED_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPL_API_KEY=
# PORTONE_API_KEY=
# PORTONE_API_SECRET=
# JWT_SECRET=
# ADMIN_SECRET_HASH=

# Optional, useful for some wrangler commands
# CLOUDFLARE_ACCOUNT_ID=
