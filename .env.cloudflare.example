# Cloudflare Pages deploy auth
# Recommended scope: Account.Cloudflare Pages:Edit + Account:Read
CLOUDFLARE_API_TOKEN=

# Optional alias supported by scripts/deploy-pages.mjs
# CF_API_TOKEN=

# Pages project settings
CF_PAGES_PROJECT_NAME=code-destiny
CF_PAGES_BRANCH=main

# OpenNext Worker name (wrangler.json default: code-destiny). Override if your Worker uses another name.
# CF_WORKER_NAME=code-destiny

# Pages Secret sync source values (optional if already in .env.local/.env)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY_2=
# GOOGLE_API_KEY_2=
# GEMINI_API_KEY_3=
# GOOGLE_API_KEY_3=
# ANTHROPIC_API_KEY=
# DEEPL_API_KEY=
# PORTONE_API_KEY=
# PORTONE_API_SECRET=
# NEXT_PUBLIC_PORTONE_IMP_CODE=imp00000000
# NEXT_PUBLIC_PORTONE_STORE_ID=
# NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# NEXT_PUBLIC_PORTONE_TOSS_CHANNEL_KEY=
# NEXT_PUBLIC_PORTONE_PG_CARD=tosspayments
# NEXT_PUBLIC_PORTONE_MOBILE_REDIRECT_PATH=/points
# JWT_SECRET=
# AUTH_URL=https://code-destiny.com
# AUTH_TRUST_HOST=true
# ADMIN_SECRET_HASH=
# AUTH_API_BASE_URL=https://api.code-destiny.com
# AUTH_FRONTEND_BASE_URL=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# NAVER_OAUTH_CLIENT_ID=
# NAVER_OAUTH_CLIENT_SECRET=
# KAKAO_OAUTH_CLIENT_ID=
# KAKAO_OAUTH_CLIENT_SECRET=
# MONGO_URI=
# MONGO_DB_NAME=code_destiny

# Optional, useful for some wrangler commands
# CLOUDFLARE_ACCOUNT_ID=
