# Cloudflare Pages deploy auth
# Recommended scope: Account.Cloudflare Pages:Edit + Account:Read
CLOUDFLARE_API_TOKEN=

# Optional alias supported by scripts/deploy-pages.mjs
# CF_API_TOKEN=

# Pages project settings
CF_PAGES_PROJECT_NAME=codedestiny
CF_PAGES_BRANCH=main

# Worker name. This Worker serves the backend API.
CF_WORKER_NAME=code-destiny-web

# Worker-native API base used by OAuth redirect URL generation.
AUTH_API_BASE_URL=https://code-destiny.com
AUTH_FRONTEND_BASE_URL=https://code-destiny.com
SITE_BASE_URL=https://code-destiny.com
KAKAO_OAUTH_CALLBACK=https://code-destiny.com/api/auth/oauth/kakao/callback
API_WORKER_ORIGIN=https://code-destiny-web.bulegyung.workers.dev
AUTH_SIGNUP_BONUS_POINTS=50
MONGO_DB_NAME=code_destiny
MONGODB_DB_NAME=code_destiny

# Optional fallback proxy for API groups not yet ported to Worker-native handlers.
# Do not set this to the Worker URL or the frontend URL.
API_UPSTREAM_ORIGIN=

# Frontend should normally call same-origin /api/* on Cloudflare Pages.
# Leave this blank in production unless you intentionally want direct Worker calls.
NEXT_PUBLIC_API_BASE_URL=

# Pages environment values should be browser-safe public keys only.
# Keep auth/database/provider secrets on Worker secrets only.
# NEXT_PUBLIC_PORTONE_IMP_CODE=imp00000000
# NEXT_PUBLIC_PORTONE_STORE_ID=
# NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# NEXT_PUBLIC_PORTONE_TOSS_CHANNEL_KEY=
# NEXT_PUBLIC_PORTONE_PG_CARD=tosspayments
# NEXT_PUBLIC_PORTONE_MOBILE_REDIRECT_PATH=/points

# Worker-only secrets (set via wrangler secret put or dashboard)
# JWT_SECRET=
# AUTH_SECRET=
# MONGO_URI=
# MONGODB_URI=
# MONGO_DB_NAME=code_destiny
# MONGODB_DB_NAME=code_destiny
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# NAVER_OAUTH_CLIENT_ID=
# NAVER_OAUTH_CLIENT_SECRET=
# KAKAO_OAUTH_CLIENT_ID=
# KAKAO_OAUTH_CLIENT_SECRET=

# Optional, useful for some wrangler commands
# CLOUDFLARE_ACCOUNT_ID=
